    var count = h('span', { class: 'count' });
    var body = h('div', { class: 'sec-b', id: 'und-sec-' + sec.id });
    var el = h('section', { class: 'sec' + (sec.width === 'half' ? ' half' : '') + (sec.collapsed ? ' closed' : ''), 'data-sec': sec.id, 'aria-label': TITLES[sec.id] },
