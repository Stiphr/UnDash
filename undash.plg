<FILE Name="&emhttp;/include/lib.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - core helpers.
 * Written for PHP 7.4+ : no match, str_contains, nullsafe or named arguments.
 *
 * Test seams (in-process only, never read from the environment or the web):
 *   $GLOBALS['UND_EXEC_MOCK'](array $argv) -> result array or null to run for real
 *   $GLOBALS['UND_FS'] (string)            -> prefix for /proc, /sys, /etc and /var paths (dev harness)
 *   $GLOBALS['UND_SPAWN_MOCK'](array $argv, $log)
 */

if (!defined('UND_LIB_LOADED')) {
define('UND_LIB_LOADED', 1);

define('UND_VERSION', '2026.10.29');
define('UND_NAME',    'UnDash');
if (!defined('UND_ROOT')) define('UND_ROOT',    '/usr/local/emhttp/plugins/undash');
if (!defined('UND_DIR')) define('UND_DIR',     '/boot/config/plugins/undash');
define('UND_CFG',     UND_DIR . '/config.json');
define('UND_SECRETS', UND_DIR . '/secrets.json');
if (!defined('UND_TMP')) define('UND_TMP',     '/tmp/undash');
define('UND_DM',      '/usr/local/emhttp/plugins/dynamix.docker.manager');
define('UND_UPDSTATUS', '/var/lib/docker/unraid-update-status.json');
define('UND_KEEP',    '__KEEP__');     // stands in for a stored secret in everything sent to the browser

/** System paths go through here so the dev harness can point them at fixtures. */
function und_path($p) { return isset($GLOBALS['UND_FS']) ? $GLOBALS['UND_FS'] . $p : $p; }
function und_read($p) { $s = @file_get_contents(und_path($p)); return $s === false ? '' : $s; }

function und_has($s, $p)    { return $p === '' || strpos((string)$s, $p) !== false; }
function und_starts($s, $p) { return strncmp((string)$s, $p, strlen($p)) === 0; }

/* ---------- JSON files ---------- */

function und_read_json($file, $default) {
  if (!is_file($file)) return $default;
  $d = json_decode((string)@file_get_contents($file), true);
  return is_array($d) ? $d : $default;
}

/** Atomic write; skipped when nothing changed (the flash drive has limited write cycles). */
function und_write_json($file, $data, $private = false) {
  $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR);
  if ($json === false) return false;
  if (is_file($file) && @file_get_contents($file) === $json) return true;
  @mkdir(dirname($file), 0755, true);
  $tmp = $file . '.tmp' . getmypid();
  if (@file_put_contents($tmp, $json) === false) return false;
  if ($private) @chmod($tmp, 0600);
  if (!@rename($tmp, $file)) { @unlink($tmp); return false; }
  return true;
}

function und_tmp($name) { @mkdir(UND_TMP, 0755, true); return UND_TMP . '/' . $name; }

/* ---------- running commands (no shell, argument arrays only) ---------- */

/** Returns ['code'=>int,'out'=>string,'err'=>string,'timeout'=>bool]. Output is capped, the command is killed on timeout. */
function und_run(array $argv, $timeout = 30, $maxBytes = 2097152) {
  if (isset($GLOBALS['UND_EXEC_MOCK']) && is_callable($GLOBALS['UND_EXEC_MOCK'])) {
    $r = call_user_func($GLOBALS['UND_EXEC_MOCK'], $argv);
    if (is_array($r)) return $r + ['code' => 0, 'out' => '', 'err' => '', 'timeout' => false];
  }
  $res = ['code' => -1, 'out' => '', 'err' => '', 'timeout' => false];
  $p = @proc_open($argv, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
  if (!is_resource($p)) { $res['err'] = 'could not start ' . basename((string)$argv[0]); return $res; }
  @fclose($pipes[0]);
  stream_set_blocking($pipes[1], false);
  stream_set_blocking($pipes[2], false);
  $deadline = microtime(true) + max(1, $timeout);
  $open = [1 => $pipes[1], 2 => $pipes[2]];
  while ($open) {
    $left = $deadline - microtime(true);
    if ($left <= 0) { $res['timeout'] = true; break; }
    $r = array_values($open); $w = null; $e = null;
    if (@stream_select($r, $w, $e, 0, (int)min(200000, $left * 1000000)) === false) break;
    foreach ($open as $k => $h) {
      $chunk = @fread($h, 65536);
      if ($chunk !== false && $chunk !== '') { $key = $k === 1 ? 'out' : 'err'; if (strlen($res[$key]) < $maxBytes) $res[$key] .= $chunk; }
      if (feof($h)) { @fclose($h); unset($open[$k]); }
    }
  }
  if ($res['timeout']) { @proc_terminate($p, 9); }
  foreach ($open as $h) @fclose($h);
  $code = @proc_close($p);
  $res['code'] = $res['timeout'] ? 124 : $code;
  return $res;
}

function und_bin($name) {
  foreach (['/usr/bin', '/usr/local/bin', '/bin', '/usr/sbin', '/sbin', '/usr/local/sbin'] as $d) {
    if (is_file("$d/$name") && is_executable("$d/$name")) return "$d/$name";
  }
  return $name;
}

/**
 * Start a long command in the background; its output goes to $log. A "<log>.done" file holding the exit code
 * is written when it finishes, so the UI can tell running from finished.
 */
function und_spawn(array $argv, $log) {
  if (isset($GLOBALS['UND_SPAWN_MOCK'])) { call_user_func($GLOBALS['UND_SPAWN_MOCK'], $argv, $log); return true; }
  @unlink($log . '.done');
  @file_put_contents($log, '');
  $cmd = '';
  foreach ($argv as $a) $cmd .= ($cmd === '' ? '' : ' ') . escapeshellarg($a);
  $sh = $cmd . ' >> ' . escapeshellarg($log) . ' 2>&1; echo $? > ' . escapeshellarg($log . '.done');
  exec('nohup setsid /bin/bash -c ' . escapeshellarg($sh) . ' > /dev/null 2>&1 &');
  return true;
}

/** State of a background job started with und_spawn: idle | running | done (with exit code and output tail). */
function und_job($log, $tail = 16000) {
  clearstatcache();
  if (!is_file($log)) return ['state' => 'idle', 'code' => null, 'out' => ''];
  $out = (string)@file_get_contents($log);
  if (strlen($out) > $tail) $out = substr($out, -$tail);
  $out = preg_replace('/\x1b\[[0-9;]*[A-Za-z]/', '', $out);
  $done = is_file($log . '.done');
  return ['state' => $done ? 'done' : 'running', 'code' => $done ? (int)trim((string)@file_get_contents($log . '.done')) : null, 'out' => und_redact($out), 'at' => (int)@filemtime($log)];
}

/* ---------- text ---------- */

/** Remove anything that looks like a secret from text that is shown. */
function und_redact($s, array $extra = []) {
  $s = (string)$s;
  foreach ($extra as $x) if (is_string($x) && strlen($x) >= 6) $s = str_replace($x, '[redacted]', $s);
  $s = preg_replace('#(https?://)[^/\s:@]+:[^/\s@]+@#i', '$1[redacted]@', $s);
  $s = preg_replace('/([?&](?:apikey|api_key|X-Plex-Token|token|key)=)[^&\s"]+/i', '$1[redacted]', $s);
  return $s;
}

function und_clip($s, $max) {
  $s = (string)$s;
  if (function_exists('mb_strlen')) return mb_strlen($s, 'UTF-8') > $max ? mb_substr($s, 0, $max - 1, 'UTF-8') . '…' : $s;
  return strlen($s) > $max ? substr($s, 0, $max - 3) . '...' : $s;
}

function und_valid_name($n) { return is_string($n) && preg_match('/^[A-Za-z0-9][A-Za-z0-9_. +()\-]{0,127}$/', $n) === 1; }

/* ---------- Unraid ---------- */

function und_var_ini() { $v = @parse_ini_string(und_read('/var/local/emhttp/var.ini')); return is_array($v) ? $v : []; }

function und_os_version() {
  $v = @parse_ini_string(und_read('/etc/unraid-version'));
  return is_array($v) && !empty($v['version']) ? (string)$v['version'] : '';
}

function und_server_ip() {
  $n = @parse_ini_string(und_read('/var/local/emhttp/network.ini'), true);
  if (is_array($n)) foreach ($n as $sec) if (is_array($sec) && !empty($sec['IPADDR:0'])) return (string)$sec['IPADDR:0'];
  $ip = $_SERVER['SERVER_ADDR'] ?? '';
  return $ip !== '' ? $ip : '127.0.0.1';
}

$__ident = @parse_ini_string(und_read('/boot/config/ident.cfg'));
if (is_array($__ident) && !empty($__ident['timezone'])) @date_default_timezone_set($__ident['timezone']);
unset($__ident);

} // UND_LIB_LOADED

foreach (['config', 'system', 'docker', 'vm', 'services', 'import'] as $__m) {
  $__f = __DIR__ . '/' . $__m . '.php';
  if (is_file($__f)) require_once $__f;
}
unset($__m, $__f);
]]></INLINE>
<SHA256>e48523b1097f428b0fc5366ce0725acb0458b1d57f42afe79e7c2ff19f586476</SHA256>
</FILE>

<FILE Name="&emhttp;/include/config.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - configuration.
 * config.json holds the layout (no secrets). secrets.json holds variables and per-service credentials; neither ever leaves
 * the server in clear text: stored secrets are sent to the browser as UND_KEEP and put back when the browser returns UND_KEEP.
 */

/** Every widget type: [label, credential fields it uses, needs url]. */
function und_types() {
  return [
    'system_info' => ['System information', [], false], 'cpu' => ['CPU usage', [], false], 'memory' => ['Memory usage', [], false],
    'storage' => ['Array & pools', [], false], 'ups' => ['UPS (NUT / apcupsd)', [], false],
    'docker_summary' => ['Docker summary', [], false], 'vm_summary' => ['VM summary', [], false],
    'calendar' => ['Calendar (Radarr / Sonarr)', [], false], 'tautulli_recent' => ['Recently added (Tautulli)', ['key'], true],
    'radarr' => ['Radarr', ['key'], true], 'sonarr' => ['Sonarr', ['key'], true], 'lidarr' => ['Lidarr', ['key'], true],
    'readarr' => ['Readarr', ['key'], true], 'bazarr' => ['Bazarr', ['key'], true], 'prowlarr' => ['Prowlarr', ['key'], true],
    'overseerr' => ['Overseerr / Jellyseerr', ['key'], true], 'autobrr' => ['Autobrr', ['key'], true], 'wizarr' => ['Wizarr', ['key'], true],
    'qbittorrent' => ['qBittorrent', ['username', 'password'], true], 'sabnzbd' => ['SABnzbd', ['key'], true],
    'emby' => ['Emby', ['key'], true], 'jellyfin' => ['Jellyfin', ['key'], true], 'plex' => ['Plex', ['key'], true], 'tautulli' => ['Tautulli', ['key'], true],
    'adguard' => ['AdGuard Home', ['username', 'password'], true], 'pihole' => ['Pi-hole', ['key'], true], 'npm' => ['Nginx Proxy Manager', ['username', 'password'], true],
    'immich' => ['Immich', ['key'], true], 'peanut' => ['PeaNUT', ['key', 'username', 'password'], true],
    'customapi' => ['Custom API (JSON)', ['key'], true], 'link' => ['Link only', [], false],
  ];
}

function und_default_config() {
  $svc = function ($name, $type, $icon = '', $extra = []) { return $extra + ['id' => und_id(), 'name' => $name, 'type' => $type, 'icon' => $icon, 'href' => '', 'url' => '', 'fields' => [], 'options' => new stdClass()]; };
  return [
    'general' => ['title' => 'UnDash', 'refresh_system' => 5, 'refresh_services' => 15, 'disk_path' => '/mnt/user', 'search' => 'duckduckgo',
                  'background' => '', 'blur' => 4, 'brightness' => 75, 'show_resources' => true, 'show_search' => true, 'show_date' => true, 'os_check_hours' => 6, 'ups_name' => 'ups', 'theme' => 'dark'],
    'groups' => [
      ['id' => und_id(), 'name' => 'System', 'columns' => 4, 'header' => false, 'services' => [
        $svc('System information', 'system_info', 'sh-unraid'), $svc('CPU Usage', 'cpu'), $svc('Memory Usage', 'memory'), $svc('UPS', 'ups')]],
      ['id' => und_id(), 'name' => 'Server', 'columns' => 3, 'header' => true, 'services' => [
        $svc('Docker', 'docker_summary', 'sh-docker'), $svc('Virtual machines', 'vm_summary', 'sh-qemu'), $svc('Storage', 'storage', 'sh-unraid')]],
    ],
  ];
}

function und_id() { return bin2hex(random_bytes(4)); }

function und_load_config() {
  $c = und_read_json(UND_CFG, null);
  if (!is_array($c) || !isset($c['groups'])) return und_default_config();
  return und_normalize($c);
}

/** Clamp and fill a config that came from disk or from the browser. */
function und_normalize(array $c) {
  $d = und_default_config();
  $g = (isset($c['general']) && is_array($c['general']) ? $c['general'] : []) + $d['general'];
  $g['title'] = und_clip(trim((string)$g['title']), 60) ?: 'UnDash';
  foreach (['refresh_system' => [2, 300], 'refresh_services' => [5, 3600], 'blur' => [0, 40], 'brightness' => [10, 100], 'os_check_hours' => [1, 168]] as $k => $r) $g[$k] = max($r[0], min($r[1], (int)$g[$k]));
  foreach (['show_resources', 'show_search', 'show_date'] as $k) $g[$k] = !empty($g[$k]);
  $g['disk_path'] = preg_match('#^/mnt/[A-Za-z0-9_./ -]*$#', (string)$g['disk_path']) ? (string)$g['disk_path'] : '/mnt/user';
  $g['theme'] = in_array($g['theme'], ['dark', 'light', 'midnight'], true) ? $g['theme'] : 'dark';
  $g['search'] = in_array($g['search'], ['duckduckgo', 'google', 'bing', 'startpage', 'brave'], true) ? $g['search'] : 'duckduckgo';
  $g['background'] = preg_match('#^(https?://|/)[^"\'<>\s]*$#', (string)$g['background']) ? (string)$g['background'] : '';
  $g['ups_name'] = preg_match('/^[A-Za-z0-9_.@:-]{1,64}$/', (string)$g['ups_name']) ? (string)$g['ups_name'] : 'ups';
  $types = und_types(); $groups = [];
  foreach ((array)($c['groups'] ?? []) as $gr) {
    if (!is_array($gr)) continue;
    $out = ['id' => preg_match('/^[a-f0-9]{8}$/', (string)($gr['id'] ?? '')) ? $gr['id'] : und_id(), 'name' => und_clip(trim((string)($gr['name'] ?? 'Group')), 60),
            'columns' => max(1, min(8, (int)($gr['columns'] ?? 4))), 'header' => !isset($gr['header']) || !empty($gr['header']), 'services' => []];
    foreach ((array)($gr['services'] ?? []) as $s) {
      if (!is_array($s) || !isset($types[$s['type'] ?? ''])) continue;
      $opt = isset($s['options']) && is_array($s['options']) ? $s['options'] : [];
      $out['services'][] = ['id' => preg_match('/^[a-f0-9]{8}$/', (string)($s['id'] ?? '')) ? $s['id'] : und_id(), 'name' => und_clip(trim((string)($s['name'] ?? '')), 60) ?: $types[$s['type']][0],
        'type' => $s['type'], 'icon' => und_clip((string)($s['icon'] ?? ''), 300), 'href' => und_clip((string)($s['href'] ?? ''), 500), 'url' => und_clip((string)($s['url'] ?? ''), 500),
        'fields' => array_values(array_filter(array_map('strval', (array)($s['fields'] ?? [])), function ($f) { return preg_match('/^[A-Za-z0-9_]{1,40}$/', $f); })),
        'options' => $opt ? $opt : new stdClass()];
    }
    $groups[] = $out;
  }
  return ['general' => $g, 'groups' => $groups];
}

function und_save_config(array $c) { return und_write_json(UND_CFG, und_normalize($c)); }

/* ---------- secrets ---------- */

function und_secrets() {
  $s = isset($GLOBALS['UND_TEST_SECRETS']) ? $GLOBALS['UND_TEST_SECRETS'] : und_read_json(UND_SECRETS, []);
  return ['vars' => isset($s['vars']) && is_array($s['vars']) ? $s['vars'] : [], 'svc' => isset($s['svc']) && is_array($s['svc']) ? $s['svc'] : []];
}
function und_save_secrets(array $s) { return und_write_json(UND_SECRETS, $s, true); }

function und_var_is_secret($name) { return preg_match('/KEY|TOKEN|PASS|SECRET/i', $name) === 1; }

/** What the browser may see: secret variables and stored credentials are replaced by UND_KEEP. */
function und_secrets_view(array $s) {
  $vars = [];
  foreach ($s['vars'] as $k => $v) $vars[] = ['name' => $k, 'value' => und_var_is_secret($k) && $v !== '' ? UND_KEEP : $v, 'secret' => und_var_is_secret($k)];
  $svc = [];
  foreach ($s['svc'] as $id => $c) foreach (['key', 'password', 'username'] as $f) {
    if (!isset($c[$f]) || $c[$f] === '') continue;
    $svc[$id][$f] = ($f === 'username' || und_has($c[$f], '{{')) ? $c[$f] : UND_KEEP;
  }
  return ['vars' => $vars, 'svc' => (object)$svc];
}

/** Merge what the browser sent back with what is stored (UND_KEEP = unchanged). */
function und_secrets_merge(array $old, array $vars, array $svc, array $ids) {
  $new = ['vars' => [], 'svc' => []];
  foreach ($vars as $v) {
    $n = strtoupper(trim((string)($v['name'] ?? '')));
    if (!preg_match('/^[A-Z][A-Z0-9_]{0,63}$/', $n)) continue;
    $val = (string)($v['value'] ?? '');
    $new['vars'][$n] = $val === UND_KEEP ? (string)($old['vars'][$n] ?? '') : und_clip($val, 2000);
  }
  foreach ($ids as $id) {
    $in = isset($svc[$id]) && is_array($svc[$id]) ? $svc[$id] : [];
    foreach (['key', 'password', 'username'] as $f) {
      $val = (string)($in[$f] ?? '');
      if ($val === UND_KEEP) $val = (string)($old['svc'][$id][$f] ?? '');
      if ($val !== '') $new['svc'][$id][$f] = und_clip($val, 2000);
    }
  }
  return $new;
}

/** Replace {{NAME}} with variable values. UNRAID_IP is built in. Unknown names are left as they are. */
function und_resolve($s, array $vars) {
  if (!und_has($s, '{{')) return $s;
  return preg_replace_callback('/\{\{\s*([A-Za-z0-9_]+)\s*\}\}/', function ($m) use ($vars) {
    $n = strtoupper($m[1]);
    if (isset($vars[$n])) return $vars[$n];
    if ($n === 'UNRAID_IP') return und_server_ip();
    return $m[0];
  }, (string)$s);
}

/** A service with every {{VAR}} resolved and its credentials attached. Server side only. */
function und_service_full(array $cfg, $id) {
  $sec = und_secrets();
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) {
    if ($s['id'] !== $id) continue;
    $c = $sec['svc'][$id] ?? [];
    foreach (['key', 'password', 'username'] as $f) $s[$f] = und_resolve((string)($c[$f] ?? ''), $sec['vars']);
    foreach (['url', 'href'] as $f) $s[$f] = und_resolve($s[$f], $sec['vars']);
    $s['options'] = json_decode(und_resolve(json_encode($s['options']), array_map(function ($v) { return trim(json_encode((string)$v), '"'); }, $sec['vars'])), true) ?: [];
    $s['_group'] = $g['name'];
    return $s;
  }
  return null;
}

function und_find_service(array $cfg, $group, $name, $type = null) {
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) {
    if (strcasecmp($s['name'], (string)$name) === 0 && ($group === null || $group === '' || strcasecmp($g['name'], (string)$group) === 0) && ($type === null || $s['type'] === $type)) return $s['id'];
  }
  return null;
}

/** The layout sent to the browser: hrefs resolved (they are links the user clicks anyway), nothing else. */
function und_layout_view(array $cfg) {
  $vars = und_secrets()['vars'];
  foreach ($cfg['groups'] as &$g) foreach ($g['services'] as &$s) $s['href_resolved'] = und_resolve($s['href'], $vars);
  return $cfg;
}
]]></INLINE>
<SHA256>a6b1166e5b29362955be7a296aeffdbc95e928893aac822a84990bec06a2c0c7</SHA256>
</FILE>

<FILE Name="&emhttp;/include/system.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - system information, read straight from the kernel and from Unraid's own state files (no Glances needed).
 * Rates (CPU, network) are the difference to the previous sample, kept in /tmp/undash so every poll is cheap.
 */

function und_cpu_sample() {
  foreach (explode("\n", und_read('/proc/stat')) as $l) {
    if (und_starts($l, 'cpu ')) {
      $p = array_map('intval', preg_split('/\s+/', trim(substr($l, 4))));
      $idle = ($p[3] ?? 0) + ($p[4] ?? 0);
      return ['total' => array_sum(array_slice($p, 0, 8)), 'idle' => $idle];
    }
  }
  return null;
}

function und_net_iface() {
  foreach (array_slice(explode("\n", und_read('/proc/net/route')), 1) as $l) {
    $c = preg_split('/\s+/', trim($l));
    if (count($c) > 2 && $c[1] === '00000000') return $c[0];
  }
  return '';
}

function und_net_sample($if) {
  foreach (explode("\n", und_read('/proc/net/dev')) as $l) {
    if (strpos($l, ':') === false) continue;
    list($n, $rest) = explode(':', $l, 2);
    if (trim($n) !== $if) continue;
    $c = preg_split('/\s+/', trim($rest));
    return ['rx' => (float)$c[0], 'tx' => (float)$c[8]];
  }
  return null;
}

/** CPU % and network bytes/s since the previous call (a fresh 300 ms sample when there is none, or it is stale). */
function und_rates() {
  $f = und_tmp('rates.json');
  $prev = und_read_json($f, []);
  $now = microtime(true);
  $if = und_net_iface();
  $cpu = und_cpu_sample(); $net = $if ? und_net_sample($if) : null;
  if (!$prev || $now - ($prev['t'] ?? 0) > 60 || $now - ($prev['t'] ?? 0) < 0.25) {
    usleep(300000);
    $prev = ['t' => $now, 'cpu' => $cpu, 'net' => $net, 'if' => $if];
    $now = microtime(true); $cpu = und_cpu_sample(); $net = $if ? und_net_sample($if) : null;
  }
  $dt = max(0.05, $now - $prev['t']);
  $pct = null;
  if ($cpu && !empty($prev['cpu'])) {
    $dTot = $cpu['total'] - $prev['cpu']['total']; $dIdle = $cpu['idle'] - $prev['cpu']['idle'];
    $pct = $dTot > 0 ? max(0, min(100, round(100 * ($dTot - $dIdle) / $dTot, 1))) : 0;
  }
  $rx = $tx = null;
  if ($net && !empty($prev['net']) && ($prev['if'] ?? '') === $if) { $rx = max(0, ($net['rx'] - $prev['net']['rx']) / $dt); $tx = max(0, ($net['tx'] - $prev['net']['tx']) / $dt); }
  und_write_json($f, ['t' => $now, 'cpu' => $cpu, 'net' => $net, 'if' => $if]);
  return ['cpu' => $pct, 'rx' => $rx, 'tx' => $tx, 'iface' => $if];
}

function und_meminfo() {
  $m = [];
  foreach (explode("\n", und_read('/proc/meminfo')) as $l) if (preg_match('/^(\w+):\s+(\d+)/', $l, $x)) $m[$x[1]] = (float)$x[2] * 1024;
  $total = $m['MemTotal'] ?? 0; $avail = $m['MemAvailable'] ?? ($m['MemFree'] ?? 0);
  return ['total' => $total, 'used' => max(0, $total - $avail), 'free' => $avail, 'pct' => $total ? round(100 * ($total - $avail) / $total, 1) : null];
}

function und_cpu_model() {
  if (preg_match('/^model name\s*:\s*(.+)$/m', und_read('/proc/cpuinfo'), $m)) return trim(preg_replace('/\s+/', ' ', $m[1]));
  return '';
}

function und_cpu_threads() { return max(1, preg_match_all('/^processor\s*:/m', und_read('/proc/cpuinfo'))); }

/** CPU package temperature in °C (coretemp / k10temp / zenpower), else the hottest thermal zone. */
function und_cpu_temp() {
  foreach (glob(und_path('/sys/class/hwmon/hwmon*')) ?: [] as $d) {
    $n = trim((string)@file_get_contents("$d/name"));
    if (!in_array($n, ['coretemp', 'k10temp', 'zenpower', 'cpu_thermal'], true)) continue;
    $best = null;
    foreach (glob("$d/temp*_label") ?: [] as $lf) {
      $lab = trim((string)@file_get_contents($lf));
      if (preg_match('/^(Package id 0|Tctl|Tdie)$/', $lab)) { $best = str_replace('_label', '_input', $lf); break; }
    }
    if (!$best) $best = "$d/temp1_input";
    $v = (int)@file_get_contents($best);
    if ($v > 0) return round($v / 1000, 1);
  }
  $max = null;
  foreach (glob(und_path('/sys/class/thermal/thermal_zone*/temp')) ?: [] as $f) { $v = (int)@file_get_contents($f); if ($v > 0) $max = max((float)$max, $v / 1000); }
  return $max === null ? null : round($max, 1);
}

function und_uptime() { return (int)(float)explode(' ', trim(und_read('/proc/uptime')) . ' ')[0]; }

function und_disk($path) {
  $p = und_path($path);
  $t = @disk_total_space($p); $f = @disk_free_space($p);
  if (!$t) return null;
  return ['path' => $path, 'total' => $t, 'free' => $f, 'used' => $t - $f, 'pct' => round(100 * ($t - $f) / $t, 1)];
}

/** Everything the top bar and the System cards need, in one call. */
function und_system(array $cfg) {
  $r = und_rates(); $mem = und_meminfo(); $v = und_var_ini();
  $hist = und_read_json(und_tmp('hist.json'), []);
  $now = time();
  if ($r['cpu'] !== null && (empty($hist) || $now - (int)end($hist)[0] >= 2)) { $hist[] = [$now, $r['cpu'], $mem['used']]; $hist = array_slice($hist, -90); und_write_json(und_tmp('hist.json'), $hist); }
  $load = preg_split('/\s+/', trim(und_read('/proc/loadavg')));
  return [
    'now' => $now, 'name' => (string)($v['NAME'] ?? gethostname()), 'os' => und_os_version(), 'kernel' => trim((string)preg_replace('/^Linux version (\S+).*$/s', '$1', und_read('/proc/version'))),
    'cpu' => ['pct' => $r['cpu'], 'model' => und_cpu_model(), 'threads' => und_cpu_threads(), 'temp' => und_cpu_temp(), 'load' => array_map('floatval', array_slice($load, 0, 3))],
    'mem' => $mem, 'net' => ['rx' => $r['rx'], 'tx' => $r['tx'], 'iface' => $r['iface']], 'disk' => und_disk($cfg['general']['disk_path']),
    'uptime' => und_uptime(), 'array' => ['state' => (string)($v['mdState'] ?? ''), 'resync' => (int)($v['mdResync'] ?? 0), 'resync_pos' => (float)($v['mdResyncPos'] ?? 0), 'resync_size' => (float)($v['mdResyncSize'] ?? 0)],
    'hist' => $hist, 'os_update' => und_os_cached(),
  ];
}

/* ---------- array & pools ---------- */

function und_storage() {
  $d = @parse_ini_string(und_read('/var/local/emhttp/disks.ini'), true);
  $out = ['array' => [], 'pools' => [], 'parity' => []];
  if (!is_array($d)) return $out;
  foreach ($d as $name => $x) {
    if (!is_array($x) || ($x['status'] ?? '') === 'DISK_NP' || ($x['status'] ?? '') === 'DISK_NP_DSBL') continue;
    $row = ['name' => (string)$name, 'device' => (string)($x['device'] ?? ''), 'status' => (string)($x['status'] ?? ''), 'temp' => is_numeric($x['temp'] ?? '') ? (int)$x['temp'] : null,
            'size' => (float)($x['fsSize'] ?? 0) * 1024, 'free' => (float)($x['fsFree'] ?? 0) * 1024, 'fs' => (string)($x['fsType'] ?? ''), 'spun' => ($x['spundown'] ?? '0') !== '1'];
    $type = (string)($x['type'] ?? '');
    if ($type === 'Parity') $out['parity'][] = $row;
    elseif ($type === 'Data') $out['array'][] = $row;
    // a pool's first device carries the file system totals; its other members (cache2, cache3 ...) have none
    elseif ($type === 'Cache' && (float)($x['fsSize'] ?? 0) > 0) $out['pools'][] = $row;
  }
  return $out;
}

/* ---------- UPS: NUT (upsc) first, then apcupsd (apcaccess) ---------- */

function und_ups($name = 'ups') {
  $upsc = und_bin('upsc');
  if ($upsc !== 'upsc' || isset($GLOBALS['UND_EXEC_MOCK'])) {
    $r = und_run([$upsc, strpos($name, '@') === false ? $name . '@localhost' : $name], 8);
    if ($r['code'] === 0 && preg_match('/battery\.charge:/', $r['out'])) {
      $k = [];
      foreach (explode("\n", $r['out']) as $l) if (strpos($l, ':') !== false) { list($a, $b) = explode(':', $l, 2); $k[trim($a)] = trim($b); }
      return ['source' => 'NUT', 'charge' => (float)($k['battery.charge'] ?? 0), 'load' => isset($k['ups.load']) ? (float)$k['ups.load'] : null,
              'status' => und_ups_status($k['ups.status'] ?? ''), 'runtime' => isset($k['battery.runtime']) ? (int)$k['battery.runtime'] : null, 'model' => (string)($k['ups.model'] ?? $k['device.model'] ?? '')];
    }
  }
  $apc = und_bin('apcaccess');
  if ($apc !== 'apcaccess' || isset($GLOBALS['UND_EXEC_MOCK'])) {
    $r = und_run([$apc], 8);
    if ($r['code'] === 0 && preg_match('/BCHARGE/', $r['out'])) {
      $k = [];
      foreach (explode("\n", $r['out']) as $l) if (strpos($l, ':') !== false) { list($a, $b) = explode(':', $l, 2); $k[trim($a)] = trim($b); }
      return ['source' => 'apcupsd', 'charge' => (float)($k['BCHARGE'] ?? 0), 'load' => isset($k['LOADPCT']) ? (float)$k['LOADPCT'] : null,
              'status' => ucfirst(strtolower((string)($k['STATUS'] ?? ''))), 'runtime' => isset($k['TIMELEFT']) ? (int)round((float)$k['TIMELEFT'] * 60) : null, 'model' => (string)($k['MODEL'] ?? '')];
    }
  }
  return null;
}

function und_ups_status($s) {
  $map = ['OL' => 'Online', 'OB' => 'On battery', 'LB' => 'Low battery', 'CHRG' => 'Charging', 'DISCHRG' => 'Discharging', 'BYPASS' => 'Bypass', 'OVER' => 'Overload', 'RB' => 'Replace battery'];
  $w = [];
  foreach (preg_split('/\s+/', trim($s)) as $t) if ($t !== '') $w[] = $map[$t] ?? $t;
  return implode(', ', $w);
}

/* ---------- Unraid OS update (the same unRAIDServer.plg flow Tools > Update OS uses) ---------- */

function und_os_cached() {
  $c = und_read_json(und_tmp('os.json'), []);
  $installed = und_os_version();
  $latest = (string)($c['latest'] ?? '');
  return ['installed' => $installed, 'latest' => $latest, 'checked' => (int)($c['checked'] ?? 0), 'error' => (string)($c['error'] ?? ''),
          'available' => $latest !== '' && $installed !== '' && version_compare(und_ver_norm($latest), und_ver_norm($installed), '>'),
          'staged' => und_os_staged(), 'job' => und_job(und_tmp('os-update.log'))['state']];
}

/** "7.2.0-rc.1" -> "7.2.0rc1" so version_compare orders prereleases before the release. */
function und_ver_norm($v) { return preg_replace('/[-.]?(rc|beta|alpha)[.-]?/i', '$1', (string)$v); }

/** A newer release that was installed on the flash drive and becomes active after a reboot. */
function und_os_staged() {
  $installed = und_os_version();
  foreach (['/boot/config/plugins/unRAIDServer.plg', '/var/log/plugins/unRAIDServer.plg'] as $p) {
    if (!preg_match('/<!ENTITY\s+version\s+"([^"]+)"/', und_read($p), $m)) continue;
    if ($installed !== '' && version_compare(und_ver_norm($m[1]), und_ver_norm($installed), '>')) return $m[1];
    return '';
  }
  return '';
}

function und_os_check() {
  $tmp = '/tmp/plugins/unRAIDServer.plg';
  @unlink($tmp);
  $r = und_run([und_bin('plugin'), 'check', 'unRAIDServer.plg'], 120);
  $out = ['checked' => time(), 'latest' => '', 'error' => ''];
  if ($r['code'] === 0 && is_file($tmp) && preg_match('/<!ENTITY\s+version\s+"([^"]+)"/', (string)@file_get_contents($tmp), $m) && preg_match('/^[0-9][A-Za-z0-9._+-]{0,30}$/', $m[1])) $out['latest'] = $m[1];
  elseif (preg_match('/^\s*([0-9][A-Za-z0-9._+-]{0,30})\s*$/m', $r['out'], $m)) $out['latest'] = $m[1];
  else $out['error'] = $r['timeout'] ? 'The update check timed out.' : (und_clip(trim($r['err'] . ' ' . $r['out']), 200) ?: 'The update server did not answer.');
  und_write_json(und_tmp('os.json'), $out);
  return und_os_cached();
}

/** Downloads and installs the newer release onto the flash drive. It becomes active after a reboot. */
function und_os_update() {
  $st = und_os_check();
  if (!$st['available']) return ['error' => $st['error'] ?: 'No newer Unraid release is available.'];
  if (und_job(und_tmp('os-update.log'))['state'] === 'running') return ['error' => 'An update is already running.'];
  und_spawn([und_bin('plugin'), 'update', 'unRAIDServer.plg'], und_tmp('os-update.log'));
  return ['ok' => true];
}
]]></INLINE>
<SHA256>1f08074f22ad341daa077d5a0aaf345f13f10abb712e2575c0db8809bf587326</SHA256>
</FILE>

<FILE Name="&emhttp;/include/docker.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - Docker containers. Reads go through the docker CLI; updates use Unraid's own update_container script, so the
 * container is recreated from its Unraid template exactly as the Docker tab's "apply update" does.
 */

function und_docker_bin() { return und_bin('docker'); }

function und_docker_list() {
  $ids = und_run([und_docker_bin(), 'ps', '-aq', '--no-trunc'], 20);
  if ($ids['code'] !== 0) return ['error' => trim($ids['err']) ?: 'Docker is not running.'];
  $ids = array_values(array_filter(preg_split('/\s+/', trim($ids['out']))));
  if (!$ids) return ['containers' => []];
  $r = und_run(array_merge([und_docker_bin(), 'inspect'], $ids), 30, 16777216);
  $data = json_decode($r['out'], true);
  if (!is_array($data)) return ['error' => 'docker inspect failed: ' . und_clip(trim($r['err']), 200)];
  $upd = und_read_json(und_path(UND_UPDSTATUS), []);
  $auto = array_flip(array_map(function ($l) { return trim(explode(' ', $l)[0]); }, explode("\n", und_read('/var/lib/docker/unraid-autostart'))));
  $ip = und_server_ip(); $out = [];
  foreach ($data as $c) {
    $name = ltrim((string)($c['Name'] ?? ''), '/');
    $image = (string)($c['Config']['Image'] ?? '');
    $key = und_has(basename($image), ':') || und_has($image, '@') ? $image : $image . ':latest';
    $u = $upd[$key] ?? null;
    $update = is_array($u) ? (($u['status'] ?? '') === 'false' ? 'available' : (($u['status'] ?? '') === 'true' ? 'current' : 'unknown')) : 'unknown';
    $labels = isset($c['Config']['Labels']) && is_array($c['Config']['Labels']) ? $c['Config']['Labels'] : [];
    $ports = [];
    foreach ((array)($c['HostConfig']['PortBindings'] ?? []) as $cp => $binds) foreach ((array)$binds as $b) if (!empty($b['HostPort'])) $ports[(int)$cp] = (int)$b['HostPort'];
    $net = (string)($c['HostConfig']['NetworkMode'] ?? '');
    $cip = '';
    foreach ((array)($c['NetworkSettings']['Networks'] ?? []) as $n) if (!empty($n['IPAddress'])) { $cip = $n['IPAddress']; break; }
    $webui = (string)($labels['net.unraid.docker.webui'] ?? '');
    if ($webui !== '') {
      $own = !in_array($net, ['bridge', 'host', 'default', ''], true) && strpos($net, 'container:') !== 0 && $cip !== '';
      $webui = str_replace('[IP]', $own ? $cip : $ip, $webui);
      $webui = preg_replace_callback('/\[PORT:(\d+)\]/', function ($m) use ($ports, $own) { return (string)($own ? $m[1] : ($ports[(int)$m[1]] ?? $m[1])); }, $webui);
    }
    $iconFile = '/usr/local/emhttp/state/plugins/dynamix.docker.manager/images/' . $name . '-icon.png';
    $icon = is_file(und_path($iconFile)) ? '/state/plugins/dynamix.docker.manager/images/' . rawurlencode($name) . '-icon.png' : (string)($labels['net.unraid.docker.icon'] ?? '');
    $out[] = ['id' => substr((string)$c['Id'], 0, 12), 'name' => $name, 'image' => $image, 'state' => (string)($c['State']['Status'] ?? ''),
      'health' => (string)($c['State']['Health']['Status'] ?? ''), 'started' => strtotime((string)($c['State']['StartedAt'] ?? '')) ?: null,
      'update' => $update, 'icon' => $icon, 'webui' => preg_match('#^https?://#', $webui) ? $webui : '', 'network' => $net, 'ip' => $cip,
      'ports' => $ports, 'autostart' => isset($auto[$name]), 'managed' => ($labels['net.unraid.docker.managed'] ?? '') === 'dockerman',
      'job' => und_job(und_tmp('docker-update-' . $name . '.log'))['state']];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return ['containers' => $out];
}

function und_docker_action($name, $op) {
  if (!und_valid_name($name) || strpos($name, ' ') !== false) return ['error' => 'Invalid container name.'];
  $map = ['start' => 'start', 'stop' => 'stop', 'restart' => 'restart', 'pause' => 'pause', 'unpause' => 'unpause'];
  if ($op === 'update') {
    $log = und_tmp('docker-update-' . $name . '.log');
    if (und_job($log)['state'] === 'running') return ['error' => 'An update of ' . $name . ' is already running.'];
    und_spawn([UND_DM . '/scripts/update_container', $name], $log);
    return ['ok' => true, 'job' => 'running'];
  }
  if (!isset($map[$op])) return ['error' => 'Unknown action.'];
  $r = und_run([und_docker_bin(), $map[$op], $name], 120);
  if ($r['code'] !== 0) return ['error' => und_clip(trim($r['err'] . ' ' . $r['out']), 300) ?: 'docker ' . $op . ' failed'];
  return ['ok' => true];
}

/** Starts Unraid's own update check for every container (the "check for updates" button of the Docker tab). */
function und_docker_check() {
  $log = und_tmp('docker-check.log');
  if (und_job($log)['state'] === 'running') return ['ok' => true, 'job' => 'running'];
  und_spawn([UND_DM . '/scripts/dockerupdate', 'check', 'nonotify'], $log);
  return ['ok' => true, 'job' => 'running'];
}

/** The last N lines of stdout and stderr, merged in time order. */
function und_docker_logs($name, $lines = 300) {
  if (!und_valid_name($name) || strpos($name, ' ') !== false) return ['error' => 'Invalid container name.'];
  $lines = max(10, min(5000, (int)$lines));
  $r = und_run([und_docker_bin(), 'logs', '--tail', (string)$lines, '--timestamps', $name], 20, 8388608);
  if ($r['code'] !== 0 && $r['out'] === '' && $r['err'] === '') return ['error' => 'Could not read the log.'];
  $all = array_merge(explode("\n", rtrim($r['out'])), explode("\n", rtrim($r['err'])));
  $all = array_values(array_filter($all, function ($l) { return $l !== ''; }));
  usort($all, function ($a, $b) { return strcmp(substr($a, 0, 30), substr($b, 0, 30)); });
  $all = array_slice($all, -$lines);
  $text = implode("\n", array_map(function ($l) { return preg_replace('/^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)\.\d+Z /', '$1 ', $l); }, $all));
  return ['log' => preg_replace('/\x1b\[[0-9;]*[A-Za-z]/', '', $text)];
}

/** CPU and memory per running container (docker stats takes about two seconds, so it is a separate call). */
function und_docker_stats() {
  $r = und_run([und_docker_bin(), 'stats', '--no-stream', '--format', '{{json .}}'], 25);
  $out = [];
  foreach (explode("\n", trim($r['out'])) as $l) {
    $j = json_decode($l, true);
    if (!is_array($j) || empty($j['Name'])) continue;
    $out[$j['Name']] = ['cpu' => (float)rtrim((string)($j['CPUPerc'] ?? '0'), '%'), 'mem' => (string)preg_replace('#\s*/.*$#', '', (string)($j['MemUsage'] ?? '')), 'memp' => (float)rtrim((string)($j['MemPerc'] ?? '0'), '%')];
  }
  return ['stats' => (object)$out];
}

function und_docker_summary() {
  $l = und_docker_list();
  if (isset($l['error'])) return $l;
  $s = ['running' => 0, 'stopped' => 0, 'paused' => 0, 'updates' => 0, 'total' => count($l['containers'])];
  foreach ($l['containers'] as $c) {
    if ($c['state'] === 'running') $s['running']++; elseif ($c['state'] === 'paused') $s['paused']++; else $s['stopped']++;
    if ($c['update'] === 'available') $s['updates']++;
  }
  return $s;
}
]]></INLINE>
<SHA256>c622f88349e59f3d77c57497f3bd87f64f1870d66147ddab985b288d53429574</SHA256>
</FILE>

<FILE Name="&emhttp;/include/vm.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - virtual machines through libvirt's virsh, the same backend Unraid's VMs tab uses.
 * Hibernate is "dompmsuspend <vm> disk", which needs the QEMU guest agent running inside the VM (as on the VMs tab).
 */

function und_virsh() { return und_bin('virsh'); }

function und_vm_list() {
  $r = und_run([und_virsh(), 'list', '--all', '--name'], 15);
  if ($r['code'] !== 0) return ['error' => trim($r['err']) ?: 'The VM service is not running.'];
  $out = [];
  foreach (array_filter(array_map('trim', explode("\n", $r['out']))) as $name) {
    $info = [];
    foreach (explode("\n", und_run([und_virsh(), 'dominfo', $name], 10)['out']) as $l) if (strpos($l, ':') !== false) { list($k, $v) = explode(':', $l, 2); $info[trim($k)] = trim($v); }
    $xml = und_run([und_virsh(), 'dumpxml', $name], 10)['out'];
    $icon = preg_match('/<vmtemplate[^>]*\sicon=[\'"]([^\'"]+)[\'"]/', $xml, $m) ? $m[1] : '';
    $ws = preg_match('/<graphics[^>]*type=[\'"]vnc[\'"][^>]*websocket=[\'"](\d+)[\'"]/', $xml, $m) || preg_match('/<graphics[^>]*websocket=[\'"](\d+)[\'"][^>]*type=[\'"]vnc[\'"]/', $xml, $m) ? (int)$m[1] : 0;
    $os = preg_match('/<vmtemplate[^>]*\sos=[\'"]([^\'"]+)[\'"]/', $xml, $m) ? $m[1] : '';
    $out[] = ['name' => $name, 'state' => strtolower((string)($info['State'] ?? 'unknown')), 'cpus' => (int)($info['CPU(s)'] ?? 0),
      'memory' => (float)preg_replace('/[^0-9]/', '', (string)($info['Max memory'] ?? '0')) * 1024, 'autostart' => ($info['Autostart'] ?? '') === 'enable',
      'icon' => preg_match('/^[A-Za-z0-9_.-]+\.(png|svg)$/', $icon) ? '/plugins/dynamix.vm.manager/templates/images/' . $icon : '', 'os' => $os,
      'vnc' => $ws > 0 ? '/wsproxy/' . $ws . '/' : '', 'agent' => und_has($xml, 'org.qemu.guest_agent')];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return ['vms' => $out];
}

function und_vm_action($name, $op) {
  if (!is_string($name) || $name === '' || strlen($name) > 200 || preg_match('/[\x00-\x1f\/]/', $name)) return ['error' => 'Invalid VM name.'];
  $known = und_vm_list();
  if (isset($known['error'])) return $known;
  $vm = null;
  foreach ($known['vms'] as $v) if ($v['name'] === $name) $vm = $v;
  if (!$vm) return ['error' => 'No VM named ' . $name . '.'];
  $map = ['start' => ['start'], 'stop' => ['shutdown'], 'kill' => ['destroy'], 'restart' => ['reboot'], 'pause' => ['suspend'], 'hibernate' => ['dompmsuspend', '__NAME__', 'disk']];
  if ($op === 'resume') $map['resume'] = $vm['state'] === 'pmsuspended' ? ['dompmwakeup'] : ['resume'];
  if (!isset($map[$op])) return ['error' => 'Unknown action.'];
  if ($op === 'start' && $vm['state'] === 'pmsuspended') $map['start'] = ['dompmwakeup'];
  $args = $map[$op];
  $argv = [und_virsh(), $args[0], $name];
  if (count($args) > 2) $argv = [und_virsh(), $args[0], $name, $args[2]];
  $r = und_run($argv, 90);
  if ($r['code'] !== 0) {
    $err = und_clip(trim($r['err'] . ' ' . $r['out']), 300);
    if ($op === 'hibernate' && preg_match('/agent/i', $err)) $err = 'Hibernate needs the QEMU guest agent running inside the VM. ' . $err;
    return ['error' => $err ?: 'virsh ' . $args[0] . ' failed'];
  }
  return ['ok' => true];
}

function und_vm_summary() {
  $l = und_vm_list();
  if (isset($l['error'])) return $l;
  $s = ['running' => 0, 'stopped' => 0, 'paused' => 0, 'total' => count($l['vms']), 'vms' => []];
  foreach ($l['vms'] as $v) {
    if ($v['state'] === 'running') $s['running']++; elseif (in_array($v['state'], ['paused', 'pmsuspended'], true)) $s['paused']++; else $s['stopped']++;
    $s['vms'][] = ['name' => $v['name'], 'state' => $v['state'], 'vnc' => $v['vnc']];
  }
  return $s;
}
]]></INLINE>
