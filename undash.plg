      h('button', { type: 'button', class: D.layout === 'cards' ? 'on' : '', title: 'Cards', 'aria-label': 'Card layout', 'aria-pressed': D.layout === 'cards' ? 'true' : 'false', onclick: function () { setLayout('docker', 'cards'); } }, ic('grid')));
