<FILE Name="&emhttp;/include/import.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - import from a gethomepage/homepage setup (services.yaml, settings.yaml and optionally its .env).
 * PHP on Unraid has no YAML extension, so this is a small parser for the YAML Homepage's files use:
 * block maps and lists, quoted and plain scalars, flow lists ["a", "b"], comments. Anchors and multi-line strings are not supported.
 */

function und_yaml_parse($text) {
  $lines = [];
  foreach (preg_split('/\r\n|\r|\n/', (string)$text) as $raw) {
    if (strpos($raw, "\t") !== false) $raw = str_replace("\t", '    ', $raw);
    $l = und_yaml_strip_comment($raw);
    if (trim($l) === '' || trim($l) === '---') continue;
    $lines[] = [strlen($l) - strlen(ltrim($l, ' ')), rtrim(ltrim($l, ' '))];
  }
  $i = 0;
  return $lines ? und_yaml_block($lines, $i, $lines[0][0]) : [];
}

function und_yaml_strip_comment($l) {
  $q = '';
  for ($k = 0, $n = strlen($l); $k < $n; $k++) {
    $c = $l[$k];
    if ($q !== '') { if ($c === $q) $q = ''; continue; }
    if ($c === '"' || $c === "'") { if ($k === 0 || strpos(" :[,-", $l[$k - 1]) !== false) $q = $c; continue; }
    if ($c === '#' && ($k === 0 || $l[$k - 1] === ' ')) return substr($l, 0, $k);
  }
  return $l;
}

function und_yaml_block(array &$lines, &$i, $indent) {
  if ($i >= count($lines)) return null;
  if ($lines[$i][1] === '-' || strncmp($lines[$i][1], '- ', 2) === 0) {
    $out = [];
    while ($i < count($lines) && $lines[$i][0] === $indent && ($lines[$i][1] === '-' || strncmp($lines[$i][1], '- ', 2) === 0)) {
      $rest = ltrim(substr($lines[$i][1], 1), ' ');
      if ($rest === '') { $i++; $out[] = ($i < count($lines) && $lines[$i][0] > $indent) ? und_yaml_block($lines, $i, $lines[$i][0]) : null; continue; }
      if (und_yaml_is_key($rest)) {
        // "- key: value" starts a map whose keys sit at the column after "- "
        $lines[$i] = [$indent + (strlen($lines[$i][1]) - strlen($rest)), $rest];
        $out[] = und_yaml_block($lines, $i, $lines[$i][0]);
      } else { $out[] = und_yaml_scalar($rest); $i++; }
    }
    return $out;
  }
  $out = [];
  while ($i < count($lines) && $lines[$i][0] === $indent && und_yaml_is_key($lines[$i][1])) {
    list($k, $v) = und_yaml_split($lines[$i][1]);
    $i++;
    if ($v === '') {
      if ($i < count($lines) && ($lines[$i][0] > $indent || ($lines[$i][0] === $indent && strncmp($lines[$i][1], '-', 1) === 0))) $out[$k] = und_yaml_block($lines, $i, $lines[$i][0]);
      else $out[$k] = null;
    } else $out[$k] = und_yaml_scalar($v);
  }
  // skip anything indented deeper that did not belong to a key (malformed input): never loop forever
  while ($i < count($lines) && $lines[$i][0] > $indent) $i++;
  return $out;
}

function und_yaml_is_key($s) {
  if ($s === '' || $s[0] === '[' || ($s[0] === '{' && substr($s, 0, 2) !== '{{')) return false;
  if ($s[0] === '"' || $s[0] === "'") return preg_match('/^(["\']).*?\1\s*:(\s|$)/', $s) === 1;
  return preg_match('/^[^:]+?:(\s|$)/', $s) === 1 && substr($s, 0, 2) !== '{{';
}

function und_yaml_split($s) {
  if ($s[0] === '"' || $s[0] === "'") { preg_match('/^(["\'])(.*?)\1\s*:\s*(.*)$/', $s, $m); return [$m[2], trim($m[3])]; }
  $p = strpos($s, ': '); if ($p === false) $p = strlen($s) - 1;
  return [trim(substr($s, 0, $p)), trim((string)substr($s, $p + 1))];
}

function und_yaml_scalar($v) {
  $v = trim($v);
  if ($v === '' || $v === '~' || $v === 'null') return null;
  if ($v[0] === '"') { $e = strrpos($v, '"'); return stripcslashes((string)substr($v, 1, ($e ?: strlen($v)) - 1)); }
  if ($v[0] === "'") return str_replace("''", "'", (string)substr($v, 1, (strrpos($v, "'") ?: strlen($v)) - 1));
  if ($v[0] === '[') {
    $in = trim(substr($v, 1, (strrpos($v, ']') ?: strlen($v)) - 1));
    if ($in === '') return [];
    preg_match_all('/"(?:[^"\\\\]|\\\\.)*"|\'[^\']*\'|[^,]+/', $in, $m);
    return array_map('und_yaml_scalar', array_map('trim', $m[0]));
  }
  if (in_array(strtolower($v), ['true', 'yes', 'on'], true)) return true;
  if (in_array(strtolower($v), ['false', 'no', 'off'], true)) return false;
  if (preg_match('/^-?\d+$/', $v)) return (int)$v;
  if (preg_match('/^-?\d+\.\d+$/', $v)) return (float)$v;
  return $v;
}

/* ---------- Homepage -> UnDash ---------- */

function und_env_parse($text) {
  $out = [];
  foreach (preg_split('/\r\n|\r|\n/', (string)$text) as $l) {
    if (!preg_match('/^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/', $l, $m)) continue;
    $v = trim($m[2]);
    if ($v !== '' && ($v[0] === '"' || $v[0] === "'") && substr($v, -1) === $v[0]) $v = substr($v, 1, -1);
    elseif (($p = strpos($v, ' #')) !== false) $v = rtrim(substr($v, 0, $p));
    $out[strtoupper($m[1])] = $v;
  }
  return $out;
}

/** A Homepage customapi "field" (a nested map like {response: {data: {items: {0: title}}}}) as a dot path. */
function und_hp_path($f) {
  $parts = [];
  while (is_array($f) && count($f) === 1) { $k = array_keys($f)[0]; $parts[] = $k; $f = $f[$k]; }
  if (is_scalar($f) && $f !== '') $parts[] = (string)$f;
  return implode('.', $parts);
}

function und_hp_convert($servicesYaml, $settingsYaml = '', $envText = '') {
  $warn = [];
  $svcs = und_yaml_parse($servicesYaml);
  if (!is_array($svcs) || !$svcs) return ['error' => 'services.yaml could not be read (expected a list of groups).'];
  $settings = $settingsYaml !== '' ? und_yaml_parse($settingsYaml) : [];
  $layout = is_array($settings['layout'] ?? null) ? $settings['layout'] : [];
  $env = und_env_parse($envText);
  $direct = ['radarr', 'sonarr', 'lidarr', 'readarr', 'bazarr', 'prowlarr', 'overseerr', 'autobrr', 'qbittorrent', 'sabnzbd', 'emby', 'jellyfin', 'plex', 'tautulli', 'adguard', 'pihole', 'npm', 'immich', 'peanut'];
  $alias = ['jellyseerr' => 'overseerr', 'nginxproxymanager' => 'npm'];
  $groups = []; $secrets = []; $calendars = [];
  foreach ($svcs as $gEntry) {
    if (!is_array($gEntry)) continue;
    foreach ($gEntry as $gName => $items) {
      $lay = is_array($layout[$gName] ?? null) ? $layout[$gName] : [];
      $g = ['id' => und_id(), 'name' => (string)$gName, 'columns' => (int)($lay['columns'] ?? 4) ?: 4, 'header' => !isset($lay['header']) || !empty($lay['header']), 'services' => []];
      foreach ((array)$items as $sEntry) {
        if (!is_array($sEntry)) continue;
        foreach ($sEntry as $sName => $def) {
          if (!is_array($def)) $def = [];
          if (isset($def[0])) { $warn[] = "\"$sName\" in \"$gName\" is a nested group; nested groups are not supported, skipped."; continue; }
          $w = is_array($def['widget'] ?? null) ? $def['widget'] : null;
          $s = ['id' => und_id(), 'name' => (string)$sName, 'type' => 'link', 'icon' => (string)($def['icon'] ?? ''), 'href' => (string)($def['href'] ?? ''), 'url' => '', 'fields' => [], 'options' => []];
          $sec = [];
          if ($w) {
            $t = strtolower((string)($w['type'] ?? ''));
            $t = $alias[$t] ?? $t;
            foreach (['key', 'username', 'password'] as $f) if (isset($w[$f]) && $w[$f] !== '') $sec[$f] = (string)$w[$f];
            if (isset($w['url'])) $s['url'] = (string)$w['url'];
            if (isset($w['fields']) && is_array($w['fields'])) $s['fields'] = array_values(array_map('strval', $w['fields']));
            if (in_array($t, $direct, true)) {
              $s['type'] = $t;
              if (in_array($t, ['emby', 'jellyfin'], true) && isset($w['enableBlocks']) && !$w['enableBlocks']) $s['options']['hide_blocks'] = true;
            } elseif ($t === 'glances') {
              $m = (string)($w['metric'] ?? 'info');
              // the dashboard's own system overview shows these now
              $warn[] = "\"$sName\" (Glances $m) is covered by UnDash's built-in system overview and was not imported as a widget.";
              continue;
            } elseif ($t === 'calendar') {
              $s['type'] = 'calendar';
              $s['options'] = ['max_events' => (int)($w['maxEvents'] ?? 8), 'previous_days' => (int)($w['previousDays'] ?? 0), 'days_ahead' => 30, 'integrations' => []];
              $calendars[] = [count($groups), count($g['services']), (array)($w['integrations'] ?? [])];
            } elseif ($t === 'customapi') {
              $s['type'] = 'customapi';
              $maps = [];
              foreach ((array)($w['mappings'] ?? []) as $m) {
                if (!is_array($m)) continue;
                $x = ['field' => und_hp_path($m['field'] ?? ''), 'label' => (string)($m['label'] ?? ''), 'format' => (string)($m['format'] ?? 'text')];
                if (isset($m['scale'])) $x['scale'] = $m['scale'];
                if (is_array($m['additionalField'] ?? null)) $x['additional'] = ['field' => und_hp_path($m['additionalField']['field'] ?? ''), 'format' => (string)($m['additionalField']['format'] ?? 'text'), 'scale' => $m['additionalField']['scale'] ?? 1];
                $maps[] = $x;
              }
              $s['options'] = ['display' => ($w['display'] ?? '') === 'list' ? 'list' : 'block', 'method' => (string)($w['method'] ?? 'GET'), 'headers' => is_array($w['headers'] ?? null) ? $w['headers'] : new stdClass(), 'mappings' => $maps];
            } else {
              $warn[] = "\"$sName\": widget type \"$t\" is not supported yet, imported as a link.";
              $s['url'] = '';
            }
          }
          if ($sec) $secrets[$s['id']] = $sec;
          $g['services'][] = $s;
        }
      }
      $groups[] = $g;
    }
  }
  foreach ($calendars as $c) {
    list($gi, $si, $ints) = $c;
    foreach ($ints as $in) {
      if (!is_array($in)) continue;
      foreach ($groups as $gg) foreach ($gg['services'] as $ss) {
        if (strcasecmp($ss['name'], (string)($in['service_name'] ?? '')) === 0 && (empty($in['service_group']) || strcasecmp($gg['name'], (string)$in['service_group']) === 0)) {
          $groups[$gi]['services'][$si]['options']['integrations'][] = ['service' => $ss['id'], 'unmonitored' => !empty($in['params']['unmonitored'])];
        }
      }
    }
    if (!$groups[$gi]['services'][$si]['options']['integrations']) $warn[] = '"' . $groups[$gi]['services'][$si]['name'] . '": its Radarr/Sonarr service was not found.';
  }
  // every {{VAR}} the import refers to, with a value from the .env when one was given
  $all = json_encode([$groups, $secrets]);
  preg_match_all('/\{\{\s*([A-Za-z0-9_]+)\s*\}\}/', $all, $m);
  $vars = [];
  foreach (array_unique(array_map('strtoupper', $m[1])) as $n) $vars[$n] = $env[$n] ?? null;
  foreach ($vars as $n => $v) if ($v === null && preg_match('/SERVER_IP$/', $n)) $vars[$n] = und_server_ip();
  $count = 0; foreach ($groups as $gg) $count += count($gg['services']);
  // only the widgets are replaced: appearance, dashboard sections and container/VM preferences stay as they are
  $cfg = und_load_config();
  if (!empty($settings['title'])) $cfg['general']['title'] = (string)$settings['title'];
  $cfg['groups'] = $groups;
  return ['config' => $cfg, 'secrets' => $secrets, 'vars' => $vars, 'warnings' => $warn, 'groups' => count($groups), 'services' => $count];
}

/** Save an import: replaces the layout; keeps stored variable values unless the .env gave a new one. */
function und_hp_apply(array $conv) {
  $old = und_secrets();
  $vars = $old['vars'];
  foreach ($conv['vars'] as $n => $v) if ($v !== null || !isset($vars[$n])) $vars[$n] = $v === null ? (string)($vars[$n] ?? '') : (string)$v;
  und_save_config($conv['config']);
  $saved = und_load_config();
  $ids = [];
  foreach ($saved['groups'] as $g) foreach ($g['services'] as $s) $ids[] = $s['id'];
  $svc = [];
  foreach ($conv['secrets'] as $id => $c) if (in_array($id, $ids, true)) $svc[$id] = $c;
  und_save_secrets(['vars' => $vars, 'svc' => $svc]);
  return ['ok' => true];
}
]]></INLINE>
<SHA256>8d28fc16533a48c31c552dba9a22fa3e6d88160a9999f7aeb8e3166f43d7822d</SHA256>
</FILE>

<FILE Name="&emhttp;/include/transfer.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - settings export and import.
 *
 * Export file: {"undash_export": 1, "schema": 2, "kind": "full"|"redacted", "created": unix time, "config": {...}, "css": "...", "vars": {...}, "secrets": {...}}
 *   full      layout, preferences, appearance, custom CSS, every variable and every widget credential (a complete backup; keep it private)
 *   redacted  the same without anything secret: credentials are dropped, secret-looking variables are emptied, and passwords or
 *             tokens written straight into URLs (user:pass@host, ?apikey=...) are replaced by {{REDACTED}}
 * Neither contains anything but UnDash's own settings.
 */

function und_export($kind) {
  $cfg = und_load_config(); $sec = und_secrets();
  $out = ['undash_export' => 1, 'schema' => UND_SCHEMA, 'kind' => $kind === 'full' ? 'full' : 'redacted', 'created' => time(), 'version' => UND_VERSION,
          'config' => $cfg, 'css' => und_load_css()];
  if ($out['kind'] === 'full') { $out['vars'] = (object)$sec['vars']; $out['secrets'] = (object)$sec['svc']; $out['unraid'] = (object)$sec['unraid']; return $out; }
  if (!empty($sec['unraid']['url'])) $out['unraid'] = ['url' => und_redact_url((string)$sec['unraid']['url'])];
  $vars = [];
  foreach ($sec['vars'] as $k => $v) $vars[$k] = und_var_is_secret($k) ? '' : und_redact_url((string)$v);
  $out['vars'] = (object)$vars;
  foreach ($out['config']['groups'] as &$g) foreach ($g['services'] as &$s) {
    $s['url'] = und_redact_url($s['url']); $s['href'] = und_redact_url($s['href']);
    // custom API headers may hold a key written in clear text
    if (is_array($s['options']) && isset($s['options']['headers']) && is_array($s['options']['headers'])) foreach ($s['options']['headers'] as $hk => $hv) {
      if (!preg_match('/^\{\{\s*[A-Za-z0-9_]+\s*\}\}$/', (string)$hv)) $s['options']['headers'][$hk] = '{{REDACTED}}';
    }
  }
  unset($g, $s);
  return $out;
}

/** Secrets written into a URL: user:password@host and token-like query parameters. Variables ({{NAME}}) are kept. */
function und_redact_url($u) {
  $u = preg_replace('#^([a-z][a-z0-9+.-]*://)[^/@\s]+@#i', '$1', (string)$u);
  return preg_replace_callback('/([?&])([^=&#]+)=([^&#]*)/', function ($m) {
    if (!preg_match('/key|token|pass|secret|auth|sig|session/i', $m[2]) || preg_match('/^\{\{\s*[A-Za-z0-9_]+\s*\}\}$/', urldecode($m[3]))) return $m[0];
    return $m[1] . $m[2] . '={{REDACTED}}';
  }, $u);
}

/**
 * Check an uploaded export before anything is changed. Returns a summary for the preview, or an error.
 * Only UnDash export files (and older UnDash layout files, which are plain config objects) are accepted.
 */
function und_import_parse($raw) {
  if (!is_string($raw) || $raw === '') return ['error' => 'The file is empty.'];
  if (strlen($raw) > 2097152) return ['error' => 'The file is larger than 2 MB; that is not an UnDash export.'];
  $j = json_decode($raw, true, 64);
  if (!is_array($j)) return ['error' => 'The file is not valid JSON.'];
  if (isset($j['undash_export'])) {
    if ((int)$j['undash_export'] !== 1) return ['error' => 'This export comes from a newer UnDash; update the plugin first.'];
    if ((int)($j['schema'] ?? 0) > UND_SCHEMA) return ['error' => 'This export uses settings schema ' . (int)$j['schema'] . '; this UnDash understands up to ' . UND_SCHEMA . '. Update the plugin first.'];
    if (!isset($j['config']) || !is_array($j['config']) || !isset($j['config']['groups']) || !is_array($j['config']['groups'])) return ['error' => 'The export has no layout in it.'];
    $file = ['kind' => ($j['kind'] ?? '') === 'full' ? 'full' : 'redacted', 'config' => $j['config'], 'css' => is_string($j['css'] ?? null) ? $j['css'] : null,
             'vars' => isset($j['vars']) && is_array($j['vars']) ? $j['vars'] : [], 'secrets' => isset($j['secrets']) && is_array($j['secrets']) ? $j['secrets'] : [], 'created' => (int)($j['created'] ?? 0)];
  } elseif (isset($j['groups']) && is_array($j['groups'])) {
    $file = ['kind' => 'layout', 'config' => $j, 'css' => null, 'vars' => [], 'secrets' => [], 'created' => 0];
  } else return ['error' => 'This is not an UnDash settings file.'];
  foreach ($file['vars'] as $k => $v) if (!is_string($k) || !preg_match('/^[A-Za-z][A-Za-z0-9_]{0,63}$/', $k) || !is_scalar($v)) return ['error' => 'The variables in the file are malformed.'];
  foreach ($file['secrets'] as $id => $c) if (!preg_match('/^[a-f0-9]{8}$/', (string)$id) || !is_array($c)) return ['error' => 'The credentials in the file are malformed.'];
  $rawGroups = $file['config']['groups'];
  $cfg = und_normalize(und_migrate($file['config']));
  $file['config'] = $cfg;
  $n = 0; foreach ($cfg['groups'] as $g) $n += count($g['services']);
  $dropped = 0; foreach ($rawGroups as $g) $dropped += is_array($g) ? count((array)($g['services'] ?? [])) : 0;
  $file['summary'] = ['kind' => $file['kind'], 'created' => $file['created'], 'groups' => count($cfg['groups']), 'widgets' => $n, 'skipped' => max(0, $dropped - $n),
    'theme' => $cfg['appearance']['theme'], 'accent' => $cfg['appearance']['accent'], 'refresh' => $cfg['general']['refresh'], 'css' => $file['css'] !== null ? strlen($file['css']) : null,
    'vars' => count($file['vars']), 'credentials' => count($file['secrets'])];
  return $file;
}

/**
 * Apply a checked import. A backup of the current settings is taken first, so it can be undone from the backup list.
 * Credentials: a full export replaces them; a redacted or layout-only file keeps the stored ones for widgets with the same id
 * and keeps stored values of variables the file leaves empty.
 */
function und_import_apply($raw) {
  $f = und_import_parse($raw);
  if (isset($f['error'])) return $f;
  $j_unraid = json_decode($raw, true)['unraid'] ?? null;
  $bk = und_backup('before import');
  $old = und_secrets();
  $ids = und_service_ids($f['config']);
  $vars = $old['vars'];
  foreach ($f['vars'] as $k => $v) { $k = strtoupper($k); if ((string)$v !== '' || !isset($vars[$k])) $vars[$k] = und_clip((string)$v, 2000); }
  $svc = [];
  foreach ($ids as $id) {
    $c = $f['kind'] === 'full' && isset($f['secrets'][$id]) ? $f['secrets'][$id] : ($old['svc'][$id] ?? []);
    foreach (['key', 'password', 'username'] as $k) if (isset($c[$k]) && is_scalar($c[$k]) && (string)$c[$k] !== '') $svc[$id][$k] = und_clip((string)$c[$k], 2000);
  }
  if (!und_save_config($f['config'], false)) return ['error' => 'Could not write the configuration directory.'];
  $unraid = $old['unraid'];
  if (isset($j_unraid) && is_array($j_unraid)) {
    if (!empty($j_unraid['url']) && is_string($j_unraid['url']) && preg_match('#^https?://#i', $j_unraid['url'])) $unraid['url'] = und_clip($j_unraid['url'], 300);
    if ($f['kind'] === 'full' && !empty($j_unraid['key']) && is_string($j_unraid['key'])) $unraid['key'] = und_clip($j_unraid['key'], 300);
  }
  und_save_secrets(['vars' => $vars, 'svc' => $svc, 'unraid' => $unraid]);
  if ($f['css'] !== null) und_save_css($f['css'], false);
  return ['ok' => true, 'backup' => $bk];
}
]]></INLINE>
<SHA256>92cba8a91108d7a7212551de9fc9437d680fd1177cf29b697c13b095cd4ca506</SHA256>
</FILE>

<FILE Name="&emhttp;/include/ops.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - operations: one-at-a-time locks per target, the recent-operation history, and server power.
 * Every management action is a fixed operation on a validated target; nothing here takes a command from the browser.
 */

/** Exclusive, non-blocking lock for one target ("docker:plex", "vm:Windows 10", "power"). Returns a handle, or false when busy. */
function und_lock($target) {
  @mkdir(und_tmp('locks'), 0755, true);
  $fp = @fopen(und_tmp('locks/' . hash('sha256', $target) . '.lock'), 'c');
  if (!$fp) return false;
  if (flock($fp, LOCK_EX | LOCK_NB)) return $fp;
  fclose($fp);
  return false;
}
function und_unlock($fp) { if (is_resource($fp)) { @flock($fp, LOCK_UN); @fclose($fp); } }

/** Append to the recent-operation history (newest 100, kept in RAM until reboot). Messages are redacted. */
function und_history_add($kind, $target, $op, $ok, $msg = '') {
  $f = und_tmp('history.json');
  $fp = @fopen($f . '.lock', 'c');
  if ($fp) flock($fp, LOCK_EX);
  $h = und_read_json($f, []);
  $h[] = ['at' => time(), 'kind' => $kind, 'target' => und_clip($target, 120), 'op' => $op, 'ok' => (bool)$ok, 'msg' => und_clip(und_redact($msg), 300)];
  und_write_json($f, array_slice($h, -100));
  if ($fp) { flock($fp, LOCK_UN); fclose($fp); }
}
function und_history() { return array_reverse(und_read_json(und_tmp('history.json'), [])); }

/* ---------- server power ---------- */

/**
 * Restart or shut down the server with the same commands Unraid's own Reboot / Shutdown buttons run
 * (webGui/include/Boot.php: /sbin/reboot -n and /sbin/poweroff -n; these stop the array cleanly first).
 *
 * Two steps so a single stray request can never power the server off:
 *   power_prepare -> a one-time nonce bound to the operation, valid 120 s, plus anything that makes it a bad moment
 *   power         -> needs that nonce and the server's name typed back; the command starts 3 s later so the answer reaches the browser
 */
function und_power_prepare($op) {
  if (und_api_mode()) return ['error' => 'The Unraid API has no restart or shutdown. Use Unraid\'s own Reboot / Shutdown buttons (or the UnDash plugin).'];
  if (!in_array($op, ['reboot', 'shutdown'], true)) return ['error' => 'Unknown power action.'];
  $nonce = bin2hex(random_bytes(16));
  und_write_json(und_tmp('power-nonce.json'), ['op' => $op, 'hash' => hash('sha256', $nonce), 'exp' => time() + 120], true);
  $v = und_var_ini(); $warn = [];
  if ((int)($v['mdResync'] ?? 0) > 0) $warn[] = 'A parity check, sync or rebuild is running; it will be interrupted.';
  if (is_file('/var/run/mover.pid')) $warn[] = 'The mover is running.';
  $vm = und_vm_states(); $running = [];
  foreach ($vm as $n => $s) if ($s === 'running') $running[] = $n;
  if ($running) $warn[] = 'Running VMs (' . implode(', ', $running) . ') will be shut down.';
  return ['nonce' => $nonce, 'op' => $op, 'name' => (string)($v['NAME'] ?? gethostname()), 'warnings' => $warn];
}

function und_power($op, $nonce, $typed) {
  if (und_api_mode()) return ['error' => 'Not available in the Docker version.'];
  $n = und_read_json(und_tmp('power-nonce.json'), []);
  @unlink(und_tmp('power-nonce.json'));                       // single use, whatever happens next
  if (!in_array($op, ['reboot', 'shutdown'], true) || ($n['op'] ?? '') !== $op) return ['error' => 'Unknown power action.'];
  if (empty($n['hash']) || !hash_equals((string)$n['hash'], hash('sha256', (string)$nonce)) || time() > (int)($n['exp'] ?? 0)) return ['error' => 'The confirmation expired. Start again.'];
  $name = (string)(und_var_ini()['NAME'] ?? gethostname());
  if (strcasecmp(trim((string)$typed), $name) !== 0) return ['error' => 'The server name you typed does not match.'];
  $lock = und_lock('power');
  if (!$lock) return ['error' => 'A power action is already in progress.'];
  if (is_file(und_tmp('power-started'))) return ['error' => 'The server is already ' . ($op === 'reboot' ? 'restarting' : 'shutting down') . '.'];
  @file_put_contents(und_tmp('power-started'), $op);
  und_history_add('server', $name, $op, true, 'requested from UnDash');
  if (function_exists('und_log_syslog')) und_log_syslog("server $op requested from UnDash");
  $cmd = $op === 'reboot' ? '/sbin/reboot' : '/sbin/poweroff';
  und_spawn(['/bin/bash', '-c', 'sleep 3; exec ' . $cmd . ' -n'], und_tmp('power.log'));
  return ['ok' => true, 'op' => $op];
}

/** A line in the system log (Tools > System Log), so power actions are visible outside UnDash too. */
function und_log_syslog($msg) {
  if (isset($GLOBALS['UND_EXEC_MOCK'])) return;
  und_run([und_bin('logger'), '-t', 'undash', '--', $msg], 5);
}

/* ---------- is there a newer UnDash? ---------- */

/**
 * The newest release tag (vX.Y.Z) of the UnDash repository, checked at most every 6 hours (a failed check is retried
 * after an hour). Nothing is sent but the request itself.
 */
function und_self_update() {
  $f = und_tmp('self-update.json');
  $c = und_read_json($f, null);
  $fresh = is_array($c) && time() - (int)($c['at'] ?? 0) < (!empty($c['error']) ? 3600 : 21600);
  if (!$fresh) {
    $c = ['at' => time(), 'latest' => '', 'error' => ''];
    $r = und_http('GET', 'https://api.github.com/repos/Stiphr/UnDash/tags?per_page=30', ['timeout' => 6, 'headers' => ['Accept' => 'application/vnd.github+json']]);
    if ($r['code'] !== 200 || !is_array($r['json'])) $c['error'] = $r['err'] ?: 'GitHub answered HTTP ' . $r['code'];
    else foreach ($r['json'] as $t) {
      $v = preg_match('/^v?(\d+\.\d+\.\d+)$/', (string)($t['name'] ?? ''), $m) ? $m[1] : '';
      if ($v !== '' && ($c['latest'] === '' || version_compare($v, $c['latest'], '>'))) $c['latest'] = $v;
    }
    und_write_json($f, $c);
  }
  $cur = UND_VERSION;
  $semver = preg_match('/^\d+\.\d+\.\d+$/', $cur) === 1;
  return ['current' => $cur, 'latest' => $c['latest'], 'newer' => $semver && $c['latest'] !== '' && version_compare($c['latest'], $cur, '>'),
          'checked' => (int)$c['at'], 'error' => $c['error'], 'url' => 'https://github.com/Stiphr/UnDash/releases'];
}
]]></INLINE>
<SHA256>d5313587bc9ece05b79f0b5275a6cb211ccda8af3e5adb4f6b857b5e4bef6f39</SHA256>
</FILE>

<FILE Name="&emhttp;/include/auth.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - sign-in for the standalone port (default 9099).
 *
 * The standalone port is served outside Unraid's nginx, so it checks the login itself. A browser is let in when
 *   a) it carries a valid Unraid login session (cookie "unraid_<md5 of the host name>", the same one Unraid's own
 *      auth-request.php checks; cookies are shared across ports of the same host), or
 *   b) it was handed over from Unraid's web UI: /plugins/undash/handoff.php (behind Unraid's login) creates a one-time
 *      token valid for 60 s, and the standalone port swaps it for its own session cookie.
 * Either way UnDash then keeps its own session (HttpOnly, SameSite=Strict, 12 h, renewed while used) with its own CSRF token.
 */

if (!defined('UND_SESS_TTL')) define('UND_SESS_TTL', 12 * 3600);

function und_sess_dir() { $d = und_tmp('sess'); @mkdir($d, 0700, true); return $d; }

function und_sess_file($sid) { return und_sess_dir() . '/' . hash('sha256', (string)$sid) . '.json'; }

/** The UnDash session of this request, or null. */
function und_sess_get() {
  $sid = (string)($_COOKIE['undash_sid'] ?? '');
  if (!preg_match('/^[a-f0-9]{64}$/', $sid)) return null;
  $s = und_read_json(und_sess_file($sid), null);
  if (!is_array($s) || (int)($s['exp'] ?? 0) < time()) { @unlink(und_sess_file($sid)); return null; }
  if ((int)$s['exp'] - time() < UND_SESS_TTL - 600) { $s['exp'] = time() + UND_SESS_TTL; und_write_json(und_sess_file($sid), $s, true); }
  return $s;
}

/** After a password change: every other browser has to sign in again (sessions opened without a password included). */
function und_sess_drop_others() {
  $keep = und_sess_file((string)($_COOKIE['undash_sid'] ?? ''));
  foreach (glob(und_sess_dir() . '/*.json') ?: [] as $f) if ($f !== $keep) @unlink($f);
}

function und_sess_new($how) {
  $sid = bin2hex(random_bytes(32));
  $s = ['exp' => time() + UND_SESS_TTL, 'csrf' => bin2hex(random_bytes(24)), 'how' => $how, 'at' => time()];
  und_write_json(und_sess_file($sid), $s, true);
  setcookie('undash_sid', $sid, ['expires' => 0, 'path' => '/', 'httponly' => true, 'samesite' => 'Strict', 'secure' => !empty($_SERVER['HTTPS'])]);
  // old sessions are removed now and then
  if (random_int(1, 20) === 1) foreach (glob(und_sess_dir() . '/*.json') ?: [] as $f) if (filemtime($f) < time() - UND_SESS_TTL - 3600) @unlink($f);
  return $s;
}

function und_sess_end() {
  $sid = (string)($_COOKIE['undash_sid'] ?? '');
  if (preg_match('/^[a-f0-9]{64}$/', $sid)) @unlink(und_sess_file($sid));
  setcookie('undash_sid', '', ['expires' => 1, 'path' => '/', 'httponly' => true, 'samesite' => 'Strict']);
}

/** The host name of this request without the port, or '' when it does not look like one. */
function und_req_host() {
  $h = strtolower((string)($_SERVER['HTTP_HOST'] ?? ''));
  $h = preg_replace('/:\d+$/', '', $h);
  if (preg_match('/^\[[0-9a-f:]+\]$/', $h)) return $h;
  return preg_match('/^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$/', $h) ? $h : '';
}

/** Is this browser logged in to Unraid? Reads Unraid's PHP session file (read-only, so Unraid's session is never touched). */
function und_unraid_logged_in() {
  if (und_api_mode()) return false;            // a container cannot see Unraid's sessions
  $host = und_req_host();
  if ($host === '') return false;
  $sid = (string)($_COOKIE['unraid_' . md5($host)] ?? '');
  if (!preg_match('/^[A-Za-z0-9,-]{16,128}$/', $sid)) return false;
  $path = isset($GLOBALS['UND_PHPSESS_DIR']) ? $GLOBALS['UND_PHPSESS_DIR'] : (ini_get('session.save_path') ?: '/var/lib/php');
  $f = rtrim(preg_replace('/^\d+;/', '', $path), '/') . '/sess_' . $sid;
  $data = @file_get_contents($f);
  if (!is_string($data) || !preg_match('/(^|;|\})unraid_login\|i:(\d+);/', $data, $m)) return false;
  // Unraid's session lifetime (php.ini session.gc_maxlifetime) bounds how old a login may be
  $max = (int)(ini_get('session.gc_maxlifetime') ?: 172800);
  return (int)@filemtime($f) > time() - $max;
}

/* ---------- handoff from Unraid's web UI ---------- */

function und_handoff_create() {
  $t = bin2hex(random_bytes(24));
  $d = und_tmp('handoff'); @mkdir($d, 0700, true);
  foreach (glob("$d/*") ?: [] as $f) if (filemtime($f) < time() - 120) @unlink($f);
  @file_put_contents("$d/" . hash('sha256', $t), (string)(time() + 60));
  return $t;
}

function und_handoff_use($t) {
  if (und_api_mode()) return false;
  if (!preg_match('/^[a-f0-9]{48}$/', (string)$t)) return false;
  $f = und_tmp('handoff') . '/' . hash('sha256', $t);
  $exp = (int)@file_get_contents($f);
  @unlink($f);                                   // single use
  return $exp >= time();
}

/* ---------- password sign-in (Docker version: there is no Unraid session to reuse) ---------- */

function und_auth_file() { return UND_DIR . '/auth.json'; }
function und_setup_file() { return UND_DIR . '/setup-code.txt'; }

/** none = not set up yet (first start), env = UNDASH_PASSWORD, file = password set in the dashboard,
 *  open = the owner chose to go without a password for now (anyone who reaches the port is signed in). */
function und_auth_kind() {
  if ((string)getenv('UNDASH_PASSWORD') !== '') return 'env';
  $a = und_read_json(und_auth_file(), []);
  return !empty($a['hash']) ? 'file' : (!empty($a['open']) ? 'open' : 'none');
}

/** Skip the password (setup page) or remove it later (Settings). A password can be added again at any time. */
function und_auth_open() {
  if (und_auth_kind() === 'env') return ['error' => 'The password comes from UNDASH_PASSWORD in the container settings; remove it there.'];
  if (!und_write_json(und_auth_file(), ['open' => true, 'set' => time()], true)) return ['error' => 'Could not write ' . und_auth_file() . '. Check the /config volume.'];
  @unlink(und_setup_file());
  return ['ok' => true];
}

function und_password_ok($pw) {
  $pw = (string)$pw;
  if (und_auth_kind() === 'env') return hash_equals((string)getenv('UNDASH_PASSWORD'), $pw);
  $a = und_read_json(und_auth_file(), []);
  return !empty($a['hash']) && password_verify($pw, (string)$a['hash']);
}

function und_password_set($pw) {
  if (strlen((string)$pw) < 10) return ['error' => 'Use at least 10 characters.'];
  if (!und_write_json(und_auth_file(), ['hash' => password_hash((string)$pw, PASSWORD_DEFAULT), 'set' => time()], true)) return ['error' => 'Could not write ' . und_auth_file() . '. Check the /config volume.'];
  @unlink(und_setup_file());
  return ['ok' => true];
}

/** The one-time code that proves the person creating the password can read the container log. Created at container start. */
function und_setup_code_ensure() {
  if (und_auth_kind() !== 'none') { @unlink(und_setup_file()); return null; }
  $c = trim((string)@file_get_contents(und_setup_file()));
  if (!preg_match('/^[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$/', $c)) {
    $abc = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; $c = '';
    for ($i = 0; $i < 12; $i++) $c .= ($i && $i % 4 === 0 ? '-' : '') . $abc[random_int(0, strlen($abc) - 1)];
    @file_put_contents(und_setup_file(), $c); @chmod(und_setup_file(), 0600);
  }
  return $c;
}

/** At most 5 wrong passwords per address in 15 minutes. */
function und_login_throttled($ip) {
  $f = und_tmp('login-' . hash('sha256', (string)$ip) . '.json');
  $a = array_values(array_filter(und_read_json($f, []), function ($t) { return $t > time() - 900; }));
  return count($a) >= 5;
}
function und_login_failed($ip) {
  $f = und_tmp('login-' . hash('sha256', (string)$ip) . '.json');
  $a = array_values(array_filter(und_read_json($f, []), function ($t) { return $t > time() - 900; }));
  $a[] = time(); und_write_json($f, $a, true);
}
]]></INLINE>
