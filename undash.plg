<FILE Name="&emhttp;/include/lib.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - core helpers.
 * Written for PHP 7.4+ : no match, str_contains, nullsafe or named arguments.
 *
 * Test seams (in-process only, never read from the environment or the web):
 *   $GLOBALS['UND_EXEC_MOCK'](array $argv) -> result array or null to run for real
 *   $GLOBALS['UND_FS'] (string)            -> prefix for /proc, /sys, /etc and /var paths (dev harness)
 *   $GLOBALS['UND_SPAWN_MOCK'](array $argv, $log)
 */

if (!defined('UND_LIB_LOADED')) {
define('UND_LIB_LOADED', 1);

define('UND_VERSION', '2026.10.30b');
define('UND_NAME',    'UnDash');
/*
 * Two ways to run the same code:
 *   plugin  (default) inside Unraid: reads /proc and Unraid's state files, runs docker / virsh / plugin directly.
 *   api     the Docker image (UNDASH_MODE=api): everything about the server comes from the official Unraid GraphQL API
 *           (include/unraid_api.php); nothing on the host is touched directly. Settings live in UNDASH_CONFIG (/config).
 */
if (!defined('UND_MODE')) define('UND_MODE', getenv('UNDASH_MODE') === 'api' ? 'api' : 'plugin');
if (!defined('UND_ROOT')) define('UND_ROOT',    UND_MODE === 'api' ? dirname(__DIR__) : '/usr/local/emhttp/plugins/undash');
if (!defined('UND_DIR')) define('UND_DIR',     UND_MODE === 'api' ? rtrim(getenv('UNDASH_CONFIG') ?: '/config', '/') : '/boot/config/plugins/undash');
if (!defined('UND_TMP')) define('UND_TMP',     '/tmp/undash');
define('UND_DM',      '/usr/local/emhttp/plugins/dynamix.docker.manager');
define('UND_UPDSTATUS', '/var/lib/docker/unraid-update-status.json');
define('UND_KEEP',    '__KEEP__');     // stands in for a stored secret in everything sent to the browser

/** System paths go through here so the dev harness can point them at fixtures. */
function und_path($p) { return isset($GLOBALS['UND_FS']) ? $GLOBALS['UND_FS'] . $p : $p; }
function und_read($p) { $s = @file_get_contents(und_path($p)); return $s === false ? '' : $s; }

function und_has($s, $p)    { return $p === '' || strpos((string)$s, $p) !== false; }
function und_starts($s, $p) { return strncmp((string)$s, $p, strlen($p)) === 0; }

/* ---------- JSON files ---------- */

function und_read_json($file, $default) {
  if (!is_file($file)) return $default;
  $d = json_decode((string)@file_get_contents($file), true);
  return is_array($d) ? $d : $default;
}

/** Atomic write; skipped when nothing changed (the flash drive has limited write cycles). */
function und_write_json($file, $data, $private = false) {
  $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR);
  if ($json === false) return false;
  if (is_file($file) && @file_get_contents($file) === $json) return true;
  @mkdir(dirname($file), 0755, true);
  $tmp = $file . '.tmp' . getmypid();
  if (@file_put_contents($tmp, $json) === false) return false;
  if ($private) @chmod($tmp, 0600);
  if (!@rename($tmp, $file)) { @unlink($tmp); return false; }
  return true;
}

function und_tmp($name) { @mkdir(UND_TMP, 0755, true); return UND_TMP . '/' . $name; }

/* ---------- running commands (no shell, argument arrays only) ---------- */

/** Returns ['code'=>int,'out'=>string,'err'=>string,'timeout'=>bool]. Output is capped, the command is killed on timeout. */
function und_run(array $argv, $timeout = 30, $maxBytes = 2097152) {
  if (isset($GLOBALS['UND_EXEC_MOCK']) && is_callable($GLOBALS['UND_EXEC_MOCK'])) {
    $r = call_user_func($GLOBALS['UND_EXEC_MOCK'], $argv);
    if (is_array($r)) return $r + ['code' => 0, 'out' => '', 'err' => '', 'timeout' => false];
  }
  $res = ['code' => -1, 'out' => '', 'err' => '', 'timeout' => false];
  $p = @proc_open($argv, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
  if (!is_resource($p)) { $res['err'] = 'could not start ' . basename((string)$argv[0]); return $res; }
  @fclose($pipes[0]);
  stream_set_blocking($pipes[1], false);
  stream_set_blocking($pipes[2], false);
  $deadline = microtime(true) + max(1, $timeout);
  $open = [1 => $pipes[1], 2 => $pipes[2]];
  while ($open) {
    $left = $deadline - microtime(true);
    if ($left <= 0) { $res['timeout'] = true; break; }
    $r = array_values($open); $w = null; $e = null;
    if (@stream_select($r, $w, $e, 0, (int)min(200000, $left * 1000000)) === false) break;
    foreach ($open as $k => $h) {
      $chunk = @fread($h, 65536);
      if ($chunk !== false && $chunk !== '') { $key = $k === 1 ? 'out' : 'err'; if (strlen($res[$key]) < $maxBytes) $res[$key] .= $chunk; }
      if (feof($h)) { @fclose($h); unset($open[$k]); }
    }
  }
  if ($res['timeout']) { @proc_terminate($p, 9); }
  foreach ($open as $h) @fclose($h);
  $code = @proc_close($p);
  $res['code'] = $res['timeout'] ? 124 : $code;
  return $res;
}

function und_bin($name) {
  foreach (['/usr/bin', '/usr/local/bin', '/bin', '/usr/sbin', '/sbin', '/usr/local/sbin'] as $d) {
    if (is_file("$d/$name") && is_executable("$d/$name")) return "$d/$name";
  }
  return $name;
}

/**
 * Start a long command in the background; its output goes to $log. A "<log>.done" file holding the exit code
 * is written when it finishes, so the UI can tell running from finished.
 */
function und_spawn(array $argv, $log) {
  if (isset($GLOBALS['UND_SPAWN_MOCK'])) { call_user_func($GLOBALS['UND_SPAWN_MOCK'], $argv, $log); return true; }
  @unlink($log . '.done');
  @file_put_contents($log, '');
  $cmd = '';
  foreach ($argv as $a) $cmd .= ($cmd === '' ? '' : ' ') . escapeshellarg($a);
  $sh = $cmd . ' >> ' . escapeshellarg($log) . ' 2>&1; echo $? > ' . escapeshellarg($log . '.done');
  exec('nohup setsid /bin/bash -c ' . escapeshellarg($sh) . ' > /dev/null 2>&1 &');
  return true;
}

/** State of a background job started with und_spawn: idle | running | done (with exit code and output tail). */
function und_job($log, $tail = 16000) {
  clearstatcache();
  if (!is_file($log)) return ['state' => 'idle', 'code' => null, 'out' => ''];
  $out = (string)@file_get_contents($log);
  if (strlen($out) > $tail) $out = substr($out, -$tail);
  $out = preg_replace('/\x1b\[[0-9;]*[A-Za-z]/', '', $out);
  $done = is_file($log . '.done');
  return ['state' => $done ? 'done' : 'running', 'code' => $done ? (int)trim((string)@file_get_contents($log . '.done')) : null, 'out' => und_redact($out), 'at' => (int)@filemtime($log)];
}

/* ---------- text ---------- */

/** Remove anything that looks like a secret from text that is shown. */
function und_redact($s, array $extra = []) {
  $s = (string)$s;
  foreach ($extra as $x) if (is_string($x) && strlen($x) >= 6) $s = str_replace($x, '[redacted]', $s);
  $s = preg_replace('#(https?://)[^/\s:@]+:[^/\s@]+@#i', '$1[redacted]@', $s);
  $s = preg_replace('/([?&](?:apikey|api_key|X-Plex-Token|token|key)=)[^&\s"]+/i', '$1[redacted]', $s);
  return $s;
}

function und_clip($s, $max) {
  $s = (string)$s;
  if (function_exists('mb_strlen')) return mb_strlen($s, 'UTF-8') > $max ? mb_substr($s, 0, $max - 1, 'UTF-8') . '…' : $s;
  return strlen($s) > $max ? substr($s, 0, $max - 3) . '...' : $s;
}

function und_valid_name($n) { return is_string($n) && preg_match('/^[A-Za-z0-9][A-Za-z0-9_. +()\-]{0,127}$/', $n) === 1; }

/* ---------- Unraid ---------- */

function und_var_ini() { $v = @parse_ini_string(und_read('/var/local/emhttp/var.ini')); return is_array($v) ? $v : []; }

function und_api_mode() { return UND_MODE === 'api'; }

/** What this deployment can do; the UI hides what is not available instead of failing. */
function und_caps() {
  $p = !und_api_mode();
  return ['power' => $p, 'os_update' => $p, 'docker_check' => $p, 'docker_stats' => $p, 'docker_inspect' => true, 'vm_hibernate' => $p, 'vm_details' => $p,
          'vnc' => $p, 'storage_detail' => true, 'mode' => UND_MODE];
}

function und_os_version() {
  $v = @parse_ini_string(und_read('/etc/unraid-version'));
  return is_array($v) && !empty($v['version']) ? (string)$v['version'] : '';
}

function und_server_ip() {
  $n = @parse_ini_string(und_read('/var/local/emhttp/network.ini'), true);
  if (is_array($n)) foreach ($n as $sec) if (is_array($sec) && !empty($sec['IPADDR:0'])) return (string)$sec['IPADDR:0'];
  $ip = $_SERVER['SERVER_ADDR'] ?? '';
  return $ip !== '' ? $ip : '127.0.0.1';
}

$__ident = @parse_ini_string(und_read('/boot/config/ident.cfg'));
if (is_array($__ident) && !empty($__ident['timezone'])) @date_default_timezone_set($__ident['timezone']);
unset($__ident);

} // UND_LIB_LOADED

foreach (['config', 'transfer', 'system', 'docker', 'vm', 'services', 'import', 'ops', 'unraid_api', 'media', 'arr', 'downloads'] as $__m) {
  $__f = __DIR__ . '/' . $__m . '.php';
  if (is_file($__f)) require_once $__f;
}
unset($__m, $__f);
]]></INLINE>
<SHA256>580b4f1e1889825d2d6ffd379049ef0afd56e5716e467a3e5bac9533902e32d2</SHA256>
</FILE>

<FILE Name="&emhttp;/include/config.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - configuration (schema version UND_SCHEMA, documented in docs/CONFIG.md).
 *
 * Where it lives
 *   The configuration directory defaults to /mnt/user/appdata/undash and is set in /boot/config/plugins/undash/undash.cfg.
 *   Every save is mirrored to the flash drive, so UnDash keeps working while the array (and with it /mnt/user) is stopped.
 *   Reads prefer the configuration directory and fall back to the flash copy.
 *
 * Files in the configuration directory
 *   config.json   layout, preferences, appearance (no secrets)
 *   secrets.json  variables and per-widget credentials (never sent to the browser in clear text)
 *   custom.css    the user's custom CSS
 *   backups/      a snapshot of the three files before every save, import and restore (newest 15 kept)
 */

define('UND_SCHEMA', 3);

/** Every widget type: [label, credential fields it uses, needs url]. */
function und_types() {
  return [
    'system_info' => ['System information', [], false], 'cpu' => ['CPU usage', [], false], 'memory' => ['Memory usage', [], false],
    'storage' => ['Array & pools', [], false], 'ups' => ['UPS (NUT / apcupsd)', [], false],
    'docker_summary' => ['Docker summary', [], false], 'vm_summary' => ['VM summary', [], false],
    'calendar' => ['Calendar (Radarr / Sonarr)', [], false], 'tautulli_recent' => ['Recently added (Tautulli)', ['key'], true],
    'radarr' => ['Radarr', ['key'], true], 'sonarr' => ['Sonarr', ['key'], true], 'lidarr' => ['Lidarr', ['key'], true],
    'readarr' => ['Readarr', ['key'], true], 'bazarr' => ['Bazarr', ['key'], true], 'prowlarr' => ['Prowlarr', ['key'], true],
    'overseerr' => ['Overseerr / Jellyseerr', ['key'], true], 'autobrr' => ['Autobrr', ['key'], true], 'wizarr' => ['Wizarr', ['key'], true],
    'qbittorrent' => ['qBittorrent', ['username', 'password'], true], 'sabnzbd' => ['SABnzbd', ['key'], true],
    'emby' => ['Emby', ['key'], true], 'jellyfin' => ['Jellyfin', ['key'], true], 'plex' => ['Plex', ['key'], true], 'tautulli' => ['Tautulli', ['key'], true],
    'adguard' => ['AdGuard Home', ['username', 'password'], true], 'pihole' => ['Pi-hole', ['key'], true], 'npm' => ['Nginx Proxy Manager', ['username', 'password'], true],
    'immich' => ['Immich', ['key'], true], 'peanut' => ['PeaNUT', ['key', 'username', 'password'], true],
    'customapi' => ['Custom API (JSON)', ['key'], true], 'link' => ['Link only', [], false],
  ];
}

/** Dashboard sections, in their default order. */
function und_section_ids() { return ['overview', 'alerts', 'favorites', 'media', 'arr', 'downloads', 'docker', 'vms', 'apps']; }

/** System metrics the overview can show, in their default order. */
function und_metric_ids() { return ['cpu', 'memory', 'storage', 'network', 'health', 'disks', 'uptime', 'ups', 'cores', 'swap', 'load', 'path', 'docker', 'vms']; }

/** The media widgets, in their default order. */
function und_media_ids() { return ['upcoming_movies', 'upcoming_episodes', 'recent_movies', 'recent_episodes']; }

function und_default_config() {
  $svc = function ($name, $type, $icon = '') { return ['id' => und_id(), 'name' => $name, 'type' => $type, 'icon' => $icon, 'href' => '', 'url' => '', 'fields' => [], 'options' => new stdClass()]; };
  $sections = [];
  foreach (und_section_ids() as $id) $sections[] = ['id' => $id, 'visible' => $id !== 'favorites', 'width' => in_array($id, ['arr', 'downloads'], true) ? 'half' : 'full', 'collapsed' => false];
  $metrics = [];
  foreach (und_metric_ids() as $id) $metrics[] = ['id' => $id, 'visible' => !in_array($id, ['cores', 'swap', 'load', 'path', 'docker', 'vms'], true)];
  return [
    'schema' => UND_SCHEMA,
    'general' => ['title' => 'UnDash', 'refresh' => 2, 'refresh_services' => 15, 'background_poll' => 'slow', 'disk_path' => '/mnt/user', 'search' => 'duckduckgo',
                  'show_search' => true, 'show_date' => true, 'os_check_hours' => 6, 'ups_name' => 'ups'],
    'appearance' => ['theme' => 'default', 'accent' => '#f15a2c', 'density' => 'comfortable', 'background' => '', 'blur' => 4, 'brightness' => 75, 'css_enabled' => true],
    'media' => ['radarr' => '', 'sonarr' => '', 'count' => 15, 'days_ahead' => 30, 'widgets' => array_map(function ($id) { return ['id' => $id, 'visible' => true]; }, und_media_ids())],
    'downloads' => ['items' => 4],
    'dashboard' => ['sections' => $sections, 'metrics' => $metrics],
    'docker' => ['layout' => 'list', 'view' => 'compact', 'sort' => 'name', 'show' => ['status', 'cpu', 'memory', 'uptime', 'image', 'update'], 'hide_stopped' => false, 'items' => new stdClass()],
    'vms' => ['layout' => 'list', 'show' => ['status', 'cpus', 'memory'], 'items' => new stdClass()],
    'groups' => [
      ['id' => und_id(), 'name' => 'Apps', 'columns' => 4, 'header' => true, 'services' => []],
    ],
  ];
}

function und_id() { return bin2hex(random_bytes(4)); }

/* ---------- location ---------- */

/** undash.cfg on the flash drive: CONFIG_DIR, PORT, BIND, STANDALONE. */
function und_loc() {
  if (und_api_mode()) return ['CONFIG_DIR' => UND_DIR, 'PORT' => (string)((int)(getenv('UNDASH_PORT') ?: 9099)), 'BIND' => '0.0.0.0', 'STANDALONE' => 'yes'];
  $d = ['CONFIG_DIR' => '/mnt/user/appdata/undash', 'PORT' => '9099', 'BIND' => '0.0.0.0', 'STANDALONE' => 'yes'];
  $v = @parse_ini_string(und_read_flash('undash.cfg'));
  $v = is_array($v) ? $v + $d : $d;
  if (!und_valid_cfg_dir($v['CONFIG_DIR'])) $v['CONFIG_DIR'] = $d['CONFIG_DIR'];
  $p = (int)$v['PORT']; $v['PORT'] = (string)($p >= 1024 && $p <= 65535 ? $p : 9099);
  if (!filter_var($v['BIND'], FILTER_VALIDATE_IP)) $v['BIND'] = '0.0.0.0';
  $v['STANDALONE'] = $v['STANDALONE'] === 'no' ? 'no' : 'yes';
  return $v;
}

/** The configuration directory must be an absolute path on a user share, a pool or the flash plugin folder: never anything else. */
function und_valid_cfg_dir($p) {
  $p = (string)$p;
  if (strpos($p, '..') !== false || strpos($p, "\0") !== false) return false;
  return preg_match('#^(/mnt/[A-Za-z0-9_.-]+(/[A-Za-z0-9_. -]+)*|' . preg_quote(UND_DIR, '#') . ')/?$#', $p) === 1;
}

function und_read_flash($name) { $s = @file_get_contents(UND_DIR . '/' . $name); return $s === false ? '' : $s; }

function und_save_loc(array $v) {
  if (und_api_mode()) return ['error' => 'In the Docker version the port and the /config folder are set in the container settings.'];
  $cur = und_loc();
  foreach (['CONFIG_DIR', 'PORT', 'BIND', 'STANDALONE'] as $k) if (isset($v[$k])) $cur[$k] = (string)$v[$k];
  if (!und_valid_cfg_dir($cur['CONFIG_DIR'])) return ['error' => 'The configuration directory must be a path under /mnt (for example /mnt/user/appdata/undash).'];
  $p = (int)$cur['PORT'];
  if ($p < 1024 || $p > 65535) return ['error' => 'The port must be between 1024 and 65535.'];
  if (!filter_var($cur['BIND'], FILTER_VALIDATE_IP)) return ['error' => 'The listen address must be an IP address (0.0.0.0 = all).'];
  $txt = '';
  foreach (['CONFIG_DIR', 'PORT', 'BIND', 'STANDALONE'] as $k) $txt .= $k . '="' . str_replace('"', '', $cur[$k]) . "\"\n";
  @mkdir(UND_DIR, 0755, true);
  if (@file_put_contents(UND_DIR . '/undash.cfg', $txt) === false) return ['error' => 'Could not write ' . UND_DIR . '/undash.cfg.'];
  return ['ok' => true, 'loc' => $cur];
}

/**
 * The directory UnDash writes to: the configured directory when it can be used, else the flash folder.
 * A missing directory is created only when its parent exists (so a stopped array never creates a stray folder on the RAM disk).
 */
function und_store_dir() {
  static $cache = [];
  $dir = und_path(rtrim(und_loc()['CONFIG_DIR'], '/'));
  if (isset($cache[$dir]) && is_dir($cache[$dir])) return $cache[$dir];
  $ok = false;
  if ($dir === UND_DIR) $ok = true;
  elseif (is_dir($dir)) $ok = is_writable($dir);
  elseif (is_dir(dirname($dir)) && is_writable(dirname($dir)) && und_array_mounted($dir)) $ok = @mkdir($dir, 0755, true);
  if ($ok) und_migrate_into($dir);
  return $cache[$dir] = $ok ? $dir : UND_DIR;
}

/** /mnt/user (and pools) only exist while the array is started; before that /mnt is a plain RAM-disk folder. */
function und_array_mounted($dir) {
  if (isset($GLOBALS['UND_FS'])) return true;
  if (strpos($dir, '/mnt/') !== 0) return true;
  $top = '/mnt/' . explode('/', substr($dir, 5))[0];
  foreach (@file('/proc/mounts', FILE_IGNORE_NEW_LINES) ?: [] as $l) { $c = explode(' ', $l); if (($c[1] ?? '') === $top) return true; }
  return false;
}

/** First use of a configuration directory: copy the flash files into it, never over existing ones. */
function und_migrate_into($dir) {
  if ($dir === UND_DIR) return;
  foreach (['config.json', 'secrets.json', 'custom.css'] as $f) {
    if (!is_file("$dir/$f") && is_file(UND_DIR . "/$f")) { @copy(UND_DIR . "/$f", "$dir/$f"); if ($f === 'secrets.json') @chmod("$dir/$f", 0600); }
  }
}

function und_file($name) {
  $d = und_store_dir();
  return is_file("$d/$name") || $d === UND_DIR ? "$d/$name" : UND_DIR . "/$name";
}

/** Write one file to the configuration directory and mirror it to the flash drive. */
function und_store_write($name, $content, $private = false) {
  $dirs = array_unique([und_store_dir(), UND_DIR]);
  $ok = false;
  foreach ($dirs as $i => $d) {
    @mkdir($d, 0755, true);
    $f = "$d/$name";
    if (is_file($f) && @file_get_contents($f) === $content) { if ($i === 0) $ok = true; continue; }
    $tmp = $f . '.tmp' . getmypid();
    $w = @file_put_contents($tmp, $content) !== false;
    if ($w && $private) @chmod($tmp, 0600);
    $w = $w && @rename($tmp, $f);
    if (!$w) @unlink($tmp);
    if ($i === 0) $ok = $w;
  }
  return $ok;
}

/* ---------- backups ---------- */

function und_backup_dir() { return und_store_dir() . '/backups'; }

/** Snapshot config, secrets and CSS before they change. Returns the backup id. */
function und_backup($reason) {
  $dir = und_backup_dir();
  @mkdir($dir, 0700, true);
  $id = date('Ymd-His') . '-' . substr(und_id(), 0, 4);
  $snap = ['undash_backup' => 1, 'schema' => UND_SCHEMA, 'created' => time(), 'reason' => und_clip((string)$reason, 80),
           'config' => und_read_json(und_file('config.json'), null), 'secrets' => und_read_json(und_file('secrets.json'), null), 'css' => (string)@file_get_contents(und_file('custom.css'))];
  if ($snap['config'] === null && $snap['secrets'] === null && $snap['css'] === '') return null;
  @file_put_contents("$dir/$id.json", json_encode($snap, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
  @chmod("$dir/$id.json", 0600);
  $all = glob("$dir/*.json") ?: [];
  sort($all);
  foreach (array_slice($all, 0, max(0, count($all) - 15)) as $old) @unlink($old);
  return $id;
}

function und_backups() {
  $out = [];
  foreach (array_reverse(glob(und_backup_dir() . '/*.json') ?: []) as $f) {
    $j = und_read_json($f, []);
    $out[] = ['id' => basename($f, '.json'), 'created' => (int)($j['created'] ?? filemtime($f)), 'reason' => (string)($j['reason'] ?? ''), 'schema' => (int)($j['schema'] ?? 0)];
  }
  return $out;
}

function und_restore($id) {
  if (!preg_match('/^\d{8}-\d{6}-[a-f0-9]{4}$/', (string)$id)) return ['error' => 'Unknown backup.'];
  $f = und_backup_dir() . "/$id.json";
  $j = und_read_json($f, null);
  if (!is_array($j) || empty($j['undash_backup'])) return ['error' => 'That backup cannot be read.'];
  und_backup('before restoring ' . $id);
  if (is_array($j['config'])) und_save_config($j['config'], false);
  if (is_array($j['secrets'])) und_save_secrets($j['secrets']);
  und_save_css((string)($j['css'] ?? ''), false);
  return ['ok' => true];
}

/* ---------- load / save ---------- */

function und_load_config() {
  $c = und_read_json(und_file('config.json'), null);
  if (!is_array($c) || !isset($c['groups'])) return und_normalize(und_default_config());
  return und_normalize(und_migrate($c));
}

/** Bring an older schema up to date. Version 1 (2026.10.29) had general.theme, refresh_system and no dashboard sections. */
function und_migrate(array $c) {
  $v = (int)($c['schema'] ?? 1);
  if ($v < 2) {
    $g = isset($c['general']) && is_array($c['general']) ? $c['general'] : [];
    $theme = (string)($g['theme'] ?? 'dark');
    $c['appearance'] = ['theme' => $theme === 'light' ? 'light' : 'default', 'background' => (string)($g['background'] ?? ''), 'blur' => $g['blur'] ?? 4, 'brightness' => $g['brightness'] ?? 75];
    if (isset($g['refresh_system'])) $g['refresh'] = 2;     // the new default; version 1 only allowed 5 s or more
    if (isset($g['show_resources']) && !$g['show_resources']) $c['dashboard']['sections'] = [['id' => 'metrics', 'visible' => false]];
    unset($g['theme'], $g['background'], $g['blur'], $g['brightness'], $g['refresh_system'], $g['show_resources']);
    $c['general'] = $g;
    // Glances-style system cards are now the built-in System section: drop them, and a group they leave empty
    foreach ((array)($c['groups'] ?? []) as $i => $gr) {
      if (!is_array($gr)) continue;
      $keep = array_values(array_filter((array)($gr['services'] ?? []), function ($s) { return !in_array($s['type'] ?? '', ['system_info', 'cpu', 'memory'], true); }));
      if (!$keep && count((array)($gr['services'] ?? []))) unset($c['groups'][$i]); else $c['groups'][$i]['services'] = $keep;
    }
    $c['groups'] = array_values((array)($c['groups'] ?? []));
    $c['schema'] = 2;
  }
  if ($v < 3) {
    // version 3 (2026.10.30): System metrics joined the overview, Storage moved into it, Services became Apps,
    // and Media, Arr Stack and Download Clients are sections of their own. Visibility and order of the kept sections survive.
    $old = isset($c['dashboard']['sections']) && is_array($c['dashboard']['sections']) ? $c['dashboard']['sections'] : [];
    $new = [];
    foreach ($old as $sec) {
      $id = $sec['id'] ?? '';
      if ($id === 'services') { $sec['id'] = 'apps'; $id = 'apps'; }
      if ($id === 'metrics' || $id === 'storage') continue;
      $sec['width'] = 'full';
      $new[] = $sec;
      if ($id === 'favorites') foreach (['media', 'arr', 'downloads'] as $n) $new[] = ['id' => $n, 'visible' => true, 'width' => $n === 'media' ? 'full' : 'half', 'collapsed' => false];
    }
    $c['dashboard']['sections'] = $new;
    $c['dashboard']['metrics'] = [];
    if (($c['appearance']['density'] ?? '') === 'comfortable') $c['appearance']['density'] = 'comfortable';
    $c['schema'] = 3;
  }
  return $c;
}

function und_hex($c, $d) { return preg_match('/^#[0-9a-fA-F]{6}$/', (string)$c) ? strtolower($c) : $d; }

/** Clamp and fill a config that came from disk, the browser or an import. Unknown keys are dropped. */
function und_normalize(array $c) {
  $d = und_default_config();
  $g = (isset($c['general']) && is_array($c['general']) ? $c['general'] : []) + $d['general'];
  $g = array_intersect_key($g, $d['general']);
  $g['title'] = und_clip(trim((string)$g['title']), 60) ?: 'UnDash';
  foreach (['refresh' => [1, 300], 'refresh_services' => [5, 3600], 'os_check_hours' => [1, 168]] as $k => $r) $g[$k] = max($r[0], min($r[1], (int)$g[$k]));
  foreach (['show_search', 'show_date'] as $k) $g[$k] = !empty($g[$k]);
  $g['background_poll'] = in_array($g['background_poll'], ['slow', 'pause', 'normal'], true) ? $g['background_poll'] : 'slow';
  $g['disk_path'] = preg_match('#^/mnt/[A-Za-z0-9_./ -]*$#', (string)$g['disk_path']) && strpos($g['disk_path'], '..') === false ? (string)$g['disk_path'] : '/mnt/user';
  $g['search'] = in_array($g['search'], ['duckduckgo', 'google', 'bing', 'startpage', 'brave', 'none'], true) ? $g['search'] : 'duckduckgo';
  $g['ups_name'] = preg_match('/^[A-Za-z0-9_.@:-]{1,64}$/', (string)$g['ups_name']) ? (string)$g['ups_name'] : 'ups';

  $a = (isset($c['appearance']) && is_array($c['appearance']) ? $c['appearance'] : []) + $d['appearance'];
  $a = array_intersect_key($a, $d['appearance']);
  $a['theme'] = in_array($a['theme'], ['default', 'light', 'amoled'], true) ? $a['theme'] : 'default';
  $a['accent'] = und_hex($a['accent'], '#f15a2c');
  $a['density'] = in_array($a['density'], ['compact', 'comfortable', 'expanded'], true) ? $a['density'] : 'comfortable';
  $a['background'] = preg_match('#^(https?://|/)[^"\'<>\s()\\\\]*$#', (string)$a['background']) ? (string)$a['background'] : '';
  $a['blur'] = max(0, min(40, (int)$a['blur'])); $a['brightness'] = max(10, min(100, (int)$a['brightness']));
  $a['css_enabled'] = !empty($a['css_enabled']);

  // sections and metrics: keep the user's order, drop unknown ids, append new ones at the end
  $db = isset($c['dashboard']) && is_array($c['dashboard']) ? $c['dashboard'] : [];
  $order = function ($list, $known, $defaults, $fields) {
    $out = []; $seen = [];
    foreach ((array)$list as $x) {
      if (!is_array($x) || !in_array($x['id'] ?? '', $known, true) || isset($seen[$x['id']])) continue;
      $seen[$x['id']] = 1;
      $def = null; foreach ($defaults as $dd) if ($dd['id'] === $x['id']) $def = $dd;
      $row = ['id' => $x['id']];
      foreach ($fields as $f => $type) {
        $v = array_key_exists($f, $x) ? $x[$f] : $def[$f];
        $row[$f] = $type === 'bool' ? !empty($v) : (in_array($v, $type, true) ? $v : $def[$f]);
      }
      $out[] = $row;
    }
    foreach ($defaults as $dd) if (!isset($seen[$dd['id']])) $out[] = $dd;
    return $out;
  };
  $sections = $order($db['sections'] ?? [], und_section_ids(), $d['dashboard']['sections'], ['visible' => 'bool', 'width' => ['full', 'half'], 'collapsed' => 'bool']);
  $metrics = $order($db['metrics'] ?? [], und_metric_ids(), $d['dashboard']['metrics'], ['visible' => 'bool']);

  $items = function ($list, $extra = []) {
    $out = [];
    foreach ((array)$list as $name => $p) {
      if (!is_array($p) || !is_string($name) || $name === '' || strlen($name) > 200 || preg_match('/[\x00-\x1f]/', $name)) continue;
      $row = ['label' => und_clip(trim((string)($p['label'] ?? '')), 60), 'icon' => und_clip((string)($p['icon'] ?? ''), 300), 'description' => und_clip(trim((string)($p['description'] ?? '')), 200),
              'hidden' => !empty($p['hidden']), 'favorite' => !empty($p['favorite'])];
      if ($row['label'] === '' && $row['icon'] === '' && $row['description'] === '' && !$row['hidden'] && !$row['favorite']) continue;
      $out[$name] = $row;
    }
    return $out ? $out : new stdClass();
  };
  $md = (isset($c['media']) && is_array($c['media']) ? $c['media'] : []) + $d['media'];
  $media = ['radarr' => preg_match('/^[a-f0-9]{8}$/', (string)$md['radarr']) ? $md['radarr'] : '', 'sonarr' => preg_match('/^[a-f0-9]{8}$/', (string)$md['sonarr']) ? $md['sonarr'] : '',
            'count' => max(4, min(40, (int)$md['count'])), 'days_ahead' => max(7, min(120, (int)$md['days_ahead'])),
            'widgets' => $order($md['widgets'] ?? [], und_media_ids(), $d['media']['widgets'], ['visible' => 'bool'])];
  $dl = (isset($c['downloads']) && is_array($c['downloads']) ? $c['downloads'] : []) + $d['downloads'];
  $downloads = ['items' => max(0, min(20, (int)$dl['items']))];
  $dk = (isset($c['docker']) && is_array($c['docker']) ? $c['docker'] : []) + $d['docker'];
  $docker = ['layout' => $dk['layout'] === 'cards' ? 'cards' : 'list', 'view' => $dk['view'] === 'expanded' ? 'expanded' : 'compact', 'sort' => in_array($dk['sort'], ['name', 'status', 'cpu', 'memory'], true) ? $dk['sort'] : 'name',
             'show' => array_values(array_intersect((array)$dk['show'], ['status', 'cpu', 'memory', 'uptime', 'image', 'update', 'ports', 'restarts', 'network'])),
             'hide_stopped' => !empty($dk['hide_stopped']), 'items' => $items($dk['items'] ?? [])];
  $vm = (isset($c['vms']) && is_array($c['vms']) ? $c['vms'] : []) + $d['vms'];
  $vms = ['layout' => $vm['layout'] === 'cards' ? 'cards' : 'list', 'show' => array_values(array_intersect((array)$vm['show'], ['status', 'cpus', 'memory', 'os', 'autostart'])), 'items' => $items($vm['items'] ?? [])];

  $types = und_types(); $groups = [];
  foreach ((array)($c['groups'] ?? []) as $gr) {
    if (!is_array($gr)) continue;
    $out = ['id' => preg_match('/^[a-f0-9]{8}$/', (string)($gr['id'] ?? '')) ? $gr['id'] : und_id(), 'name' => und_clip(trim((string)($gr['name'] ?? 'Group')), 60),
            'columns' => max(1, min(8, (int)($gr['columns'] ?? 4))), 'header' => !isset($gr['header']) || !empty($gr['header']), 'services' => []];
    foreach ((array)($gr['services'] ?? []) as $s) {
      if (!is_array($s) || !isset($types[$s['type'] ?? ''])) continue;
      $opt = isset($s['options']) && is_array($s['options']) ? $s['options'] : [];
      $out['services'][] = ['id' => preg_match('/^[a-f0-9]{8}$/', (string)($s['id'] ?? '')) ? $s['id'] : und_id(), 'name' => und_clip(trim((string)($s['name'] ?? '')), 60) ?: $types[$s['type']][0],
        'type' => $s['type'], 'icon' => und_clip((string)($s['icon'] ?? ''), 300), 'href' => und_clip((string)($s['href'] ?? ''), 500), 'url' => und_clip((string)($s['url'] ?? ''), 500),
        'description' => und_clip(trim((string)($s['description'] ?? '')), 200), 'hidden' => !empty($s['hidden']), 'favorite' => !empty($s['favorite']), 'span' => (int)($s['span'] ?? 1) === 2 ? 2 : 1,
        'fields' => array_values(array_filter(array_map('strval', (array)($s['fields'] ?? [])), function ($f) { return preg_match('/^[A-Za-z0-9_]{1,40}$/', $f); })),
        'options' => $opt ? $opt : new stdClass()];
    }
    $groups[] = $out;
  }
  return ['schema' => UND_SCHEMA, 'general' => $g, 'appearance' => $a, 'dashboard' => ['sections' => $sections, 'metrics' => $metrics], 'media' => $media, 'downloads' => $downloads,
          'docker' => $docker, 'vms' => $vms, 'groups' => $groups];
}

function und_save_config(array $c, $backup = true) {
  if ($backup) und_backup('settings saved');
  return und_store_write('config.json', json_encode(und_normalize($c), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR));
}

/** Every widget id in a config (used to drop credentials of widgets that were removed). */
function und_service_ids(array $cfg) { $ids = []; foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) $ids[] = $s['id']; return $ids; }

/* ---------- custom CSS ---------- */

/**
 * Custom CSS is only ever CSS: it is inserted with textContent inside the app's own <style>, nested under .und so it cannot
 * restyle Unraid's page. Things that could load or run something else are removed: @import, url() to other sites,
 * legacy expression() / behavior / -moz-binding, javascript: and a closing </style>.
 */
function und_sanitize_css($css) {
  $css = str_replace("\0", '', (string)$css);
  if (strlen($css) > 102400) $css = substr($css, 0, 102400);
  $css = preg_replace('#</\s*style#i', '', $css);
  $css = preg_replace('/@import[^;]*;?/i', '/* @import removed */', $css);
  $css = preg_replace('/expression\s*\(|behavior\s*:|-moz-binding|javascript\s*:/i', '/* removed */', $css);
  $css = preg_replace_callback('/url\(\s*([\'"]?)(.*?)\1\s*\)/i', function ($m) {
    return preg_match('#^(data:image/|/|\./|[A-Za-z0-9_.-]+\.(png|jpe?g|gif|svg|webp|woff2?)$|https://)#i', trim($m[2])) && !preg_match('/^javascript:/i', trim($m[2])) ? $m[0] : 'none';
  }, $css);
  return $css;
}

function und_load_css() { return und_sanitize_css((string)@file_get_contents(und_file('custom.css'))); }

function und_save_css($css, $backup = true) {
  if ($backup) und_backup('custom CSS saved');
  return und_store_write('custom.css', und_sanitize_css($css));
}

/* ---------- secrets ---------- */

function und_secrets() {
  $s = isset($GLOBALS['UND_TEST_SECRETS']) ? $GLOBALS['UND_TEST_SECRETS'] : und_read_json(und_file('secrets.json'), []);
  return ['vars' => isset($s['vars']) && is_array($s['vars']) ? $s['vars'] : [], 'svc' => isset($s['svc']) && is_array($s['svc']) ? $s['svc'] : [],
          'unraid' => isset($s['unraid']) && is_array($s['unraid']) ? $s['unraid'] : []];
}
function und_save_secrets(array $s) {
  // the Unraid API connection is kept unless the caller sets it explicitly
  $unraid = isset($s['unraid']) && is_array($s['unraid']) ? $s['unraid'] : und_read_json(und_file('secrets.json'), [])['unraid'] ?? [];
  $s = ['vars' => isset($s['vars']) && is_array($s['vars']) ? $s['vars'] : [], 'svc' => isset($s['svc']) && is_array($s['svc']) ? $s['svc'] : [], 'unraid' => is_array($unraid) ? $unraid : []];
  return und_store_write('secrets.json', json_encode($s, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), true);
}

function und_var_is_secret($name) { return preg_match('/KEY|TOKEN|PASS|SECRET|AUTH|COOKIE|SESSION|CREDENTIAL/i', $name) === 1; }

/** What the browser may see: secret variables and stored credentials are replaced by UND_KEEP. */
function und_secrets_view(array $s) {
  $vars = [];
  foreach ($s['vars'] as $k => $v) $vars[] = ['name' => $k, 'value' => und_var_is_secret($k) && $v !== '' ? UND_KEEP : $v, 'secret' => und_var_is_secret($k)];
  $svc = [];
  foreach ($s['svc'] as $id => $c) foreach (['key', 'password', 'username'] as $f) {
    if (!isset($c[$f]) || $c[$f] === '') continue;
    $svc[$id][$f] = ($f === 'username' || preg_match('/^\{\{\s*[A-Za-z0-9_]+\s*\}\}$/', $c[$f])) ? $c[$f] : UND_KEEP;
  }
  return ['vars' => $vars, 'svc' => (object)$svc];
}

/** Merge what the browser sent back with what is stored (UND_KEEP = unchanged). */
function und_secrets_merge(array $old, array $vars, array $svc, array $ids) {
  $new = ['vars' => [], 'svc' => []];
  foreach ($vars as $v) {
    $n = strtoupper(trim((string)($v['name'] ?? '')));
    if (!preg_match('/^[A-Z][A-Z0-9_]{0,63}$/', $n)) continue;
    $val = (string)($v['value'] ?? '');
    $new['vars'][$n] = $val === UND_KEEP ? (string)($old['vars'][$n] ?? '') : und_clip($val, 2000);
  }
  foreach ($ids as $id) {
    $in = isset($svc[$id]) && is_array($svc[$id]) ? $svc[$id] : [];
    foreach (['key', 'password', 'username'] as $f) {
      $val = (string)($in[$f] ?? '');
      if ($val === UND_KEEP) $val = (string)($old['svc'][$id][$f] ?? '');
      if ($val !== '') $new['svc'][$id][$f] = und_clip($val, 2000);
    }
  }
  return $new;
}

/** Replace {{NAME}} with variable values. UNRAID_IP is built in. Unknown names are left as they are. */
function und_resolve($s, array $vars) {
  if (!und_has($s, '{{')) return $s;
  return preg_replace_callback('/\{\{\s*([A-Za-z0-9_]+)\s*\}\}/', function ($m) use ($vars) {
    $n = strtoupper($m[1]);
    if (isset($vars[$n])) return $vars[$n];
    if ($n === 'UNRAID_IP') return und_server_ip();
    return $m[0];
  }, (string)$s);
}

/** A service with every {{VAR}} resolved and its credentials attached. Server side only. */
function und_service_full(array $cfg, $id) {
  $sec = und_secrets();
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) {
    if ($s['id'] !== $id) continue;
    $c = $sec['svc'][$id] ?? [];
    foreach (['key', 'password', 'username'] as $f) $s[$f] = und_resolve((string)($c[$f] ?? ''), $sec['vars']);
    foreach (['url', 'href'] as $f) $s[$f] = und_resolve($s[$f], $sec['vars']);
    $s['options'] = json_decode(und_resolve(json_encode($s['options']), array_map(function ($v) { return trim(json_encode((string)$v), '"'); }, $sec['vars'])), true) ?: [];
    $s['_group'] = $g['name'];
    return $s;
  }
  return null;
}

function und_find_service(array $cfg, $group, $name, $type = null) {
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) {
    if (strcasecmp($s['name'], (string)$name) === 0 && ($group === null || $group === '' || strcasecmp($g['name'], (string)$group) === 0) && ($type === null || $s['type'] === $type)) return $s['id'];
  }
  return null;
}

/**
 * Where a configured app shows up on the dashboard, so nothing appears twice:
 *   arr        Arr Stack section        downloads  Download Clients section
 *   media      covered by the Media section (calendars, "recently added" lists)
 *   overview   covered by the server overview (system, UPS, Docker / VM summaries)
 *   apps       everything else (Plex, Immich, AdGuard, links ...)
 */
function und_zone(array $s) {
  $t = (string)($s['type'] ?? '');
  if (in_array($t, und_arr_types(), true)) return 'arr';
  if (in_array($t, und_dl_types(), true)) return 'downloads';
  if ($t === 'calendar' || $t === 'tautulli_recent' || ($t === 'customapi' && und_has((string)($s['url'] ?? ''), 'get_recently_added'))) return 'media';
  if (in_array($t, ['system_info', 'cpu', 'memory', 'storage', 'ups', 'peanut', 'docker_summary', 'vm_summary'], true)) return 'overview';
  return 'apps';
}

/** The layout sent to the browser: hrefs resolved (they are links the user clicks anyway), nothing secret. */
function und_layout_view(array $cfg) {
  $vars = und_secrets()['vars'];
  foreach ($cfg['groups'] as &$g) foreach ($g['services'] as &$s) {
    $s['zone'] = und_zone($s);
    $h = und_resolve($s['href'], $vars);
    // a link that would carry a secret variable is not resolved for the browser
    if (preg_match_all('/\{\{\s*([A-Za-z0-9_]+)\s*\}\}/', $s['href'], $m)) foreach ($m[1] as $n) if (und_var_is_secret($n)) $h = '';
    $s['href_resolved'] = preg_match('#^(https?://|/)#i', $h) ? $h : '';
  }
  return $cfg;
}

/* ---------- validation ---------- */

/** Problems a user can fix: widgets without a URL, unknown variables, calendar sources that no longer exist. */
function und_validate(array $cfg) {
  $issues = []; $vars = und_secrets()['vars']; $types = und_types(); $ids = array_flip(und_service_ids($cfg));
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) {
    $where = '"' . $s['name'] . '" in "' . $g['name'] . '"';
    if (!empty($types[$s['type']][2]) && trim($s['url']) === '') $issues[] = ['level' => 'warn', 'msg' => "$where has no API URL."];
    foreach (['url', 'href'] as $f) if (preg_match_all('/\{\{\s*([A-Za-z0-9_]+)\s*\}\}/', $s[$f], $m)) foreach ($m[1] as $n) {
      $n = strtoupper($n);
      if (!isset($vars[$n]) && $n !== 'UNRAID_IP') $issues[] = ['level' => 'bad', 'msg' => "$where uses {{" . $n . '}}, which is not defined.'];
      elseif (isset($vars[$n]) && $vars[$n] === '') $issues[] = ['level' => 'warn', 'msg' => "$where uses {{" . $n . '}}, which is empty.'];
    }
    if ($s['type'] === 'calendar') foreach ((array)(((array)$s['options'])['integrations'] ?? []) as $in) if (!isset($ids[$in['service'] ?? ''])) $issues[] = ['level' => 'warn', 'msg' => "$where refers to a Radarr/Sonarr widget that was removed."];
  }
  if (und_store_dir() !== und_path(rtrim(und_loc()['CONFIG_DIR'], '/'))) $issues[] = ['level' => 'warn', 'msg' => 'The configuration directory ' . und_loc()['CONFIG_DIR'] . ' is not available (is the array started?). Settings are read from and saved to the flash drive until it is.'];
  return $issues;
}
]]></INLINE>
<SHA256>bfaf2d5144e2c376194a669be08618f936a4120cd22c2634e81123614d3cd779</SHA256>
</FILE>

<FILE Name="&emhttp;/include/system.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - system information, read straight from the kernel and from Unraid's own state files (no Glances needed).
 * Rates (CPU, network) are the difference to the previous sample, kept in /tmp/undash so every poll is cheap.
 */

/** Jiffies for the whole CPU ("cpu") and for every core ("cpu0", "cpu1" ...). */
function und_cpu_sample() {
  $out = [];
  foreach (explode("\n", und_read('/proc/stat')) as $l) {
    if (!preg_match('/^cpu(\d*)\s+(.+)$/', $l, $m)) continue;
    $p = array_map('intval', preg_split('/\s+/', trim($m[2])));
    $out[$m[1] === '' ? 'all' : (int)$m[1]] = [array_sum(array_slice($p, 0, 8)), ($p[3] ?? 0) + ($p[4] ?? 0)];
  }
  return $out ?: null;
}

function und_cpu_pct($now, $prev) {
  $dTot = $now[0] - $prev[0]; $dIdle = $now[1] - $prev[1];
  return $dTot > 0 ? max(0, min(100, round(100 * ($dTot - $dIdle) / $dTot, 1))) : 0;
}

/** The interface of the default route. Unraid's macvlan "shim-" interfaces only mirror a bridge, so the bridge itself is preferred. */
function und_net_iface() {
  $found = [];
  foreach (array_slice(explode("\n", und_read('/proc/net/route')), 1) as $l) {
    $c = preg_split('/\s+/', trim($l));
    if (count($c) > 2 && $c[1] === '00000000') $found[] = $c[0];
  }
  foreach ($found as $f) if (strpos($f, 'shim-') !== 0) return $f;
  return $found ? substr($found[0], 5) : '';
}

function und_net_sample($if) {
  foreach (explode("\n", und_read('/proc/net/dev')) as $l) {
    if (strpos($l, ':') === false) continue;
    list($n, $rest) = explode(':', $l, 2);
    if (trim($n) !== $if) continue;
    $c = preg_split('/\s+/', trim($rest));
    return ['rx' => (float)$c[0], 'tx' => (float)$c[8]];
  }
  return null;
}

/** CPU % and network bytes/s since the previous call (a fresh 300 ms sample when there is none, or it is stale). */
function und_rates() {
  $f = und_tmp('rates.json');
  $prev = und_read_json($f, []);
  $now = microtime(true);
  $if = und_net_iface();
  // several browsers polling at once: a result from the last second is reused instead of sampling again
  if (!empty($prev['res']) && $now - ($prev['t'] ?? 0) < 1 && $now >= ($prev['t'] ?? 0)) return $prev['res'];
  $cpu = und_cpu_sample(); $net = $if ? und_net_sample($if) : null;
  if (!$prev || $now - ($prev['t'] ?? 0) > 60 || $now - ($prev['t'] ?? 0) < 0.25) {
    usleep(300000);
    $prev = ['t' => $now, 'cpu' => $cpu, 'net' => $net, 'if' => $if];
    $now = microtime(true); $cpu = und_cpu_sample(); $net = $if ? und_net_sample($if) : null;
  }
  $dt = max(0.05, $now - $prev['t']);
  $pct = null; $cores = [];
  if ($cpu && !empty($prev['cpu']['all'])) {
    $pct = und_cpu_pct($cpu['all'], $prev['cpu']['all']);
    foreach ($cpu as $k => $v) if ($k !== 'all' && isset($prev['cpu'][$k])) $cores[] = und_cpu_pct($v, $prev['cpu'][$k]);
  }
  $rx = $tx = null;
  if ($net && !empty($prev['net']) && ($prev['if'] ?? '') === $if) { $rx = max(0, ($net['rx'] - $prev['net']['rx']) / $dt); $tx = max(0, ($net['tx'] - $prev['net']['tx']) / $dt); }
  $res = ['cpu' => $pct, 'cores' => $cores, 'rx' => $rx, 'tx' => $tx, 'iface' => $if];
  und_write_json($f, ['t' => $now, 'cpu' => $cpu, 'net' => $net, 'if' => $if, 'res' => $res]);
  return $res;
}

function und_meminfo() {
  $m = [];
  foreach (explode("\n", und_read('/proc/meminfo')) as $l) if (preg_match('/^(\w+):\s+(\d+)/', $l, $x)) $m[$x[1]] = (float)$x[2] * 1024;
  $total = $m['MemTotal'] ?? 0; $avail = $m['MemAvailable'] ?? ($m['MemFree'] ?? 0);
  $st = $m['SwapTotal'] ?? 0; $sf = $m['SwapFree'] ?? 0;
  return ['total' => $total, 'used' => max(0, $total - $avail), 'free' => $avail, 'pct' => $total ? round(100 * ($total - $avail) / $total, 1) : null,
          'swap_total' => $st, 'swap_used' => max(0, $st - $sf)];
}

function und_cpu_model() {
  if (preg_match('/^model name\s*:\s*(.+)$/m', und_read('/proc/cpuinfo'), $m)) return trim(preg_replace('/\s+/', ' ', $m[1]));
  return '';
}

function und_cpu_threads() { return max(1, preg_match_all('/^processor\s*:/m', und_read('/proc/cpuinfo'))); }

/** CPU package temperature in °C (coretemp / k10temp / zenpower), else the hottest thermal zone. */
function und_cpu_temp() {
  foreach (glob(und_path('/sys/class/hwmon/hwmon*')) ?: [] as $d) {
    $n = trim((string)@file_get_contents("$d/name"));
    if (!in_array($n, ['coretemp', 'k10temp', 'zenpower', 'cpu_thermal'], true)) continue;
    $best = null;
    foreach (glob("$d/temp*_label") ?: [] as $lf) {
      $lab = trim((string)@file_get_contents($lf));
      if (preg_match('/^(Package id 0|Tctl|Tdie)$/', $lab)) { $best = str_replace('_label', '_input', $lf); break; }
    }
    if (!$best) $best = "$d/temp1_input";
    $v = (int)@file_get_contents($best);
    if ($v > 0) return round($v / 1000, 1);
  }
  $max = null;
  foreach (glob(und_path('/sys/class/thermal/thermal_zone*/temp')) ?: [] as $f) { $v = (int)@file_get_contents($f); if ($v > 0) $max = max((float)$max, $v / 1000); }
  return $max === null ? null : round($max, 1);
}

function und_uptime() { return (int)(float)explode(' ', trim(und_read('/proc/uptime')) . ' ')[0]; }

function und_disk($path) {
  $p = und_path($path);
  if (!is_dir($p)) return null;
  $t = @disk_total_space($p); $f = @disk_free_space($p);
  // /mnt/user reports 0 on servers whose shares live only on ZFS or other pools
  if (!$t) return ['path' => $path, 'total' => 0, 'free' => 0, 'used' => 0, 'pct' => null];
  return ['path' => $path, 'total' => $t, 'free' => $f, 'used' => $t - $f, 'pct' => round(100 * ($t - $f) / $t, 1)];
}

/** Everything the overview needs, in one cheap call (no Docker, no network). */
function und_system(array $cfg) {
  if (und_api_mode()) return und_api_system($cfg);
  $r = und_rates(); $mem = und_meminfo(); $v = und_var_ini();
  $hist = und_read_json(und_tmp('hist.json'), []);
  $now = time();
  if ($r['cpu'] !== null && (empty($hist) || $now - (int)end($hist)[0] >= 2)) { $hist[] = [$now, $r['cpu'], $mem['used'], $r['rx'], $r['tx']]; $hist = array_slice($hist, -150); und_write_json(und_tmp('hist.json'), $hist); }
  $load = preg_split('/\s+/', trim(und_read('/proc/loadavg')));
  return [
    'now' => $now, 'name' => (string)($v['NAME'] ?? gethostname()), 'ip' => und_server_ip(), 'os' => und_os_version(), 'kernel' => trim((string)preg_replace('/^Linux version (\S+).*$/s', '$1', und_read('/proc/version'))),
    'cpu' => ['pct' => $r['cpu'], 'cores' => $r['cores'], 'model' => und_cpu_model(), 'threads' => und_cpu_threads(), 'temp' => und_cpu_temp(), 'load' => array_map('floatval', array_slice($load, 0, 3))],
    'mem' => $mem, 'net' => ['rx' => $r['rx'], 'tx' => $r['tx'], 'iface' => $r['iface']], 'disk' => und_disk($cfg['general']['disk_path']),
    'uptime' => und_uptime(), 'array' => und_array_info($v), 'hist' => $hist, 'os_update' => und_os_cached(),
  ];
}

/** Array state plus totals and a health summary from Unraid's disks.ini (cheap: a RAM-disk file). */
function und_array_info(array $v) {
  $st = und_storage(); $size = 0; $free = 0; $bad = 0; $hot = 0; $errors = 0;
  foreach ($st['array'] as $d) { $size += $d['size']; $free += $d['free']; }
  foreach (array_merge($st['parity'], $st['array'], $st['pools']) as $d) {
    if ($d['health'] === 'bad') $bad++;
    if ($d['temp'] !== null && $d['temp'] >= 50) $hot++;
    $errors += $d['errors'];
  }
  $resync = (int)($v['mdResync'] ?? 0);
  return ['state' => (string)($v['mdState'] ?? ''), 'resync' => $resync, 'resync_pct' => $resync && (float)($v['mdResyncSize'] ?? 0) > 0 ? round(100 * (float)$v['mdResyncPos'] / (float)$v['mdResyncSize'], 1) : null,
          'resync_action' => (string)($v['mdResyncAction'] ?? ''), 'size' => $size, 'free' => $free, 'disks' => count($st['array']), 'parity' => count($st['parity']), 'pools' => $st['pools'],
          'bad' => $bad, 'hot' => $hot, 'errors' => $errors, 'mover' => is_file('/var/run/mover.pid')];
}

/* ---------- array & pools ---------- */

function und_storage() {
  if (und_api_mode()) return und_api_storage();
  $d = @parse_ini_string(und_read('/var/local/emhttp/disks.ini'), true);
  $out = ['array' => [], 'pools' => [], 'parity' => []];
  if (!is_array($d)) return $out;
  foreach ($d as $name => $x) {
    if (!is_array($x) || ($x['status'] ?? '') === 'DISK_NP' || ($x['status'] ?? '') === 'DISK_NP_DSBL') continue;
    $row = ['name' => (string)$name, 'device' => (string)($x['device'] ?? ''), 'status' => (string)($x['status'] ?? ''), 'temp' => is_numeric($x['temp'] ?? '') ? (int)$x['temp'] : null,
            'size' => (float)($x['fsSize'] ?? 0) * 1024, 'free' => (float)($x['fsFree'] ?? 0) * 1024, 'fs' => (string)($x['fsType'] ?? ''), 'spun' => ($x['spundown'] ?? '0') !== '1',
            'errors' => (int)($x['numErrors'] ?? 0), 'color' => (string)($x['color'] ?? '')];
    // Unraid's own disk colour: green = ok, yellow = emulated / being rebuilt, red = disabled; plus read/write errors
    $row['health'] = ($row['status'] !== 'DISK_OK' || strpos($row['color'], 'red') === 0) ? 'bad' : ((strpos($row['color'], 'yellow') === 0 || $row['errors'] > 0) ? 'warn' : 'ok');
    $type = (string)($x['type'] ?? '');
    if ($type === 'Parity') $out['parity'][] = $row;
    elseif ($type === 'Data') $out['array'][] = $row;
    // a pool's first device carries the file system totals; its other members (cache2, cache3 ...) have none
    elseif ($type === 'Cache' && (float)($x['fsSize'] ?? 0) > 0) $out['pools'][] = $row;
  }
  return $out;
}

/* ---------- UPS: NUT (upsc) first, then apcupsd (apcaccess) ---------- */

function und_ups($name = 'ups') {
  if (und_api_mode()) return und_api_ups();
  $upsc = und_bin('upsc');
  if ($upsc !== 'upsc' || isset($GLOBALS['UND_EXEC_MOCK'])) {
    $r = und_run([$upsc, strpos($name, '@') === false ? $name . '@localhost' : $name], 8);
    if ($r['code'] === 0 && preg_match('/battery\.charge:/', $r['out'])) {
      $k = [];
      foreach (explode("\n", $r['out']) as $l) if (strpos($l, ':') !== false) { list($a, $b) = explode(':', $l, 2); $k[trim($a)] = trim($b); }
      return ['source' => 'NUT', 'charge' => (float)($k['battery.charge'] ?? 0), 'load' => isset($k['ups.load']) ? (float)$k['ups.load'] : null,
              'status' => und_ups_status($k['ups.status'] ?? ''), 'runtime' => isset($k['battery.runtime']) ? (int)$k['battery.runtime'] : null, 'model' => (string)($k['ups.model'] ?? $k['device.model'] ?? '')];
    }
  }
  $apc = und_bin('apcaccess');
  if ($apc !== 'apcaccess' || isset($GLOBALS['UND_EXEC_MOCK'])) {
    $r = und_run([$apc], 8);
    if ($r['code'] === 0 && preg_match('/BCHARGE/', $r['out'])) {
      $k = [];
      foreach (explode("\n", $r['out']) as $l) if (strpos($l, ':') !== false) { list($a, $b) = explode(':', $l, 2); $k[trim($a)] = trim($b); }
      return ['source' => 'apcupsd', 'charge' => (float)($k['BCHARGE'] ?? 0), 'load' => isset($k['LOADPCT']) ? (float)$k['LOADPCT'] : null,
              'status' => ucfirst(strtolower((string)($k['STATUS'] ?? ''))), 'runtime' => isset($k['TIMELEFT']) ? (int)round((float)$k['TIMELEFT'] * 60) : null, 'model' => (string)($k['MODEL'] ?? '')];
    }
  }
  return null;
}

function und_ups_status($s) {
  $map = ['OL' => 'Online', 'OB' => 'On battery', 'LB' => 'Low battery', 'CHRG' => 'Charging', 'DISCHRG' => 'Discharging', 'BYPASS' => 'Bypass', 'OVER' => 'Overload', 'RB' => 'Replace battery'];
  $w = [];
  foreach (preg_split('/\s+/', trim($s)) as $t) if ($t !== '') $w[] = $map[$t] ?? $t;
  return implode(', ', $w);
}

/* ---------- Unraid OS update (the same unRAIDServer.plg flow Tools > Update OS uses) ---------- */

function und_os_cached() {
  $c = und_read_json(und_tmp('os.json'), []);
  $installed = und_os_version();
  $latest = (string)($c['latest'] ?? '');
  return ['installed' => $installed, 'latest' => $latest, 'checked' => (int)($c['checked'] ?? 0), 'error' => (string)($c['error'] ?? ''),
          'available' => $latest !== '' && $installed !== '' && version_compare(und_ver_norm($latest), und_ver_norm($installed), '>'),
          'staged' => und_os_staged(), 'job' => und_job(und_tmp('os-update.log'))['state']];
}

/** "7.2.0-rc.1" -> "7.2.0rc1" so version_compare orders prereleases before the release. */
function und_ver_norm($v) { return preg_replace('/[-.]?(rc|beta|alpha)[.-]?/i', '$1', (string)$v); }

/** A newer release that was installed on the flash drive and becomes active after a reboot. */
function und_os_staged() {
  $installed = und_os_version();
  foreach (['/boot/config/plugins/unRAIDServer.plg', '/var/log/plugins/unRAIDServer.plg'] as $p) {
    if (!preg_match('/<!ENTITY\s+version\s+"([^"]+)"/', und_read($p), $m)) continue;
    if ($installed !== '' && version_compare(und_ver_norm($m[1]), und_ver_norm($installed), '>')) return $m[1];
    return '';
  }
  return '';
}

function und_os_check() {
  if (und_api_mode()) return ['error' => 'Unraid OS updates are not available through the Unraid API; use Tools > Update OS in Unraid.'];
  $tmp = '/tmp/plugins/unRAIDServer.plg';
  @unlink($tmp);
  $r = und_run([und_bin('plugin'), 'check', 'unRAIDServer.plg'], 120);
  $out = ['checked' => time(), 'latest' => '', 'error' => ''];
  if ($r['code'] === 0 && is_file($tmp) && preg_match('/<!ENTITY\s+version\s+"([^"]+)"/', (string)@file_get_contents($tmp), $m) && preg_match('/^[0-9][A-Za-z0-9._+-]{0,30}$/', $m[1])) $out['latest'] = $m[1];
  elseif (preg_match('/^\s*([0-9][A-Za-z0-9._+-]{0,30})\s*$/m', $r['out'], $m)) $out['latest'] = $m[1];
  else $out['error'] = $r['timeout'] ? 'The update check timed out.' : (und_clip(trim($r['err'] . ' ' . $r['out']), 200) ?: 'The update server did not answer.');
  und_write_json(und_tmp('os.json'), $out);
  return und_os_cached();
}

/** Downloads and installs the newer release onto the flash drive. It becomes active after a reboot. */
function und_os_update() {
  if (und_api_mode()) return ['error' => 'Unraid OS updates are not available through the Unraid API; use Tools > Update OS in Unraid.'];
  $st = und_os_check();
  if (!$st['available']) return ['error' => $st['error'] ?: 'No newer Unraid release is available.'];
  if (und_job(und_tmp('os-update.log'))['state'] === 'running') return ['error' => 'An update is already running.'];
  und_spawn([und_bin('plugin'), 'update', 'unRAIDServer.plg'], und_tmp('os-update.log'));
  return ['ok' => true];
}
]]></INLINE>
<SHA256>48d3ba2a36b327ee9cbe1d5d0eaf9ae6946313c4c28076998de544fd3d090216</SHA256>
</FILE>

<FILE Name="&emhttp;/include/docker.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - Docker containers.
 *
 * Live status (every refresh) costs one `docker ps` plus two small cgroup files per running container: no `docker inspect`
 * and no `docker stats` (which takes ~2 s). The full inspect data (icons, WebUI, ports, restart count) is cached and only
 * re-read when a container appears, disappears or changes state, or after 5 minutes.
 * Updates use Unraid's own update_container script, so a container is recreated from its Unraid template exactly as the
 * Docker tab's "apply update" does.
 */

function und_docker_bin() { return und_bin('docker'); }

function und_valid_container($n) { return is_string($n) && preg_match('/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/', $n) === 1; }

/** id, name, state and health of every container: one cheap call. */
function und_docker_ps() {
  $r = und_run([und_docker_bin(), 'ps', '-a', '--no-trunc', '--format', '{{.ID}}|{{.Names}}|{{.State}}|{{.Status}}|{{.Image}}'], 15);
  if ($r['code'] !== 0) return ['error' => preg_match('/daemon|connect/i', $r['err']) ? 'Docker is not running.' : (und_clip(trim($r['err']), 200) ?: 'Docker is not available.')];
  $out = [];
  foreach (explode("\n", trim($r['out'])) as $l) {
    $c = explode('|', $l);
    if (count($c) < 5) continue;
    $health = preg_match('/\((healthy|unhealthy|health: starting)\)/', $c[3], $m) ? str_replace('health: ', '', $m[1]) : '';
    $out[$c[1]] = ['id' => $c[0], 'name' => $c[1], 'state' => $c[2], 'status' => $c[3], 'health' => $health, 'image' => $c[4]];
  }
  return ['ps' => $out];
}

/** Inspect data for every container, cached in /tmp/undash/inspect.json and keyed by the set of ids and states. */
function und_docker_details(array $ps, $force = false) {
  $f = und_tmp('inspect.json');
  $sig = md5(json_encode(array_map(function ($c) { return $c['id'] . $c['state']; }, $ps)));
  $c = und_read_json($f, []);
  if (!$force && ($c['sig'] ?? '') === $sig && time() - (int)($c['at'] ?? 0) < 300) return $c['d'];
  $ids = array_values(array_map(function ($x) { return $x['id']; }, $ps));
  $d = [];
  if ($ids) {
    $r = und_run(array_merge([und_docker_bin(), 'inspect'], $ids), 30, 16777216);
    $data = json_decode($r['out'], true);
    if (!is_array($data)) return $c['d'] ?? [];
    $ip = und_server_ip();
    $auto = array_flip(array_map(function ($l) { return trim(explode(' ', $l)[0]); }, explode("\n", und_read('/var/lib/docker/unraid-autostart'))));
    foreach ($data as $x) {
      $name = ltrim((string)($x['Name'] ?? ''), '/');
      $labels = isset($x['Config']['Labels']) && is_array($x['Config']['Labels']) ? $x['Config']['Labels'] : [];
      $ports = [];
      foreach ((array)($x['HostConfig']['PortBindings'] ?? []) as $cp => $binds) foreach ((array)$binds as $b) if (!empty($b['HostPort'])) $ports[(string)$cp] = (int)$b['HostPort'];
      $net = (string)($x['HostConfig']['NetworkMode'] ?? '');
      $cip = '';
      foreach ((array)($x['NetworkSettings']['Networks'] ?? []) as $n) if (!empty($n['IPAddress'])) { $cip = $n['IPAddress']; break; }
      $webui = (string)($labels['net.unraid.docker.webui'] ?? '');
      if ($webui !== '') {
        $own = !in_array($net, ['bridge', 'host', 'default', ''], true) && strpos($net, 'container:') !== 0 && $cip !== '';
        $webui = str_replace('[IP]', $own ? $cip : $ip, $webui);
        $webui = preg_replace_callback('/\[PORT:(\d+)\]/', function ($m) use ($ports, $own) {
          foreach ($ports as $cp => $hp) if ((int)$cp === (int)$m[1]) return (string)($own ? $m[1] : $hp);
          return $m[1];
        }, $webui);
      }
      $iconFile = '/usr/local/emhttp/state/plugins/dynamix.docker.manager/images/' . $name . '-icon.png';
      $d[$name] = ['icon' => is_file(und_path($iconFile)) ? '/state/plugins/dynamix.docker.manager/images/' . rawurlencode($name) . '-icon.png' : (string)($labels['net.unraid.docker.icon'] ?? ''),
        'webui' => preg_match('#^https?://#', $webui) ? $webui : '', 'network' => $net, 'ip' => $cip, 'ports' => $ports, 'autostart' => isset($auto[$name]),
        'managed' => ($labels['net.unraid.docker.managed'] ?? '') === 'dockerman', 'restarts' => (int)($x['RestartCount'] ?? 0),
        'started' => strtotime((string)($x['State']['StartedAt'] ?? '')) ?: null, 'exit' => (int)($x['State']['ExitCode'] ?? 0),
        'created' => strtotime((string)($x['Created'] ?? '')) ?: null, 'cfg_image' => (string)($x['Config']['Image'] ?? '')];
    }
  }
  und_write_json($f, ['sig' => $sig, 'at' => time(), 'd' => $d]);
  return $d;
}

/** CPU % (100% = one core, like `docker stats` and Unraid's Docker tab) and memory from cgroup v2, measured against the previous call. */
function und_docker_cgroup(array $ps) {
  $f = und_tmp('cg.json');
  $prev = und_read_json($f, []);
  $now = microtime(true); $cur = []; $out = [];
  foreach ($ps as $c) {
    if ($c['state'] !== 'running') continue;
    $base = null;
    foreach (['/sys/fs/cgroup/docker/' . $c['id'], '/sys/fs/cgroup/system.slice/docker-' . $c['id'] . '.scope'] as $b) if (is_dir(und_path($b))) { $base = $b; break; }
    if ($base === null) continue;
    $usage = preg_match('/^usage_usec (\d+)/m', und_read("$base/cpu.stat"), $m) ? (float)$m[1] : null;
    $mem = (float)trim(und_read("$base/memory.current"));
    $inactive = preg_match('/^inactive_file (\d+)/m', und_read("$base/memory.stat"), $m) ? (float)$m[1] : 0;
    $cur[$c['id']] = $usage;
    $cpu = null;
    if ($usage !== null && isset($prev['u'][$c['id']]) && $now > ($prev['t'] ?? 0)) $cpu = max(0, round(($usage - $prev['u'][$c['id']]) / (($now - $prev['t']) * 1e6) * 100, 1));
    $out[$c['name']] = ['cpu' => $cpu, 'mem' => max(0, $mem - $inactive)];
  }
  // several browsers polling at once must not shrink the window to nothing: keep the older sample if it is very recent
  if ($now - ($prev['t'] ?? 0) >= 1) und_write_json($f, ['t' => $now, 'u' => $cur]);
  return $out;
}

/** Update state per container from Unraid's own status file: available | current | unknown (never checked or not an Unraid template). */
function und_docker_updates() {
  return und_read_json(und_path(UND_UPDSTATUS), []);
}
function und_docker_update_state(array $upd, $image) {
  $key = und_has(basename($image), ':') || und_has($image, '@') ? $image : $image . ':latest';
  $u = $upd[$key] ?? null;
  if (!is_array($u)) return 'unknown';
  $s = (string)($u['status'] ?? '');
  return $s === 'false' ? 'available' : ($s === 'true' ? 'current' : 'unknown');
}

/** Everything the dashboard shows about containers. Cheap enough for every refresh. */
function und_docker_live($withDetails = true) {
  if (und_api_mode()) return und_api_docker_live();
  $ps = und_docker_ps();
  if (isset($ps['error'])) return $ps;
  $ps = $ps['ps'];
  $det = $withDetails ? und_docker_details($ps) : [];
  $cg = und_docker_cgroup($ps);
  $upd = und_docker_updates();
  $out = [];
  foreach ($ps as $name => $c) {
    $d = $det[$name] ?? [];
    $job = und_job(und_tmp('docker-update-' . $name . '.log'));
    $image = $d['cfg_image'] ?? $c['image'];
    $out[] = ['name' => $name, 'id' => substr($c['id'], 0, 12), 'image' => $image, 'state' => $c['state'], 'status' => $c['status'], 'health' => $c['health'],
      'cpu' => $cg[$name]['cpu'] ?? null, 'mem' => $cg[$name]['mem'] ?? null, 'update' => und_docker_update_state($upd, $image),
      'icon' => $d['icon'] ?? '', 'webui' => $d['webui'] ?? '', 'ports' => (object)($d['ports'] ?? []), 'network' => $d['network'] ?? '', 'autostart' => !empty($d['autostart']),
      'managed' => !empty($d['managed']), 'restarts' => $d['restarts'] ?? null, 'started' => $d['started'] ?? null, 'exit' => $d['exit'] ?? null,
      'job' => $job['state'] === 'running' ? 'updating' : ($job['state'] === 'done' && time() - (int)$job['at'] < 600 ? ($job['code'] === 0 ? 'updated' : 'update_failed') : '')];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  $chk = und_job(und_tmp('docker-check.log'));
  return ['containers' => $out, 'checking' => $chk['state'] === 'running', 'checked' => is_file(und_path(UND_UPDSTATUS)) ? (int)@filemtime(und_path(UND_UPDSTATUS)) : null];
}

/** Older callers (summary widget). */
function und_docker_list() { return und_docker_live(); }

function und_docker_action($name, $op) {
  if (!und_valid_container($name)) return ['error' => 'Invalid container name.'];
  if (und_api_mode()) return und_api_docker_action($name, $op);
  $ps = und_docker_ps();
  if (isset($ps['error'])) return $ps;
  if (!isset($ps['ps'][$name])) return ['error' => 'There is no container named ' . $name . '.'];
  $state = $ps['ps'][$name]['state'];
  $valid = ['start' => ['exited', 'created', 'dead'], 'stop' => ['running', 'restarting', 'paused'], 'restart' => ['running', 'exited', 'created', 'restarting'],
            'pause' => ['running'], 'unpause' => ['paused'], 'update' => null];
  if (!array_key_exists($op, $valid)) return ['error' => 'Unknown action.'];
  if ($valid[$op] !== null && !in_array($state, $valid[$op], true)) return ['error' => ucfirst($op) . ' is not possible while ' . $name . ' is ' . $state . '.'];
  $lock = und_lock('docker:' . $name);
  if (!$lock) return ['error' => 'Another action on ' . $name . ' is still running.'];
  if ($op === 'update') {
    $log = und_tmp('docker-update-' . $name . '.log');
    if (und_job($log)['state'] === 'running') { und_unlock($lock); return ['error' => 'An update of ' . $name . ' is already running.']; }
    und_spawn([UND_DM . '/scripts/update_container', $name], $log);
    und_history_add('docker', $name, 'update', true, 'started');
    und_unlock($lock);
    return ['ok' => true, 'job' => 'running'];
  }
  $r = und_run([und_docker_bin(), $op, $name], 120);
  und_unlock($lock);
  @unlink(und_tmp('inspect.json'));
  $ok = $r['code'] === 0;
  $msg = $ok ? '' : (und_clip(trim(preg_replace('/^Error response from daemon:\s*/i', '', $r['err'] . ' ' . $r['out'])), 300) ?: 'docker ' . $op . ' failed');
  und_history_add('docker', $name, $op, $ok, $msg);
  return $ok ? ['ok' => true] : ['error' => $msg];
}

/** Starts Unraid's own update check for every container (the "check for updates" button of the Docker tab). */
function und_docker_check() {
  if (und_api_mode()) return ['error' => 'Unraid checks container updates on its own schedule; the API has no "check now".'];
  $log = und_tmp('docker-check.log');
  if (und_job($log)['state'] === 'running') return ['ok' => true, 'job' => 'running'];
  und_spawn([UND_DM . '/scripts/dockerupdate', 'check', 'nonotify'], $log);
  und_history_add('docker', 'all containers', 'check', true, 'update check started');
  return ['ok' => true, 'job' => 'running'];
}

/** Record how an update finished (called when the UI sees the job end). */
function und_docker_job($name) {
  $log = und_tmp('docker-update-' . $name . '.log');
  $j = und_job($log);
  if ($j['state'] === 'done' && !is_file($log . '.recorded')) {
    @touch($log . '.recorded');
    @unlink(und_tmp('inspect.json'));
    $ok = $j['code'] === 0 && !preg_match('/\b(error|failed|denied)\b/i', $j['out']);
    und_history_add('docker', $name, 'update', $ok, $ok ? 'finished' : und_clip(trim(substr($j['out'], -300)), 300));
    $j['ok'] = $ok;
  } elseif ($j['state'] === 'done') $j['ok'] = $j['code'] === 0 && !preg_match('/\b(error|failed|denied)\b/i', $j['out']);
  return $j;
}

/** The last N lines of stdout and stderr, merged in time order. */
function und_docker_logs($name, $lines = 300) {
  if (!und_valid_container($name)) return ['error' => 'Invalid container name.'];
  if (und_api_mode()) return und_api_docker_logs($name, $lines);
  $lines = max(10, min(5000, (int)$lines));
  $r = und_run([und_docker_bin(), 'logs', '--tail', (string)$lines, '--timestamps', $name], 20, 8388608);
  if ($r['code'] !== 0 && $r['out'] === '' && $r['err'] === '') return ['error' => 'Could not read the log.'];
  if ($r['code'] !== 0 && preg_match('/No such container/i', $r['err'])) return ['error' => 'There is no container named ' . $name . '.'];
  $all = array_merge(explode("\n", rtrim($r['out'])), explode("\n", rtrim($r['err'])));
  $all = array_values(array_filter($all, function ($l) { return $l !== ''; }));
  usort($all, function ($a, $b) { return strcmp(substr($a, 0, 30), substr($b, 0, 30)); });
  $all = array_slice($all, -$lines);
  $text = implode("\n", array_map(function ($l) { return preg_replace('/^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)\.\d+Z /', '$1 ', $l); }, $all));
  return ['log' => preg_replace('/\x1b\[[0-9;]*[A-Za-z]/', '', $text)];
}

/**
 * Diagnostic details for one container. Environment variables are listed by name only (their values are often passwords),
 * labels are limited to Unraid's and OCI's descriptive ones.
 */
function und_docker_inspect($name) {
  if (!und_valid_container($name)) return ['error' => 'Invalid container name.'];
  if (und_api_mode()) return und_api_docker_inspect($name);
  $r = und_run([und_docker_bin(), 'inspect', $name], 15, 4194304);
  $j = json_decode($r['out'], true);
  if (!is_array($j) || !isset($j[0])) return ['error' => 'There is no container named ' . $name . '.'];
  $x = $j[0];
  $mounts = [];
  foreach ((array)($x['Mounts'] ?? []) as $m) $mounts[] = ['src' => (string)($m['Source'] ?? ''), 'dst' => (string)($m['Destination'] ?? ''), 'rw' => !empty($m['RW'])];
  $nets = [];
  foreach ((array)($x['NetworkSettings']['Networks'] ?? []) as $n => $v) $nets[] = ['name' => $n, 'ip' => (string)($v['IPAddress'] ?? '')];
  $ports = [];
  foreach ((array)($x['HostConfig']['PortBindings'] ?? []) as $cp => $binds) foreach ((array)$binds as $b) $ports[] = ($b['HostIp'] ?? '') . ':' . ($b['HostPort'] ?? '') . ' → ' . $cp;
  $env = [];
  foreach ((array)($x['Config']['Env'] ?? []) as $e) $env[] = explode('=', (string)$e, 2)[0];
  $health = [];
  foreach (array_slice((array)($x['State']['Health']['Log'] ?? []), -3) as $hl) $health[] = ['at' => strtotime((string)($hl['End'] ?? '')) ?: null, 'code' => (int)($hl['ExitCode'] ?? 0), 'out' => und_clip(und_redact(trim((string)($hl['Output'] ?? ''))), 400)];
  $labels = [];
  foreach ((array)($x['Config']['Labels'] ?? []) as $k => $v) if (preg_match('/^(net\.unraid\.docker\.(managed|webui|icon|shell)|org\.opencontainers\.image\.(version|source|title|description|url|created))$/', $k)) $labels[$k] = und_clip((string)$v, 300);
  return ['name' => $name, 'id' => substr((string)$x['Id'], 0, 12), 'image' => (string)($x['Config']['Image'] ?? ''), 'image_id' => substr(str_replace('sha256:', '', (string)($x['Image'] ?? '')), 0, 12),
    'created' => strtotime((string)($x['Created'] ?? '')) ?: null, 'state' => (string)($x['State']['Status'] ?? ''), 'started' => strtotime((string)($x['State']['StartedAt'] ?? '')) ?: null,
    'finished' => strtotime((string)($x['State']['FinishedAt'] ?? '')) ?: null, 'exit' => (int)($x['State']['ExitCode'] ?? 0), 'state_error' => (string)($x['State']['Error'] ?? ''),
    'oom' => !empty($x['State']['OOMKilled']), 'restarts' => (int)($x['RestartCount'] ?? 0), 'restart_policy' => (string)($x['HostConfig']['RestartPolicy']['Name'] ?? ''),
    'network_mode' => (string)($x['HostConfig']['NetworkMode'] ?? ''), 'networks' => $nets, 'ports' => $ports, 'mounts' => $mounts, 'env' => $env, 'labels' => (object)$labels, 'health' => $health,
    'privileged' => !empty($x['HostConfig']['Privileged'])];
}

function und_docker_summary() {
  $l = und_docker_live(false);
  if (isset($l['error'])) return $l;
  $s = ['running' => 0, 'stopped' => 0, 'paused' => 0, 'updates' => 0, 'unhealthy' => 0, 'total' => count($l['containers'])];
  foreach ($l['containers'] as $c) {
    if ($c['state'] === 'running') $s['running']++; elseif ($c['state'] === 'paused') $s['paused']++; else $s['stopped']++;
    if ($c['update'] === 'available') $s['updates']++;
    if ($c['health'] === 'unhealthy') $s['unhealthy']++;
  }
  return $s;
}
]]></INLINE>
<SHA256>730ed0b9f7b4e46dbaf2a846171469ec681eed5738b7828de7baaa6e8f15839d</SHA256>
</FILE>

<FILE Name="&emhttp;/include/vm.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - virtual machines through libvirt's virsh, the same backend Unraid's VMs tab uses.
 * Live status is one `virsh list --all`; the details (vCPUs, memory, icon, VNC port, guest agent) are cached and re-read
 * only when the set of VMs or a VM's state changes, or after 10 minutes.
 * Hibernate is "dompmsuspend <vm> disk", which needs the QEMU guest agent running inside the VM (as on the VMs tab).
 */

function und_virsh() { return und_bin('virsh'); }

function und_valid_vm($n) { return is_string($n) && $n !== '' && strlen($n) <= 200 && !preg_match('/[\x00-\x1f\/]/', $n); }

/** name => state ("running", "shut off", "paused", "pmsuspended", "in shutdown", "crashed"). Null when libvirt is not running. */
function und_vm_states() {
  if (und_api_mode()) { $l = und_api_vm_live(); if (isset($l['error'])) return null; $o = []; foreach ($l['vms'] as $v) $o[$v['name']] = $v['state']; return $o; }
  $r = und_run([und_virsh(), 'list', '--all'], 10);
  if ($r['code'] !== 0) return null;
  $out = [];
  foreach (array_slice(explode("\n", trim($r['out'])), 2) as $l) {
    if (!preg_match('/^\s*(\d+|-)\s+(.+?)\s{2,}(\S.*?)\s*$/', $l, $m)) continue;
    $out[$m[2]] = strtolower($m[3]);
  }
  return $out;
}

function und_vm_details(array $states) {
  $f = und_tmp('vminfo.json');
  $sig = md5(json_encode($states));
  $c = und_read_json($f, []);
  if (($c['sig'] ?? '') === $sig && time() - (int)($c['at'] ?? 0) < 600) return $c['d'];
  $d = [];
  foreach ($states as $name => $st) {
    $info = [];
    foreach (explode("\n", und_run([und_virsh(), 'dominfo', $name], 10)['out']) as $l) if (strpos($l, ':') !== false) { list($k, $v) = explode(':', $l, 2); $info[trim($k)] = trim($v); }
    $xml = und_run([und_virsh(), 'dumpxml', $name], 10)['out'];
    $icon = preg_match('/<vmtemplate[^>]*\sicon=[\'"]([^\'"]+)[\'"]/', $xml, $m) ? $m[1] : '';
    $ws = preg_match('/<graphics[^>]*type=[\'"]vnc[\'"][^>]*websocket=[\'"](\d+)[\'"]/', $xml, $m) || preg_match('/<graphics[^>]*websocket=[\'"](\d+)[\'"][^>]*type=[\'"]vnc[\'"]/', $xml, $m) ? (int)$m[1] : 0;
    $d[$name] = ['cpus' => (int)($info['CPU(s)'] ?? 0), 'memory' => (float)preg_replace('/[^0-9]/', '', (string)($info['Max memory'] ?? '0')) * 1024,
      'autostart' => ($info['Autostart'] ?? '') === 'enable', 'os' => preg_match('/<vmtemplate[^>]*\sos=[\'"]([^\'"]+)[\'"]/', $xml, $m) ? $m[1] : '',
      'icon' => preg_match('/^[A-Za-z0-9_.-]+\.(png|svg)$/', $icon) ? '/plugins/dynamix.vm.manager/templates/images/' . $icon : '',
      'vnc' => $ws > 0 ? '/wsproxy/' . $ws . '/' : '', 'agent' => und_has($xml, 'org.qemu.guest_agent')];
  }
  und_write_json($f, ['sig' => $sig, 'at' => time(), 'd' => $d]);
  return $d;
}

/** Which actions make sense in a state; the UI shows only these and the server refuses the rest. */
function und_vm_valid_ops($state, $agent) {
  switch ($state) {
    case 'running': return array_values(array_filter(['stop', 'kill', 'restart', 'pause', $agent ? 'hibernate' : null]));
    case 'paused': return ['resume', 'kill'];
    case 'pmsuspended': return ['resume', 'kill'];
    case 'in shutdown': return ['kill'];
    case 'shut off': case 'crashed': return ['start'];
  }
  return [];
}

function und_vm_live() {
  if (und_api_mode()) return und_api_vm_live();
  $st = und_vm_states();
  if ($st === null) return ['error' => 'The VM service is not running.'];
  $det = und_vm_details($st);
  $out = [];
  foreach ($st as $name => $state) {
    $d = $det[$name] ?? ['cpus' => 0, 'memory' => 0, 'autostart' => false, 'os' => '', 'icon' => '', 'vnc' => '', 'agent' => false];
    $out[] = ['name' => $name, 'state' => $state, 'ops' => und_vm_valid_ops($state, $d['agent'])] + $d;
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return ['vms' => $out];
}

function und_vm_list() { return und_vm_live(); }

function und_vm_action($name, $op) {
  if (!und_valid_vm($name)) return ['error' => 'Invalid VM name.'];
  if (und_api_mode()) return und_api_vm_action($name, $op);
  $st = und_vm_states();
  if ($st === null) return ['error' => 'The VM service is not running.'];
  if (!isset($st[$name])) return ['error' => 'There is no VM named ' . $name . '.'];
  $state = $st[$name];
  $det = und_vm_details($st)[$name] ?? ['agent' => false];
  if (!in_array($op, und_vm_valid_ops($state, !empty($det['agent'])), true)) return ['error' => ucfirst($op) . ' is not possible while ' . $name . ' is ' . $state . '.'];
  $map = ['start' => 'start', 'stop' => 'shutdown', 'kill' => 'destroy', 'restart' => 'reboot', 'pause' => 'suspend', 'resume' => $state === 'pmsuspended' ? 'dompmwakeup' : 'resume', 'hibernate' => 'dompmsuspend'];
  $argv = [und_virsh(), $map[$op], $name];
  if ($op === 'hibernate') $argv[] = 'disk';
  $lock = und_lock('vm:' . $name);
  if (!$lock) return ['error' => 'Another action on ' . $name . ' is still running.'];
  $r = und_run($argv, 90);
  und_unlock($lock);
  @unlink(und_tmp('vminfo.json'));
  $ok = $r['code'] === 0;
  $err = $ok ? '' : und_clip(trim(preg_replace('/^error:\s*/im', '', $r['err'] . ' ' . $r['out'])), 300);
  if (!$ok && $op === 'hibernate' && preg_match('/agent/i', $err)) $err = 'Hibernate needs the QEMU guest agent running inside the VM. ' . $err;
  und_history_add('vm', $name, $op, $ok, $err);
  return $ok ? ['ok' => true] : ['error' => $err ?: 'virsh ' . $map[$op] . ' failed'];
}

function und_vm_summary() {
  $l = und_vm_live();
  if (isset($l['error'])) return $l;
  $s = ['running' => 0, 'stopped' => 0, 'paused' => 0, 'total' => count($l['vms'])];
  foreach ($l['vms'] as $v) {
    if ($v['state'] === 'running') $s['running']++; elseif (in_array($v['state'], ['paused', 'pmsuspended'], true)) $s['paused']++; else $s['stopped']++;
  }
  return $s;
}
]]></INLINE>
<SHA256>d6379d3477d36740161d8fbf4515c33ff6283423cf33a3cf386528e2e422afa2</SHA256>
</FILE>

<FILE Name="&emhttp;/include/services.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - service widgets. Each fetcher talks to one app's API from the server (credentials never reach the browser)
 * and returns one of these shapes, which the UI renders the same way for every app:
 *   ['blocks' => [['key','label','value','fmt'], ...]]           fmt: n | bytes | rate | ms | pct | text
 *   ['list'   => [['title','sub','right','ts'], ...]]             ts: unix time shown as a relative date
 *   ['calendar' => [['ts','title','sub','done'], ...]]
 *   ['streams' => [['title','user','state','pos','dur'], ...]]   (can be combined with blocks)
 *   ['error' => 'message']
 * The endpoints and the numbers they produce follow gethomepage/homepage's widgets, so the cards show what Homepage showed.
 */

/* ---------- HTTP ---------- */

function und_http($method, $url, array $o = []) {
  if (isset($GLOBALS['UND_HTTP_MOCK'])) { $r = call_user_func($GLOBALS['UND_HTTP_MOCK'], $method, $url, $o); if (is_array($r)) return $r; }
  if (!preg_match('#^https?://#i', $url)) return ['code' => 0, 'body' => '', 'json' => null, 'err' => 'The URL must start with http:// or https://', 'headers' => []];
  $ch = curl_init($url);
  $headers = [];
  foreach (($o['headers'] ?? []) as $k => $v) $headers[] = $k . ': ' . $v;
  $resp = [];
  curl_setopt_array($ch, [
    CURLOPT_CUSTOMREQUEST => $method, CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => true, CURLOPT_MAXREDIRS => 3,
    CURLOPT_CONNECTTIMEOUT => 4, CURLOPT_TIMEOUT => (int)($o['timeout'] ?? 10), CURLOPT_HTTPHEADER => $headers,
    CURLOPT_SSL_VERIFYPEER => false, CURLOPT_SSL_VERIFYHOST => 0,     // LAN apps mostly use self-signed certificates
    CURLOPT_USERAGENT => 'UnDash/' . UND_VERSION, CURLOPT_ENCODING => '',
    CURLOPT_HEADERFUNCTION => function ($c, $h) use (&$resp) { $p = explode(':', $h, 2); if (count($p) === 2) $resp[strtolower(trim($p[0]))][] = trim($p[1]); return strlen($h); },
  ]);
  if (isset($o['body'])) curl_setopt($ch, CURLOPT_POSTFIELDS, $o['body']);
  if (isset($o['basic'])) curl_setopt($ch, CURLOPT_USERPWD, $o['basic'][0] . ':' . $o['basic'][1]);
  if (isset($o['cookie'])) curl_setopt($ch, CURLOPT_COOKIE, $o['cookie']);
  $body = curl_exec($ch);
  $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
  $err = $body === false ? curl_error($ch) : '';
  curl_close($ch);
  $body = $body === false ? '' : $body;
  return ['code' => $code, 'body' => $body, 'json' => json_decode($body, true), 'err' => $err, 'headers' => $resp];
}

/** GET returning decoded JSON, or throws with a readable message. */
function und_get($url, array $o = []) {
  $r = und_http($o['method'] ?? 'GET', $url, $o);
  if ($r['err'] !== '') throw new Exception(und_redact($r['err']));
  if ($r['code'] === 401 || $r['code'] === 403) throw new Exception('Not authorised (HTTP ' . $r['code'] . '): check the API key or login.');
  if ($r['code'] >= 400 || $r['code'] === 0) throw new Exception('HTTP ' . $r['code'] . ' from ' . und_redact(preg_replace('#\?.*$#', '', $url)));
  if (!empty($o['raw'])) return $r;
  if ($r['json'] === null && trim($r['body']) !== 'null') throw new Exception('The answer was not JSON (is the URL right?).');
  return $r['json'];
}

function und_u($base, $path) { return rtrim($base, '/') . '/' . ltrim($path, '/'); }
function und_b($key, $label, $value, $fmt = 'n') { return ['key' => $key, 'label' => $label, 'value' => $value, 'fmt' => $fmt]; }

/* ---------- dispatcher ---------- */

function und_fetch_service(array $cfg, $id) {
  $s = und_service_full($cfg, $id);
  if (!$s) return ['error' => 'Unknown widget.'];
  $fn = 'und_w_' . $s['type'];
  if (!function_exists($fn)) return ['error' => 'No data for this widget type.'];
  $types = und_types();
  if (!empty($types[$s['type']][2]) && trim($s['url']) === '') return ['error' => 'Not configured: set the URL in Settings.', 'unconfigured' => true];
  if (und_has($s['url'], '{{')) return ['error' => 'Unknown variable in the URL: ' . und_clip($s['url'], 120), 'unconfigured' => true];
  try {
    $r = call_user_func($fn, $s, $cfg);
  } catch (Throwable $e) {
    return ['error' => und_redact($e->getMessage(), [$s['key'] ?? '', $s['password'] ?? ''])];
  }
  if (isset($r['blocks']) && $s['fields']) {
    $want = array_flip(array_map('strtolower', $s['fields']));
    $keep = array_values(array_filter($r['blocks'], function ($b) use ($want) { return isset($want[strtolower($b['key'])]); }));
    if ($keep) {
      $order = array_map('strtolower', $s['fields']);
      usort($keep, function ($a, $b) use ($order) { return array_search(strtolower($a['key']), $order) - array_search(strtolower($b['key']), $order); });
      $r['blocks'] = $keep;
    }
  }
  return $r;
}

/* ---------- native widgets ---------- */

function und_w_docker_summary($s) { $r = und_docker_summary(); if (isset($r['error'])) throw new Exception($r['error']);
  return ['blocks' => [und_b('running', 'Running', $r['running']), und_b('stopped', 'Stopped', $r['stopped']), und_b('paused', 'Paused', $r['paused']), und_b('updates', 'Updates', $r['updates'])], 'link' => 'docker']; }
function und_w_vm_summary($s) { $r = und_vm_summary(); if (isset($r['error'])) throw new Exception($r['error']);
  return ['blocks' => [und_b('running', 'Running', $r['running']), und_b('stopped', 'Stopped', $r['stopped']), und_b('paused', 'Paused', $r['paused']), und_b('total', 'Total', $r['total'])], 'link' => 'vms']; }
function und_w_ups($s, $cfg) {
  $u = und_ups($s['options']['ups'] ?? $cfg['general']['ups_name']);
  if (!$u) throw new Exception('No UPS found (NUT or apcupsd).');
  $b = [und_b('battery_charge', 'Battery charge', $u['charge'], 'pct')];
  if ($u['load'] !== null) $b[] = und_b('ups_load', 'UPS load', $u['load'], 'pct');
  $b[] = und_b('ups_status', 'UPS status', $u['status'], 'text');
  if ($u['runtime'] !== null) $b[] = und_b('runtime', 'Runtime', $u['runtime'], 'dur');
  return ['blocks' => $b];
}
function und_w_storage() {
  $st = und_storage(); $sum = function ($rows) { $t = 0; $f = 0; foreach ($rows as $r) { $t += $r['size']; $f += $r['free']; } return [$t, $f]; };
  list($t, $f) = $sum($st['array']);
  $list = [];
  if ($t > 0) $list[] = ['title' => 'Array', 'sub' => count($st['array']) . ' disks' . ($st['parity'] ? ' + ' . count($st['parity']) . ' parity' : ''), 'used' => $t - $f, 'size' => $t];
  foreach ($st['pools'] as $p) $list[] = ['title' => ucfirst($p['name']), 'sub' => $p['fs'], 'used' => $p['size'] - $p['free'], 'size' => $p['size']];
  return ['bars' => $list];
}
// system_info / cpu / memory are drawn from the system poll in the browser; they need no fetch.
function und_w_system_info() { return ['native' => true]; }
function und_w_cpu() { return ['native' => true]; }
function und_w_memory() { return ['native' => true]; }
function und_w_link() { return ['native' => true]; }

/* ---------- *arr ---------- */

function und_arr_h($s) { return ['headers' => ['X-Api-Key' => $s['key'], 'Accept' => 'application/json']]; }

function und_w_radarr($s) {
  $movies = und_get(und_u($s['url'], '/api/v3/movie'), und_arr_h($s) + ['timeout' => 20]);
  $q = und_get(und_u($s['url'], '/api/v3/queue/status'), und_arr_h($s));
  $wanted = $missing = 0;
  foreach ((array)$movies as $m) if (!empty($m['monitored']) && empty($m['hasFile'])) { $missing++; if (!empty($m['isAvailable'])) $wanted++; }
  return ['blocks' => [und_b('wanted', 'Wanted', $wanted), und_b('missing', 'Missing', $missing), und_b('queued', 'Queued', (int)($q['totalCount'] ?? 0)), und_b('movies', 'Movies', count((array)$movies))]];
}

function und_w_sonarr($s) {
  $w = und_get(und_u($s['url'], '/api/v3/wanted/missing?pageSize=1'), und_arr_h($s));
  $q = und_get(und_u($s['url'], '/api/v3/queue?pageSize=1&includeUnknownSeriesItems=false'), und_arr_h($s));
  $series = und_get(und_u($s['url'], '/api/v3/series'), und_arr_h($s) + ['timeout' => 20]);
  return ['blocks' => [und_b('wanted', 'Wanted', (int)($w['totalRecords'] ?? 0)), und_b('queued', 'Queued', (int)($q['totalRecords'] ?? 0)), und_b('series', 'Series', count((array)$series))]];
}

function und_w_lidarr($s) {
  $w = und_get(und_u($s['url'], '/api/v1/wanted/missing?pageSize=1'), und_arr_h($s));
  $q = und_get(und_u($s['url'], '/api/v1/queue/status'), und_arr_h($s));
  $a = und_get(und_u($s['url'], '/api/v1/artist'), und_arr_h($s) + ['timeout' => 20]);
  return ['blocks' => [und_b('wanted', 'Wanted', (int)($w['totalRecords'] ?? 0)), und_b('queued', 'Queued', (int)($q['totalCount'] ?? 0)), und_b('artists', 'Artists', count((array)$a))]];
}

function und_w_readarr($s) {
  $w = und_get(und_u($s['url'], '/api/v1/wanted/missing?pageSize=1'), und_arr_h($s));
  $q = und_get(und_u($s['url'], '/api/v1/queue/status'), und_arr_h($s));
  $b = und_get(und_u($s['url'], '/api/v1/book'), und_arr_h($s) + ['timeout' => 20]);
  return ['blocks' => [und_b('wanted', 'Wanted', (int)($w['totalRecords'] ?? 0)), und_b('queued', 'Queued', (int)($q['totalCount'] ?? 0)), und_b('books', 'Books', count((array)$b))]];
}

function und_w_bazarr($s) {
  $b = und_get(und_u($s['url'], '/api/badges?apikey=' . rawurlencode($s['key'])), ['headers' => ['X-API-KEY' => $s['key']]]);
  return ['blocks' => [und_b('missingEpisodes', 'Missing episodes', (int)($b['episodes'] ?? 0)), und_b('missingMovies', 'Missing movies', (int)($b['movies'] ?? 0))]];
}

function und_w_prowlarr($s) {
  $st = und_get(und_u($s['url'], '/api/v1/indexerstats'), und_arr_h($s));
  $t = ['g' => 0, 'q' => 0, 'fg' => 0, 'fq' => 0];
  foreach ((array)($st['indexers'] ?? []) as $i) { $t['g'] += (int)($i['numberOfGrabs'] ?? 0); $t['q'] += (int)($i['numberOfQueries'] ?? 0); $t['fg'] += (int)($i['numberOfFailedGrabs'] ?? 0); $t['fq'] += (int)($i['numberOfFailedQueries'] ?? 0); }
  return ['blocks' => [und_b('numberOfGrabs', 'Grabs', $t['g']), und_b('numberOfQueries', 'Queries', $t['q']), und_b('numberOfFailGrabs', 'Fail grabs', $t['fg']), und_b('numberOfFailQueries', 'Fail queries', $t['fq'])]];
}

function und_w_overseerr($s) {
  $c = und_get(und_u($s['url'], '/api/v1/request/count'), und_arr_h($s));
  $b = [und_b('pending', 'Pending', (int)($c['pending'] ?? 0)), und_b('approved', 'Approved', (int)($c['approved'] ?? 0)), und_b('processing', 'Processing', (int)($c['processing'] ?? 0))];
  if (isset($c['completed'])) $b[] = und_b('completed', 'Completed', (int)$c['completed']);
  $b[] = und_b('available', 'Available', (int)($c['available'] ?? 0));
  if (!$s['fields']) $b = array_values(array_filter($b, function ($x) use ($c) { return $x['key'] !== 'processing' && !($x['key'] === 'available' && isset($c['completed'])); }));
  return ['blocks' => $b];
}

function und_w_autobrr($s) {
  $h = ['headers' => ['X-API-Token' => $s['key']]];
  $st = und_get(und_u($s['url'], '/api/release/stats'), $h);
  $f = und_get(und_u($s['url'], '/api/filters'), $h);
  $i = und_get(und_u($s['url'], '/api/release/indexers'), $h);
  return ['blocks' => [und_b('approvedPushes', 'Approved', (int)($st['push_approved_count'] ?? 0)), und_b('rejectedPushes', 'Rejected', (int)($st['push_rejected_count'] ?? 0)),
                       und_b('filters', 'Filters', count((array)$f)), und_b('indexers', 'Indexers', count((array)$i))]];
}

function und_w_wizarr($s) {
  $j = und_get(und_u($s['url'], '/api/status'), ['headers' => ['X-API-Key' => $s['key']]]);
  return ['blocks' => [und_b('users', 'Users', (int)($j['users'] ?? 0)), und_b('invites', 'Invites', (int)($j['invites'] ?? 0)), und_b('pending', 'Pending', (int)($j['pending'] ?? 0)), und_b('expired', 'Expired', (int)($j['expired'] ?? 0))]];
}

/* ---------- downloaders ---------- */

function und_w_qbittorrent($s) {
  $cf = und_tmp('qbit-' . $s['id'] . '.sid');
  $login = function () use ($s, $cf) {
    $r = und_http('POST', und_u($s['url'], '/api/v2/auth/login'), ['body' => http_build_query(['username' => $s['username'], 'password' => $s['password']]),
      'headers' => ['Referer' => rtrim($s['url'], '/'), 'Content-Type' => 'application/x-www-form-urlencoded']]);
    if ($r['err'] !== '') throw new Exception($r['err']);
    $sid = '';
    foreach (($r['headers']['set-cookie'] ?? []) as $c) if (preg_match('/^(SID|QBT_SID_\d+)=([^;]+)/', $c, $m)) $sid = $m[1] . '=' . $m[2];
    if ($sid === '' && trim($r['body']) !== 'Ok.') throw new Exception('qBittorrent login failed (HTTP ' . $r['code'] . ').');
    @file_put_contents($cf, $sid); @chmod($cf, 0600);
    return $sid;
  };
  $sid = is_file($cf) ? (string)@file_get_contents($cf) : $login();
  $r = und_http('GET', und_u($s['url'], '/api/v2/torrents/info'), ['cookie' => $sid, 'timeout' => 20]);
  if ($r['code'] === 403) { $sid = $login(); $r = und_http('GET', und_u($s['url'], '/api/v2/torrents/info'), ['cookie' => $sid, 'timeout' => 20]); }
  if ($r['err'] !== '' || !is_array($r['json'])) throw new Exception($r['err'] ?: 'qBittorrent did not answer (HTTP ' . $r['code'] . ').');
  $leech = $seed = 0; $dl = $ul = 0;
  foreach ($r['json'] as $t) { $dl += (float)($t['dlspeed'] ?? 0); $ul += (float)($t['upspeed'] ?? 0); if ((float)($t['progress'] ?? 0) < 1) $leech++; else $seed++; }
  return ['blocks' => [und_b('leech', 'Leech', $leech), und_b('download', 'Download', $dl, 'rate'), und_b('seed', 'Seed', $seed), und_b('upload', 'Upload', $ul, 'rate')]];
}

function und_w_sabnzbd($s) {
  $j = und_get(und_u($s['url'], '/api?output=json&mode=queue&apikey=' . rawurlencode($s['key'])));
  if (isset($j['error'])) throw new Exception('SABnzbd: ' . $j['error']);
  $q = $j['queue'] ?? [];
  return ['blocks' => [und_b('rate', 'Rate', (float)($q['kbpersec'] ?? 0) * 1024, 'rate'), und_b('queue', 'Queue', (int)($q['noofslots'] ?? 0)), und_b('timeleft', 'Time left', (string)($q['timeleft'] ?? '0:00:00'), 'text')]];
}

/* ---------- media servers ---------- */

function und_w_emby($s) { return und_emby_like($s, '/emby'); }
function und_w_jellyfin($s) { return und_emby_like($s, ''); }
function und_emby_like($s, $pre) {
  $base = rtrim($s['url'], '/');
  if ($pre !== '' && und_ends($base, $pre)) $pre = '';
  $h = ['headers' => ['X-Emby-Token' => $s['key'], 'Accept' => 'application/json']];
  $c = und_get($base . $pre . '/Items/Counts', $h);
  $sess = und_get($base . $pre . '/Sessions', $h);
  $streams = [];
  foreach ((array)$sess as $x) {
    if (empty($x['NowPlayingItem'])) continue;
    $n = $x['NowPlayingItem'];
    $t = !empty($n['SeriesName']) ? $n['SeriesName'] . ': S' . sprintf('%02d', (int)($n['ParentIndexNumber'] ?? 0)) . ' · E' . sprintf('%02d', (int)($n['IndexNumber'] ?? 0)) . ' - ' . ($n['Name'] ?? '') : (string)($n['Name'] ?? '');
    $streams[] = ['title' => $t, 'user' => (string)($x['UserName'] ?? ''), 'state' => !empty($x['PlayState']['IsPaused']) ? 'paused' : 'playing',
                  'pos' => (int)(($x['PlayState']['PositionTicks'] ?? 0) / 10000000), 'dur' => (int)(($n['RunTimeTicks'] ?? 0) / 10000000)];
  }
  $b = [und_b('movies', 'Movies', (int)($c['MovieCount'] ?? 0)), und_b('series', 'Series', (int)($c['SeriesCount'] ?? 0)), und_b('episodes', 'Episodes', (int)($c['EpisodeCount'] ?? 0)), und_b('songs', 'Songs', (int)($c['SongCount'] ?? 0))];
  return ['blocks' => empty($s['options']['hide_blocks']) ? $b : [], 'streams' => $streams, 'empty' => 'No active streams'];
}
function und_ends($s, $p) { return substr($s, -strlen($p)) === $p; }

function und_w_plex($s) {
  $h = ['headers' => ['X-Plex-Token' => $s['key'], 'Accept' => 'application/json']];
  $sess = und_get(und_u($s['url'], '/status/sessions'), $h);
  $secs = und_get(und_u($s['url'], '/library/sections'), $h);
  $count = ['movie' => 0, 'show' => 0, 'artist' => 0];
  foreach ((array)($secs['MediaContainer']['Directory'] ?? []) as $d) {
    $type = (string)($d['type'] ?? '');
    if (!isset($count[$type])) continue;
    $q = $type === 'artist' ? '?type=9&' : '?';     // albums for music libraries, like Homepage
    $r = und_get(und_u($s['url'], '/library/sections/' . rawurlencode((string)$d['key']) . '/all' . $q . 'X-Plex-Container-Start=0&X-Plex-Container-Size=0'), $h);
    $count[$type] += (int)($r['MediaContainer']['totalSize'] ?? $r['MediaContainer']['size'] ?? 0);
  }
  return ['blocks' => [und_b('streams', 'Active streams', (int)($sess['MediaContainer']['size'] ?? 0)), und_b('albums', 'Albums', $count['artist']),
                       und_b('movies', 'Movies', $count['movie']), und_b('tv', 'TV shows', $count['show'])]];
}

function und_tautulli($s, array $q) {
  $j = und_get(und_u($s['url'], '/api/v2?' . http_build_query(['apikey' => $s['key']] + $q)), ['timeout' => 15]);
  if (($j['response']['result'] ?? '') !== 'success') throw new Exception('Tautulli: ' . ($j['response']['message'] ?? 'request failed'));
  return $j['response']['data'] ?? [];
}

function und_w_tautulli($s) {
  $d = und_tautulli($s, ['cmd' => 'get_activity']);
  $streams = [];
  foreach ((array)($d['sessions'] ?? []) as $x) {
    $t = ($x['media_type'] ?? '') === 'episode'
      ? $x['grandparent_title'] . ': S' . sprintf('%02d', (int)$x['parent_media_index']) . ' · E' . sprintf('%02d', (int)$x['media_index']) . ' - ' . $x['title']
      : (string)($x['full_title'] ?? $x['title'] ?? '');
    $streams[] = ['title' => $t, 'user' => (string)($x['friendly_name'] ?? $x['user'] ?? ''), 'state' => (string)($x['state'] ?? ''),
                  'pos' => (int)((int)($x['view_offset'] ?? 0) / 1000), 'dur' => (int)((int)($x['duration'] ?? 0) / 1000), 'transcode' => (string)($x['transcode_decision'] ?? '')];
  }
  return ['streams' => $streams, 'empty' => 'No active streams'];
}

function und_w_tautulli_recent($s) {
  $o = $s['options'];
  $q = ['cmd' => 'get_recently_added', 'count' => max(1, min(25, (int)($o['count'] ?? 6)))];
  if (!empty($o['media_type'])) $q['media_type'] = (string)$o['media_type'];
  if (isset($o['section_id']) && $o['section_id'] !== '') $q['section_id'] = (string)$o['section_id'];
  $d = und_tautulli($s, $q);
  $list = [];
  foreach ((array)($d['recently_added'] ?? []) as $x) {
    $title = in_array($x['media_type'] ?? '', ['episode', 'season'], true) ? ($x['grandparent_title'] ?: $x['parent_title']) : ($x['title'] ?? '');
    $list[] = ['title' => (string)$title, 'ts' => (int)($x['added_at'] ?? 0)];
  }
  return ['list' => $list];
}

/* ---------- other apps ---------- */

function und_w_adguard($s) {
  $j = und_get(und_u($s['url'], '/control/stats'), ['basic' => [$s['username'], $s['password']]]);
  $filtered = (int)($j['num_replaced_safebrowsing'] ?? 0) + (int)($j['num_replaced_safesearch'] ?? 0) + (int)($j['num_replaced_parental'] ?? 0);
  return ['blocks' => [und_b('queries', 'Queries', (int)($j['num_dns_queries'] ?? 0)), und_b('blocked', 'Blocked', (int)($j['num_blocked_filtering'] ?? 0)),
                       und_b('filtered', 'Filtered', $filtered), und_b('latency', 'Latency', round((float)($j['avg_processing_time'] ?? 0) * 1000, 3), 'ms')]];
}

function und_w_pihole($s) {
  $r = und_http('POST', und_u($s['url'], '/api/auth'), ['body' => json_encode(['password' => $s['key']]), 'headers' => ['Content-Type' => 'application/json']]);
  if ($r['code'] === 200 && !empty($r['json']['session']['sid'])) {
    $j = und_get(und_u($s['url'], '/api/stats/summary'), ['headers' => ['X-FTL-SID' => $r['json']['session']['sid']]]);
    return ['blocks' => [und_b('queries', 'Queries', (int)($j['queries']['total'] ?? 0)), und_b('blocked', 'Blocked', (int)($j['queries']['blocked'] ?? 0)),
                         und_b('blocked_percent', 'Blocked %', round((float)($j['queries']['percent_blocked'] ?? 0), 1), 'pct'), und_b('gravity', 'Gravity', (int)($j['gravity']['domains_being_blocked'] ?? 0))]];
  }
  $j = und_get(und_u($s['url'], '/admin/api.php?summaryRaw&auth=' . rawurlencode($s['key'])));
  return ['blocks' => [und_b('queries', 'Queries', (int)($j['dns_queries_today'] ?? 0)), und_b('blocked', 'Blocked', (int)($j['ads_blocked_today'] ?? 0)),
                       und_b('blocked_percent', 'Blocked %', round((float)($j['ads_percentage_today'] ?? 0), 1), 'pct'), und_b('gravity', 'Gravity', (int)($j['domains_being_blocked'] ?? 0))]];
}

function und_w_npm($s) {
  $tf = und_tmp('npm-' . $s['id'] . '.json');
  $tok = und_read_json($tf, []);
  if (empty($tok['token']) || strtotime((string)($tok['expires'] ?? '')) < time() + 60) {
    $j = und_get(und_u($s['url'], '/api/tokens'), ['method' => 'POST', 'body' => json_encode(['identity' => $s['username'], 'secret' => $s['password']]), 'headers' => ['Content-Type' => 'application/json']]);
    if (empty($j['token'])) throw new Exception('Nginx Proxy Manager login failed.');
    $tok = ['token' => $j['token'], 'expires' => (string)($j['expires'] ?? '')];
    und_write_json($tf, $tok, true);
  }
  $hosts = und_get(und_u($s['url'], '/api/nginx/proxy-hosts'), ['headers' => ['Authorization' => 'Bearer ' . $tok['token']]]);
  $on = 0; foreach ((array)$hosts as $x) if (!empty($x['enabled'])) $on++;
  return ['blocks' => [und_b('enabled', 'Enabled', $on), und_b('disabled', 'Disabled', count((array)$hosts) - $on), und_b('total', 'Total', count((array)$hosts))]];
}

function und_w_immich($s) {
  $h = ['headers' => ['x-api-key' => $s['key'], 'Accept' => 'application/json']];
  try { $j = und_get(und_u($s['url'], '/api/server/statistics'), $h); }
  catch (Exception $e) { $j = und_get(und_u($s['url'], '/api/server-info/statistics'), $h); }
  return ['blocks' => [und_b('users', 'Users', count((array)($j['usageByUser'] ?? []))), und_b('photos', 'Photos', (int)($j['photos'] ?? 0)),
                       und_b('videos', 'Videos', (int)($j['videos'] ?? 0)), und_b('storage', 'Storage', (float)($j['usage'] ?? 0), 'bytes')]];
}

function und_w_peanut($s) {
  $o = $s['username'] !== '' ? ['basic' => [$s['username'], $s['password']]] : [];
  $j = und_get(und_u($s['url'], '/api/v1/devices/' . rawurlencode($s['key'] ?: 'ups')), $o);
  return ['blocks' => [und_b('battery_charge', 'Battery charge', (float)($j['battery.charge'] ?? 0), 'pct'), und_b('ups_load', 'UPS load', (float)($j['ups.load'] ?? 0), 'pct'),
                       und_b('ups_status', 'UPS status', und_ups_status((string)($j['ups.status'] ?? '')), 'text')]];
}

/* ---------- calendar (Radarr + Sonarr) ---------- */

function und_w_calendar($s, $cfg) {
  $o = $s['options'];
  $prev = max(0, (int)($o['previous_days'] ?? 0)); $ahead = max(1, min(90, (int)($o['days_ahead'] ?? 30)));
  $start = date('Y-m-d', time() - $prev * 86400); $end = date('Y-m-d', time() + $ahead * 86400);
  $from = strtotime($start); $ev = []; $errs = [];
  foreach ((array)($o['integrations'] ?? []) as $in) {
    $src = und_service_full($cfg, (string)($in['service'] ?? ''));
    if (!$src) { $errs[] = 'a linked service no longer exists'; continue; }
    $um = !empty($in['unmonitored']) ? 'true' : 'false';
    try {
      if ($src['type'] === 'radarr') {
        $j = und_get(und_u($src['url'], "/api/v3/calendar?start=$start&end=$end&unmonitored=$um"), und_arr_h($src));
        foreach ((array)$j as $m) foreach (['inCinemas' => 'In cinemas', 'digitalRelease' => 'Digital release', 'physicalRelease' => 'Physical release'] as $k => $lab) {
          if (empty($m[$k])) continue;
          $ts = strtotime($m[$k]);
          if ($ts >= $from && $ts <= time() + $ahead * 86400) $ev[] = ['ts' => $ts, 'title' => $m['title'] . ' - ' . $lab, 'done' => !empty($m['hasFile']), 'src' => 'radarr'];
        }
      } elseif ($src['type'] === 'sonarr') {
        $j = und_get(und_u($src['url'], "/api/v3/calendar?start=$start&end=$end&unmonitored=$um&includeSeries=true"), und_arr_h($src));
        foreach ((array)$j as $e) {
          if (empty($e['airDateUtc'])) continue;
          $ev[] = ['ts' => strtotime($e['airDateUtc']), 'title' => (string)($e['series']['title'] ?? 'Unknown'), 'sub' => 'S' . sprintf('%02d', (int)$e['seasonNumber']) . 'E' . sprintf('%02d', (int)$e['episodeNumber']) . ' ' . ($e['title'] ?? ''), 'done' => !empty($e['hasFile']), 'src' => 'sonarr'];
        }
      }
    } catch (Exception $e) { $errs[] = $src['name'] . ': ' . $e->getMessage(); }
  }
  if (!$ev && $errs) throw new Exception(implode('; ', $errs));
  usort($ev, function ($a, $b) { return $a['ts'] - $b['ts'] ?: strcmp($a['title'], $b['title']); });
  return ['calendar' => array_slice($ev, 0, max(1, min(50, (int)($o['max_events'] ?? 8)))), 'empty' => 'Nothing coming up'];
}

/* ---------- custom JSON API ---------- */

/** "response.data.items.0.title" -> value */
function und_jpath($data, $path) {
  foreach (explode('.', (string)$path) as $p) {
    if ($p === '') continue;
    if (is_array($data) && array_key_exists($p, $data)) $data = $data[$p];
    elseif (is_array($data) && ctype_digit($p) && array_key_exists((int)$p, $data)) $data = $data[(int)$p];
    else return null;
  }
  return $data;
}

function und_w_customapi($s) {
  $o = $s['options'];
  $h = isset($o['headers']) && is_array($o['headers']) ? array_map('strval', $o['headers']) : [];
  foreach ($h as $k => $v) $h[$k] = str_replace('{{KEY}}', $s['key'], $v);
  $opts = ['headers' => $h, 'method' => strtoupper((string)($o['method'] ?? 'GET'))];
  if ($s['username'] !== '') $opts['basic'] = [$s['username'], $s['password']];
  $j = und_get(str_replace('{{KEY}}', rawurlencode($s['key']), $s['url']), $opts);
  $maps = (array)($o['mappings'] ?? []);
  if (($o['display'] ?? 'block') === 'list') {
    $list = [];
    foreach ($maps as $m) {
      $v = und_jpath($j, $m['field'] ?? '');
      if ($v === null) continue;
      $row = ['title' => (string)(is_scalar($v) ? $v : json_encode($v)), 'label' => (string)($m['label'] ?? '')];
      if (!empty($m['additional'])) {
        $a = und_jpath($j, $m['additional']['field'] ?? '');
        $fmt = (string)($m['additional']['format'] ?? 'text');
        if (in_array($fmt, ['relativeDate', 'date'], true)) $row['ts'] = (int)round((float)$a * (float)($m['additional']['scale'] ?? 1) / 1000);
        else $row['right'] = (string)$a;
      }
      $list[] = $row;
    }
    return ['list' => $list];
  }
  $b = [];
  foreach ($maps as $i => $m) {
    $v = und_jpath($j, $m['field'] ?? '');
    $fmt = (string)($m['format'] ?? 'n');
    if ($fmt === 'number') $fmt = 'n';
    if ($fmt === 'percent') $fmt = 'pct';
    if (!in_array($fmt, ['n', 'bytes', 'rate', 'ms', 'pct', 'text'], true)) $fmt = 'text';
    if (is_numeric($v) && isset($m['scale'])) $v = (float)$v * (float)$m['scale'];
    $b[] = und_b((string)($m['field'] ?? $i), (string)($m['label'] ?? $m['field'] ?? ''), is_scalar($v) || $v === null ? $v : count((array)$v), $fmt);
  }
  return ['blocks' => $b];
}
]]></INLINE>
<SHA256>fbf98446bc27e667d4609f2d156804ebb0e72654b15c7e1abdc42cb9654752a1</SHA256>
</FILE>

<FILE Name="&emhttp;/include/import.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - import from a gethomepage/homepage setup (services.yaml, settings.yaml and optionally its .env).
 * PHP on Unraid has no YAML extension, so this is a small parser for the YAML Homepage's files use:
 * block maps and lists, quoted and plain scalars, flow lists ["a", "b"], comments. Anchors and multi-line strings are not supported.
 */

function und_yaml_parse($text) {
  $lines = [];
  foreach (preg_split('/\r\n|\r|\n/', (string)$text) as $raw) {
    if (strpos($raw, "\t") !== false) $raw = str_replace("\t", '    ', $raw);
    $l = und_yaml_strip_comment($raw);
    if (trim($l) === '' || trim($l) === '---') continue;
    $lines[] = [strlen($l) - strlen(ltrim($l, ' ')), rtrim(ltrim($l, ' '))];
  }
  $i = 0;
  return $lines ? und_yaml_block($lines, $i, $lines[0][0]) : [];
}

function und_yaml_strip_comment($l) {
  $q = '';
  for ($k = 0, $n = strlen($l); $k < $n; $k++) {
    $c = $l[$k];
    if ($q !== '') { if ($c === $q) $q = ''; continue; }
    if ($c === '"' || $c === "'") { if ($k === 0 || strpos(" :[,-", $l[$k - 1]) !== false) $q = $c; continue; }
    if ($c === '#' && ($k === 0 || $l[$k - 1] === ' ')) return substr($l, 0, $k);
  }
  return $l;
}

function und_yaml_block(array &$lines, &$i, $indent) {
  if ($i >= count($lines)) return null;
  if ($lines[$i][1] === '-' || strncmp($lines[$i][1], '- ', 2) === 0) {
    $out = [];
    while ($i < count($lines) && $lines[$i][0] === $indent && ($lines[$i][1] === '-' || strncmp($lines[$i][1], '- ', 2) === 0)) {
      $rest = ltrim(substr($lines[$i][1], 1), ' ');
      if ($rest === '') { $i++; $out[] = ($i < count($lines) && $lines[$i][0] > $indent) ? und_yaml_block($lines, $i, $lines[$i][0]) : null; continue; }
      if (und_yaml_is_key($rest)) {
        // "- key: value" starts a map whose keys sit at the column after "- "
        $lines[$i] = [$indent + (strlen($lines[$i][1]) - strlen($rest)), $rest];
        $out[] = und_yaml_block($lines, $i, $lines[$i][0]);
      } else { $out[] = und_yaml_scalar($rest); $i++; }
    }
    return $out;
  }
  $out = [];
  while ($i < count($lines) && $lines[$i][0] === $indent && und_yaml_is_key($lines[$i][1])) {
    list($k, $v) = und_yaml_split($lines[$i][1]);
    $i++;
    if ($v === '') {
      if ($i < count($lines) && ($lines[$i][0] > $indent || ($lines[$i][0] === $indent && strncmp($lines[$i][1], '-', 1) === 0))) $out[$k] = und_yaml_block($lines, $i, $lines[$i][0]);
      else $out[$k] = null;
    } else $out[$k] = und_yaml_scalar($v);
  }
  // skip anything indented deeper that did not belong to a key (malformed input): never loop forever
  while ($i < count($lines) && $lines[$i][0] > $indent) $i++;
  return $out;
}

function und_yaml_is_key($s) {
  if ($s === '' || $s[0] === '[' || ($s[0] === '{' && substr($s, 0, 2) !== '{{')) return false;
  if ($s[0] === '"' || $s[0] === "'") return preg_match('/^(["\']).*?\1\s*:(\s|$)/', $s) === 1;
  return preg_match('/^[^:]+?:(\s|$)/', $s) === 1 && substr($s, 0, 2) !== '{{';
}

function und_yaml_split($s) {
  if ($s[0] === '"' || $s[0] === "'") { preg_match('/^(["\'])(.*?)\1\s*:\s*(.*)$/', $s, $m); return [$m[2], trim($m[3])]; }
  $p = strpos($s, ': '); if ($p === false) $p = strlen($s) - 1;
  return [trim(substr($s, 0, $p)), trim((string)substr($s, $p + 1))];
}

function und_yaml_scalar($v) {
  $v = trim($v);
  if ($v === '' || $v === '~' || $v === 'null') return null;
  if ($v[0] === '"') { $e = strrpos($v, '"'); return stripcslashes((string)substr($v, 1, ($e ?: strlen($v)) - 1)); }
  if ($v[0] === "'") return str_replace("''", "'", (string)substr($v, 1, (strrpos($v, "'") ?: strlen($v)) - 1));
  if ($v[0] === '[') {
    $in = trim(substr($v, 1, (strrpos($v, ']') ?: strlen($v)) - 1));
    if ($in === '') return [];
    preg_match_all('/"(?:[^"\\\\]|\\\\.)*"|\'[^\']*\'|[^,]+/', $in, $m);
    return array_map('und_yaml_scalar', array_map('trim', $m[0]));
  }
  if (in_array(strtolower($v), ['true', 'yes', 'on'], true)) return true;
  if (in_array(strtolower($v), ['false', 'no', 'off'], true)) return false;
  if (preg_match('/^-?\d+$/', $v)) return (int)$v;
  if (preg_match('/^-?\d+\.\d+$/', $v)) return (float)$v;
  return $v;
}

/* ---------- Homepage -> UnDash ---------- */

function und_env_parse($text) {
  $out = [];
  foreach (preg_split('/\r\n|\r|\n/', (string)$text) as $l) {
    if (!preg_match('/^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/', $l, $m)) continue;
    $v = trim($m[2]);
    if ($v !== '' && ($v[0] === '"' || $v[0] === "'") && substr($v, -1) === $v[0]) $v = substr($v, 1, -1);
    elseif (($p = strpos($v, ' #')) !== false) $v = rtrim(substr($v, 0, $p));
    $out[strtoupper($m[1])] = $v;
  }
  return $out;
}

/** A Homepage customapi "field" (a nested map like {response: {data: {items: {0: title}}}}) as a dot path. */
function und_hp_path($f) {
  $parts = [];
  while (is_array($f) && count($f) === 1) { $k = array_keys($f)[0]; $parts[] = $k; $f = $f[$k]; }
  if (is_scalar($f) && $f !== '') $parts[] = (string)$f;
  return implode('.', $parts);
}

function und_hp_convert($servicesYaml, $settingsYaml = '', $envText = '') {
  $warn = [];
  $svcs = und_yaml_parse($servicesYaml);
  if (!is_array($svcs) || !$svcs) return ['error' => 'services.yaml could not be read (expected a list of groups).'];
  $settings = $settingsYaml !== '' ? und_yaml_parse($settingsYaml) : [];
  $layout = is_array($settings['layout'] ?? null) ? $settings['layout'] : [];
  $env = und_env_parse($envText);
  $direct = ['radarr', 'sonarr', 'lidarr', 'readarr', 'bazarr', 'prowlarr', 'overseerr', 'autobrr', 'qbittorrent', 'sabnzbd', 'emby', 'jellyfin', 'plex', 'tautulli', 'adguard', 'pihole', 'npm', 'immich', 'peanut'];
  $alias = ['jellyseerr' => 'overseerr', 'nginxproxymanager' => 'npm'];
  $groups = []; $secrets = []; $calendars = [];
  foreach ($svcs as $gEntry) {
    if (!is_array($gEntry)) continue;
    foreach ($gEntry as $gName => $items) {
      $lay = is_array($layout[$gName] ?? null) ? $layout[$gName] : [];
      $g = ['id' => und_id(), 'name' => (string)$gName, 'columns' => (int)($lay['columns'] ?? 4) ?: 4, 'header' => !isset($lay['header']) || !empty($lay['header']), 'services' => []];
      foreach ((array)$items as $sEntry) {
        if (!is_array($sEntry)) continue;
        foreach ($sEntry as $sName => $def) {
          if (!is_array($def)) $def = [];
          if (isset($def[0])) { $warn[] = "\"$sName\" in \"$gName\" is a nested group; nested groups are not supported, skipped."; continue; }
          $w = is_array($def['widget'] ?? null) ? $def['widget'] : null;
          $s = ['id' => und_id(), 'name' => (string)$sName, 'type' => 'link', 'icon' => (string)($def['icon'] ?? ''), 'href' => (string)($def['href'] ?? ''), 'url' => '', 'fields' => [], 'options' => []];
          $sec = [];
          if ($w) {
            $t = strtolower((string)($w['type'] ?? ''));
            $t = $alias[$t] ?? $t;
            foreach (['key', 'username', 'password'] as $f) if (isset($w[$f]) && $w[$f] !== '') $sec[$f] = (string)$w[$f];
            if (isset($w['url'])) $s['url'] = (string)$w['url'];
            if (isset($w['fields']) && is_array($w['fields'])) $s['fields'] = array_values(array_map('strval', $w['fields']));
            if (in_array($t, $direct, true)) {
              $s['type'] = $t;
              if (in_array($t, ['emby', 'jellyfin'], true) && isset($w['enableBlocks']) && !$w['enableBlocks']) $s['options']['hide_blocks'] = true;
            } elseif ($t === 'glances') {
              $m = (string)($w['metric'] ?? 'info');
              // the dashboard's own system overview shows these now
              $warn[] = "\"$sName\" (Glances $m) is covered by UnDash's built-in system overview and was not imported as a widget.";
              continue;
            } elseif ($t === 'calendar') {
              $s['type'] = 'calendar';
              $s['options'] = ['max_events' => (int)($w['maxEvents'] ?? 8), 'previous_days' => (int)($w['previousDays'] ?? 0), 'days_ahead' => 30, 'integrations' => []];
              $calendars[] = [count($groups), count($g['services']), (array)($w['integrations'] ?? [])];
            } elseif ($t === 'customapi') {
              $s['type'] = 'customapi';
              $maps = [];
              foreach ((array)($w['mappings'] ?? []) as $m) {
                if (!is_array($m)) continue;
                $x = ['field' => und_hp_path($m['field'] ?? ''), 'label' => (string)($m['label'] ?? ''), 'format' => (string)($m['format'] ?? 'text')];
                if (isset($m['scale'])) $x['scale'] = $m['scale'];
                if (is_array($m['additionalField'] ?? null)) $x['additional'] = ['field' => und_hp_path($m['additionalField']['field'] ?? ''), 'format' => (string)($m['additionalField']['format'] ?? 'text'), 'scale' => $m['additionalField']['scale'] ?? 1];
                $maps[] = $x;
              }
              $s['options'] = ['display' => ($w['display'] ?? '') === 'list' ? 'list' : 'block', 'method' => (string)($w['method'] ?? 'GET'), 'headers' => is_array($w['headers'] ?? null) ? $w['headers'] : new stdClass(), 'mappings' => $maps];
            } else {
              $warn[] = "\"$sName\": widget type \"$t\" is not supported yet, imported as a link.";
              $s['url'] = '';
            }
          }
          if ($sec) $secrets[$s['id']] = $sec;
          $g['services'][] = $s;
        }
      }
      $groups[] = $g;
    }
  }
  foreach ($calendars as $c) {
    list($gi, $si, $ints) = $c;
    foreach ($ints as $in) {
      if (!is_array($in)) continue;
      foreach ($groups as $gg) foreach ($gg['services'] as $ss) {
        if (strcasecmp($ss['name'], (string)($in['service_name'] ?? '')) === 0 && (empty($in['service_group']) || strcasecmp($gg['name'], (string)$in['service_group']) === 0)) {
          $groups[$gi]['services'][$si]['options']['integrations'][] = ['service' => $ss['id'], 'unmonitored' => !empty($in['params']['unmonitored'])];
        }
      }
    }
    if (!$groups[$gi]['services'][$si]['options']['integrations']) $warn[] = '"' . $groups[$gi]['services'][$si]['name'] . '": its Radarr/Sonarr service was not found.';
  }
  // every {{VAR}} the import refers to, with a value from the .env when one was given
  $all = json_encode([$groups, $secrets]);
  preg_match_all('/\{\{\s*([A-Za-z0-9_]+)\s*\}\}/', $all, $m);
  $vars = [];
  foreach (array_unique(array_map('strtoupper', $m[1])) as $n) $vars[$n] = $env[$n] ?? null;
  foreach ($vars as $n => $v) if ($v === null && preg_match('/SERVER_IP$/', $n)) $vars[$n] = und_server_ip();
  $count = 0; foreach ($groups as $gg) $count += count($gg['services']);
  // only the widgets are replaced: appearance, dashboard sections and container/VM preferences stay as they are
  $cfg = und_load_config();
  if (!empty($settings['title'])) $cfg['general']['title'] = (string)$settings['title'];
  $cfg['groups'] = $groups;
  return ['config' => $cfg, 'secrets' => $secrets, 'vars' => $vars, 'warnings' => $warn, 'groups' => count($groups), 'services' => $count];
}

/** Save an import: replaces the layout; keeps stored variable values unless the .env gave a new one. */
function und_hp_apply(array $conv) {
  $old = und_secrets();
  $vars = $old['vars'];
  foreach ($conv['vars'] as $n => $v) if ($v !== null || !isset($vars[$n])) $vars[$n] = $v === null ? (string)($vars[$n] ?? '') : (string)$v;
  und_save_config($conv['config']);
  $saved = und_load_config();
  $ids = [];
  foreach ($saved['groups'] as $g) foreach ($g['services'] as $s) $ids[] = $s['id'];
  $svc = [];
  foreach ($conv['secrets'] as $id => $c) if (in_array($id, $ids, true)) $svc[$id] = $c;
  und_save_secrets(['vars' => $vars, 'svc' => $svc]);
  return ['ok' => true];
}
]]></INLINE>
<SHA256>8d28fc16533a48c31c552dba9a22fa3e6d88160a9999f7aeb8e3166f43d7822d</SHA256>
</FILE>

<FILE Name="&emhttp;/include/transfer.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - settings export and import.
 *
 * Export file: {"undash_export": 1, "schema": 2, "kind": "full"|"redacted", "created": unix time, "config": {...}, "css": "...", "vars": {...}, "secrets": {...}}
 *   full      layout, preferences, appearance, custom CSS, every variable and every widget credential (a complete backup; keep it private)
 *   redacted  the same without anything secret: credentials are dropped, secret-looking variables are emptied, and passwords or
 *             tokens written straight into URLs (user:pass@host, ?apikey=...) are replaced by {{REDACTED}}
 * Neither contains anything but UnDash's own settings.
 */

function und_export($kind) {
  $cfg = und_load_config(); $sec = und_secrets();
  $out = ['undash_export' => 1, 'schema' => UND_SCHEMA, 'kind' => $kind === 'full' ? 'full' : 'redacted', 'created' => time(), 'version' => UND_VERSION,
          'config' => $cfg, 'css' => und_load_css()];
  if ($out['kind'] === 'full') { $out['vars'] = (object)$sec['vars']; $out['secrets'] = (object)$sec['svc']; $out['unraid'] = (object)$sec['unraid']; return $out; }
  if (!empty($sec['unraid']['url'])) $out['unraid'] = ['url' => und_redact_url((string)$sec['unraid']['url'])];
  $vars = [];
  foreach ($sec['vars'] as $k => $v) $vars[$k] = und_var_is_secret($k) ? '' : und_redact_url((string)$v);
  $out['vars'] = (object)$vars;
  foreach ($out['config']['groups'] as &$g) foreach ($g['services'] as &$s) {
    $s['url'] = und_redact_url($s['url']); $s['href'] = und_redact_url($s['href']);
    // custom API headers may hold a key written in clear text
    if (is_array($s['options']) && isset($s['options']['headers']) && is_array($s['options']['headers'])) foreach ($s['options']['headers'] as $hk => $hv) {
      if (!preg_match('/^\{\{\s*[A-Za-z0-9_]+\s*\}\}$/', (string)$hv)) $s['options']['headers'][$hk] = '{{REDACTED}}';
    }
  }
  unset($g, $s);
  return $out;
}

/** Secrets written into a URL: user:password@host and token-like query parameters. Variables ({{NAME}}) are kept. */
function und_redact_url($u) {
  $u = preg_replace('#^([a-z][a-z0-9+.-]*://)[^/@\s]+@#i', '$1', (string)$u);
  return preg_replace_callback('/([?&])([^=&#]+)=([^&#]*)/', function ($m) {
    if (!preg_match('/key|token|pass|secret|auth|sig|session/i', $m[2]) || preg_match('/^\{\{\s*[A-Za-z0-9_]+\s*\}\}$/', urldecode($m[3]))) return $m[0];
    return $m[1] . $m[2] . '={{REDACTED}}';
  }, $u);
}

/**
 * Check an uploaded export before anything is changed. Returns a summary for the preview, or an error.
 * Only UnDash export files (and older UnDash layout files, which are plain config objects) are accepted.
 */
function und_import_parse($raw) {
  if (!is_string($raw) || $raw === '') return ['error' => 'The file is empty.'];
  if (strlen($raw) > 2097152) return ['error' => 'The file is larger than 2 MB; that is not an UnDash export.'];
  $j = json_decode($raw, true, 64);
  if (!is_array($j)) return ['error' => 'The file is not valid JSON.'];
  if (isset($j['undash_export'])) {
    if ((int)$j['undash_export'] !== 1) return ['error' => 'This export comes from a newer UnDash; update the plugin first.'];
    if ((int)($j['schema'] ?? 0) > UND_SCHEMA) return ['error' => 'This export uses settings schema ' . (int)$j['schema'] . '; this UnDash understands up to ' . UND_SCHEMA . '. Update the plugin first.'];
    if (!isset($j['config']) || !is_array($j['config']) || !isset($j['config']['groups']) || !is_array($j['config']['groups'])) return ['error' => 'The export has no layout in it.'];
    $file = ['kind' => ($j['kind'] ?? '') === 'full' ? 'full' : 'redacted', 'config' => $j['config'], 'css' => is_string($j['css'] ?? null) ? $j['css'] : null,
             'vars' => isset($j['vars']) && is_array($j['vars']) ? $j['vars'] : [], 'secrets' => isset($j['secrets']) && is_array($j['secrets']) ? $j['secrets'] : [], 'created' => (int)($j['created'] ?? 0)];
  } elseif (isset($j['groups']) && is_array($j['groups'])) {
    $file = ['kind' => 'layout', 'config' => $j, 'css' => null, 'vars' => [], 'secrets' => [], 'created' => 0];
  } else return ['error' => 'This is not an UnDash settings file.'];
  foreach ($file['vars'] as $k => $v) if (!is_string($k) || !preg_match('/^[A-Za-z][A-Za-z0-9_]{0,63}$/', $k) || !is_scalar($v)) return ['error' => 'The variables in the file are malformed.'];
  foreach ($file['secrets'] as $id => $c) if (!preg_match('/^[a-f0-9]{8}$/', (string)$id) || !is_array($c)) return ['error' => 'The credentials in the file are malformed.'];
  $rawGroups = $file['config']['groups'];
  $cfg = und_normalize(und_migrate($file['config']));
  $file['config'] = $cfg;
  $n = 0; foreach ($cfg['groups'] as $g) $n += count($g['services']);
  $dropped = 0; foreach ($rawGroups as $g) $dropped += is_array($g) ? count((array)($g['services'] ?? [])) : 0;
  $file['summary'] = ['kind' => $file['kind'], 'created' => $file['created'], 'groups' => count($cfg['groups']), 'widgets' => $n, 'skipped' => max(0, $dropped - $n),
    'theme' => $cfg['appearance']['theme'], 'accent' => $cfg['appearance']['accent'], 'refresh' => $cfg['general']['refresh'], 'css' => $file['css'] !== null ? strlen($file['css']) : null,
    'vars' => count($file['vars']), 'credentials' => count($file['secrets'])];
  return $file;
}

/**
 * Apply a checked import. A backup of the current settings is taken first, so it can be undone from the backup list.
 * Credentials: a full export replaces them; a redacted or layout-only file keeps the stored ones for widgets with the same id
 * and keeps stored values of variables the file leaves empty.
 */
function und_import_apply($raw) {
  $f = und_import_parse($raw);
  if (isset($f['error'])) return $f;
  $j_unraid = json_decode($raw, true)['unraid'] ?? null;
  $bk = und_backup('before import');
  $old = und_secrets();
  $ids = und_service_ids($f['config']);
  $vars = $old['vars'];
  foreach ($f['vars'] as $k => $v) { $k = strtoupper($k); if ((string)$v !== '' || !isset($vars[$k])) $vars[$k] = und_clip((string)$v, 2000); }
  $svc = [];
  foreach ($ids as $id) {
    $c = $f['kind'] === 'full' && isset($f['secrets'][$id]) ? $f['secrets'][$id] : ($old['svc'][$id] ?? []);
    foreach (['key', 'password', 'username'] as $k) if (isset($c[$k]) && is_scalar($c[$k]) && (string)$c[$k] !== '') $svc[$id][$k] = und_clip((string)$c[$k], 2000);
  }
  if (!und_save_config($f['config'], false)) return ['error' => 'Could not write the configuration directory.'];
  $unraid = $old['unraid'];
  if (isset($j_unraid) && is_array($j_unraid)) {
    if (!empty($j_unraid['url']) && is_string($j_unraid['url']) && preg_match('#^https?://#i', $j_unraid['url'])) $unraid['url'] = und_clip($j_unraid['url'], 300);
    if ($f['kind'] === 'full' && !empty($j_unraid['key']) && is_string($j_unraid['key'])) $unraid['key'] = und_clip($j_unraid['key'], 300);
  }
  und_save_secrets(['vars' => $vars, 'svc' => $svc, 'unraid' => $unraid]);
  if ($f['css'] !== null) und_save_css($f['css'], false);
  return ['ok' => true, 'backup' => $bk];
}
]]></INLINE>
<SHA256>92cba8a91108d7a7212551de9fc9437d680fd1177cf29b697c13b095cd4ca506</SHA256>
</FILE>

<FILE Name="&emhttp;/include/ops.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - operations: one-at-a-time locks per target, the recent-operation history, and server power.
 * Every management action is a fixed operation on a validated target; nothing here takes a command from the browser.
 */

/** Exclusive, non-blocking lock for one target ("docker:plex", "vm:Windows 10", "power"). Returns a handle, or false when busy. */
function und_lock($target) {
  @mkdir(und_tmp('locks'), 0755, true);
  $fp = @fopen(und_tmp('locks/' . hash('sha256', $target) . '.lock'), 'c');
  if (!$fp) return false;
  if (flock($fp, LOCK_EX | LOCK_NB)) return $fp;
  fclose($fp);
  return false;
}
function und_unlock($fp) { if (is_resource($fp)) { @flock($fp, LOCK_UN); @fclose($fp); } }

/** Append to the recent-operation history (newest 100, kept in RAM until reboot). Messages are redacted. */
function und_history_add($kind, $target, $op, $ok, $msg = '') {
  $f = und_tmp('history.json');
  $fp = @fopen($f . '.lock', 'c');
  if ($fp) flock($fp, LOCK_EX);
  $h = und_read_json($f, []);
  $h[] = ['at' => time(), 'kind' => $kind, 'target' => und_clip($target, 120), 'op' => $op, 'ok' => (bool)$ok, 'msg' => und_clip(und_redact($msg), 300)];
  und_write_json($f, array_slice($h, -100));
  if ($fp) { flock($fp, LOCK_UN); fclose($fp); }
}
function und_history() { return array_reverse(und_read_json(und_tmp('history.json'), [])); }

/* ---------- server power ---------- */

/**
 * Restart or shut down the server with the same commands Unraid's own Reboot / Shutdown buttons run
 * (webGui/include/Boot.php: /sbin/reboot -n and /sbin/poweroff -n; these stop the array cleanly first).
 *
 * Two steps so a single stray request can never power the server off:
 *   power_prepare -> a one-time nonce bound to the operation, valid 120 s, plus anything that makes it a bad moment
 *   power         -> needs that nonce and the server's name typed back; the command starts 3 s later so the answer reaches the browser
 */
function und_power_prepare($op) {
  if (und_api_mode()) return ['error' => 'The Unraid API has no restart or shutdown. Use Unraid\'s own Reboot / Shutdown buttons (or the UnDash plugin).'];
  if (!in_array($op, ['reboot', 'shutdown'], true)) return ['error' => 'Unknown power action.'];
  $nonce = bin2hex(random_bytes(16));
  und_write_json(und_tmp('power-nonce.json'), ['op' => $op, 'hash' => hash('sha256', $nonce), 'exp' => time() + 120], true);
  $v = und_var_ini(); $warn = [];
  if ((int)($v['mdResync'] ?? 0) > 0) $warn[] = 'A parity check, sync or rebuild is running; it will be interrupted.';
  if (is_file('/var/run/mover.pid')) $warn[] = 'The mover is running.';
  $vm = und_vm_states(); $running = [];
  foreach ($vm as $n => $s) if ($s === 'running') $running[] = $n;
  if ($running) $warn[] = 'Running VMs (' . implode(', ', $running) . ') will be shut down.';
  return ['nonce' => $nonce, 'op' => $op, 'name' => (string)($v['NAME'] ?? gethostname()), 'warnings' => $warn];
}

function und_power($op, $nonce, $typed) {
  if (und_api_mode()) return ['error' => 'Not available in the Docker version.'];
  $n = und_read_json(und_tmp('power-nonce.json'), []);
  @unlink(und_tmp('power-nonce.json'));                       // single use, whatever happens next
  if (!in_array($op, ['reboot', 'shutdown'], true) || ($n['op'] ?? '') !== $op) return ['error' => 'Unknown power action.'];
  if (empty($n['hash']) || !hash_equals((string)$n['hash'], hash('sha256', (string)$nonce)) || time() > (int)($n['exp'] ?? 0)) return ['error' => 'The confirmation expired. Start again.'];
  $name = (string)(und_var_ini()['NAME'] ?? gethostname());
  if (strcasecmp(trim((string)$typed), $name) !== 0) return ['error' => 'The server name you typed does not match.'];
  $lock = und_lock('power');
  if (!$lock) return ['error' => 'A power action is already in progress.'];
  if (is_file(und_tmp('power-started'))) return ['error' => 'The server is already ' . ($op === 'reboot' ? 'restarting' : 'shutting down') . '.'];
  @file_put_contents(und_tmp('power-started'), $op);
  und_history_add('server', $name, $op, true, 'requested from UnDash');
  if (function_exists('und_log_syslog')) und_log_syslog("server $op requested from UnDash");
  $cmd = $op === 'reboot' ? '/sbin/reboot' : '/sbin/poweroff';
  und_spawn(['/bin/bash', '-c', 'sleep 3; exec ' . $cmd . ' -n'], und_tmp('power.log'));
  return ['ok' => true, 'op' => $op];
}

/** A line in the system log (Tools > System Log), so power actions are visible outside UnDash too. */
function und_log_syslog($msg) {
  if (isset($GLOBALS['UND_EXEC_MOCK'])) return;
  und_run([und_bin('logger'), '-t', 'undash', '--', $msg], 5);
}
]]></INLINE>
