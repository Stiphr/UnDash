<FILE Name="&emhttp;/include/unraid_api.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - the official Unraid GraphQL API (https://docs.unraid.net/API/), used by the Docker image.
 *
 * Every query and mutation below was checked against the API's own generated schema for API 4.37.7
 * (docs/unraid-api-schema-4.37.7.graphql, from github.com/unraid/api). The API key is sent in the x-api-key header from the
 * server only; it never reaches the browser.
 *
 * Permissions the key needs (Settings > Management Access > API Keys in Unraid):
 *   INFO, ARRAY, DISK, VMS, DOCKER: read            for the dashboard
 *   DOCKER, VMS: update                              for start / stop / restart / pause / update
 * What the API does not offer (so the Docker image does not either): server restart / shutdown, Unraid OS updates,
 * per-container CPU and memory over plain HTTP (only as a WebSocket subscription), VM hibernate, VM vCPU / memory details.
 *
 * Connection settings: UNRAID_API_URL and UNRAID_API_KEY in the environment, or Settings > Connection
 * (stored in secrets.json). The environment wins when both are set.
 */

function und_api_conf() {
  $sec = und_secrets();
  $url = getenv('UNRAID_API_URL') ?: (string)($sec['unraid']['url'] ?? '');
  $key = getenv('UNRAID_API_KEY') ?: (string)($sec['unraid']['key'] ?? '');
  $url = rtrim(trim($url), '/');
  if ($url !== '' && !preg_match('#/graphql$#', $url)) $url .= '/graphql';
  return ['url' => $url, 'key' => $key, 'from_env' => ['url' => (bool)getenv('UNRAID_API_URL'), 'key' => (bool)getenv('UNRAID_API_KEY')]];
}

/** Run one GraphQL operation. Returns ['data' => ...] or ['error' => readable message, 'auth' => bool]. */
function und_gql($query, array $vars = [], $timeout = 10) {
  $c = und_api_conf();
  if ($c['url'] === '' || $c['key'] === '') return ['error' => 'The Unraid API is not configured (Settings > Connection).', 'auth' => true];
  if (!preg_match('#^https?://#i', $c['url'])) return ['error' => 'The Unraid API address must start with http:// or https://.'];
  $r = und_http('POST', $c['url'], ['body' => json_encode(['query' => $query, 'variables' => (object)$vars]), 'timeout' => $timeout,
    'headers' => ['Content-Type' => 'application/json', 'Accept' => 'application/json', 'x-api-key' => $c['key']]]);
  if ($r['err'] !== '') return ['error' => 'Cannot reach the Unraid API at ' . und_redact($c['url']) . ': ' . und_redact($r['err'], [$c['key']])];
  if ($r['code'] === 401 || $r['code'] === 403) return ['error' => 'The Unraid API refused the API key (HTTP ' . $r['code'] . ').', 'auth' => true];
  if (!is_array($r['json'])) return ['error' => 'The Unraid API answered with HTTP ' . $r['code'] . ' and no JSON (is the address right?).'];
  $j = $r['json'];
  if (!empty($j['errors'])) {
    $e = $j['errors'][0];
    $code = (string)($e['extensions']['code'] ?? '');
    $msg = und_clip(und_redact((string)($e['message'] ?? 'error'), [$c['key']]), 300);
    $auth = in_array($code, ['UNAUTHENTICATED', 'FORBIDDEN'], true) || preg_match('/permission|forbidden|unauthori[sz]ed|api key/i', $msg);
    // partial data is still useful (for example everything but the UPS when the key lacks that permission)
    if (!empty($j['data']) && !$auth) return ['data' => $j['data'], 'partial' => $msg];
    $prefix = !$auth ? 'Unraid API: ' : ($code === 'FORBIDDEN' || preg_match('/forbidden|permission/i', $msg) ? 'The API key is missing a permission: ' : 'The Unraid API rejected the API key: ');
    return ['error' => $prefix . $msg, 'auth' => (bool)$auth, 'data' => $j['data'] ?? null];
  }
  return ['data' => $j['data'] ?? []];
}

/** Connection test for Settings: who answers, which Unraid / API version, and which parts the key may read. */
function und_api_test() {
  $r = und_gql('query { info { versions { core { unraid api } } os { hostname } } }', [], 8);
  if (isset($r['error'])) return ['ok' => false, 'error' => $r['error']];
  $v = $r['data']['info']['versions']['core'] ?? [];
  $out = ['ok' => true, 'unraid' => (string)($v['unraid'] ?? ''), 'api' => (string)($v['api'] ?? ''), 'hostname' => (string)($r['data']['info']['os']['hostname'] ?? ''), 'access' => []];
  foreach (['array' => 'query { array { state } }', 'docker' => 'query { docker { containers { id } } }', 'vms' => 'query { vms { domains { id } } }', 'metrics' => 'query { metrics { cpu { percentTotal } } }', 'ups' => 'query { upsDevices { id } }'] as $k => $q) {
    $t = und_gql($q, [], 8);
    $out['access'][$k] = isset($t['error']) ? $t['error'] : 'ok';
  }
  return $out;
}

/* ---------- reads (cached briefly so several open browsers share one request) ---------- */

function und_api_cached($name, $ttl, $fn) {
  $f = und_tmp('api-' . $name . '.json');
  $c = und_read_json($f, null);
  if (is_array($c) && microtime(true) - (float)$c['t'] < $ttl) return $c['v'];
  $v = $fn();
  und_write_json($f, ['t' => microtime(true), 'v' => $v]);
  return $v;
}

function und_api_bigint($v) { return is_numeric($v) ? (float)$v : 0.0; }

/** Overview data in the same shape as the plugin's und_system(). */
function und_api_system(array $cfg) {
  $q = 'query {
    info { os { hostname uptime kernel } cpu { brand threads } versions { core { unraid } } primaryNetwork { name ipAddress } }
    metrics {
      cpu { percentTotal cpus { percentTotal } }
      memory { total used available swapTotal swapUsed percentTotal }
      temperature { sensors { type current { value } } summary { hottest { current { value } } } }
      network { name rxSec txSec }
    }
    array { state capacity { kilobytes { free used total } } parityCheckStatus { running progress status }
      parities { name device status temp numErrors fsSize fsFree fsType color isSpinning type }
      disks { name device status temp numErrors fsSize fsFree fsType color isSpinning type }
      caches { name device status temp numErrors fsSize fsFree fsType color isSpinning type } }
    vars { name }
  }';
  $r = und_api_cached('system', 1, function () use ($q) { return und_gql($q); });
  if (isset($r['error']) && empty($r['data'])) return ['error' => $r['error'], 'auth' => !empty($r['auth'])];
  $d = $r['data']; $now = time();
  $m = $d['metrics'] ?? []; $info = $d['info'] ?? [];
  $mem = $m['memory'] ?? null;
  $total = und_api_bigint($mem['total'] ?? 0); $avail = und_api_bigint($mem['available'] ?? 0);
  $memOut = $mem ? ['total' => $total, 'used' => max(0, $total - $avail), 'free' => $avail, 'pct' => $total ? round(100 * ($total - $avail) / $total, 1) : null,
                    'swap_total' => und_api_bigint($mem['swapTotal'] ?? 0), 'swap_used' => und_api_bigint($mem['swapUsed'] ?? 0)] : ['total' => 0, 'used' => 0, 'free' => 0, 'pct' => null, 'swap_total' => 0, 'swap_used' => 0];
  $temp = null;
  foreach ((array)($m['temperature']['sensors'] ?? []) as $sn) if (($sn['type'] ?? '') === 'CPU_PACKAGE') { $temp = (float)$sn['current']['value']; break; }
  if ($temp === null) foreach ((array)($m['temperature']['sensors'] ?? []) as $sn) if (($sn['type'] ?? '') === 'CPU_CORE') $temp = max((float)$temp, (float)$sn['current']['value']);
  // the main interface: Unraid's primary network, else the first bridge / bond / ethernet
  $nets = (array)($m['network'] ?? []); $want = (string)($info['primaryNetwork']['name'] ?? ''); $net = null;
  foreach ($nets as $n) if ($n['name'] === $want) $net = $n;
  if (!$net) foreach (['br0', 'bond0', 'eth0'] as $w) foreach ($nets as $n) if (!$net && $n['name'] === $w) $net = $n;
  $cpu = $m['cpu'] ?? null;
  $uptime = (string)($info['os']['uptime'] ?? '');
  $up = is_numeric($uptime) ? (int)$uptime : (($t = strtotime($uptime)) ? max(0, $now - $t) : 0);
  $hist = und_read_json(und_tmp('hist.json'), []);
  if ($cpu && (empty($hist) || $now - (int)end($hist)[0] >= 2)) { $hist[] = [$now, round((float)$cpu['percentTotal'], 1), $memOut['used'], $net ? (float)$net['rxSec'] : null, $net ? (float)$net['txSec'] : null]; $hist = array_slice($hist, -150); und_write_json(und_tmp('hist.json'), $hist); }
  $arr = und_api_array($d['array'] ?? []);
  return [
    'now' => $now, 'name' => (string)($d['vars']['name'] ?? $info['os']['hostname'] ?? ''), 'ip' => (string)($info['primaryNetwork']['ipAddress'] ?? ''),
    'os' => (string)($info['versions']['core']['unraid'] ?? ''), 'kernel' => (string)($info['os']['kernel'] ?? ''),
    'cpu' => ['pct' => $cpu ? round((float)$cpu['percentTotal'], 1) : null, 'cores' => $cpu ? array_map(function ($c) { return round((float)$c['percentTotal'], 1); }, (array)$cpu['cpus']) : [],
              'model' => (string)($info['cpu']['brand'] ?? ''), 'threads' => (int)($info['cpu']['threads'] ?? 0), 'temp' => $temp, 'load' => null],
    'mem' => $memOut, 'net' => ['rx' => $net ? (float)$net['rxSec'] : null, 'tx' => $net ? (float)$net['txSec'] : null, 'iface' => $net ? $net['name'] : ''],
    'disk' => null, 'uptime' => $up, 'array' => $arr, 'hist' => $hist,
    'os_update' => ['installed' => (string)($info['versions']['core']['unraid'] ?? ''), 'latest' => '', 'checked' => 0, 'error' => '', 'available' => false, 'staged' => '', 'job' => 'idle'],
    'partial' => $r['partial'] ?? null,
  ];
}

/** ArrayDisk -> the plugin's disk row shape. fsSize / fsFree are in KiB, as in Unraid's disks.ini. */
function und_api_disk_row(array $x, $kind) {
  $status = (string)($x['status'] ?? '');
  $color = strtolower(str_replace('_', '-', (string)($x['color'] ?? '')));
  $row = ['name' => (string)($x['name'] ?? ''), 'device' => (string)($x['device'] ?? ''), 'status' => $status, 'temp' => isset($x['temp']) && $x['temp'] !== null && (int)$x['temp'] > 0 ? (int)$x['temp'] : null,
          'size' => und_api_bigint($x['fsSize'] ?? 0) * 1024, 'free' => und_api_bigint($x['fsFree'] ?? 0) * 1024, 'fs' => (string)($x['fsType'] ?? ''), 'spun' => !isset($x['isSpinning']) || $x['isSpinning'] !== false,
          'errors' => (int)und_api_bigint($x['numErrors'] ?? 0), 'color' => $color, 'k' => $kind];
  $row['health'] = ($status !== 'DISK_OK' || strpos($color, 'red') === 0) ? 'bad' : ((strpos($color, 'yellow') === 0 || $row['errors'] > 0) ? 'warn' : 'ok');
  return $row;
}

function und_api_array(array $a) {
  $parity = []; $data = []; $pools = [];
  foreach ((array)($a['parities'] ?? []) as $x) if (($x['status'] ?? '') !== 'DISK_NP' && ($x['status'] ?? '') !== 'DISK_NP_DSBL') $parity[] = und_api_disk_row($x, 'Parity');
  foreach ((array)($a['disks'] ?? []) as $x) if (($x['status'] ?? '') !== 'DISK_NP') $data[] = und_api_disk_row($x, 'Array');
  foreach ((array)($a['caches'] ?? []) as $x) if (und_api_bigint($x['fsSize'] ?? 0) > 0) $pools[] = und_api_disk_row($x, 'Pool');
  $size = 0; $free = 0;
  foreach ($data as $x) { $size += $x['size']; $free += $x['free']; }
  $fl = und_disk_flags(array_merge($parity, $data, $pools));
  $pc = $a['parityCheckStatus'] ?? [];
  return ['state' => (string)($a['state'] ?? ''), 'resync' => !empty($pc['running']) ? 1 : 0, 'resync_pct' => !empty($pc['running']) && isset($pc['progress']) ? (float)$pc['progress'] : null,
          'resync_action' => !empty($pc['running']) ? 'Parity check' : '', 'size' => $size, 'free' => $free, 'disks' => count($data), 'parity' => count($parity),
          'pools' => $pools, 'mover' => false, '_rows' => ['parity' => $parity, 'array' => $data, 'pools' => $pools]] + $fl;
}

function und_api_storage() {
  $s = und_api_system(und_load_config());
  if (isset($s['error'])) return $s;
  return $s['array']['_rows'];
}

function und_api_ups() {
  $r = und_api_cached('ups', 5, function () { return und_gql('query { upsDevices { name model status battery { chargeLevel estimatedRuntime } power { loadPercentage } } }'); });
  $u = $r['data']['upsDevices'][0] ?? null;
  if (!$u) return null;
  return ['source' => 'Unraid API', 'charge' => (float)$u['battery']['chargeLevel'], 'load' => (float)$u['power']['loadPercentage'], 'status' => (string)$u['status'],
          'runtime' => isset($u['battery']['estimatedRuntime']) ? (int)$u['battery']['estimatedRuntime'] : null, 'model' => (string)$u['model']];
}

/* ---------- Docker ---------- */

function und_api_containers($fresh = false) {
  $fn = function () { return und_gql('query { docker { containers { id names image state status autoStart iconUrl webUiUrl isUpdateAvailable isRebuildReady ports { privatePort publicPort type } hostConfig { networkMode } } } }', [], 15); };
  return $fresh ? $fn() : und_api_cached('containers', 1, $fn);
}

function und_api_docker_live() {
  $r = und_api_containers();
  if (isset($r['error']) && empty($r['data']['docker'])) return ['error' => $r['error']];
  $out = [];
  foreach ((array)($r['data']['docker']['containers'] ?? []) as $c) {
    $name = ltrim((string)($c['names'][0] ?? ''), '/');
    $status = (string)$c['status'];
    $health = preg_match('/\((healthy|unhealthy|health: starting)\)/', $status, $m) ? str_replace('health: ', '', $m[1]) : '';
    $state = strtolower((string)$c['state']);
    // a restart loop shows up as EXITED (or RUNNING) with a "Restarting (1) …" status
    if (stripos($status, 'restarting') === 0) $state = 'restarting';
    $ports = [];
    foreach ((array)($c['ports'] ?? []) as $p) if (!empty($p['publicPort'])) $ports[$p['privatePort'] . '/' . strtolower((string)$p['type'])] = (int)$p['publicPort'];
    $job = und_job(und_tmp('docker-update-' . $name . '.log'));
    $out[] = ['name' => $name, 'id' => (string)$c['id'], 'image' => (string)$c['image'], 'state' => $state, 'status' => $status, 'health' => $health, 'cpu' => null, 'mem' => null,
      'update' => $c['isUpdateAvailable'] === true || $c['isRebuildReady'] === true ? 'available' : ($c['isUpdateAvailable'] === false ? 'current' : 'unknown'),
      'icon' => preg_match('#^https?://#', (string)$c['iconUrl']) ? (string)$c['iconUrl'] : '', 'webui' => preg_match('#^https?://#', (string)$c['webUiUrl']) ? (string)$c['webUiUrl'] : '',
      'ports' => (object)$ports, 'network' => (string)($c['hostConfig']['networkMode'] ?? ''), 'autostart' => !empty($c['autoStart']), 'managed' => true, 'restarts' => null, 'started' => null,
      'exit' => preg_match('/^Exited \((\d+)\)/', $status, $m) ? (int)$m[1] : null,
      'job' => $job['state'] === 'running' ? 'updating' : ($job['state'] === 'done' && time() - (int)$job['at'] < 600 ? ($job['code'] === 0 ? 'updated' : 'update_failed') : '')];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return ['containers' => $out, 'checking' => false, 'checked' => null];
}

function und_api_container_id($name) {
  $r = und_api_containers(true);
  foreach ((array)($r['data']['docker']['containers'] ?? []) as $c) if (ltrim((string)($c['names'][0] ?? ''), '/') === $name) return ['id' => (string)$c['id'], 'state' => strtolower((string)$c['state'])];
  return isset($r['error']) ? ['error' => $r['error']] : null;
}

function und_api_docker_action($name, $op) {
  $valid = ['start' => ['exited'], 'stop' => ['running', 'paused'], 'restart' => ['running', 'exited'], 'pause' => ['running'], 'unpause' => ['paused'], 'update' => null];
  if (!array_key_exists($op, $valid)) return ['error' => 'Unknown action.'];
  $c = und_api_container_id($name);
  if (!$c) return ['error' => 'There is no container named ' . $name . '.'];
  if (isset($c['error'])) return $c;
  if ($valid[$op] !== null && !in_array($c['state'], $valid[$op], true)) return ['error' => ucfirst($op) . ' is not possible while ' . $name . ' is ' . $c['state'] . '.'];
  $lock = und_lock('docker:' . $name);
  if (!$lock) return ['error' => 'Another action on ' . $name . ' is still running.'];
  if ($op === 'update') {
    // updateContainer pulls and recreates; it can take minutes, so it runs in the background like the plugin's update_container
    $log = und_tmp('docker-update-' . $name . '.log');
    if (und_job($log)['state'] === 'running') { und_unlock($lock); return ['error' => 'An update of ' . $name . ' is already running.']; }
    und_spawn([PHP_BINARY ?: 'php', '-d', 'auto_prepend_file=', UND_ROOT . '/scripts/apiop.php', 'update', $c['id']], $log);
    und_unlock($lock);
    und_history_add('docker', $name, 'update', true, 'started');
    return ['ok' => true, 'job' => 'running'];
  }
  $r = und_gql('mutation ($id: PrefixedID!) { docker { ' . $op . '(id: $id) { id state } } }', ['id' => $c['id']], 120);
  und_unlock($lock);
  @unlink(und_tmp('api-containers.json'));
  $ok = !isset($r['error']);
  und_history_add('docker', $name, $op, $ok, $ok ? '' : $r['error']);
  return $ok ? ['ok' => true] : ['error' => $r['error']];
}

function und_api_docker_logs($name, $lines) {
  $c = und_api_container_id($name);
  if (!$c) return ['error' => 'There is no container named ' . $name . '.'];
  if (isset($c['error'])) return $c;
  $r = und_gql('query ($id: PrefixedID!, $tail: Int) { docker { logs(id: $id, tail: $tail) { lines { timestamp message } } } }', ['id' => $c['id'], 'tail' => max(10, min(5000, (int)$lines))], 20);
  if (isset($r['error'])) return ['error' => $r['error']];
  $out = [];
  foreach ((array)($r['data']['docker']['logs']['lines'] ?? []) as $l) $out[] = substr((string)$l['timestamp'], 0, 19) . ' ' . rtrim((string)$l['message']);
  return ['log' => preg_replace('/\x1b\[[0-9;]*[A-Za-z]/', '', implode("\n", $out))];
}

function und_api_docker_inspect($name) {
  $r = und_gql('query { docker { containers { id names image imageId created state status autoStart ports { ip privatePort publicPort type } hostConfig { networkMode } mounts networkSettings } } }', [], 15);
  if (isset($r['error'])) return ['error' => $r['error']];
  foreach ((array)($r['data']['docker']['containers'] ?? []) as $c) {
    if (ltrim((string)($c['names'][0] ?? ''), '/') !== $name) continue;
    $mounts = [];
    foreach ((array)($c['mounts'] ?? []) as $m) $mounts[] = ['src' => (string)($m['Source'] ?? $m['source'] ?? ''), 'dst' => (string)($m['Destination'] ?? $m['destination'] ?? ''), 'rw' => !empty($m['RW'] ?? $m['rw'] ?? false)];
    $nets = [];
    foreach ((array)($c['networkSettings']['Networks'] ?? []) as $n => $v) $nets[] = ['name' => $n, 'ip' => (string)($v['IPAddress'] ?? '')];
    $ports = [];
    foreach ((array)($c['ports'] ?? []) as $p) if (!empty($p['publicPort'])) $ports[] = ($p['ip'] ?? '') . ':' . $p['publicPort'] . ' → ' . $p['privatePort'] . '/' . strtolower((string)$p['type']);
    return ['name' => $name, 'id' => (string)$c['id'], 'image' => (string)$c['image'], 'image_id' => substr(str_replace('sha256:', '', (string)$c['imageId']), 0, 12), 'created' => (int)$c['created'] ?: null,
      'state' => strtolower((string)$c['state']), 'started' => null, 'finished' => null, 'exit' => 0, 'state_error' => '', 'oom' => false, 'restarts' => null, 'restart_policy' => '',
      'network_mode' => (string)($c['hostConfig']['networkMode'] ?? ''), 'networks' => $nets, 'ports' => $ports, 'mounts' => $mounts,
      'env' => [], 'labels' => new stdClass(), 'health' => [], 'privileged' => false, 'note' => 'Environment variables and health-check history are not available through the Unraid API.'];
  }
  return ['error' => 'There is no container named ' . $name . '.'];
}

/* ---------- VMs ---------- */

function und_api_vm_state($s) {
  $m = ['RUNNING' => 'running', 'IDLE' => 'running', 'PAUSED' => 'paused', 'SHUTOFF' => 'shut off', 'SHUTDOWN' => 'in shutdown', 'CRASHED' => 'crashed', 'PMSUSPENDED' => 'pmsuspended', 'NOSTATE' => 'unknown'];
  return $m[(string)$s] ?? strtolower((string)$s);
}

/** Actions the API offers (VmMutations: start, stop, pause, resume, forceStop, reboot) for each state. */
function und_api_vm_ops($state) {
  switch ($state) {
    case 'running': return ['stop', 'kill', 'restart', 'pause'];
    case 'paused': return ['resume', 'kill'];
    case 'in shutdown': case 'pmsuspended': return ['kill'];
    case 'shut off': case 'crashed': return ['start'];
  }
  return [];
}

function und_api_vm_live() {
  $r = und_api_cached('vms', 1, function () { return und_gql('query { vms { domains { id name state } } }'); });
  if (isset($r['error'])) return ['error' => preg_match('/permission/i', $r['error']) ? $r['error'] : 'VMs are not available: ' . $r['error']];
  $out = [];
  foreach ((array)($r['data']['vms']['domains'] ?? []) as $d) {
    $st = und_api_vm_state($d['state']);
    $out[] = ['name' => (string)$d['name'], 'id' => (string)$d['id'], 'state' => $st, 'ops' => und_api_vm_ops($st), 'cpus' => null, 'memory' => null, 'autostart' => null, 'os' => '', 'icon' => '', 'vnc' => '', 'agent' => false];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return ['vms' => $out];
}

function und_api_vm_action($name, $op) {
  @unlink(und_tmp('api-vms.json'));
  $l = und_api_vm_live();
  if (isset($l['error'])) return $l;
  $vm = null; foreach ($l['vms'] as $v) if ($v['name'] === $name) $vm = $v;
  if (!$vm) return ['error' => 'There is no VM named ' . $name . '.'];
  if (!in_array($op, $vm['ops'], true)) return ['error' => ucfirst($op) . ' is not possible while ' . $name . ' is ' . $vm['state'] . ($op === 'hibernate' ? ' (hibernate is not offered by the Unraid API)' : '') . '.'];
  $map = ['start' => 'start', 'stop' => 'stop', 'kill' => 'forceStop', 'restart' => 'reboot', 'pause' => 'pause', 'resume' => 'resume'];
  $lock = und_lock('vm:' . $name);
  if (!$lock) return ['error' => 'Another action on ' . $name . ' is still running.'];
  $r = und_gql('mutation ($id: PrefixedID!) { vm { ' . $map[$op] . '(id: $id) } }', ['id' => $vm['id']], 90);
  und_unlock($lock);
  @unlink(und_tmp('api-vms.json'));
  $ok = !isset($r['error']) && !empty($r['data']['vm'][$map[$op]]);
  $err = $ok ? '' : ($r['error'] ?? 'Unraid did not confirm the action.');
  und_history_add('vm', $name, $op, $ok, $err);
  return $ok ? ['ok' => true] : ['error' => $err];
}
]]></INLINE>
<SHA256>062853bb817cc1085d5ce95b348bc5b11ce2332800a4b53385cf8345d9c1b682</SHA256>
</FILE>

<FILE Name="&emhttp;/include/media.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - media discovery: upcoming movies, upcoming episodes, recently added movies, recently added episodes.
 * Everything comes from the Radarr and Sonarr widgets already configured (no new integration). Posters are the public
 * TMDB / TheTVDB images Radarr and Sonarr report as remoteUrl, so no API key ever reaches the browser.
 * Each list is cached for 60 seconds per source.
 */

/** The Radarr / Sonarr widget the Media section uses: the one chosen in Settings, else the first one. */
function und_media_source(array $cfg, $type) {
  $want = (string)($cfg['media'][$type] ?? '');
  $first = null;
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) {
    if ($s['type'] !== $type) continue;
    if ($want !== '' && $s['id'] === $want) return $s['id'];
    if ($first === null) $first = $s['id'];
  }
  return $first;
}

function und_media_poster($images) {
  foreach ((array)$images as $i) if (($i['coverType'] ?? '') === 'poster' && preg_match('#^https://#', (string)($i['remoteUrl'] ?? ''))) {
    // TMDB serves any size; the original is several MB, a 185 px wide poster is a few KB
    return preg_replace('#^(https://image\.tmdb\.org/t/p/)original/#', '$1w185/', (string)$i['remoteUrl']);
  }
  return '';
}

function und_media_ep($season, $ep) { return 'S' . sprintf('%02d', (int)$season) . 'E' . sprintf('%02d', (int)$ep); }

/** kind: upcoming_movies | upcoming_episodes | recent_movies | recent_episodes */
function und_media(array $cfg, $kind) {
  $type = in_array($kind, ['upcoming_movies', 'recent_movies'], true) ? 'radarr' : 'sonarr';
  $id = und_media_source($cfg, $type);
  if (!$id) return ['items' => [], 'unconfigured' => true, 'error' => 'Add a ' . ($type === 'radarr' ? 'Radarr' : 'Sonarr') . ' app in Settings > Apps to see this.'];
  $count = max(1, min(50, (int)($cfg['media']['count'] ?? 15)));
  foreach ((array)($cfg['media']['widgets'] ?? []) as $w) if (($w['id'] ?? '') === $kind && isset($w['count'])) $count = max(1, min(50, (int)$w['count']));
  $days = max(7, min(120, (int)($cfg['media']['days_ahead'] ?? 30)));
  return und_api_cached('media-' . $kind . '-' . $id . '-' . $count . '-' . $days, 60, function () use ($cfg, $id, $kind, $count, $days) {
    $s = und_service_full($cfg, $id);
    if (trim($s['url']) === '' || und_has($s['url'], '{{')) return ['items' => [], 'unconfigured' => true, 'error' => $s['name'] . ' has no API URL yet.'];
    $base = rtrim($s['url'], '/'); $link = rtrim($s['href'] ?: $s['url'], '/');
    $h = und_arr_h($s);
    try {
      $items = [];
      if ($kind === 'upcoming_movies') {
        $start = gmdate('Y-m-d'); $end = gmdate('Y-m-d', time() + $days * 86400);
        foreach ((array)und_get("$base/api/v3/calendar?start=$start&end=$end&unmonitored=false", $h + ['timeout' => 15]) as $m) {
          // the next release of each movie, and which kind of release it is
          $best = null;
          foreach (['inCinemas' => 'In cinemas', 'digitalRelease' => 'Digital', 'physicalRelease' => 'Physical'] as $k => $lab) {
            if (empty($m[$k])) continue;
            $ts = strtotime($m[$k]);
            if ($ts >= strtotime($start) && (!$best || $ts < $best[0])) $best = [$ts, $lab];
          }
          if (!$best) continue;
          $items[] = ['title' => (string)$m['title'], 'year' => (int)($m['year'] ?? 0), 'ts' => $best[0], 'when' => $best[1], 'poster' => und_media_poster($m['images'] ?? []),
                      'href' => !empty($m['titleSlug']) ? "$link/movie/" . rawurlencode($m['titleSlug']) : $link, 'done' => !empty($m['hasFile'])];
        }
        usort($items, function ($a, $b) { return $a['ts'] - $b['ts']; });
      } elseif ($kind === 'upcoming_episodes') {
        $start = gmdate('Y-m-d\TH:i:s\Z', time() - 6 * 3600); $end = gmdate('Y-m-d', time() + $days * 86400);
        foreach ((array)und_get("$base/api/v3/calendar?start=$start&end=$end&unmonitored=false&includeSeries=true", $h + ['timeout' => 15]) as $e) {
          if (empty($e['airDateUtc'])) continue;
          $items[] = ['title' => (string)($e['series']['title'] ?? 'Unknown'), 'sub' => und_media_ep($e['seasonNumber'], $e['episodeNumber']) . (!empty($e['title']) ? ' · ' . $e['title'] : ''),
                      'ts' => strtotime($e['airDateUtc']), 'when' => 'Airs', 'poster' => und_media_poster($e['series']['images'] ?? []),
                      'href' => !empty($e['series']['titleSlug']) ? "$link/series/" . rawurlencode($e['series']['titleSlug']) : $link, 'done' => !empty($e['hasFile'])];
        }
        usort($items, function ($a, $b) { return $a['ts'] - $b['ts']; });
      } elseif ($kind === 'recent_movies') {
        // eventType 3 = downloadFolderImported: the moment a file landed in the library
        $j = und_get("$base/api/v3/history?page=1&pageSize=" . ($count * 2) . "&sortKey=date&sortDirection=descending&eventType=3&includeMovie=true", $h + ['timeout' => 15]);
        $seen = [];
        foreach ((array)($j['records'] ?? []) as $r) {
          $m = $r['movie'] ?? null; $mid = (int)($r['movieId'] ?? 0);
          if (!$m || isset($seen[$mid])) continue; $seen[$mid] = 1;
          $items[] = ['title' => (string)$m['title'], 'year' => (int)($m['year'] ?? 0), 'ts' => strtotime((string)$r['date']), 'when' => 'Added', 'poster' => und_media_poster($m['images'] ?? []),
                      'href' => !empty($m['titleSlug']) ? "$link/movie/" . rawurlencode($m['titleSlug']) : $link, 'quality' => (string)($r['quality']['quality']['name'] ?? '')];
        }
      } else {
        $j = und_get("$base/api/v3/history?page=1&pageSize=" . ($count * 2) . "&sortKey=date&sortDirection=descending&eventType=3&includeSeries=true&includeEpisode=true", $h + ['timeout' => 15]);
        $seen = [];
        foreach ((array)($j['records'] ?? []) as $r) {
          $e = $r['episode'] ?? null; $sr = $r['series'] ?? null; $eid = (int)($r['episodeId'] ?? 0);
          if (!$e || !$sr || isset($seen[$eid])) continue; $seen[$eid] = 1;
          $items[] = ['title' => (string)$sr['title'], 'sub' => und_media_ep($e['seasonNumber'], $e['episodeNumber']) . (!empty($e['title']) ? ' · ' . $e['title'] : ''), 'ts' => strtotime((string)$r['date']),
                      'when' => 'Added', 'poster' => und_media_poster($sr['images'] ?? []), 'href' => !empty($sr['titleSlug']) ? "$link/series/" . rawurlencode($sr['titleSlug']) : $link,
                      'quality' => (string)($r['quality']['quality']['name'] ?? '')];
        }
      }
      return ['items' => array_slice($items, 0, $count), 'app' => ['name' => $s['name'], 'href' => preg_match('#^https?://#', $link) ? $link : '']];
    } catch (Throwable $e) {
      return ['items' => [], 'error' => $s['name'] . ': ' . und_redact($e->getMessage(), [$s['key']])];
    }
  });
}
]]></INLINE>
<SHA256>46a0307e44faa387765ad415fa425144076a2abef5a2d544b82b887e5fce4022</SHA256>
</FILE>

<FILE Name="&emhttp;/include/arr.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - Arr Stack: one compact status per configured *arr / request app (several instances of the same app are fine).
 * Online state and version come from each app's status endpoint, warnings from its health endpoint, and failed or stuck
 * imports from its download queue. Numbers are the same ones the widgets already showed (und_w_*). Cached for 20 seconds.
 */

function und_arr_types() { return ['radarr', 'sonarr', 'lidarr', 'readarr', 'prowlarr', 'bazarr', 'overseerr', 'autobrr', 'wizarr']; }

/** API version path per app family. */
function und_arr_v($type) { return in_array($type, ['radarr', 'sonarr'], true) ? 'v3' : 'v1'; }

function und_arr_status(array $cfg, $id) {
  $s0 = null;
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $x) if ($x['id'] === $id) $s0 = $x;
  if (!$s0 || !in_array($s0['type'], und_arr_types(), true)) return ['error' => 'Unknown app.'];
  return und_api_cached('arr-' . $id, 20, function () use ($cfg, $id) {
    $s = und_service_full($cfg, $id);
    $out = ['online' => false, 'version' => '', 'blocks' => [], 'health' => [], 'issues' => [], 'href' => preg_match('#^https?://#', $s['href']) ? $s['href'] : ''];
    if (trim($s['url']) === '' || und_has($s['url'], '{{')) return $out + ['error' => 'No API URL configured.', 'unconfigured' => true];
    $base = rtrim($s['url'], '/'); $t = $s['type'];
    $w = und_fetch_service($cfg, $id);
    if (isset($w['error'])) return $out + ['error' => $w['error'], 'unconfigured' => !empty($w['unconfigured'])];
    $out['online'] = true;
    $out['blocks'] = $w['blocks'] ?? [];
    try {
      if (in_array($t, ['radarr', 'sonarr', 'lidarr', 'readarr', 'prowlarr'], true)) {
        $h = und_arr_h($s); $v = und_arr_v($t);
        $st = und_get("$base/api/$v/system/status", $h);
        $out['version'] = (string)($st['version'] ?? '');
        foreach ((array)und_get("$base/api/$v/health", $h) as $x) {
          $type = strtolower((string)($x['type'] ?? ''));
          if ($type === 'warning' || $type === 'error') $out['health'][] = ['level' => $type === 'error' ? 'bad' : 'warn', 'msg' => und_clip((string)($x['message'] ?? ''), 240), 'source' => (string)($x['source'] ?? '')];
        }
        if ($t !== 'prowlarr') {
          $q = und_get("$base/api/$v/queue?page=1&pageSize=50" . ($t === 'sonarr' ? '&includeSeries=true' : ($t === 'radarr' ? '&includeMovie=true' : '')), $h + ['timeout' => 15]);
          foreach ((array)($q['records'] ?? []) as $r) {
            $status = strtolower((string)($r['trackedDownloadStatus'] ?? '')); $state = strtolower((string)($r['trackedDownloadState'] ?? ''));
            if ($status !== 'warning' && $status !== 'error' && !in_array($state, ['importblocked', 'failedpending', 'failed'], true)) continue;
            $msg = (string)($r['errorMessage'] ?? '');
            if ($msg === '' && !empty($r['statusMessages'][0]['messages'][0])) $msg = (string)$r['statusMessages'][0]['messages'][0];
            $out['issues'][] = ['level' => $status === 'error' || strpos($state, 'fail') !== false ? 'bad' : 'warn', 'title' => und_clip((string)($r['title'] ?? $r['movie']['title'] ?? $r['series']['title'] ?? 'Download'), 120),
                                'msg' => und_clip($msg !== '' ? $msg : ucfirst($state ?: $status), 200)];
          }
        }
      } elseif ($t === 'bazarr') {
        $h = ['headers' => ['X-API-KEY' => $s['key']]];
        $st = und_get("$base/api/system/status", $h);
        $out['version'] = (string)($st['data']['bazarr_version'] ?? '');
        foreach ((array)(und_get("$base/api/system/health", $h)['data'] ?? []) as $x) $out['health'][] = ['level' => 'warn', 'msg' => und_clip((string)($x['issue'] ?? ''), 240), 'source' => (string)($x['object'] ?? '')];
      } elseif ($t === 'overseerr') {
        $st = und_get("$base/api/v1/status", und_arr_h($s));
        $out['version'] = (string)($st['version'] ?? '');
        if (!empty($st['updateAvailable'])) $out['health'][] = ['level' => 'warn', 'msg' => 'An update is available.', 'source' => ''];
      }
    } catch (Throwable $e) {
      // the app answered the widget call, so it is online; only the extra details failed
      $out['health'][] = ['level' => 'warn', 'msg' => 'Status details unavailable: ' . und_redact($e->getMessage(), [$s['key']]), 'source' => 'UnDash'];
    }
    return $out;
  });
}
]]></INLINE>
<SHA256>20489c835c661a64eef82d18cd98a5f20b58b6d947c6bc794e3c0510d945be68</SHA256>
</FILE>

<FILE Name="&emhttp;/include/downloads.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - download clients (qBittorrent, SABnzbd): connection, speeds, counts by state, the active items with progress
 * and ETA, and pause / resume of the whole client through the client's own API. Cached for 3 seconds.
 */

function und_dl_types() { return ['qbittorrent', 'sabnzbd']; }

function und_dl_service(array $cfg, $id) {
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $x) if ($x['id'] === $id && in_array($x['type'], und_dl_types(), true)) return und_service_full($cfg, $id);
  return null;
}

/** A qBittorrent request with its login cookie (logs in again once when the cookie expired). */
function und_qbit_req(array $s, $path, $method = 'GET', $body = null) {
  $cf = und_tmp('qbit-' . $s['id'] . '.sid');
  $login = function () use ($s, $cf) {
    $r = und_http('POST', und_u($s['url'], '/api/v2/auth/login'), ['body' => http_build_query(['username' => $s['username'], 'password' => $s['password']]),
      'headers' => ['Referer' => rtrim($s['url'], '/'), 'Content-Type' => 'application/x-www-form-urlencoded']]);
    if ($r['err'] !== '') throw new Exception($r['err']);
    $sid = '';
    foreach (($r['headers']['set-cookie'] ?? []) as $c) if (preg_match('/^(SID|QBT_SID_\d+)=([^;]+)/', $c, $m)) $sid = $m[1] . '=' . $m[2];
    if ($sid === '' && trim($r['body']) !== 'Ok.') throw new Exception('qBittorrent login failed (HTTP ' . $r['code'] . ').');
    @file_put_contents($cf, $sid); @chmod($cf, 0600);
    return $sid;
  };
  $sid = is_file($cf) ? (string)@file_get_contents($cf) : $login();
  $o = ['cookie' => $sid, 'timeout' => 15, 'headers' => ['Referer' => rtrim($s['url'], '/')]];
  if ($body !== null) { $o['body'] = $body; $o['headers']['Content-Type'] = 'application/x-www-form-urlencoded'; }
  $r = und_http($method, und_u($s['url'], $path), $o);
  if ($r['code'] === 403) { $o['cookie'] = $login(); $r = und_http($method, und_u($s['url'], $path), $o); }
  if ($r['err'] !== '') throw new Exception($r['err']);
  return $r;
}

function und_dl_status(array $cfg, $id) {
  $s = und_dl_service($cfg, $id);
  if (!$s) return ['error' => 'Unknown download client.'];
  return und_api_cached('dl-' . $id, 3, function () use ($s) {
    $out = ['online' => false, 'state' => 'disconnected', 'down' => null, 'up' => null, 'counts' => [], 'items' => [], 'href' => preg_match('#^https?://#', $s['href']) ? $s['href'] : '', 'type' => $s['type']];
    if (trim($s['url']) === '' || und_has($s['url'], '{{')) return $out + ['error' => 'No API URL configured.', 'unconfigured' => true];
    try {
      if ($s['type'] === 'qbittorrent') {
        $tr = und_qbit_req($s, '/api/v2/transfer/info')['json'];
        $list = und_qbit_req($s, '/api/v2/torrents/info')['json'];
        if (!is_array($list)) throw new Exception('qBittorrent did not answer.');
        $c = ['downloading' => 0, 'seeding' => 0, 'paused' => 0, 'stalled' => 0, 'queued' => 0, 'completed' => 0, 'error' => 0];
        $active = [];
        foreach ($list as $t) {
          $st = (string)($t['state'] ?? '');
          if (in_array($st, ['downloading', 'forcedDL', 'metaDL', 'forcedMetaDL', 'checkingDL', 'allocating'], true)) { $c['downloading']++; $active[] = $t; }
          elseif ($st === 'stalledDL') { $c['stalled']++; $active[] = $t; }
          elseif (in_array($st, ['pausedDL', 'stoppedDL', 'pausedUP', 'stoppedUP'], true)) $c['paused']++;
          elseif (in_array($st, ['queuedDL', 'queuedUP'], true)) $c['queued']++;
          elseif (in_array($st, ['uploading', 'forcedUP', 'stalledUP', 'checkingUP'], true)) $c['seeding']++;
          elseif (in_array($st, ['error', 'missingFiles'], true)) $c['error']++;
          if ((float)($t['progress'] ?? 0) >= 1) $c['completed']++;
        }
        usort($active, function ($a, $b) { return ($b['dlspeed'] ?? 0) <=> ($a['dlspeed'] ?? 0) ?: ($b['progress'] ?? 0) <=> ($a['progress'] ?? 0); });
        foreach (array_slice($active, 0, 8) as $t) {
          $eta = (int)($t['eta'] ?? 0);
          $out['items'][] = ['name' => und_clip((string)$t['name'], 140), 'progress' => round(100 * (float)$t['progress'], 1), 'speed' => (float)($t['dlspeed'] ?? 0),
                             'eta' => $eta > 0 && $eta < 8640000 ? $eta : null, 'state' => $t['state'] === 'stalledDL' ? 'stalled' : 'downloading', 'size' => (float)($t['size'] ?? 0)];
        }
        $conn = (string)($tr['connection_status'] ?? 'connected');
        $out = array_merge($out, ['online' => true, 'down' => (float)($tr['dl_info_speed'] ?? 0), 'up' => (float)($tr['up_info_speed'] ?? 0), 'counts' => $c,
          'state' => $conn === 'disconnected' ? 'disconnected' : ($c['downloading'] ? 'downloading' : ($c['stalled'] ? 'stalled' : ($c['paused'] && !$c['seeding'] && !$c['queued'] ? 'paused' : 'idle'))),
          'note' => $conn === 'firewalled' ? 'Firewalled: incoming connections are blocked.' : '', 'can_pause' => true]);
      } else {
        $q = und_get(und_u($s['url'], '/api?output=json&mode=queue&limit=8&apikey=' . rawurlencode($s['key'])));
        if (isset($q['error'])) throw new Exception('SABnzbd: ' . $q['error']);
        $qq = $q['queue'] ?? [];
        $hist = und_get(und_u($s['url'], '/api?output=json&mode=history&limit=1&apikey=' . rawurlencode($s['key'])));
        $paused = !empty($qq['paused']);
        foreach ((array)($qq['slots'] ?? []) as $sl) {
          $left = (string)($sl['timeleft'] ?? '');
          $sec = preg_match('/^(\d+):(\d+):(\d+)$/', $left, $m) ? $m[1] * 3600 + $m[2] * 60 + $m[3] : null;
          $out['items'][] = ['name' => und_clip((string)($sl['filename'] ?? ''), 140), 'progress' => (float)($sl['percentage'] ?? 0), 'speed' => null, 'eta' => $sec ?: null,
                             'state' => strtolower((string)($sl['status'] ?? '')) === 'paused' || $paused ? 'paused' : (strtolower((string)($sl['status'] ?? '')) === 'downloading' ? 'downloading' : 'queued'),
                             'size' => (float)($sl['mb'] ?? 0) * 1048576];
        }
        $total = (int)($qq['noofslots_total'] ?? $qq['noofslots'] ?? 0);
        $failed = 0;
        $out = array_merge($out, ['online' => true, 'down' => (float)($qq['kbpersec'] ?? 0) * 1024, 'up' => null,
          'counts' => ['downloading' => $total && !$paused ? 1 : 0, 'queued' => max(0, $total - ($paused ? 0 : 1)), 'paused' => $paused ? $total : 0, 'completed' => (int)($hist['history']['noofslots'] ?? 0)],
          'state' => $paused ? 'paused' : ($total ? 'downloading' : 'idle'), 'eta' => (string)($qq['timeleft'] ?? ''), 'can_pause' => true, 'paused' => $paused]);
      }
    } catch (Throwable $e) {
      $out['error'] = und_redact($e->getMessage(), [$s['key'], $s['password']]);
    }
    return $out;
  });
}

/** Pause or resume everything in a client. */
function und_dl_action(array $cfg, $id, $op) {
  if (!in_array($op, ['pause', 'resume'], true)) return ['error' => 'Unknown action.'];
  $s = und_dl_service($cfg, $id);
  if (!$s) return ['error' => 'Unknown download client.'];
  $lock = und_lock('dl:' . $id);
  if (!$lock) return ['error' => 'Another action on ' . $s['name'] . ' is still running.'];
  try {
    if ($s['type'] === 'qbittorrent') {
      // qBittorrent 5 renamed pause / resume to stop / start; older versions answer 404 to the new names
      $r = und_qbit_req($s, '/api/v2/torrents/' . ($op === 'pause' ? 'stop' : 'start'), 'POST', 'hashes=all');
      if ($r['code'] === 404) $r = und_qbit_req($s, '/api/v2/torrents/' . $op, 'POST', 'hashes=all');
      if ($r['code'] !== 200) throw new Exception('qBittorrent answered HTTP ' . $r['code'] . '.');
    } else {
      $j = und_get(und_u($s['url'], '/api?output=json&mode=' . $op . '&apikey=' . rawurlencode($s['key'])));
      if (empty($j['status'])) throw new Exception('SABnzbd did not confirm the ' . $op . '.');
    }
    und_unlock($lock);
    @unlink(und_tmp('api-dl-' . $id . '.json'));
    und_history_add('download', $s['name'], $op, true, 'all downloads');
    return ['ok' => true];
  } catch (Throwable $e) {
    und_unlock($lock);
    $m = und_redact($e->getMessage(), [$s['key'], $s['password']]);
    und_history_add('download', $s['name'], $op, false, $m);
    return ['error' => $s['name'] . ': ' . $m];
  }
}
]]></INLINE>
<SHA256>cda7a5f8385d5bc9fa00f5b8c177fd6d0763cf1a38ff191ffbe5719312e7284d</SHA256>
</FILE>

<FILE Name="&emhttp;/include/ignores.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - ignored alerts. Alerts are still worked out on every refresh; an ignore rule only hides a matching alert
 * from the dashboard, so monitoring never stops and an ignored alert comes back as soon as its rule is removed or runs
 * out while the condition is still there. Rules live in ignores.json in the configuration directory (mirrored to the
 * flash drive like config.json), so they survive plugin updates and container re-creation.
 *
 * A rule hides either one alert (kind "instance", key "<category>:<resource>", e.g. "disk.hot:disk3") or every alert
 * of a category (kind "type", key "<category>"). until is a Unix time, or null for "permanently".
 */

/** The alert categories the dashboard raises and lets you ignore. Connection and sign-in alerts are never ignorable. */
function und_alert_categories() {
  return ['docker.unhealthy' => 'Container unhealthy', 'docker.restarting' => 'Container restarting', 'docker.exited' => 'Container stopped with an error',
          'docker.update_failed' => 'Container update failed', 'array.state' => 'Array not started', 'array.resync' => 'Parity operation running',
          'disk.bad' => 'Disk disabled or missing', 'disk.errors' => 'Disk read/write errors', 'disk.hot' => 'Disk temperature',
          'os.staged' => 'Unraid update waiting for restart', 'os.available' => 'Unraid update available', 'os.check_failed' => 'Unraid update check failed',
          'api.error' => 'Unraid API problem', 'auth.open' => 'No dashboard password'];
}

const UND_IGNORE_MAX = 500;
const UND_IGNORE_MIN_S = 300;            // 5 minutes
const UND_IGNORE_MAX_S = 366 * 86400;    // a year; longer than that is "permanently"

function und_ignore_file() { return und_file('ignores.json'); }

/** Valid rules only: anything malformed in the file is dropped instead of breaking the dashboard. */
function und_ignore_clean($list) {
  $cats = und_alert_categories(); $out = []; $seen = [];
  foreach (is_array($list) ? $list : [] as $r) {
    if (!is_array($r)) continue;
    $kind = (string)($r['kind'] ?? ''); $cat = (string)($r['category'] ?? ''); $res = (string)($r['resource'] ?? '');
    if (!isset($cats[$cat]) || !in_array($kind, ['instance', 'type'], true)) continue;
    if ($kind === 'instance' && !und_ignore_res_ok($res)) continue;
    $key = $kind === 'type' ? $cat : $cat . ':' . $res;
    $id = (string)($r['id'] ?? '');
    if (!preg_match('/^[a-f0-9]{12}$/', $id) || isset($seen[$id]) || isset($seen["$kind|$key"])) continue;
    $until = $r['until'] ?? null;
    $out[] = ['id' => $id, 'kind' => $kind, 'key' => $key, 'category' => $cat, 'resource' => $kind === 'type' ? '' : $res,
              'until' => $until === null ? null : (int)$until, 'created' => (int)($r['created'] ?? 0),
              'title' => und_clip((string)($r['title'] ?? ''), 200), 'severity' => in_array($r['severity'] ?? '', ['bad', 'warn', 'info'], true) ? $r['severity'] : 'warn'];
    $seen[$id] = 1; $seen["$kind|$key"] = 1;
  }
  return array_slice($out, 0, UND_IGNORE_MAX);
}

/** Container names, disk names, versions, array states: letters, digits and a few separators. */
function und_ignore_res_ok($res) { return is_string($res) && preg_match('/^[A-Za-z0-9][A-Za-z0-9_.+@ -]{0,127}$/', $res) === 1; }

function und_ignores() { return und_ignore_clean(und_read_json(und_ignore_file(), [])); }

/** The rules still in force at $now (what the live refresh sends with every answer). */
function und_ignores_active($now = null) {
  $now = $now ?? time();
  return array_values(array_filter(und_ignores(), function ($r) use ($now) { return $r['until'] === null || $r['until'] > $now; }));
}

/** Read, change and write the rules under one lock, so two browser tabs cannot lose each other's changes. */
function und_ignore_edit(callable $fn) {
  @mkdir(und_tmp('locks'), 0755, true);
  $fp = @fopen(und_tmp('locks/ignores.lock'), 'c');
  if (!$fp || !flock($fp, LOCK_EX)) { if ($fp) fclose($fp); return ['error' => 'The ignore list is busy. Try again.']; }
  try {
    $list = und_ignores();
    $res = $fn($list);
    if (isset($res['error'])) return $res;
    // keep expired rules a month so Settings can show them, then let them go
    $old = time() - 30 * 86400;
    $list = array_values(array_filter($list, function ($r) use ($old) { return $r['until'] === null || $r['until'] > $old; }));
    if (!und_store_write('ignores.json', json_encode(und_ignore_clean($list), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES))) return ['error' => 'The ignore list could not be saved.'];
    return $res + ['ok' => true];
  } finally { flock($fp, LOCK_UN); fclose($fp); }
}

/** duration: seconds, or "permanent". Ignoring the same alert again replaces the old rule. */
function und_ignore_add($kind, $cat, $res, $duration, $title = '', $severity = 'warn') {
  $cats = und_alert_categories();
  if (!in_array($kind, ['instance', 'type'], true)) return ['error' => 'Unknown ignore scope.'];
  if (!isset($cats[$cat])) return ['error' => 'This alert cannot be ignored.'];
  if ($kind === 'instance' && !und_ignore_res_ok($res)) return ['error' => 'Unknown alert.'];
  if ($duration === 'permanent') $until = null;
  elseif (is_numeric($duration) && (int)$duration == $duration && $duration >= UND_IGNORE_MIN_S && $duration <= UND_IGNORE_MAX_S) $until = time() + (int)$duration;
  else return ['error' => 'Choose a duration between 5 minutes and a year, or permanently.'];
  $key = $kind === 'type' ? $cat : $cat . ':' . $res;
  return und_ignore_edit(function (&$list) use ($kind, $cat, $res, $key, $until, $title, $severity) {
    $list = array_values(array_filter($list, function ($r) use ($kind, $key) { return !($r['kind'] === $kind && $r['key'] === $key); }));
    if (count($list) >= UND_IGNORE_MAX) return ['error' => 'Too many ignored alerts. Restore or delete some in Settings first.'];
    $rule = ['id' => bin2hex(random_bytes(6)), 'kind' => $kind, 'key' => $key, 'category' => $cat, 'resource' => $kind === 'type' ? '' : $res,
             'until' => $until, 'created' => time(), 'title' => und_clip((string)$title, 200), 'severity' => in_array($severity, ['bad', 'warn', 'info'], true) ? $severity : 'warn'];
    $list[] = $rule;
    return ['rule' => $rule];
  });
}

/** Remove the rules with these ids. Unknown ids are ignored, so a stale tab cannot remove anything else. */
function und_ignore_remove(array $ids) {
  $ids = array_values(array_filter($ids, function ($i) { return is_string($i) && preg_match('/^[a-f0-9]{12}$/', $i); }));
  if (!$ids) return ['error' => 'Nothing to restore.'];
  return und_ignore_edit(function (&$list) use ($ids) {
    $n = count($list);
    $list = array_values(array_filter($list, function ($r) use ($ids) { return !in_array($r['id'], $ids, true); }));
    return ['removed' => $n - count($list)];
  });
}

function und_ignore_restore_all() {
  return und_ignore_edit(function (&$list) { $n = count($list); $list = []; return ['removed' => $n]; });
}

function und_ignore_purge_expired() {
  return und_ignore_edit(function (&$list) {
    $now = time(); $n = count($list);
    $list = array_values(array_filter($list, function ($r) use ($now) { return $r['until'] === null || $r['until'] > $now; }));
    return ['removed' => $n - count($list)];
  });
}
]]></INLINE>
<SHA256>fbcbd6b5641d1b4156896c59f162e1807c3717f7de135f9c7612207f61f09768</SHA256>
</FILE>

<FILE Name="&emhttp;/include/alerts.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - alerts: what is wrong right now, worked out on the server from the same data the dashboard shows, plus a
 * history of when each problem started and ended. The live refresh evaluates them for the page; scripts/alertcheck.php
 * does it once a minute in the background, so the history is complete even when no dashboard is open.
 *
 * Each alert: lv (bad | warn | info), msg, cat (an id from und_alert_categories()), res (the disk, container, version …)
 * and act (the button the page shows: logs | settings | restart | os, or '').
 */

/** The alerts for one snapshot. $sys = und_system(), $dk = und_docker_live() (either may be null when not loaded). */
function und_alerts(array $cfg, $sys, $dk) {
  $out = [];
  $add = function ($lv, $msg, $cat, $res, $act = '') use (&$out) { $out[] = ['lv' => $lv, 'msg' => $msg, 'cat' => $cat, 'res' => (string)$res, 'act' => $act]; };
  if (is_array($sys) && isset($sys['error'])) {
    $add('bad', $sys['error'] . (!empty($sys['auth']) ? ' Check Settings > Connection.' : ''), 'api.error', 'unraid', 'settings');
  } elseif (is_array($sys)) {
    $a = $sys['array'] ?? [];
    $st = (string)($a['state'] ?? '');
    if ($st !== '' && $st !== 'STARTED') $add('warn', 'The array is ' . strtolower($st) . '. Shares, containers and VMs on it are unavailable.', 'array.state', $st);
    if (!empty($a['resync'])) $add('info', ($a['resync_action'] ?: 'A parity operation') . ' is running' . (isset($a['resync_pct']) && $a['resync_pct'] !== null ? ' (' . $a['resync_pct'] . '%)' : '') . '.', 'array.resync', 'array');
    foreach ((array)($a['bad_disks'] ?? []) as $n) $add('bad', $n . ' is disabled, missing or emulated. Check Main in Unraid.', 'disk.bad', $n);
    foreach ((array)($a['error_disks'] ?? []) as $d) $add('bad', $d['name'] . ' reported ' . $d['errors'] . ' read/write error' . ($d['errors'] > 1 ? 's' : '') . '.', 'disk.errors', $d['name']);
    foreach ((array)($a['hot_disks'] ?? []) as $d) $add('warn', $d['name'] . ' is at ' . $d['temp'] . '°C.', 'disk.hot', $d['name']);
    $o = $sys['os_update'] ?? [];
    if (!empty($o['staged'])) $add('info', 'Unraid ' . $o['staged'] . ' is installed and becomes active after a restart.', 'os.staged', $o['staged'], 'restart');
    elseif (!empty($o['available'])) $add('info', 'Unraid ' . $o['latest'] . ' is available (running ' . $o['installed'] . ').', 'os.available', $o['latest'], 'os');
    if (!empty($o['error']) && empty($o['available'])) $add('warn', 'The Unraid update check failed: ' . $o['error'], 'os.check_failed', 'server');
  }
  if (is_array($dk) && !isset($dk['error'])) {
    $items = (array)($cfg['docker']['items'] ?? []);
    foreach ((array)($dk['containers'] ?? []) as $c) {
      $p = (array)($items[$c['name']] ?? []);
      if (!empty($p['hidden'])) continue;
      $nm = ($p['label'] ?? '') !== '' ? $p['label'] : $c['name'];
      if (($c['health'] ?? '') === 'unhealthy') $add('bad', $nm . ' is unhealthy.', 'docker.unhealthy', $c['name'], 'logs');
      elseif (($c['state'] ?? '') === 'restarting') $add('bad', $nm . ' keeps restarting' . (!empty($c['restarts']) ? ' (' . $c['restarts'] . ' restarts)' : '') . '.', 'docker.restarting', $c['name'], 'logs');
      elseif (($c['state'] ?? '') === 'exited' && !empty($c['exit']) && !empty($c['autostart'])) $add('warn', $nm . ' stopped with exit code ' . $c['exit'] . '.', 'docker.exited', $c['name'], 'logs');
      if (($c['job'] ?? '') === 'update_failed') $add('bad', 'The update of ' . $nm . ' failed.', 'docker.update_failed', $c['name'], 'logs');
    }
  }
  return $out;
}

/* ---------- history ---------- */

const UND_ALERT_LOG_MAX = 300;

function und_alert_file() { return und_store_dir() . '/alert-history.json'; }

/**
 * Records starts and ends. $scopes says which categories this snapshot actually checked ('system', 'docker'): an
 * alert of a category that was not checked (for example containers, when Docker did not answer) stays open.
 * The file is only written when something starts or ends, so the 2-second refresh does not wear the disk.
 */
function und_alerts_track(array $alerts, array $scopes, $now = null) {
  $now = $now ?? time();
  @mkdir(und_tmp('locks'), 0755, true);
  $fp = @fopen(und_tmp('locks/alert-history.lock'), 'c');
  if ($fp) flock($fp, LOCK_EX);
  $h = und_read_json(und_alert_file(), []);
  $act = is_array($h['active'] ?? null) ? $h['active'] : [];
  $log = is_array($h['log'] ?? null) ? $h['log'] : [];
  $changed = false; $seen = [];
  foreach ($alerts as $a) {
    $k = $a['cat'] . ':' . $a['res'];
    $seen[$k] = 1;
    if (!isset($act[$k])) { $act[$k] = ['cat' => $a['cat'], 'res' => $a['res'], 'lv' => $a['lv'], 'msg' => und_clip($a['msg'], 300), 'start' => $now]; $changed = true; }
  }
  foreach ($act as $k => $a) {
    if (isset($seen[$k])) continue;
    $scope = strpos((string)$a['cat'], 'docker.') === 0 ? 'docker' : 'system';
    if (!in_array($scope, $scopes, true)) continue;
    $log[] = $a + ['end' => $now];
    unset($act[$k]); $changed = true;
  }
  if ($changed) {
    $old = $now - 30 * 86400;
    $log = array_values(array_filter($log, function ($e) use ($old) { return (int)($e['end'] ?? 0) >= $old; }));
    $log = array_slice($log, -UND_ALERT_LOG_MAX);
    @mkdir(dirname(und_alert_file()), 0755, true);
    und_write_json(und_alert_file(), ['active' => $act, 'log' => $log]);
  }
  if ($fp) { flock($fp, LOCK_UN); fclose($fp); }
  return $changed;
}

/** For the page: open problems first, then ended ones, newest first. */
function und_alert_history() {
  $h = und_read_json(und_alert_file(), []);
  $act = array_values(array_filter((array)($h['active'] ?? []), 'is_array'));
  usort($act, function ($a, $b) { return (int)$b['start'] - (int)$a['start']; });
  $log = array_reverse(array_values(array_filter((array)($h['log'] ?? []), 'is_array')));
  return ['now' => time(), 'active' => $act, 'log' => array_slice($log, 0, 200)];
}

/** One background check (scripts/alertcheck.php): the full system and container state, then the history. */
function und_alerts_check() {
  $cfg = und_load_config();
  $sys = und_system($cfg);
  $dk = und_docker_live();
  $scopes = isset($sys['error']) ? [] : ['system'];
  if (is_array($dk) && !isset($dk['error'])) $scopes[] = 'docker';
  $alerts = und_alerts($cfg, $sys, $dk);
  und_alerts_track($alerts, $scopes);
  @file_put_contents(und_tmp('alertcheck.at'), (string)time());
  return count($alerts);
}
]]></INLINE>
<SHA256>cc6bf742dd366c2b65f1e662e7c7f8f0568f811db00871c512b01dbd5ffdbc0d</SHA256>
</FILE>

<FILE Name="&emhttp;/include/health.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - endpoint health: is every app and container web UI answering, with which HTTP status, how fast.
 * Only addresses UnDash already knows are probed: the links of the apps in Settings > Apps and the web UI labels of
 * running containers. Nothing the browser sends becomes a URL. All probes run in parallel; results are cached 60 s.
 */

/** host:port of a URL, without user info, path or query (what the page shows). */
function und_health_hostport($u) {
  $p = parse_url($u);
  if (!$p || empty($p['host'])) return '';
  $port = $p['port'] ?? (strtolower($p['scheme'] ?? 'http') === 'https' ? 443 : 80);
  return $p['host'] . ':' . $port;
}

/** The list to probe: apps first (they have names you chose), then container web UIs that no app already covers. */
function und_health_targets(array $cfg, $docker = null) {
  $out = []; $seen = [];
  $view = und_layout_view($cfg);
  foreach ($view['groups'] as $g) foreach ($g['services'] as $s) {
    if (!empty($s['hidden'])) continue;
    $u = (string)($s['href_resolved'] ?? '');
    if (!preg_match('#^https?://#i', $u)) continue;
    $hp = und_health_hostport($u);
    if ($hp === '' || isset($seen[$hp])) continue;
    $seen[$hp] = 1;
    $out[] = ['name' => $s['name'], 'kind' => 'app', 'group' => $g['name'] ?? '', 'url' => $u, 'hostport' => $hp, 'icon' => $s['icon'] ?? ''];
  }
  $items = (array)($cfg['docker']['items'] ?? []);
  foreach ((array)($docker['containers'] ?? []) as $c) {
    if (($c['state'] ?? '') !== 'running' || !preg_match('#^https?://#i', (string)($c['webui'] ?? ''))) continue;
    $p = (array)($items[$c['name']] ?? []);
    if (!empty($p['hidden'])) continue;
    $hp = und_health_hostport($c['webui']);
    if ($hp === '' || isset($seen[$hp])) continue;
    $seen[$hp] = 1;
    $out[] = ['name' => ($p['label'] ?? '') !== '' ? $p['label'] : $c['name'], 'kind' => 'container', 'group' => 'container', 'url' => $c['webui'], 'hostport' => $hp, 'icon' => $p['icon'] ?? $c['icon'] ?? ''];
  }
  return array_slice($out, 0, 120);
}

function und_health_reason($code) {
  $r = [200 => 'OK', 201 => 'Created', 204 => 'No content', 301 => 'Redirect', 302 => 'Redirect', 303 => 'Redirect', 307 => 'Redirect', 308 => 'Redirect',
        400 => 'Bad request', 401 => 'Login required', 403 => 'Forbidden', 404 => 'Not found', 405 => 'Method not allowed', 500 => 'Server error',
        502 => 'Bad gateway', 503 => 'Unavailable', 504 => 'Gateway timeout'];
  return $r[$code] ?? ($code >= 500 ? 'Server error' : ($code >= 400 ? 'Client error' : ($code >= 300 ? 'Redirect' : 'OK')));
}

/** Probes in parallel. A GET without following redirects; the body is not downloaded (the transfer stops at the first byte). */
function und_health_probe(array $targets) {
  if (isset($GLOBALS['UND_HEALTH_MOCK'])) return call_user_func($GLOBALS['UND_HEALTH_MOCK'], $targets);
  $mh = curl_multi_init(); $hs = [];
  foreach ($targets as $i => $t) {
    $ch = curl_init($t['url']);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => false, CURLOPT_CONNECTTIMEOUT => 3, CURLOPT_TIMEOUT => 5,
      CURLOPT_SSL_VERIFYPEER => false, CURLOPT_SSL_VERIFYHOST => 0, CURLOPT_USERAGENT => 'UnDash/' . UND_VERSION . ' (health check)', CURLOPT_NOSIGNAL => true,
      CURLOPT_WRITEFUNCTION => function ($c, $data) { return 0; }]);      // stop after the headers: the status is all we need
    curl_multi_add_handle($mh, $ch); $hs[$i] = $ch;
  }
  do { $st = curl_multi_exec($mh, $running); if ($running) curl_multi_select($mh, 0.5); } while ($running && $st === CURLM_OK);
  $res = [];
  foreach ($hs as $i => $ch) {
    $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
    $ms = (int)round(1000 * (float)curl_getinfo($ch, CURLINFO_TOTAL_TIME));
    $errno = curl_errno($ch);
    // aborting the body on purpose shows up as a write error; anything else with no status is a real failure
    $err = $code > 0 ? '' : ($errno === 28 ? 'No answer (timed out)' : ($errno === 7 ? 'Connection refused' : (curl_error($ch) ?: 'No answer')));
    $res[$i] = ['code' => $code, 'ms' => $code > 0 ? $ms : null, 'err' => $err];
    curl_multi_remove_handle($mh, $ch); curl_close($ch);
  }
  curl_multi_close($mh);
  return $res;
}

/** The section's data. $force probes again now (at most every 10 seconds). */
function und_health(array $cfg, $force = false) {
  $f = und_tmp('health.json');
  $c = und_read_json($f, null);
  $age = is_array($c) ? time() - (int)($c['at'] ?? 0) : PHP_INT_MAX;
  if (is_array($c) && ($age < 60 && !$force || $age < 10)) return $c;
  $lock = und_lock('health');
  if (!$lock) return is_array($c) ? $c : ['at' => time(), 'rows' => [], 'busy' => true];
  $targets = und_health_targets($cfg, und_docker_live());
  $probe = und_health_probe($targets);
  $rows = [];
  foreach ($targets as $i => $t) {
    $p = $probe[$i] ?? ['code' => 0, 'ms' => null, 'err' => 'No answer'];
    $code = (int)$p['code'];
    $rows[] = ['name' => $t['name'], 'kind' => $t['kind'], 'group' => $t['group'], 'url' => $t['url'], 'hostport' => $t['hostport'], 'icon' => $t['icon'],
               'code' => $code, 'text' => $code ? $code . ' ' . und_health_reason($code) : $p['err'], 'ms' => $p['ms'],
               'level' => !$code ? 'bad' : ($code >= 500 ? 'bad' : ($code >= 400 && !in_array($code, [401, 403], true) ? 'warn' : 'ok'))];
  }
  // problems first, then by name
  $rank = ['bad' => 0, 'warn' => 1, 'ok' => 2];
  usort($rows, function ($a, $b) use ($rank) { return $rank[$a['level']] - $rank[$b['level']] ?: strcasecmp($a['name'], $b['name']); });
  $out = ['at' => time(), 'rows' => $rows, 'up' => count(array_filter($rows, function ($r) { return $r['code'] > 0; })), 'total' => count($rows)];
  und_write_json($f, $out);
  und_unlock($lock);
  return $out;
}
]]></INLINE>
<SHA256>507ce9bafa38ed08d878ce86dbe0c81259d149b56d8e198674826576811d6582</SHA256>
</FILE>

<FILE Name="&emhttp;/include/playing.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - now playing: every active stream on the configured Plex, Emby, Jellyfin and Tautulli apps, with who is
 * watching on what, progress, and whether it is direct play or a transcode. When Tautulli is set up it reports Plex
 * (with more detail), so Plex itself is not asked as well and nothing is listed twice. Cached for 5 seconds.
 */

function und_playing_sources(array $cfg) {
  $list = [];
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) if (in_array($s['type'], ['plex', 'emby', 'jellyfin', 'tautulli'], true)) $list[] = $s;
  $haveTautulli = (bool)array_filter($list, function ($s) { return $s['type'] === 'tautulli'; });
  return array_values(array_filter($list, function ($s) use ($haveTautulli) { return !($haveTautulli && $s['type'] === 'plex'); }));
}

function und_playing_method($m) {
  $m = strtolower((string)$m);
  if ($m === 'transcode') return 'transcode';
  if ($m === 'copy' || $m === 'directstream' || $m === 'direct stream') return 'direct stream';
  return $m === '' ? '' : 'direct play';
}

function und_playing_ep($series, $season, $ep, $name) { return [$series, 'S' . sprintf('%02d', (int)$season) . 'E' . sprintf('%02d', (int)$ep) . ($name !== '' ? ' · ' . $name : '')]; }

function und_playing_one(array $cfg, $id) {
  $s = und_service_full($cfg, $id);
  if (trim($s['url']) === '' || und_has($s['url'], '{{')) return ['error' => $s['name'] . ' has no API URL yet.'];
  $out = [];
  if ($s['type'] === 'tautulli') {
    foreach ((array)(und_tautulli($s, ['cmd' => 'get_activity'])['sessions'] ?? []) as $x) {
      $ep = ($x['media_type'] ?? '') === 'episode';
      [$t, $sub] = $ep ? und_playing_ep($x['grandparent_title'] ?? '', $x['parent_media_index'] ?? 0, $x['media_index'] ?? 0, (string)($x['title'] ?? ''))
                       : [(string)($x['title'] ?? $x['full_title'] ?? ''), !empty($x['year']) ? (string)$x['year'] : ''];
      $out[] = ['title' => $t, 'sub' => $sub, 'user' => (string)($x['friendly_name'] ?? $x['user'] ?? ''), 'device' => trim(($x['player'] ?? '') . (isset($x['product']) && $x['product'] !== ($x['player'] ?? '') ? ' · ' . $x['product'] : '')),
        'state' => (string)($x['state'] ?? 'playing'), 'pos' => (int)((int)($x['view_offset'] ?? 0) / 1000), 'dur' => (int)((int)($x['duration'] ?? 0) / 1000),
        'method' => und_playing_method($x['transcode_decision'] ?? ''), 'quality' => (string)($x['quality_profile'] ?? $x['stream_video_full_resolution'] ?? ''),
        'bandwidth' => isset($x['bandwidth']) && $x['bandwidth'] !== '' ? (int)$x['bandwidth'] * 1000 : null, 'location' => strtolower((string)($x['location'] ?? ''))];
    }
  } elseif ($s['type'] === 'plex') {
    $j = und_get(und_u($s['url'], '/status/sessions'), ['headers' => ['X-Plex-Token' => $s['key'], 'Accept' => 'application/json']]);
    foreach ((array)($j['MediaContainer']['Metadata'] ?? []) as $x) {
      $ep = ($x['type'] ?? '') === 'episode';
      [$t, $sub] = $ep ? und_playing_ep($x['grandparentTitle'] ?? '', $x['parentIndex'] ?? 0, $x['index'] ?? 0, (string)($x['title'] ?? ''))
                       : [(string)($x['title'] ?? ''), !empty($x['year']) ? (string)$x['year'] : ''];
      $ts = $x['TranscodeSession'] ?? null;
      $out[] = ['title' => $t, 'sub' => $sub, 'user' => (string)($x['User']['title'] ?? ''), 'device' => trim(($x['Player']['title'] ?? '') . (!empty($x['Player']['product']) ? ' · ' . $x['Player']['product'] : '')),
        'state' => (string)($x['Player']['state'] ?? 'playing'), 'pos' => (int)((int)($x['viewOffset'] ?? 0) / 1000), 'dur' => (int)((int)($x['duration'] ?? 0) / 1000),
        'method' => $ts ? und_playing_method($ts['videoDecision'] ?? 'transcode') : 'direct play', 'quality' => (string)($x['Media'][0]['videoResolution'] ?? ''),
        'bandwidth' => isset($x['Session']['bandwidth']) ? (int)$x['Session']['bandwidth'] * 1000 : null, 'location' => strtolower((string)($x['Session']['location'] ?? ''))];
    }
  } else {
    $base = rtrim($s['url'], '/'); $pre = $s['type'] === 'emby' && !und_ends($base, '/emby') ? '/emby' : '';
    $j = und_get($base . $pre . '/Sessions', ['headers' => ['X-Emby-Token' => $s['key'], 'Accept' => 'application/json']]);
    foreach ((array)$j as $x) {
      if (empty($x['NowPlayingItem'])) continue;
      $n = $x['NowPlayingItem'];
      [$t, $sub] = !empty($n['SeriesName']) ? und_playing_ep($n['SeriesName'], $n['ParentIndexNumber'] ?? 0, $n['IndexNumber'] ?? 0, (string)($n['Name'] ?? ''))
                                           : [(string)($n['Name'] ?? ''), !empty($n['ProductionYear']) ? (string)$n['ProductionYear'] : ''];
      $w = (int)($n['Width'] ?? 0);
      $out[] = ['title' => $t, 'sub' => $sub, 'user' => (string)($x['UserName'] ?? ''), 'device' => trim(($x['DeviceName'] ?? '') . (!empty($x['Client']) ? ' · ' . $x['Client'] : '')),
        'state' => !empty($x['PlayState']['IsPaused']) ? 'paused' : 'playing', 'pos' => (int)(($x['PlayState']['PositionTicks'] ?? 0) / 10000000), 'dur' => (int)(($n['RunTimeTicks'] ?? 0) / 10000000),
        'method' => und_playing_method($x['PlayState']['PlayMethod'] ?? ''), 'quality' => $w >= 3800 ? '4K' : ($w >= 1900 ? '1080p' : ($w >= 1260 ? '720p' : ($w ? 'SD' : ''))),
        'bandwidth' => isset($x['TranscodingInfo']['Bitrate']) ? (int)$x['TranscodingInfo']['Bitrate'] : null, 'location' => ''];
    }
  }
  return ['streams' => $out];
}

function und_playing(array $cfg) {
  $src = und_playing_sources($cfg);
  if (!$src) return ['unconfigured' => true, 'streams' => [], 'apps' => []];
  return und_api_cached('playing', 5, function () use ($cfg, $src) {
    $streams = []; $apps = [];
    foreach ($src as $s) {
      try { $r = und_playing_one($cfg, $s['id']); }
      catch (Throwable $e) { $full = und_service_full($cfg, $s['id']); $r = ['error' => und_redact($e->getMessage(), [$full['key']])]; }
      $apps[] = ['name' => $s['name'], 'type' => $s['type'], 'icon' => $s['icon'], 'error' => $r['error'] ?? '', 'count' => count($r['streams'] ?? [])];
      foreach ($r['streams'] ?? [] as $x) $streams[] = $x + ['app' => $s['name'], 'app_type' => $s['type'], 'icon' => $s['icon']];
    }
    // playing before buffering before paused, then by user
    $rank = function ($st) { return $st === 'playing' ? 0 : ($st === 'paused' ? 2 : 1); };
    usort($streams, function ($a, $b) use ($rank) { return $rank($a['state']) - $rank($b['state']) ?: strcasecmp($a['user'], $b['user']); });
    return ['streams' => $streams, 'apps' => $apps];
  });
}
]]></INLINE>
<SHA256>5e00f2d43968077c1e919232f0b4cf529185f22ff543af3beaf4a8ce78a4cd03</SHA256>
