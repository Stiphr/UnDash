<FILE Name="&emhttp;/include/system.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - system information, read straight from the kernel and from Unraid's own state files (no Glances needed).
 * Rates (CPU, network) are the difference to the previous sample, kept in /tmp/undash so every poll is cheap.
 */

/** Jiffies for the whole CPU ("cpu") and for every core ("cpu0", "cpu1" ...). */
function und_cpu_sample() {
  $out = [];
  foreach (explode("\n", und_read('/proc/stat')) as $l) {
    if (!preg_match('/^cpu(\d*)\s+(.+)$/', $l, $m)) continue;
    $p = array_map('intval', preg_split('/\s+/', trim($m[2])));
    $out[$m[1] === '' ? 'all' : (int)$m[1]] = [array_sum(array_slice($p, 0, 8)), ($p[3] ?? 0) + ($p[4] ?? 0)];
  }
  return $out ?: null;
}

function und_cpu_pct($now, $prev) {
  $dTot = $now[0] - $prev[0]; $dIdle = $now[1] - $prev[1];
  return $dTot > 0 ? max(0, min(100, round(100 * ($dTot - $dIdle) / $dTot, 1))) : 0;
}

/** The interface of the default route. Unraid's macvlan "shim-" interfaces only mirror a bridge, so the bridge itself is preferred. */
function und_net_iface() {
  $found = [];
  foreach (array_slice(explode("\n", und_read('/proc/net/route')), 1) as $l) {
    $c = preg_split('/\s+/', trim($l));
    if (count($c) > 2 && $c[1] === '00000000') $found[] = $c[0];
  }
  foreach ($found as $f) if (strpos($f, 'shim-') !== 0) return $f;
  return $found ? substr($found[0], 5) : '';
}

function und_net_sample($if) {
  foreach (explode("\n", und_read('/proc/net/dev')) as $l) {
    if (strpos($l, ':') === false) continue;
    list($n, $rest) = explode(':', $l, 2);
    if (trim($n) !== $if) continue;
    $c = preg_split('/\s+/', trim($rest));
    return ['rx' => (float)$c[0], 'tx' => (float)$c[8]];
  }
  return null;
}

/** CPU % and network bytes/s since the previous call (a fresh 300 ms sample when there is none, or it is stale). */
function und_rates() {
  $f = und_tmp('rates.json');
  $prev = und_read_json($f, []);
  $now = microtime(true);
  $if = und_net_iface();
  // several browsers polling at once: a result from the last second is reused instead of sampling again
  if (!empty($prev['res']) && $now - ($prev['t'] ?? 0) < 1 && $now >= ($prev['t'] ?? 0)) return $prev['res'];
  $cpu = und_cpu_sample(); $net = $if ? und_net_sample($if) : null;
  if (!$prev || $now - ($prev['t'] ?? 0) > 60 || $now - ($prev['t'] ?? 0) < 0.25) {
    usleep(300000);
    $prev = ['t' => $now, 'cpu' => $cpu, 'net' => $net, 'if' => $if];
    $now = microtime(true); $cpu = und_cpu_sample(); $net = $if ? und_net_sample($if) : null;
  }
  $dt = max(0.05, $now - $prev['t']);
  $pct = null; $cores = [];
  if ($cpu && !empty($prev['cpu']['all'])) {
    $pct = und_cpu_pct($cpu['all'], $prev['cpu']['all']);
    foreach ($cpu as $k => $v) if ($k !== 'all' && isset($prev['cpu'][$k])) $cores[] = und_cpu_pct($v, $prev['cpu'][$k]);
  }
  $rx = $tx = null;
  if ($net && !empty($prev['net']) && ($prev['if'] ?? '') === $if) { $rx = max(0, ($net['rx'] - $prev['net']['rx']) / $dt); $tx = max(0, ($net['tx'] - $prev['net']['tx']) / $dt); }
  $res = ['cpu' => $pct, 'cores' => $cores, 'rx' => $rx, 'tx' => $tx, 'iface' => $if];
  und_write_json($f, ['t' => $now, 'cpu' => $cpu, 'net' => $net, 'if' => $if, 'res' => $res]);
  return $res;
}

function und_meminfo() {
  $m = [];
  foreach (explode("\n", und_read('/proc/meminfo')) as $l) if (preg_match('/^(\w+):\s+(\d+)/', $l, $x)) $m[$x[1]] = (float)$x[2] * 1024;
  $total = $m['MemTotal'] ?? 0; $avail = $m['MemAvailable'] ?? ($m['MemFree'] ?? 0);
  $st = $m['SwapTotal'] ?? 0; $sf = $m['SwapFree'] ?? 0;
  return ['total' => $total, 'used' => max(0, $total - $avail), 'free' => $avail, 'pct' => $total ? round(100 * ($total - $avail) / $total, 1) : null,
          'swap_total' => $st, 'swap_used' => max(0, $st - $sf)];
}

function und_cpu_model() {
  if (preg_match('/^model name\s*:\s*(.+)$/m', und_read('/proc/cpuinfo'), $m)) return trim(preg_replace('/\s+/', ' ', $m[1]));
  return '';
}

function und_cpu_threads() { return max(1, preg_match_all('/^processor\s*:/m', und_read('/proc/cpuinfo'))); }

/** CPU package temperature in °C (coretemp / k10temp / zenpower), else the hottest thermal zone. */
function und_cpu_temp() {
  foreach (glob(und_path('/sys/class/hwmon/hwmon*')) ?: [] as $d) {
    $n = trim((string)@file_get_contents("$d/name"));
    if (!in_array($n, ['coretemp', 'k10temp', 'zenpower', 'cpu_thermal'], true)) continue;
    $best = null;
    foreach (glob("$d/temp*_label") ?: [] as $lf) {
      $lab = trim((string)@file_get_contents($lf));
      if (preg_match('/^(Package id 0|Tctl|Tdie)$/', $lab)) { $best = str_replace('_label', '_input', $lf); break; }
    }
    if (!$best) $best = "$d/temp1_input";
    $v = (int)@file_get_contents($best);
    if ($v > 0) return round($v / 1000, 1);
  }
  $max = null;
  foreach (glob(und_path('/sys/class/thermal/thermal_zone*/temp')) ?: [] as $f) { $v = (int)@file_get_contents($f); if ($v > 0) $max = max((float)$max, $v / 1000); }
  return $max === null ? null : round($max, 1);
}

function und_uptime() { return (int)(float)explode(' ', trim(und_read('/proc/uptime')) . ' ')[0]; }

function und_disk($path) {
  $p = und_path($path);
  if (!is_dir($p)) return null;
  $t = @disk_total_space($p); $f = @disk_free_space($p);
  // /mnt/user reports 0 on servers whose shares live only on ZFS or other pools
  if (!$t) return ['path' => $path, 'total' => 0, 'free' => 0, 'used' => 0, 'pct' => null];
  return ['path' => $path, 'total' => $t, 'free' => $f, 'used' => $t - $f, 'pct' => round(100 * ($t - $f) / $t, 1)];
}

/** Everything the overview needs, in one cheap call (no Docker, no network). */
function und_system(array $cfg) {
  if (und_api_mode()) return und_api_system($cfg);
  $r = und_rates(); $mem = und_meminfo(); $v = und_var_ini();
  $hist = und_read_json(und_tmp('hist.json'), []);
  $now = time();
  if ($r['cpu'] !== null && (empty($hist) || $now - (int)end($hist)[0] >= 2)) { $hist[] = [$now, $r['cpu'], $mem['used'], $r['rx'], $r['tx']]; $hist = array_slice($hist, -150); und_write_json(und_tmp('hist.json'), $hist); }
  $load = preg_split('/\s+/', trim(und_read('/proc/loadavg')));
  return [
    'now' => $now, 'name' => (string)($v['NAME'] ?? gethostname()), 'ip' => und_server_ip(), 'os' => und_os_version(), 'kernel' => trim((string)preg_replace('/^Linux version (\S+).*$/s', '$1', und_read('/proc/version'))),
    'cpu' => ['pct' => $r['cpu'], 'cores' => $r['cores'], 'model' => und_cpu_model(), 'threads' => und_cpu_threads(), 'temp' => und_cpu_temp(), 'load' => array_map('floatval', array_slice($load, 0, 3))],
    'mem' => $mem, 'net' => ['rx' => $r['rx'], 'tx' => $r['tx'], 'iface' => $r['iface']], 'disk' => und_disk($cfg['general']['disk_path']),
    'uptime' => und_uptime(), 'array' => und_array_info($v), 'hist' => $hist, 'os_update' => und_os_cached(),
  ];
}

/** Array state plus totals and a health summary from Unraid's disks.ini (cheap: a RAM-disk file). */
function und_array_info(array $v) {
  $st = und_storage(); $size = 0; $free = 0;
  foreach ($st['array'] as $d) { $size += $d['size']; $free += $d['free']; }
  $fl = und_disk_flags(array_merge($st['parity'], $st['array'], $st['pools']));
  $resync = (int)($v['mdResync'] ?? 0);
  return ['state' => (string)($v['mdState'] ?? ''), 'resync' => $resync, 'resync_pct' => $resync && (float)($v['mdResyncSize'] ?? 0) > 0 ? round(100 * (float)$v['mdResyncPos'] / (float)$v['mdResyncSize'], 1) : null,
          'resync_action' => (string)($v['mdResyncAction'] ?? ''), 'size' => $size, 'free' => $free, 'disks' => count($st['array']), 'parity' => count($st['parity']), 'pools' => $st['pools'],
          'mover' => is_file('/var/run/mover.pid')] + $fl;
}

/** Health counts plus the names of the disks behind them, so each disk can raise (and be ignored as) its own alert. */
function und_disk_flags(array $rows) {
  $o = ['bad' => 0, 'hot' => 0, 'errors' => 0, 'bad_disks' => [], 'hot_disks' => [], 'error_disks' => []];
  foreach ($rows as $d) {
    $n = (string)($d['name'] ?? '');
    if (($d['health'] ?? '') === 'bad') { $o['bad']++; $o['bad_disks'][] = $n; }
    if (($d['temp'] ?? null) !== null && $d['temp'] >= 50) { $o['hot']++; $o['hot_disks'][] = ['name' => $n, 'temp' => (int)$d['temp']]; }
    if ((int)($d['errors'] ?? 0) > 0) { $o['errors'] += (int)$d['errors']; $o['error_disks'][] = ['name' => $n, 'errors' => (int)$d['errors']]; }
  }
  return $o;
}

/* ---------- array & pools ---------- */

function und_storage() {
  if (und_api_mode()) return und_api_storage();
  $d = @parse_ini_string(und_read('/var/local/emhttp/disks.ini'), true);
  $out = ['array' => [], 'pools' => [], 'parity' => []];
  if (!is_array($d)) return $out;
  foreach ($d as $name => $x) {
    if (!is_array($x) || ($x['status'] ?? '') === 'DISK_NP' || ($x['status'] ?? '') === 'DISK_NP_DSBL') continue;
    $row = ['name' => (string)$name, 'device' => (string)($x['device'] ?? ''), 'status' => (string)($x['status'] ?? ''), 'temp' => is_numeric($x['temp'] ?? '') ? (int)$x['temp'] : null,
            'size' => (float)($x['fsSize'] ?? 0) * 1024, 'free' => (float)($x['fsFree'] ?? 0) * 1024, 'fs' => (string)($x['fsType'] ?? ''), 'spun' => ($x['spundown'] ?? '0') !== '1',
            'errors' => (int)($x['numErrors'] ?? 0), 'color' => (string)($x['color'] ?? '')];
    // Unraid's own disk colour: green = ok, yellow = emulated / being rebuilt, red = disabled; plus read/write errors
    $row['health'] = ($row['status'] !== 'DISK_OK' || strpos($row['color'], 'red') === 0) ? 'bad' : ((strpos($row['color'], 'yellow') === 0 || $row['errors'] > 0) ? 'warn' : 'ok');
    $type = (string)($x['type'] ?? '');
    if ($type === 'Parity') $out['parity'][] = $row;
    elseif ($type === 'Data') $out['array'][] = $row;
    // a pool's first device carries the file system totals; its other members (cache2, cache3 ...) have none
    elseif ($type === 'Cache' && (float)($x['fsSize'] ?? 0) > 0) $out['pools'][] = $row;
  }
  return $out;
}

/* ---------- UPS: NUT (upsc) first, then apcupsd (apcaccess) ---------- */

function und_ups($name = 'ups') {
  if (und_api_mode()) return und_api_ups();
  $upsc = und_bin('upsc');
  if ($upsc !== 'upsc' || isset($GLOBALS['UND_EXEC_MOCK'])) {
    $r = und_run([$upsc, strpos($name, '@') === false ? $name . '@localhost' : $name], 8);
    if ($r['code'] === 0 && preg_match('/battery\.charge:/', $r['out'])) {
      $k = [];
      foreach (explode("\n", $r['out']) as $l) if (strpos($l, ':') !== false) { list($a, $b) = explode(':', $l, 2); $k[trim($a)] = trim($b); }
      return ['source' => 'NUT', 'charge' => (float)($k['battery.charge'] ?? 0), 'load' => isset($k['ups.load']) ? (float)$k['ups.load'] : null,
              'status' => und_ups_status($k['ups.status'] ?? ''), 'runtime' => isset($k['battery.runtime']) ? (int)$k['battery.runtime'] : null, 'model' => (string)($k['ups.model'] ?? $k['device.model'] ?? '')];
    }
  }
  $apc = und_bin('apcaccess');
  if ($apc !== 'apcaccess' || isset($GLOBALS['UND_EXEC_MOCK'])) {
    $r = und_run([$apc], 8);
    if ($r['code'] === 0 && preg_match('/BCHARGE/', $r['out'])) {
      $k = [];
      foreach (explode("\n", $r['out']) as $l) if (strpos($l, ':') !== false) { list($a, $b) = explode(':', $l, 2); $k[trim($a)] = trim($b); }
      return ['source' => 'apcupsd', 'charge' => (float)($k['BCHARGE'] ?? 0), 'load' => isset($k['LOADPCT']) ? (float)$k['LOADPCT'] : null,
              'status' => ucfirst(strtolower((string)($k['STATUS'] ?? ''))), 'runtime' => isset($k['TIMELEFT']) ? (int)round((float)$k['TIMELEFT'] * 60) : null, 'model' => (string)($k['MODEL'] ?? '')];
    }
  }
  return null;
}

function und_ups_status($s) {
  $map = ['OL' => 'Online', 'OB' => 'On battery', 'LB' => 'Low battery', 'CHRG' => 'Charging', 'DISCHRG' => 'Discharging', 'BYPASS' => 'Bypass', 'OVER' => 'Overload', 'RB' => 'Replace battery'];
  $w = [];
  foreach (preg_split('/\s+/', trim($s)) as $t) if ($t !== '') $w[] = $map[$t] ?? $t;
  return implode(', ', $w);
}

/* ---------- Unraid OS update (the same unRAIDServer.plg flow Tools > Update OS uses) ---------- */

function und_os_cached() {
  $c = und_read_json(und_tmp('os.json'), []);
  $installed = und_os_version();
  $latest = (string)($c['latest'] ?? '');
  return ['installed' => $installed, 'latest' => $latest, 'checked' => (int)($c['checked'] ?? 0), 'error' => (string)($c['error'] ?? ''),
          'available' => $latest !== '' && $installed !== '' && version_compare(und_ver_norm($latest), und_ver_norm($installed), '>'),
          'staged' => und_os_staged(), 'job' => und_job(und_tmp('os-update.log'))['state']];
}

/** "7.2.0-rc.1" -> "7.2.0rc1" so version_compare orders prereleases before the release. */
function und_ver_norm($v) { return preg_replace('/[-.]?(rc|beta|alpha)[.-]?/i', '$1', (string)$v); }

/** A newer release that was installed on the flash drive and becomes active after a reboot. */
function und_os_staged() {
  $installed = und_os_version();
  foreach (['/boot/config/plugins/unRAIDServer.plg', '/var/log/plugins/unRAIDServer.plg'] as $p) {
    if (!preg_match('/<!ENTITY\s+version\s+"([^"]+)"/', und_read($p), $m)) continue;
    if ($installed !== '' && version_compare(und_ver_norm($m[1]), und_ver_norm($installed), '>')) return $m[1];
    return '';
  }
  return '';
}

function und_os_check() {
  if (und_api_mode()) return ['error' => 'Unraid OS updates are not available through the Unraid API; use Tools > Update OS in Unraid.'];
  $tmp = '/tmp/plugins/unRAIDServer.plg';
  @unlink($tmp);
  $r = und_run([und_bin('plugin'), 'check', 'unRAIDServer.plg'], 120);
  $out = ['checked' => time(), 'latest' => '', 'error' => ''];
  if ($r['code'] === 0 && is_file($tmp) && preg_match('/<!ENTITY\s+version\s+"([^"]+)"/', (string)@file_get_contents($tmp), $m) && preg_match('/^[0-9][A-Za-z0-9._+-]{0,30}$/', $m[1])) $out['latest'] = $m[1];
  elseif (preg_match('/^\s*([0-9][A-Za-z0-9._+-]{0,30})\s*$/m', $r['out'], $m)) $out['latest'] = $m[1];
  else $out['error'] = $r['timeout'] ? 'The update check timed out.' : (und_clip(trim($r['err'] . ' ' . $r['out']), 200) ?: 'The update server did not answer.');
  und_write_json(und_tmp('os.json'), $out);
  return und_os_cached();
}

/** Downloads and installs the newer release onto the flash drive. It becomes active after a reboot. */
function und_os_update() {
  if (und_api_mode()) return ['error' => 'Unraid OS updates are not available through the Unraid API; use Tools > Update OS in Unraid.'];
  $st = und_os_check();
  if (!$st['available']) return ['error' => $st['error'] ?: 'No newer Unraid release is available.'];
  if (und_job(und_tmp('os-update.log'))['state'] === 'running') return ['error' => 'An update is already running.'];
  und_spawn([und_bin('plugin'), 'update', 'unRAIDServer.plg'], und_tmp('os-update.log'));
  return ['ok' => true];
}
]]></INLINE>
<SHA256>ffe04a5f8de2653c70c70605b3fff4760adf979853246da6aa79c35bf19a529e</SHA256>
</FILE>

<FILE Name="&emhttp;/include/docker.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - Docker containers.
 *
 * Live status (every refresh) costs one `docker ps` plus two small cgroup files per running container: no `docker inspect`
 * and no `docker stats` (which takes ~2 s). The full inspect data (icons, WebUI, ports, restart count) is cached and only
 * re-read when a container appears, disappears or changes state, or after 5 minutes.
 * Updates use Unraid's own update_container script, so a container is recreated from its Unraid template exactly as the
 * Docker tab's "apply update" does.
 */

function und_docker_bin() { return und_bin('docker'); }

function und_valid_container($n) { return is_string($n) && preg_match('/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/', $n) === 1; }

/** id, name, state and health of every container: one cheap call. */
function und_docker_ps() {
  $r = und_run([und_docker_bin(), 'ps', '-a', '--no-trunc', '--format', '{{.ID}}|{{.Names}}|{{.State}}|{{.Status}}|{{.Image}}'], 15);
  if ($r['code'] !== 0) return ['error' => preg_match('/daemon|connect/i', $r['err']) ? 'Docker is not running.' : (und_clip(trim($r['err']), 200) ?: 'Docker is not available.')];
  $out = [];
  foreach (explode("\n", trim($r['out'])) as $l) {
    $c = explode('|', $l);
    if (count($c) < 5) continue;
    $health = preg_match('/\((healthy|unhealthy|health: starting)\)/', $c[3], $m) ? str_replace('health: ', '', $m[1]) : '';
    $out[$c[1]] = ['id' => $c[0], 'name' => $c[1], 'state' => $c[2], 'status' => $c[3], 'health' => $health, 'image' => $c[4]];
  }
  return ['ps' => $out];
}

/** Inspect data for every container, cached in /tmp/undash/inspect.json and keyed by the set of ids and states. */
function und_docker_details(array $ps, $force = false) {
  $f = und_tmp('inspect.json');
  $sig = md5(json_encode(array_map(function ($c) { return $c['id'] . $c['state']; }, $ps)));
  $c = und_read_json($f, []);
  if (!$force && ($c['sig'] ?? '') === $sig && time() - (int)($c['at'] ?? 0) < 300) return $c['d'];
  $ids = array_values(array_map(function ($x) { return $x['id']; }, $ps));
  $d = [];
  if ($ids) {
    $r = und_run(array_merge([und_docker_bin(), 'inspect'], $ids), 30, 16777216);
    $data = json_decode($r['out'], true);
    if (!is_array($data)) return $c['d'] ?? [];
    $ip = und_server_ip();
    $auto = array_flip(array_map(function ($l) { return trim(explode(' ', $l)[0]); }, explode("\n", und_read('/var/lib/docker/unraid-autostart'))));
    foreach ($data as $x) {
      $name = ltrim((string)($x['Name'] ?? ''), '/');
      $labels = isset($x['Config']['Labels']) && is_array($x['Config']['Labels']) ? $x['Config']['Labels'] : [];
      $ports = [];
      foreach ((array)($x['HostConfig']['PortBindings'] ?? []) as $cp => $binds) foreach ((array)$binds as $b) if (!empty($b['HostPort'])) $ports[(string)$cp] = (int)$b['HostPort'];
      $net = (string)($x['HostConfig']['NetworkMode'] ?? '');
      $cip = '';
      foreach ((array)($x['NetworkSettings']['Networks'] ?? []) as $n) if (!empty($n['IPAddress'])) { $cip = $n['IPAddress']; break; }
      $webui = (string)($labels['net.unraid.docker.webui'] ?? '');
      if ($webui !== '') {
        // the container's own address only when it has one on the LAN (br0 / macvlan style) and publishes nothing on the host;
        // on a user-defined bridge with published ports the web UI is reached through the server's address and the host port
        $own = !$ports && !in_array($net, ['bridge', 'host', 'default', ''], true) && strpos($net, 'container:') !== 0 && $cip !== '';
        $webui = str_replace('[IP]', $own ? $cip : $ip, $webui);
        $webui = preg_replace_callback('/\[PORT:(\d+)\]/', function ($m) use ($ports, $own) {
          foreach ($ports as $cp => $hp) if ((int)$cp === (int)$m[1]) return (string)($own ? $m[1] : $hp);
          return $m[1];
        }, $webui);
      }
      $iconFile = '/usr/local/emhttp/state/plugins/dynamix.docker.manager/images/' . $name . '-icon.png';
      $d[$name] = ['icon' => is_file(und_path($iconFile)) ? '/state/plugins/dynamix.docker.manager/images/' . rawurlencode($name) . '-icon.png' : (string)($labels['net.unraid.docker.icon'] ?? ''),
        'webui' => preg_match('#^https?://#', $webui) ? $webui : '', 'network' => $net, 'ip' => $cip, 'ports' => $ports, 'autostart' => isset($auto[$name]),
        'managed' => ($labels['net.unraid.docker.managed'] ?? '') === 'dockerman', 'restarts' => (int)($x['RestartCount'] ?? 0),
        'started' => strtotime((string)($x['State']['StartedAt'] ?? '')) ?: null, 'exit' => (int)($x['State']['ExitCode'] ?? 0),
        'created' => strtotime((string)($x['Created'] ?? '')) ?: null, 'cfg_image' => (string)($x['Config']['Image'] ?? '')];
    }
  }
  und_write_json($f, ['sig' => $sig, 'at' => time(), 'd' => $d]);
  return $d;
}

/** CPU % (100% = one core, like `docker stats` and Unraid's Docker tab) and memory from cgroup v2, measured against the previous call. */
function und_docker_cgroup(array $ps) {
  $f = und_tmp('cg.json');
  $prev = und_read_json($f, []);
  $now = microtime(true); $cur = []; $out = [];
  foreach ($ps as $c) {
    if ($c['state'] !== 'running') continue;
    $base = null;
    foreach (['/sys/fs/cgroup/docker/' . $c['id'], '/sys/fs/cgroup/system.slice/docker-' . $c['id'] . '.scope'] as $b) if (is_dir(und_path($b))) { $base = $b; break; }
    if ($base === null) continue;
    $usage = preg_match('/^usage_usec (\d+)/m', und_read("$base/cpu.stat"), $m) ? (float)$m[1] : null;
    $mem = (float)trim(und_read("$base/memory.current"));
    $inactive = preg_match('/^inactive_file (\d+)/m', und_read("$base/memory.stat"), $m) ? (float)$m[1] : 0;
    $cur[$c['id']] = $usage;
    $cpu = null;
    if ($usage !== null && isset($prev['u'][$c['id']]) && $now > ($prev['t'] ?? 0)) $cpu = max(0, round(($usage - $prev['u'][$c['id']]) / (($now - $prev['t']) * 1e6) * 100, 1));
    $out[$c['name']] = ['cpu' => $cpu, 'mem' => max(0, $mem - $inactive)];
  }
  // several browsers polling at once must not shrink the window to nothing: keep the older sample if it is very recent
  if ($now - ($prev['t'] ?? 0) >= 1) und_write_json($f, ['t' => $now, 'u' => $cur]);
  return $out;
}

/** Update state per container from Unraid's own status file: available | current | unknown (never checked or not an Unraid template). */
function und_docker_updates() {
  return und_read_json(und_path(UND_UPDSTATUS), []);
}
function und_docker_update_state(array $upd, $image) {
  $key = und_has(basename($image), ':') || und_has($image, '@') ? $image : $image . ':latest';
  $u = $upd[$key] ?? null;
  if (!is_array($u)) return 'unknown';
  $s = (string)($u['status'] ?? '');
  return $s === 'false' ? 'available' : ($s === 'true' ? 'current' : 'unknown');
}

/** Everything the dashboard shows about containers. Cheap enough for every refresh. */
function und_docker_live($withDetails = true) {
  if (und_api_mode()) return und_api_docker_live();
  $ps = und_docker_ps();
  if (isset($ps['error'])) return $ps;
  $ps = $ps['ps'];
  $det = $withDetails ? und_docker_details($ps) : [];
  $cg = und_docker_cgroup($ps);
  $upd = und_docker_updates();
  $out = [];
  foreach ($ps as $name => $c) {
    $d = $det[$name] ?? [];
    $job = und_job(und_tmp('docker-update-' . $name . '.log'));
    $image = $d['cfg_image'] ?? $c['image'];
    $out[] = ['name' => $name, 'id' => substr($c['id'], 0, 12), 'image' => $image, 'state' => $c['state'], 'status' => $c['status'], 'health' => $c['health'],
      'cpu' => $cg[$name]['cpu'] ?? null, 'mem' => $cg[$name]['mem'] ?? null, 'update' => und_docker_update_state($upd, $image),
      'icon' => $d['icon'] ?? '', 'webui' => $d['webui'] ?? '', 'ports' => (object)($d['ports'] ?? []), 'network' => $d['network'] ?? '', 'autostart' => !empty($d['autostart']),
      'managed' => !empty($d['managed']), 'restarts' => $d['restarts'] ?? null, 'started' => $d['started'] ?? null, 'exit' => $d['exit'] ?? null,
      'job' => $job['state'] === 'running' ? 'updating' : ($job['state'] === 'done' && time() - (int)$job['at'] < 600 ? ($job['code'] === 0 ? 'updated' : 'update_failed') : '')];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  $chk = und_job(und_tmp('docker-check.log'));
  return ['containers' => $out, 'checking' => $chk['state'] === 'running', 'checked' => is_file(und_path(UND_UPDSTATUS)) ? (int)@filemtime(und_path(UND_UPDSTATUS)) : null];
}

/** Older callers (summary widget). */
function und_docker_list() { return und_docker_live(); }

function und_docker_action($name, $op) {
  if (!und_valid_container($name)) return ['error' => 'Invalid container name.'];
  if (und_api_mode()) return und_api_docker_action($name, $op);
  $ps = und_docker_ps();
  if (isset($ps['error'])) return $ps;
  if (!isset($ps['ps'][$name])) return ['error' => 'There is no container named ' . $name . '.'];
  $state = $ps['ps'][$name]['state'];
  $valid = ['start' => ['exited', 'created', 'dead'], 'stop' => ['running', 'restarting', 'paused'], 'restart' => ['running', 'exited', 'created', 'restarting'],
            'pause' => ['running'], 'unpause' => ['paused'], 'update' => null];
  if (!array_key_exists($op, $valid)) return ['error' => 'Unknown action.'];
  if ($valid[$op] !== null && !in_array($state, $valid[$op], true)) return ['error' => ucfirst($op) . ' is not possible while ' . $name . ' is ' . $state . '.'];
  $lock = und_lock('docker:' . $name);
  if (!$lock) return ['error' => 'Another action on ' . $name . ' is still running.'];
  if ($op === 'update') {
    $log = und_tmp('docker-update-' . $name . '.log');
    if (und_job($log)['state'] === 'running') { und_unlock($lock); return ['error' => 'An update of ' . $name . ' is already running.']; }
    und_spawn([UND_DM . '/scripts/update_container', $name], $log);
    und_history_add('docker', $name, 'update', true, 'started');
    und_unlock($lock);
    return ['ok' => true, 'job' => 'running'];
  }
  $r = und_run([und_docker_bin(), $op, $name], 120);
  und_unlock($lock);
  @unlink(und_tmp('inspect.json'));
  $ok = $r['code'] === 0;
  $msg = $ok ? '' : (und_clip(trim(preg_replace('/^Error response from daemon:\s*/i', '', $r['err'] . ' ' . $r['out'])), 300) ?: 'docker ' . $op . ' failed');
  und_history_add('docker', $name, $op, $ok, $msg);
  return $ok ? ['ok' => true] : ['error' => $msg];
}

/** Starts Unraid's own update check for every container (the "check for updates" button of the Docker tab). */
function und_docker_check() {
  if (und_api_mode()) return ['error' => 'Unraid checks container updates on its own schedule; the API has no "check now".'];
  $log = und_tmp('docker-check.log');
  if (und_job($log)['state'] === 'running') return ['ok' => true, 'job' => 'running'];
  und_spawn([UND_DM . '/scripts/dockerupdate', 'check', 'nonotify'], $log);
  und_history_add('docker', 'all containers', 'check', true, 'update check started');
  return ['ok' => true, 'job' => 'running'];
}

/** Record how an update finished (called when the UI sees the job end). */
function und_docker_job($name) {
  $log = und_tmp('docker-update-' . $name . '.log');
  $j = und_job($log);
  if ($j['state'] === 'done' && !is_file($log . '.recorded')) {
    @touch($log . '.recorded');
    @unlink(und_tmp('inspect.json'));
    $ok = $j['code'] === 0 && !preg_match('/\b(error|failed|denied)\b/i', $j['out']);
    und_history_add('docker', $name, 'update', $ok, $ok ? 'finished' : und_clip(trim(substr($j['out'], -300)), 300));
    $j['ok'] = $ok;
  } elseif ($j['state'] === 'done') $j['ok'] = $j['code'] === 0 && !preg_match('/\b(error|failed|denied)\b/i', $j['out']);
  return $j;
}

/** The last N lines of stdout and stderr, merged in time order. */
function und_docker_logs($name, $lines = 300) {
  if (!und_valid_container($name)) return ['error' => 'Invalid container name.'];
  if (und_api_mode()) return und_api_docker_logs($name, $lines);
  $lines = max(10, min(5000, (int)$lines));
  $r = und_run([und_docker_bin(), 'logs', '--tail', (string)$lines, '--timestamps', $name], 20, 8388608);
  if ($r['code'] !== 0 && $r['out'] === '' && $r['err'] === '') return ['error' => 'Could not read the log.'];
  if ($r['code'] !== 0 && preg_match('/No such container/i', $r['err'])) return ['error' => 'There is no container named ' . $name . '.'];
  $all = array_merge(explode("\n", rtrim($r['out'])), explode("\n", rtrim($r['err'])));
  $all = array_values(array_filter($all, function ($l) { return $l !== ''; }));
  usort($all, function ($a, $b) { return strcmp(substr($a, 0, 30), substr($b, 0, 30)); });
  $all = array_slice($all, -$lines);
  $text = implode("\n", array_map(function ($l) { return preg_replace('/^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)\.\d+Z /', '$1 ', $l); }, $all));
  return ['log' => preg_replace('/\x1b\[[0-9;]*[A-Za-z]/', '', $text)];
}

/**
 * Diagnostic details for one container. Environment variables are listed by name only (their values are often passwords),
 * labels are limited to Unraid's and OCI's descriptive ones.
 */
function und_docker_inspect($name) {
  if (!und_valid_container($name)) return ['error' => 'Invalid container name.'];
  if (und_api_mode()) return und_api_docker_inspect($name);
  $r = und_run([und_docker_bin(), 'inspect', $name], 15, 4194304);
  $j = json_decode($r['out'], true);
  if (!is_array($j) || !isset($j[0])) return ['error' => 'There is no container named ' . $name . '.'];
  $x = $j[0];
  $mounts = [];
  foreach ((array)($x['Mounts'] ?? []) as $m) $mounts[] = ['src' => (string)($m['Source'] ?? ''), 'dst' => (string)($m['Destination'] ?? ''), 'rw' => !empty($m['RW'])];
  $nets = [];
  foreach ((array)($x['NetworkSettings']['Networks'] ?? []) as $n => $v) $nets[] = ['name' => $n, 'ip' => (string)($v['IPAddress'] ?? '')];
  $ports = [];
  foreach ((array)($x['HostConfig']['PortBindings'] ?? []) as $cp => $binds) foreach ((array)$binds as $b) $ports[] = ($b['HostIp'] ?? '') . ':' . ($b['HostPort'] ?? '') . ' → ' . $cp;
  $env = [];
  foreach ((array)($x['Config']['Env'] ?? []) as $e) $env[] = explode('=', (string)$e, 2)[0];
  $health = [];
  foreach (array_slice((array)($x['State']['Health']['Log'] ?? []), -3) as $hl) $health[] = ['at' => strtotime((string)($hl['End'] ?? '')) ?: null, 'code' => (int)($hl['ExitCode'] ?? 0), 'out' => und_clip(und_redact(trim((string)($hl['Output'] ?? ''))), 400)];
  $labels = [];
  foreach ((array)($x['Config']['Labels'] ?? []) as $k => $v) if (preg_match('/^(net\.unraid\.docker\.(managed|webui|icon|shell)|org\.opencontainers\.image\.(version|source|title|description|url|created))$/', $k)) $labels[$k] = und_clip((string)$v, 300);
  return ['name' => $name, 'id' => substr((string)$x['Id'], 0, 12), 'image' => (string)($x['Config']['Image'] ?? ''), 'image_id' => substr(str_replace('sha256:', '', (string)($x['Image'] ?? '')), 0, 12),
    'created' => strtotime((string)($x['Created'] ?? '')) ?: null, 'state' => (string)($x['State']['Status'] ?? ''), 'started' => strtotime((string)($x['State']['StartedAt'] ?? '')) ?: null,
    'finished' => strtotime((string)($x['State']['FinishedAt'] ?? '')) ?: null, 'exit' => (int)($x['State']['ExitCode'] ?? 0), 'state_error' => (string)($x['State']['Error'] ?? ''),
    'oom' => !empty($x['State']['OOMKilled']), 'restarts' => (int)($x['RestartCount'] ?? 0), 'restart_policy' => (string)($x['HostConfig']['RestartPolicy']['Name'] ?? ''),
    'network_mode' => (string)($x['HostConfig']['NetworkMode'] ?? ''), 'networks' => $nets, 'ports' => $ports, 'mounts' => $mounts, 'env' => $env, 'labels' => (object)$labels, 'health' => $health,
    'privileged' => !empty($x['HostConfig']['Privileged'])];
}

function und_docker_summary() {
  $l = und_docker_live(false);
  if (isset($l['error'])) return $l;
  $s = ['running' => 0, 'stopped' => 0, 'paused' => 0, 'updates' => 0, 'unhealthy' => 0, 'total' => count($l['containers'])];
  foreach ($l['containers'] as $c) {
    if ($c['state'] === 'running') $s['running']++; elseif ($c['state'] === 'paused') $s['paused']++; else $s['stopped']++;
    if ($c['update'] === 'available') $s['updates']++;
    if ($c['health'] === 'unhealthy') $s['unhealthy']++;
  }
  return $s;
}
]]></INLINE>
<SHA256>555c568e743a33e967b2b085742fe645febb16b63f61cf577d7c20707c86c2d7</SHA256>
</FILE>

<FILE Name="&emhttp;/include/vm.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - virtual machines through libvirt's virsh, the same backend Unraid's VMs tab uses.
 * Live status is one `virsh list --all`; the details (vCPUs, memory, icon, VNC port, guest agent) are cached and re-read
 * only when the set of VMs or a VM's state changes, or after 10 minutes.
 * Hibernate is "dompmsuspend <vm> disk", which needs the QEMU guest agent running inside the VM (as on the VMs tab).
 */

function und_virsh() { return und_bin('virsh'); }

function und_valid_vm($n) { return is_string($n) && $n !== '' && strlen($n) <= 200 && !preg_match('/[\x00-\x1f\/]/', $n); }

/** name => state ("running", "shut off", "paused", "pmsuspended", "in shutdown", "crashed"). Null when libvirt is not running. */
function und_vm_states() {
  if (und_api_mode()) { $l = und_api_vm_live(); if (isset($l['error'])) return null; $o = []; foreach ($l['vms'] as $v) $o[$v['name']] = $v['state']; return $o; }
  $r = und_run([und_virsh(), 'list', '--all'], 10);
  if ($r['code'] !== 0) return null;
  $out = [];
  foreach (array_slice(explode("\n", trim($r['out'])), 2) as $l) {
    if (!preg_match('/^\s*(\d+|-)\s+(.+?)\s{2,}(\S.*?)\s*$/', $l, $m)) continue;
    $out[$m[2]] = strtolower($m[3]);
  }
  return $out;
}

function und_vm_details(array $states) {
  $f = und_tmp('vminfo.json');
  $sig = md5(json_encode($states));
  $c = und_read_json($f, []);
  if (($c['sig'] ?? '') === $sig && time() - (int)($c['at'] ?? 0) < 600) return $c['d'];
  $d = [];
  foreach ($states as $name => $st) {
    $info = [];
    foreach (explode("\n", und_run([und_virsh(), 'dominfo', $name], 10)['out']) as $l) if (strpos($l, ':') !== false) { list($k, $v) = explode(':', $l, 2); $info[trim($k)] = trim($v); }
    $xml = und_run([und_virsh(), 'dumpxml', $name], 10)['out'];
    $icon = preg_match('/<vmtemplate[^>]*\sicon=[\'"]([^\'"]+)[\'"]/', $xml, $m) ? $m[1] : '';
    $ws = preg_match('/<graphics[^>]*type=[\'"]vnc[\'"][^>]*websocket=[\'"](\d+)[\'"]/', $xml, $m) || preg_match('/<graphics[^>]*websocket=[\'"](\d+)[\'"][^>]*type=[\'"]vnc[\'"]/', $xml, $m) ? (int)$m[1] : 0;
    $d[$name] = ['cpus' => (int)($info['CPU(s)'] ?? 0), 'memory' => (float)preg_replace('/[^0-9]/', '', (string)($info['Max memory'] ?? '0')) * 1024,
      'autostart' => ($info['Autostart'] ?? '') === 'enable', 'os' => preg_match('/<vmtemplate[^>]*\sos=[\'"]([^\'"]+)[\'"]/', $xml, $m) ? $m[1] : '',
      'icon' => preg_match('/^[A-Za-z0-9_.-]+\.(png|svg)$/', $icon) ? '/plugins/dynamix.vm.manager/templates/images/' . $icon : '',
      'vnc' => $ws > 0 ? '/wsproxy/' . $ws . '/' : '', 'agent' => und_has($xml, 'org.qemu.guest_agent')];
  }
  und_write_json($f, ['sig' => $sig, 'at' => time(), 'd' => $d]);
  return $d;
}

/** Which actions make sense in a state; the UI shows only these and the server refuses the rest. */
function und_vm_valid_ops($state, $agent) {
  switch ($state) {
    case 'running': return array_values(array_filter(['stop', 'kill', 'restart', 'pause', $agent ? 'hibernate' : null]));
    case 'paused': return ['resume', 'kill'];
    case 'pmsuspended': return ['resume', 'kill'];
    case 'in shutdown': return ['kill'];
    case 'shut off': case 'crashed': return ['start'];
  }
  return [];
}

function und_vm_live() {
  if (und_api_mode()) return und_api_vm_live();
  $st = und_vm_states();
  if ($st === null) return ['error' => 'The VM service is not running.'];
  $det = und_vm_details($st);
  $out = [];
  foreach ($st as $name => $state) {
    $d = $det[$name] ?? ['cpus' => 0, 'memory' => 0, 'autostart' => false, 'os' => '', 'icon' => '', 'vnc' => '', 'agent' => false];
    $out[] = ['name' => $name, 'state' => $state, 'ops' => und_vm_valid_ops($state, $d['agent'])] + $d;
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return ['vms' => $out];
}

function und_vm_list() { return und_vm_live(); }

function und_vm_action($name, $op) {
  if (!und_valid_vm($name)) return ['error' => 'Invalid VM name.'];
  if (und_api_mode()) return und_api_vm_action($name, $op);
  $st = und_vm_states();
  if ($st === null) return ['error' => 'The VM service is not running.'];
  if (!isset($st[$name])) return ['error' => 'There is no VM named ' . $name . '.'];
  $state = $st[$name];
  $det = und_vm_details($st)[$name] ?? ['agent' => false];
  if (!in_array($op, und_vm_valid_ops($state, !empty($det['agent'])), true)) return ['error' => ucfirst($op) . ' is not possible while ' . $name . ' is ' . $state . '.'];
  $map = ['start' => 'start', 'stop' => 'shutdown', 'kill' => 'destroy', 'restart' => 'reboot', 'pause' => 'suspend', 'resume' => $state === 'pmsuspended' ? 'dompmwakeup' : 'resume', 'hibernate' => 'dompmsuspend'];
  $argv = [und_virsh(), $map[$op], $name];
  if ($op === 'hibernate') $argv[] = 'disk';
  $lock = und_lock('vm:' . $name);
  if (!$lock) return ['error' => 'Another action on ' . $name . ' is still running.'];
  $r = und_run($argv, 90);
  und_unlock($lock);
  @unlink(und_tmp('vminfo.json'));
  $ok = $r['code'] === 0;
  $err = $ok ? '' : und_clip(trim(preg_replace('/^error:\s*/im', '', $r['err'] . ' ' . $r['out'])), 300);
  if (!$ok && $op === 'hibernate' && preg_match('/agent/i', $err)) $err = 'Hibernate needs the QEMU guest agent running inside the VM. ' . $err;
  und_history_add('vm', $name, $op, $ok, $err);
  return $ok ? ['ok' => true] : ['error' => $err ?: 'virsh ' . $map[$op] . ' failed'];
}

function und_vm_summary() {
  $l = und_vm_live();
  if (isset($l['error'])) return $l;
  $s = ['running' => 0, 'stopped' => 0, 'paused' => 0, 'total' => count($l['vms'])];
  foreach ($l['vms'] as $v) {
    if ($v['state'] === 'running') $s['running']++; elseif (in_array($v['state'], ['paused', 'pmsuspended'], true)) $s['paused']++; else $s['stopped']++;
  }
  return $s;
}
]]></INLINE>
