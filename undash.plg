<FILE Name="&emhttp;/include/requests.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - requests from Overseerr / Jellyseerr (Seerr): pending ones with Approve and Decline, and the latest others
 * with their status. Request lists do not carry titles, so titles and posters are looked up once per movie or show and
 * kept for a day. Posters are the public TMDB images Seerr itself uses. The list is cached for 30 seconds.
 */

function und_seerr_sources(array $cfg) {
  $list = [];
  foreach ($cfg['groups'] as $g) foreach ($g['services'] as $s) if ($s['type'] === 'overseerr') $list[] = $s;
  return $list;
}

/** Title, year and poster of a movie or show, cached for a day. */
function und_seerr_media(array $s, $type, $tmdb) {
  $f = und_tmp('seerr-media.json');
  $cache = und_read_json($f, []);
  $k = $s['id'] . ':' . $type . ':' . $tmdb;
  if (isset($cache[$k]) && time() - (int)$cache[$k]['at'] < 86400) return $cache[$k];
  $m = und_get(und_u($s['url'], '/api/v1/' . ($type === 'tv' ? 'tv' : 'movie') . '/' . (int)$tmdb), und_arr_h($s) + ['timeout' => 10]);
  $date = (string)($m['releaseDate'] ?? $m['firstAirDate'] ?? '');
  $row = ['title' => (string)($m['title'] ?? $m['name'] ?? ('TMDB ' . $tmdb)), 'year' => $date !== '' ? (int)substr($date, 0, 4) : 0,
          'poster' => !empty($m['posterPath']) && preg_match('#^/[A-Za-z0-9_.-]+$#', $m['posterPath']) ? 'https://image.tmdb.org/t/p/w92' . $m['posterPath'] : '', 'at' => time()];
  $cache[$k] = $row;
  if (count($cache) > 500) $cache = array_slice($cache, -400, null, true);
  und_write_json($f, $cache);
  return $row;
}

function und_seerr_status($req, $media) {
  $r = (int)$req; $m = (int)$media;
  if ($r === 1) return ['pending', 'Pending', 'warn'];
  if ($r === 3) return ['declined', 'Declined', 'bad'];
  if ($r === 4) return ['failed', 'Failed', 'bad'];
  if ($m === 5) return ['available', 'Available', 'ok'];
  if ($m === 4) return ['partial', 'Partly available', 'ok'];
  if ($m === 3) return ['processing', 'Processing', 'info'];
  return ['approved', 'Approved', 'info'];
}

function und_requests(array $cfg) {
  $src = und_seerr_sources($cfg);
  if (!$src) return ['unconfigured' => true, 'items' => [], 'apps' => []];
  return und_api_cached('requests', 30, function () use ($cfg, $src) {
    $items = []; $apps = [];
    foreach ($src as $s0) {
      $s = und_service_full($cfg, $s0['id']);
      $link = rtrim($s['href'] ?: $s['url'], '/');
      try {
        if (trim($s['url']) === '' || und_has($s['url'], '{{')) throw new Exception($s['name'] . ' has no API URL yet.');
        $pend = und_get(und_u($s['url'], '/api/v1/request?take=20&skip=0&sort=added&filter=pending'), und_arr_h($s) + ['timeout' => 15]);
        $rest = und_get(und_u($s['url'], '/api/v1/request?take=12&skip=0&sort=modified&filter=all'), und_arr_h($s) + ['timeout' => 15]);
        $seen = [];
        foreach (array_merge((array)($pend['results'] ?? []), (array)($rest['results'] ?? [])) as $r) {
          $id = (int)($r['id'] ?? 0);
          if (!$id || isset($seen[$id])) continue; $seen[$id] = 1;
          $type = ($r['type'] ?? $r['media']['mediaType'] ?? 'movie') === 'tv' ? 'tv' : 'movie';
          $tmdb = (int)($r['media']['tmdbId'] ?? 0);
          $m = $tmdb ? und_seerr_media($s, $type, $tmdb) : ['title' => 'Unknown', 'year' => 0, 'poster' => ''];
          [$st, $stLabel, $lvl] = und_seerr_status($r['status'] ?? 0, $r['media']['status'] ?? 0);
          $seasons = $type === 'tv' ? array_map(function ($x) { return (int)($x['seasonNumber'] ?? 0); }, (array)($r['seasons'] ?? [])) : [];
          $items[] = ['id' => $id, 'app' => $s['id'], 'app_name' => $s['name'], 'type' => $type, 'title' => $m['title'], 'year' => $m['year'], 'poster' => $m['poster'],
            'user' => (string)($r['requestedBy']['displayName'] ?? $r['requestedBy']['username'] ?? $r['requestedBy']['email'] ?? ''),
            'at' => !empty($r['createdAt']) ? (int)strtotime($r['createdAt']) : 0, 'is4k' => !empty($r['is4k']), 'seasons' => $seasons,
            'status' => $st, 'status_label' => $stLabel, 'level' => $lvl,
            'href' => preg_match('#^https?://#', $link) && $tmdb ? $link . '/' . $type . '/' . $tmdb : ''];
        }
        $apps[] = ['id' => $s['id'], 'name' => $s['name'], 'error' => '', 'href' => preg_match('#^https?://#', $link) ? $link : ''];
      } catch (Throwable $e) {
        $apps[] = ['id' => $s['id'], 'name' => $s['name'], 'error' => und_redact($e->getMessage(), [$s['key']]), 'href' => ''];
      }
    }
    // pending first (oldest waiting first), then the rest newest first
    usort($items, function ($a, $b) { $pa = $a['status'] === 'pending'; $pb = $b['status'] === 'pending'; return $pa !== $pb ? ($pa ? -1 : 1) : ($pa ? $a['at'] - $b['at'] : $b['at'] - $a['at']); });
    return ['items' => array_slice($items, 0, 30), 'apps' => $apps, 'pending' => count(array_filter($items, function ($x) { return $x['status'] === 'pending'; }))];
  });
}

/** Approve or decline one request (op approve | decline). */
function und_request_action(array $cfg, $app, $id, $op) {
  if (!in_array($op, ['approve', 'decline'], true)) return ['error' => 'Unknown action.'];
  if (!preg_match('/^[a-f0-9]{8}$/', (string)$app) || !ctype_digit((string)$id)) return ['error' => 'Unknown request.'];
  $s0 = null; foreach (und_seerr_sources($cfg) as $x) if ($x['id'] === $app) $s0 = $x;
  if (!$s0) return ['error' => 'Unknown request app.'];
  $s = und_service_full($cfg, $app);
  $lock = und_lock('seerr:' . $app . ':' . $id);
  if (!$lock) return ['error' => 'That request is already being changed.'];
  try {
    $r = und_http('POST', und_u($s['url'], '/api/v1/request/' . (int)$id . '/' . $op), ['headers' => ['X-Api-Key' => $s['key'], 'Content-Type' => 'application/json'], 'body' => '{}', 'timeout' => 20]);
    if ($r['err'] !== '') throw new Exception($r['err']);
    if ($r['code'] === 401 || $r['code'] === 403) throw new Exception('The API key may not ' . $op . ' requests (HTTP ' . $r['code'] . ').');
    if ($r['code'] === 404) throw new Exception('That request no longer exists.');
    if ($r['code'] < 200 || $r['code'] >= 300) throw new Exception('HTTP ' . $r['code'] . (is_array($r['json']) && !empty($r['json']['message']) ? ': ' . und_clip((string)$r['json']['message'], 200) : ''));
    und_unlock($lock);
    @unlink(und_tmp('api-requests.json'));
    und_history_add('request', $s['name'] . ' #' . (int)$id, $op, true);
    return ['ok' => true];
  } catch (Throwable $e) {
    und_unlock($lock);
    $m = und_redact($e->getMessage(), [$s['key']]);
    und_history_add('request', $s['name'] . ' #' . (int)$id, $op, false, $m);
    return ['error' => $s['name'] . ': ' . $m];
  }
}

/* ---------- search and request from the dashboard's search box ---------- */

/** Movies and series matching $q in the first Seerr app, with whether they are already there or requested. */
function und_seerr_search(array $cfg, $q) {
  $q = trim((string)$q);
  if (mb_strlen($q) < 2 || mb_strlen($q) > 100) return ['items' => [], 'error' => 'Type 2 to 100 characters.'];
  $src = und_seerr_sources($cfg);
  if (!$src) return ['items' => [], 'unconfigured' => true];
  $s = und_service_full($cfg, $src[0]['id']);
  if (trim($s['url']) === '' || und_has($s['url'], '{{')) return ['items' => [], 'error' => $s['name'] . ' has no API URL yet.'];
  $link = rtrim($s['href'] ?: $s['url'], '/');
  try {
    // Seerr wants %20, not +, in the query
    $j = und_get(und_u($s['url'], '/api/v1/search?query=' . rawurlencode($q) . '&page=1&language=en'), und_arr_h($s) + ['timeout' => 12]);
  } catch (Throwable $e) {
    return ['items' => [], 'error' => $s['name'] . ': ' . und_redact($e->getMessage(), [$s['key']])];
  }
  $st = [2 => ['requested', 'Requested'], 3 => ['processing', 'Processing'], 4 => ['partial', 'Partly available'], 5 => ['available', 'Available']];
  $items = [];
  foreach ((array)($j['results'] ?? []) as $r) {
    $type = (string)($r['mediaType'] ?? '');
    if ($type !== 'movie' && $type !== 'tv') continue;          // people are not requestable
    $date = (string)($r['releaseDate'] ?? $r['firstAirDate'] ?? '');
    $ms = (int)($r['mediaInfo']['status'] ?? 1);
    $items[] = ['id' => (int)$r['id'], 'type' => $type, 'title' => und_clip((string)($r['title'] ?? $r['name'] ?? ''), 150), 'year' => $date !== '' ? (int)substr($date, 0, 4) : 0,
      'overview' => und_clip((string)($r['overview'] ?? ''), 220),
      'poster' => !empty($r['posterPath']) && preg_match('#^/[A-Za-z0-9_.-]+$#', $r['posterPath']) ? 'https://image.tmdb.org/t/p/w92' . $r['posterPath'] : '',
      'status' => $st[$ms][0] ?? 'none', 'status_label' => $st[$ms][1] ?? '',
      'href' => preg_match('#^https?://#', $link) ? $link . '/' . $type . '/' . (int)$r['id'] : ''];
    if (count($items) >= 8) break;
  }
  return ['items' => $items, 'app' => ['id' => $s['id'], 'name' => $s['name']]];
}

/** Request a movie, or every season of a series, as the owner of the API key. */
function und_seerr_request(array $cfg, $app, $type, $tmdb) {
  if (!in_array($type, ['movie', 'tv'], true) || !ctype_digit((string)$tmdb) || (int)$tmdb < 1) return ['error' => 'Unknown title.'];
  $s0 = null; foreach (und_seerr_sources($cfg) as $x) if ($x['id'] === $app) $s0 = $x;
  if (!$s0) return ['error' => 'Unknown request app.'];
  $s = und_service_full($cfg, $app);
  $lock = und_lock('seerr-new:' . $app . ':' . $type . ':' . (int)$tmdb);
  if (!$lock) return ['error' => 'That title is already being requested.'];
  $body = ['mediaType' => $type, 'mediaId' => (int)$tmdb] + ($type === 'tv' ? ['seasons' => 'all'] : []);
  try {
    $r = und_http('POST', und_u($s['url'], '/api/v1/request'), ['headers' => ['X-Api-Key' => $s['key'], 'Content-Type' => 'application/json', 'Accept' => 'application/json'], 'body' => json_encode($body), 'timeout' => 20]);
    if ($r['err'] !== '') throw new Exception($r['err']);
    if ($r['code'] === 401 || $r['code'] === 403) throw new Exception('The API key may not request (HTTP ' . $r['code'] . ').');
    if ($r['code'] === 409) throw new Exception('It is already requested.');
    if ($r['code'] < 200 || $r['code'] >= 300) throw new Exception('HTTP ' . $r['code'] . (is_array($r['json']) && !empty($r['json']['message']) ? ': ' . und_clip((string)$r['json']['message'], 200) : ''));
    und_unlock($lock);
    @unlink(und_tmp('api-requests.json'));
    und_history_add('request', $s['name'] . ' ' . $type . ' ' . (int)$tmdb, 'request', true);
    return ['ok' => true];
  } catch (Throwable $e) {
    und_unlock($lock);
    $m = und_redact($e->getMessage(), [$s['key']]);
    und_history_add('request', $s['name'] . ' ' . $type . ' ' . (int)$tmdb, 'request', false, $m);
    return ['error' => $s['name'] . ': ' . $m];
  }
}
]]></INLINE>
<SHA256>d6acffedfb4329916763219c619fbccf7578f85cde0ab053d2b1b2cfadf98841</SHA256>
</FILE>

<FILE Name="&emhttp;/include/api.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - JSON API. Everything is POST.
 * Inside Unraid's web UI, Unraid's own local_prepend.php checks the login and the CSRF token of every POST before this file runs.
 * On the standalone port, standalone/router.php checks the Unraid login (or UnDash's own session) and its CSRF token first.
 */
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/auth.php';      // the Docker version's password (Settings > Connection)

header('Content-Type: application/json');
header('Cache-Control: no-store');
header('X-Content-Type-Options: nosniff');

function out($d, $code = 200) { http_response_code($code); echo json_encode($d, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR | JSON_INVALID_UTF8_SUBSTITUTE); exit; }
function fail($m, $code = 400) { out(['error' => $m], $code); }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') fail('POST only.', 405);
$action = (string)($_POST['action'] ?? '');
$P = function ($k, $d = '') { return isset($_POST[$k]) && is_string($_POST[$k]) ? $_POST[$k] : $d; };
$J = function ($k) { $v = json_decode((string)($_POST[$k] ?? ''), true); return is_array($v) ? $v : null; };

/** A background OS update check when the cached result is old: the page never waits for the update server. */
function api_os_autocheck(array $cfg, array $os) {
  $lock = und_tmp('os-check.lock');
  if ($os['job'] === 'running' || time() - $os['checked'] <= $cfg['general']['os_check_hours'] * 3600) return;
  if (is_file($lock) && time() - filemtime($lock) < 600) return;
  @touch($lock);
  und_spawn([PHP_BINARY ?: '/usr/bin/php', UND_ROOT . '/scripts/oscheck.php'], und_tmp('os-check.log'));
}

try {
switch ($action) {

  case 'boot': {
    $cfg = und_load_config(); $loc = und_loc();
    out(['version' => UND_VERSION, 'layout' => und_layout_view($cfg), 'types' => und_types(), 'css' => $cfg['appearance']['css_enabled'] ? und_load_css() : '',
         'server' => und_server_identity(),
         'standalone' => defined('UND_STANDALONE'), 'port' => (int)$loc['PORT'], 'port_enabled' => $loc['STANDALONE'] === 'yes' && !und_api_mode(), 'caps' => und_caps(),
         'api' => und_api_mode() ? ['configured' => und_api_conf()['url'] !== '' && und_api_conf()['key'] !== ''] : null,
         'auth' => und_api_mode() ? und_auth_kind() : 'unraid']);
  }

  /* one call per refresh: system metrics, containers and VMs (each part can be skipped when its section is hidden) */
  case 'live': {
    $cfg = und_load_config();
    $want = array_flip(explode(',', $P('parts', 'system,docker,vms')));
    $r = ['at' => time()];
    if (isset($want['system'])) { $r['system'] = und_system($cfg); if (!und_api_mode() && isset($r['system']['os_update'])) api_os_autocheck($cfg, $r['system']['os_update']); }
    if (isset($want['docker'])) $r['docker'] = und_docker_live();
    if (isset($want['vms'])) $r['vms'] = und_vm_live();
    if (isset($want['ups'])) $r['ups'] = und_ups($cfg['general']['ups_name']);
    // alerts are worked out here (one source for the page and the history); only the parts this request loaded are tracked
    if (isset($r['system'])) {
      $dk = $r['docker'] ?? null;
      $r['alerts'] = und_alerts($cfg, $r['system'], $dk);
      $scopes = isset($r['system']['error']) ? [] : ['system'];
      if (is_array($dk) && !isset($dk['error'])) $scopes[] = 'docker';
      und_alerts_track($dk === null ? array_values(array_filter($r['alerts'], function ($a) { return strpos($a['cat'], 'docker.') !== 0; })) : $r['alerts'], $scopes);
    }
    // the rules in force now, by the server's clock, so every open tab hides the same alerts
    $r['ignores'] = array_map(function ($x) { return ['id' => $x['id'], 'kind' => $x['kind'], 'key' => $x['key'], 'until' => $x['until']]; }, und_ignores_active($r['at']));
    $r['power'] = is_file(und_tmp('power-started')) ? trim((string)@file_get_contents(und_tmp('power-started'))) : '';
    out($r);
  }

  case 'service': {
    $id = $P('id');
    if (!preg_match('/^[a-f0-9]{8}$/', $id)) fail('Invalid widget id.');
    $r = und_fetch_service(und_load_config(), $id);
    $r['at'] = time();
    out($r);
  }

  /* ---- media, Arr Stack, download clients ---- */
  case 'media': {
    $k = $P('kind');
    if (!in_array($k, und_media_ids(), true)) fail('Unknown media list.');
    out(und_media(und_load_config(), $k));
  }
  case 'arr': {
    if (!preg_match('/^[a-f0-9]{8}$/', $P('id'))) fail('Invalid app id.');
    out(und_arr_status(und_load_config(), $P('id')));
  }
  case 'dl': {
    if (!preg_match('/^[a-f0-9]{8}$/', $P('id'))) fail('Invalid client id.');
    out(und_dl_status(und_load_config(), $P('id')));
  }
  case 'playing':  out(und_playing(und_load_config()));
  case 'requests': out(und_requests(und_load_config()));
  case 'request_action': {
    $r = und_request_action(und_load_config(), $P('app'), $P('id'), $P('op'));
    if (isset($r['error'])) fail($r['error'], 409);
    out($r);
  }
  case 'health': out(und_health(und_load_config(), $P('force') === '1'));
  case 'seerr_search': out(und_seerr_search(und_load_config(), $P('q')));
  case 'seerr_request': {
    $r = und_seerr_request(und_load_config(), $P('app'), $P('type'), $P('id'));
    if (isset($r['error'])) fail($r['error'], 409);
    out($r);
  }
  case 'dl_action': {
    if (!preg_match('/^[a-f0-9]{8}$/', $P('id'))) fail('Invalid client id.');
    $r = und_dl_action(und_load_config(), $P('id'), $P('op'));
    if (isset($r['error'])) fail($r['error'], 409);
    out($r);
  }

  /* ---- Docker ---- */
  case 'docker_action':  { $r = und_docker_action($P('name'), $P('op')); if (isset($r['error'])) fail($r['error'], 409); out($r); }
  case 'docker_logs':    { $r = und_docker_logs($P('name'), (int)$P('lines', '300')); if (isset($r['error'])) fail($r['error']); out($r); }
  case 'docker_inspect': { $r = und_docker_inspect($P('name')); if (isset($r['error'])) fail($r['error']); out($r); }
  case 'docker_check':   out(und_docker_check());
  case 'docker_job': {
    $n = $P('name');
    if ($n === '') out(und_job(und_tmp('docker-check.log')));
    if (!und_valid_container($n)) fail('Invalid container name.');
    out(und_docker_job($n));
  }

  /* ---- VMs ---- */
  case 'vm_action': { $r = und_vm_action($P('name'), $P('op')); if (isset($r['error'])) fail($r['error'], 409); out($r); }

  /* ---- server ---- */
  case 'power_prepare': { $r = und_power_prepare($P('op')); if (isset($r['error'])) fail($r['error']); out($r); }
  case 'power':         { $r = und_power($P('op'), $P('nonce'), $P('confirm')); if (isset($r['error'])) fail($r['error'], 409); out($r); }
  case 'history':       out(['history' => und_history()]);
  case 'self_update':   out(und_self_update());
  case 'alert_history': out(und_alert_history());

  /* ignored alerts: hiding only, monitoring goes on */
  case 'ignores_list':  out(['now' => time(), 'rules' => und_ignores(), 'categories' => und_alert_categories()]);
  case 'ignore_add': {
    $d = $P('duration');
    $r = und_ignore_add($P('kind'), $P('category'), $P('resource'), $d === 'permanent' ? 'permanent' : (ctype_digit($d) ? (int)$d : -1), $P('title'), $P('severity'));
    if (isset($r['error'])) fail($r['error']);
    out($r + ['now' => time()]);
  }
  case 'ignore_remove': {
    $ids = $J('ids') ?? [$P('id')];
    $r = und_ignore_remove($ids); if (isset($r['error'])) fail($r['error']); out($r);
  }
  case 'ignore_restore_all': { if ($P('confirm') !== 'yes') fail('Confirm restoring every ignored alert.'); $r = und_ignore_restore_all(); if (isset($r['error'])) fail($r['error']); out($r); }
  case 'ignore_purge_expired': { $r = und_ignore_purge_expired(); if (isset($r['error'])) fail($r['error']); out($r); }
  case 'os_status':     out(und_os_cached() + ['log' => und_job(und_tmp('os-update.log'))]);
  case 'os_check':      out(und_os_check());
  case 'os_update':     { $r = und_os_update(); if (isset($r['error'])) fail($r['error']); und_history_add('server', 'Unraid OS', 'update', true, 'install started'); out($r); }
  case 'storage':       out(und_storage());

  /* ---- settings ---- */
  case 'settings': {
    $cfg = und_load_config(); $loc = und_loc();
    out(['config' => $cfg, 'secrets' => und_secrets_view(und_secrets()), 'types' => und_types(), 'keep' => UND_KEEP, 'css' => und_load_css(),
         'loc' => $loc, 'store' => und_store_dir(), 'flash' => UND_DIR, 'metrics' => und_metric_ids(), 'sections' => und_section_ids()]);
  }
  case 'save': {
    $lk = und_config_lock();
    $cfg = $J('config');
    if (!$cfg || !isset($cfg['groups'])) fail('Nothing to save.');
    $norm = und_normalize($cfg);
    if (!und_save_config($norm)) fail('Could not write the configuration directory. Check that ' . und_store_dir() . ' is writable.', 500);
    if (isset($_POST['vars']) || isset($_POST['svc'])) und_save_secrets(und_secrets_merge(und_secrets(), $J('vars') ?: [], $J('svc') ?: [], und_service_ids($norm)));
    if (isset($_POST['css'])) und_save_css($P('css'), false);
    out(['ok' => true]);
  }
  /* small preference changes made on the dashboard itself (favourite, hide, collapse, layout): no backup, no secrets */
  case 'prefs': {
    $lk = und_config_lock();
    $cfg = und_load_config();
    $kind = $P('kind'); $key = $P('key'); $val = $J('value') ?: [];
    if ($kind === 'docker' || $kind === 'vms') {
      if ($key === '' || strlen($key) > 200) fail('Invalid name.');
      $items = (array)$cfg[$kind]['items'];
      $items[$key] = array_merge((array)($items[$key] ?? []), array_intersect_key($val, ['label' => 1, 'icon' => 1, 'description' => 1, 'hidden' => 1, 'favorite' => 1]));
      $cfg[$kind]['items'] = $items;
    } elseif ($kind === 'section') {
      foreach ($cfg['dashboard']['sections'] as &$s) if ($s['id'] === $key) $s = array_merge($s, array_intersect_key($val, ['collapsed' => 1, 'visible' => 1, 'width' => 1]));
      unset($s);
    } elseif ($kind === 'docker_view' || $kind === 'vms_view') {
      $k = $kind === 'docker_view' ? 'docker' : 'vms';
      $cfg[$k] = array_merge($cfg[$k], array_intersect_key($val, ['layout' => 1, 'sort' => 1, 'hide_stopped' => 1, 'view' => 1, 'filter' => 1, 'selected' => 1, 'columns' => 1]));
    } elseif ($kind === 'service') {
      foreach ($cfg['groups'] as &$g) foreach ($g['services'] as &$s) if ($s['id'] === $key) $s = array_merge($s, array_intersect_key($val, ['favorite' => 1, 'hidden' => 1]));
      unset($g, $s);
    } else fail('Unknown preference.');
    if (!und_save_config($cfg, false)) fail('Could not save.', 500);
    out(['ok' => true, 'layout' => und_layout_view(und_load_config())]);
  }
  case 'test': {
    // try one widget with the settings shown in the form, before they are saved
    $cfg = $J('config'); $id = $P('id');
    if (!$cfg || !preg_match('/^[a-f0-9]{8}$/', $id)) fail('Nothing to test.');
    $norm = und_normalize($cfg);
    $GLOBALS['UND_TEST_SECRETS'] = und_secrets_merge(und_secrets(), $J('vars') ?: [], $J('svc') ?: [], und_service_ids($norm));
    out(und_fetch_service($norm, $id));
  }
  case 'validate': out(['issues' => und_validate(und_load_config())]);

  /* ---- Unraid API connection (Docker version) ---- */
  case 'unraid_conf': {
    $c = und_api_conf();
    out(['url' => $c['url'], 'key_set' => $c['key'] !== '', 'from_env' => $c['from_env'], 'mode' => UND_MODE]);
  }
  case 'unraid_save': {
    $url = trim($P('url')); $key = $P('key');
    if ($url !== '' && !preg_match('#^https?://[^\s"\'<>]+$#i', $url)) fail('The address must start with http:// or https://, e.g. http://192.168.1.10/graphql');
    $sec = und_secrets();
    $sec['unraid']['url'] = und_clip($url, 300);
    if ($key !== UND_KEEP) $sec['unraid']['key'] = und_clip(trim($key), 300);
    und_save_secrets($sec);
    foreach (['system', 'containers', 'vms', 'ups'] as $n) @unlink(und_tmp('api-' . $n . '.json'));
    out(['ok' => true]);
  }
  case 'unraid_test': out(und_api_test());

  /* ---- the dashboard password (Docker version) ---- */
  case 'auth_status': out(['kind' => und_api_mode() ? und_auth_kind() : 'unraid']);
  case 'password_set': case 'password_remove': {
    if (!und_api_mode()) fail('The plugin signs in with your Unraid login.');
    $kind = und_auth_kind();
    if ($kind === 'env') fail('The password comes from UNDASH_PASSWORD in the container settings; change it there.');
    $ip = (string)($_SERVER['REMOTE_ADDR'] ?? '');
    if ($kind === 'file') {
      if (und_login_throttled($ip)) fail('Too many wrong passwords. Wait 15 minutes.', 429);
      if (!und_password_ok($P('current'))) { und_login_failed($ip); fail('The current password is wrong.', 403); }
    }
    if ($action === 'password_remove') { if ($P('confirm') !== 'yes') fail('Confirm going without a password.'); $r = und_auth_open(); }
    else { if ($P('password') !== $P('password2')) fail('The passwords do not match.'); $r = und_password_set($P('password')); }
    if (isset($r['error'])) fail($r['error']);
    if ($action === 'password_set') und_sess_drop_others();
    und_history_add('server', 'Dashboard password', $action === 'password_remove' ? 'removed' : ($kind === 'file' ? 'changed' : 'set'), true);
    out(['ok' => true, 'kind' => und_auth_kind()]);
  }
  case 'loc_save': {
    $r = und_save_loc(['CONFIG_DIR' => $P('dir'), 'PORT' => $P('port'), 'BIND' => $P('bind'), 'STANDALONE' => $P('standalone') === 'yes' ? 'yes' : 'no']);
    if (isset($r['error'])) fail($r['error']);
    // the standalone listener picks up a new port or address when it is restarted
    und_spawn([UND_ROOT . '/scripts/rc.undash', 'restart'], und_tmp('rc.log'));
    out($r + ['store' => und_store_dir()]);
  }

  /* ---- import / export / backups ---- */
  case 'export':        out(und_export($P('kind') === 'full' ? 'full' : 'redacted'));
  case 'import_check':  { $r = und_import_parse($P('file')); if (isset($r['error'])) fail($r['error']); out(['summary' => $r['summary']]); }
  case 'import_file':   { $r = und_import_apply($P('file')); if (isset($r['error'])) fail($r['error']); out($r); }
  case 'backups':       out(['backups' => und_backups()]);
  case 'restore':       { $r = und_restore($P('id')); if (isset($r['error'])) fail($r['error']); out($r); }
  case 'import_preview': {
    $c = und_hp_convert($P('services'), $P('settings'), $P('env'));
    if (isset($c['error'])) fail($c['error']);
    $stored = und_secrets()['vars'];
    out(['groups' => $c['groups'], 'services' => $c['services'], 'warnings' => $c['warnings'],
         'vars' => array_map(function ($n, $v) use ($stored) { return ['name' => $n, 'set' => $v !== null && $v !== '', 'stored' => isset($stored[$n]) && $stored[$n] !== '']; }, array_keys($c['vars']), $c['vars']),
         'layout' => array_map(function ($g) { return ['name' => $g['name'], 'services' => array_map(function ($s) { return $s['name'] . ' (' . $s['type'] . ')'; }, $g['services'])]; }, $c['config']['groups'])]);
  }
  case 'import_apply': {
    $c = und_hp_convert($P('services'), $P('settings'), $P('env'));
    if (isset($c['error'])) fail($c['error']);
    und_backup('before Homepage import');
    out(und_hp_apply($c));
  }
  case 'reset': {
    und_backup('before reset');
    und_save_config(und_default_config(), false);
    out(['ok' => true]);
  }
}
} catch (Throwable $e) {
  // never show a stack trace or a path to the browser; the details go to the PHP error log
  error_log('undash: ' . $e->getMessage() . ' in ' . $e->getFile() . ':' . $e->getLine());
  fail('Internal error while handling "' . preg_replace('/[^a-z_]/', '', $action) . '".', 500);
}
fail('Unknown action.');
]]></INLINE>
<SHA256>6df56974c7445671539aa543529282b94d8bbd65e978c957c6e9f14171968652</SHA256>
</FILE>

<FILE Name="&emhttp;/handoff.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - sign-in handoff to the standalone port. This file is served by Unraid's nginx, so only a browser that is
 * logged in to Unraid reaches it. It creates a one-time token (valid 60 s) and sends the browser to the standalone port
 * on the same host name, where the token is swapped for an UnDash session.
 */
require_once '/usr/local/emhttp/plugins/undash/include/lib.php';
require_once '/usr/local/emhttp/plugins/undash/include/auth.php';
$loc = und_loc();
$host = und_req_host();
header('Cache-Control: no-store');
if ($loc['STANDALONE'] !== 'yes' || $host === '') { header('Location: /UnDash', true, 303); exit; }
header('Location: http://' . $host . ':' . (int)$loc['PORT'] . '/?t=' . und_handoff_create(), true, 303);
]]></INLINE>
<SHA256>6ba3255fd3575576a7a6d8178e5f3f6cf2dda32d7c3b8c55222a01b22028d591</SHA256>
</FILE>

<FILE Name="&emhttp;/standalone/router.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * UnDash - the standalone port (default 9099), started by scripts/rc.undash with PHP's built-in web server:
 *   php -S <BIND>:<PORT> -t standalone standalone/router.php
 * Serves the full-window dashboard, its assets and the API. Every request except the sign-in redirect needs a session
 * (see include/auth.php); every API call also needs the session's CSRF token and a same-origin request.
 */
if (!defined('UND_ROOT')) define('UND_ROOT', dirname(__DIR__));
require_once UND_ROOT . '/include/lib.php';
require_once UND_ROOT . '/include/auth.php';

$uri = (string)parse_url((string)($_SERVER['REQUEST_URI'] ?? '/'), PHP_URL_PATH);
$method = (string)($_SERVER['REQUEST_METHOD'] ?? 'GET');

header('X-Content-Type-Options: nosniff');
header('X-Frame-Options: DENY');
header('Referrer-Policy: no-referrer');
header("Content-Security-Policy: default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https:");

function sa_deny($code, $msg) { http_response_code($code); header('Content-Type: text/plain; charset=utf-8'); echo $msg; exit; }

/** Where Unraid's web UI is: same host, its own port (80/443). nginx redirects http to https when Unraid requires it. */
function sa_unraid_base() { $h = und_req_host(); return $h === '' ? '' : 'http://' . $h; }

/** The login / setup page (Docker version). Plain HTML, no script, so the strict CSP still applies. */
function sa_form_page($title, $intro, $fields, $error = '', $skip = false) {
  $pre = bin2hex(random_bytes(16));
  setcookie('undash_pre', $pre, ['expires' => 0, 'path' => '/', 'httponly' => true, 'samesite' => 'Strict', 'secure' => !empty($_SERVER['HTTPS'])]);
  $e = function ($x) { return htmlspecialchars((string)$x, ENT_QUOTES, 'UTF-8'); };
  header('Content-Type: text/html; charset=utf-8'); header('Cache-Control: no-store');
  echo '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UnDash · ', $e($title), '</title>',
       '<link rel="icon" href="/favicon.png"><link rel="stylesheet" href="/assets/app.css"></head><body class="und-page"><div class="und"><form class="login card" method="post">',
       '<div class="brand"><img src="/favicon.png" alt="" width="40" height="40"><h1 class="und-name">', $e($title), '</h1></div><p class="muted">', $e($intro), '</p>';
  if ($error !== '') echo '<div class="banner bad" role="alert">', $e($error), '</div>';
  foreach ($fields as $f) echo '<div class="fld"><label for="', $f[0], '">', $e($f[1]), '</label><input id="', $f[0], '" name="', $f[0], '" type="', $f[2], '" autocomplete="', $f[3], '" required', $f[0] === $fields[0][0] ? ' autofocus' : '', '></div>';
  echo '<input type="hidden" name="pre" value="', $pre, '"><button class="btn pri" type="submit">Set password and continue</button>';
  if ($skip) {
    // a second form, so skipping never needs the code or the password fields
    echo '</form><form class="login card skip" method="post"><input type="hidden" name="pre" value="', $pre, '"><input type="hidden" name="skip" value="1">',
         '<p class="muted"><b>Recommended:</b> set a password. Without one, anyone who can open this address can see and control your containers and VMs. ',
         'You can add a password later in Settings &gt; Configuration.</p><button class="btn" type="submit">Continue without a password</button>';
  }
  echo '</form></div></body></html>';
  exit;
}
function sa_pre_ok() { $c = (string)($_COOKIE['undash_pre'] ?? ''); return $c !== '' && hash_equals($c, (string)($_POST['pre'] ?? '')); }
function sa_ip() { return (string)($_SERVER['REMOTE_ADDR'] ?? ''); }

/* ---- health check (Docker HEALTHCHECK): says nothing about the server ---- */
if ($uri === '/health') { header('Content-Type: text/plain'); header('Cache-Control: no-store'); echo "ok\n"; exit; }
if ($uri === '/assets/inter.woff2') {
  // the bundled Inter font (SIL Open Font License); public, needed by the sign-in page too
  header('Content-Type: font/woff2'); header('Cache-Control: public, max-age=31536000, immutable');
  readfile(UND_ROOT . '/assets/inter.woff2'); exit;
}
if ($uri === '/assets/app.css' || $uri === '/favicon.png') {
  // needed by the sign-in page too; nothing secret in either
  header('Content-Type: ' . ($uri === '/favicon.png' ? 'image/png' : 'text/css; charset=utf-8'));
  header('Cache-Control: no-cache');
  readfile($uri === '/favicon.png' ? UND_ROOT . '/images/undash.png' : UND_ROOT . $uri); exit;
}

/* ---- sign-in ---- */
$sess = und_sess_get();
if (!$sess && und_api_mode()) {
  $kind = und_auth_kind();
  if ($kind === 'none') {
    if ($uri !== '/setup') { if ($method === 'GET' && $uri === '/') { header('Location: /setup', true, 303); exit; } sa_deny(401, 'Not signed in.'); }
    $err = '';
    if ($method === 'POST' && ($_POST['skip'] ?? '') === '1') {
      // going without a password cannot lock anybody out (a password can be set later), so it needs no setup code
      if (!sa_pre_ok()) $err = 'The form expired. Try again.';
      else { $r = und_auth_open(); if (isset($r['error'])) $err = $r['error']; else { error_log('undash: dashboard password skipped from ' . sa_ip()); und_sess_new('open'); header('Location: /', true, 303); exit; } }
    } elseif ($method === 'POST') {
      $code = trim((string)@file_get_contents(und_setup_file()));
      if (!sa_pre_ok()) $err = 'The form expired. Try again.';
      elseif (und_login_throttled(sa_ip())) $err = 'Too many attempts. Wait 15 minutes.';
      elseif ($code === '' || !hash_equals($code, strtoupper(trim((string)($_POST['code'] ?? ''))))) { und_login_failed(sa_ip()); $err = 'The setup code is wrong. It is in the container log.'; }
      elseif ((string)($_POST['password'] ?? '') !== (string)($_POST['password2'] ?? '')) $err = 'The passwords do not match.';
      else { $r = und_password_set((string)$_POST['password']); if (isset($r['error'])) $err = $r['error']; else { und_sess_new('setup'); header('Location: /', true, 303); exit; } }
    }
    sa_form_page('Set up UnDash', 'Choose the password for this dashboard. The setup code is printed in the container log (Docker tab > UnDash > Logs).',
      [['code', 'Setup code', 'text', 'one-time-code'], ['password', 'New password (10+ characters)', 'password', 'new-password'], ['password2', 'Repeat the password', 'password', 'new-password']], $err, true);
  }
  if ($kind === 'open') { $sess = und_sess_new('open'); }   // no password chosen: everyone who reaches the port is signed in
  else {
  if ($uri === '/login' || ($method === 'GET' && $uri === '/')) {
    $err = '';
    if ($method === 'POST' && $uri === '/login') {
      if (!sa_pre_ok()) $err = 'The form expired. Try again.';
      elseif (und_login_throttled(sa_ip())) $err = 'Too many wrong passwords. Wait 15 minutes.';
      elseif (!und_password_ok((string)($_POST['password'] ?? ''))) { und_login_failed(sa_ip()); usleep(400000); $err = 'Wrong password.'; error_log('undash: failed sign-in from ' . sa_ip()); }
      else { und_sess_new('password'); header('Location: /', true, 303); exit; }
    } elseif ($uri === '/') { header('Location: /login', true, 303); exit; }
    sa_form_page('UnDash', 'Sign in to the dashboard.', [['password', 'Password', 'password', 'current-password']], $err);
  }
  sa_deny(401, 'Not signed in.');
  }
}
if (!$sess && $method === 'GET' && isset($_GET['t'])) {
  if (und_handoff_use((string)$_GET['t'])) { und_sess_new('handoff'); header('Location: /', true, 303); exit; }
  sa_deny(403, 'That sign-in link expired. Open UnDash from Unraid again.');
}
if (!$sess && und_unraid_logged_in()) $sess = und_sess_new('unraid');
if (!$sess) {
  if ($method === 'GET' && ($uri === '/' || $uri === '/index.html')) {
    $base = sa_unraid_base();
    if ($base === '') sa_deny(400, 'Bad host name.');
    // behind Unraid's login: it creates a one-time token and sends the browser back here
    header('Location: ' . $base . '/plugins/undash/handoff.php', true, 303);
    exit;
  }
  sa_deny(401, 'Not signed in. Open UnDash from Unraid first.');
}

/* ---- routes ---- */
if ($sess && $method === 'GET' && ($uri === '/setup' || $uri === '/login')) { header('Location: /', true, 303); exit; }
if ($uri === '/logout') { und_sess_end(); header('Location: ' . (und_api_mode() ? '/login' : sa_unraid_base() . '/'), true, 303); exit; }

if ($uri === '/api') {
  if ($method !== 'POST') sa_deny(405, 'POST only.');
  $tok = (string)($_SERVER['HTTP_X_CSRF_TOKEN'] ?? ($_POST['csrf_token'] ?? ''));
  if (!hash_equals($sess['csrf'], $tok)) sa_deny(403, 'Bad CSRF token. Reload the page.');
  // a cross-site page cannot read the token, but refuse foreign origins anyway
  $origin = (string)($_SERVER['HTTP_ORIGIN'] ?? '');
  if ($origin !== '' && strcasecmp(preg_replace('#^https?://#', '', $origin), (string)($_SERVER['HTTP_HOST'] ?? '')) !== 0) sa_deny(403, 'Cross-origin request refused.');
  unset($_POST['csrf_token']);
  define('UND_STANDALONE', 1);
  require UND_ROOT . '/include/api.php';
  exit;
}

if ($uri === '/assets/app.js') {
  $f = UND_ROOT . $uri;
  header('Content-Type: ' . (substr($uri, -3) === 'css' ? 'text/css' : 'application/javascript') . '; charset=utf-8');
  header('Cache-Control: no-cache');
  readfile($f); exit;
}
if ($uri === '/assets/boot.js') {
  // page settings as a script file, so the page needs no inline script (the CSP forbids it)
  header('Content-Type: application/javascript; charset=utf-8');
  header('Cache-Control: no-store');
  $unraid = und_api_mode() ? preg_replace('#/graphql$#', '', und_api_conf()['url']) : sa_unraid_base();
  echo 'window.UND_API="/api";window.UND_CSRF=' . json_encode($sess['csrf']) . ';window.UND_UNRAID=' . json_encode($unraid) . ';window.UND_STANDALONE=true;';
  exit;
}
if ($uri === '/images/undash.png') { header('Content-Type: image/png'); header('Cache-Control: max-age=86400'); readfile(UND_ROOT . '/images/undash.png'); exit; }

// container and VM icons that Unraid itself serves from these two folders
$icons = ['/state/plugins/dynamix.docker.manager/images/' => '/usr/local/emhttp/state/plugins/dynamix.docker.manager/images/',
          '/plugins/dynamix.vm.manager/templates/images/' => '/usr/local/emhttp/plugins/dynamix.vm.manager/templates/images/'];
foreach ($icons as $prefix => $dir) {
  if (strpos($uri, $prefix) !== 0) continue;
  $name = rawurldecode(substr($uri, strlen($prefix)));
  if (!preg_match('/^[A-Za-z0-9_. -]+\.(png|svg|jpg)$/', $name) || strpos($name, '..') !== false || !is_file($dir . $name)) sa_deny(404, 'Not found');
  $ext = pathinfo($name, PATHINFO_EXTENSION);
  header('Content-Type: ' . ($ext === 'svg' ? 'image/svg+xml' : ($ext === 'jpg' ? 'image/jpeg' : 'image/png')));
  header('Cache-Control: max-age=3600');
  if ($ext === 'svg') header("Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'");
  readfile($dir . $name); exit;
}

if ($uri === '/' || $uri === '/index.html') {
  $v = (int)@filemtime(UND_ROOT . '/assets/app.js');
  header('Content-Type: text/html; charset=utf-8');
  header('Cache-Control: no-store');
  echo '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">',
       '<title>UnDash</title><link rel="icon" href="/favicon.png"><link rel="stylesheet" href="/assets/app.css?v=', $v, '">',
       '</head><body class="und-page"><div id="und" class="und"><div class="und-loading">Loading UnDash…</div></div>',
       '<script src="/assets/boot.js"></script><script src="/assets/app.js?v=', $v, '"></script></body></html>';
  exit;
}
sa_deny(404, 'Not found');
]]></INLINE>
<SHA256>f6f214361e772eca9e72d738c52bf326129a0b36c0395f7984f2ff021ba2dc3d</SHA256>
</FILE>

<FILE Name="&emhttp;/scripts/oscheck.php" Mode="0755">
<INLINE><![CDATA[#!/usr/bin/php
<?php
/* UnDash - background Unraid OS update check (started by the API when the cached result is older than the configured interval). */
require_once '/usr/local/emhttp/plugins/undash/include/lib.php';
$r = und_os_check();
@unlink(und_tmp('os-check.lock'));
echo $r['available'] ? 'Unraid ' . $r['latest'] . " is available\n" : ($r['error'] ?: 'Unraid ' . $r['installed'] . " is up to date\n");
]]></INLINE>
<SHA256>6e2e28f1d5fa0e62f93a2637b66b8d1da2a8fe0bcd3f6a4c1982c6612f1e2605</SHA256>
</FILE>

<FILE Name="&emhttp;/scripts/alertcheck.php" Mode="0755">
<INLINE><![CDATA[<?php
/* UnDash - one alert check for the history (run every minute by rc.undash in the plugin, by the entrypoint in Docker). */
if (!defined('UND_ROOT')) define('UND_ROOT', dirname(__DIR__));
require_once UND_ROOT . '/include/lib.php';
und_alerts_check();
]]></INLINE>
<SHA256>4b3eb0707478bfa3bd7b0c118d180990190afb01a444ed28f6c1f8a3ccf42918</SHA256>
</FILE>

<FILE Name="&emhttp;/scripts/rc.undash" Mode="0755">
<INLINE><![CDATA[#!/bin/bash
# UnDash - start / stop the standalone dashboard port (default 9099).
# Settings come from /boot/config/plugins/undash/undash.cfg (PORT, BIND, STANDALONE); they are read, never sourced.
EM=/usr/local/emhttp/plugins/undash
CFG=/boot/config/plugins/undash/undash.cfg
PIDF=/var/run/undash.pid
CPIDF=/var/run/undash-check.pid

val() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$CFG" 2>/dev/null | tail -1; }
PORT=$(val PORT); BIND=$(val BIND); ON=$(val STANDALONE)
[[ "$PORT" =~ ^[0-9]{4,5}$ ]] && (( PORT >= 1024 && PORT <= 65535 )) || PORT=9099
[[ "$BIND" =~ ^[0-9a-fA-F.:]+$ ]] || BIND=0.0.0.0
[[ "$ON" == "no" ]] || ON=yes

running() { [[ -f $PIDF ]] && kill -0 "$(cat $PIDF)" 2>/dev/null && grep -q "undash/standalone" "/proc/$(cat $PIDF)/cmdline" 2>/dev/null; }

start() {
  [[ $ON == yes ]] || { echo "UnDash standalone port is turned off"; return 0; }
  running && { echo "UnDash already listening (pid $(cat $PIDF))"; return 0; }
  if ss -ltn "sport = :$PORT" 2>/dev/null | grep -q LISTEN; then
    echo "Port $PORT is already in use; UnDash's standalone port was not started" | tee -a /var/log/undash.log
    logger -t undash "port $PORT is already in use; standalone dashboard not started"
    return 1
  fi
  mkdir -p /tmp/undash
  # 4 workers so slow app APIs or a log download never block the dashboard; access logs are not kept, errors go to syslog.
  # Unraid's php.ini prepends webGui/include/local_prepend.php (its own CSRF check for nginx requests); this port does its own
  # sign-in and CSRF checks in router.php, so the prepend is switched off here.
  PHP_CLI_SERVER_WORKERS=4 setsid nohup /usr/bin/php -d auto_prepend_file= -d error_log=syslog -d display_errors=0 -d expose_php=0 \
    -S "$BIND:$PORT" -t "$EM/standalone" "$EM/standalone/router.php" > /dev/null 2>&1 &
  echo $! > $PIDF
  sleep 0.5
  running && echo "UnDash listening on $BIND:$PORT" || { echo "UnDash standalone port failed to start"; return 1; }
}

stop() {
  if running; then
    pkill -P "$(cat $PIDF)" 2>/dev/null; kill "$(cat $PIDF)" 2>/dev/null; sleep 0.3
    echo "UnDash standalone port stopped"
  fi
  rm -f $PIDF
}

# the alert history: one check a minute in the background, whether or not the standalone port is on
checking() { [[ -f $CPIDF ]] && kill -0 "$(cat $CPIDF)" 2>/dev/null && grep -q "undash-alertcheck" "/proc/$(cat $CPIDF)/cmdline" 2>/dev/null; }
start_check() {
  checking && return 0
  mkdir -p /tmp/undash
  setsid nohup bash -c 'exec -a undash-alertcheck bash -c "while true; do nice -n 10 /usr/bin/php -d auto_prepend_file= -d error_log=syslog -d display_errors=0 '"$EM"'/scripts/alertcheck.php; sleep 60; done"' > /dev/null 2>&1 &
  echo $! > $CPIDF
}
stop_check() {
  if checking; then pkill -P "$(cat $CPIDF)" 2>/dev/null; kill "$(cat $CPIDF)" 2>/dev/null; fi
  rm -f $CPIDF
}

case "$1" in
  start) start_check; start ;;
  stop) stop; stop_check ;;
  restart) stop; stop_check; start_check; start ;;
  status) running && echo "running on $BIND:$PORT (pid $(cat $PIDF))" || echo "stopped"; checking && echo "alert checker running (pid $(cat $CPIDF))" || echo "alert checker stopped" ;;
  *) echo "usage: $0 start|stop|restart|status"; exit 1 ;;
esac
]]></INLINE>
<SHA256>2b2bd609551f29d731648d92df227f583cb2cecfa5b7c1e7324635de467816a7</SHA256>
</FILE>

<FILE Name="&emhttp;/assets/app.css" Mode="0644">
<INLINE><![CDATA[/* UnDash - one stylesheet, scoped to .und so nothing leaks into Unraid's page.
   Colour themes are palettes in app.js (THEMES), applied as the custom properties below; these values are the Default
   dark palette (the Unraid Swiss Manager look: dark grey panels, orange accent) and only show before the script runs.
   The accent (--accent) only colours interactive and selected things; status colours (--ok, --warn, --bad) never follow it. */
/* Inter, bundled (SIL Open Font License 1.1, see docs/licenses/Inter-OFL.txt): latin subset, variable weight 400-700 */
@font-face{font-family:Inter;font-style:normal;font-weight:400 700;font-display:swap;src:url(inter.woff2) format('woff2');
  unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
.und{
  --bg:#1d1b1b;--panel:#232121;--panel-2:#1b1919;--bar:#2a2828;--field:#181616;--line:#343131;--line-2:#454141;
  --text:#ece9e9;--muted:#a19c9c;--faint:#7f7977;--title:#fff;
  --safe-x:0px;--safe-y:4px;      /* the margin around the dashboard; Settings > Theme can set its own */
  --accent:#f15a2c;--accent-btn:#d4431a;--accent-ink:#fff;--accent-soft:rgba(241,90,44,.14);--accent-text:#ff7a50;
  --ok:#4ec38b;--warn:#e8b33c;--bad:#ff6b5e;--info:#79a0ee;--off:#8a8484;
  --ok-soft:rgba(78,195,139,.13);--warn-soft:rgba(232,179,60,.14);--bad-soft:rgba(255,107,94,.13);
  --shadow:0 1px 2px rgba(0,0,0,.25);--radius:10px;--gap:12px;--pad:14px;
  --font:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color:var(--text);font:14px/1.45 var(--font);margin:0;padding:var(--safe-y) var(--safe-x) calc(var(--safe-y) + 24px);text-align:left;position:relative;isolation:isolate;-webkit-text-size-adjust:100%}
/* inside Unraid's page a theme with its own background gets a little inner margin; the full-window page always has its own */
.und[data-mode=light],.und[data-theme]:not([data-theme=default]),.und.has-bg{background:var(--bg);--safe-x:14px;--safe-y:14px;border-radius:var(--radius)}
.und[data-density=compact]{--gap:8px;--pad:10px;font-size:13.5px}
.und[data-density=expanded]{--gap:16px;--pad:18px;font-size:14.5px}
.und *,.und *::before,.und *::after{box-sizing:border-box}
body.und-page{margin:0;background:#1d1b1b;min-height:100vh}
body.und-page .und{min-height:100vh}
:where(body.und-page) .und{background:var(--bg)}      /* low specificity, so a theme's own background (Fluent's gradient) wins */
body.und-page .und,body.und-page .und[data-mode],body.und-page .und[data-theme],body.und-page .und.has-bg{--safe-x:clamp(12px,2.5vw,32px);--safe-y:16px;border-radius:0}
.und-loading{padding:48px;text-align:center;color:#a19c9c;font:14px system-ui,sans-serif}
.und a{color:var(--accent-text);text-decoration:none}.und a:hover{text-decoration:underline}
.und .muted{color:var(--muted)}.und .faint{color:var(--faint)}.und .sm{font-size:12.5px}.und .xs{font-size:11.5px}.und b{font-weight:600}
.und .grow{flex:1 1 auto;min-width:0}.und .nowrap{white-space:nowrap}.und .num{font-variant-numeric:tabular-nums}.und .mono{font-family:var(--mono);font-size:12px}
.und .ell{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.und :where(svg[aria-hidden]){width:16px;height:16px;flex:none}
.und :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}

/* wallpaper and focus mode */
.und .und-bg{position:absolute;inset:0;z-index:-1;border-radius:inherit;background-size:cover;background-position:center;overflow:hidden}
.und.full{position:fixed;inset:0;z-index:9000;overflow:auto;border-radius:0}
:where(.und.full){background:var(--bg)}
.und.full,.und.full[data-mode],.und.full[data-theme]{--safe-x:clamp(12px,2.5vw,32px);--safe-y:16px;border-radius:0}
.und.full .und-bg{position:fixed}

/* ---------- header ---------- */
.und .top{display:flex;align-items:center;gap:10px 12px;flex-wrap:wrap;margin-bottom:16px}
.und .brand{display:flex;align-items:center;gap:12px;min-width:0;flex:0 1 auto}
.und .logo{width:40px;height:40px;border-radius:10px;flex:none;display:block}
.und .und-name{font:600 20px/1.2 Poppins,"Segoe UI",system-ui,sans-serif;color:var(--title);margin:0;padding:0;border:0;background:none;text-shadow:none;letter-spacing:0}
.und .und-sub{font-size:12.5px;color:var(--muted);display:flex;gap:6px 8px;flex-wrap:wrap;align-items:center;margin-top:2px}
.und .und-sub .vchip{display:inline-flex;align-items:center;gap:6px;padding:1px 3px 1px 8px;border:1px solid var(--line-2);border-radius:999px;line-height:18px;white-space:nowrap;color:var(--text);font-size:11.5px}
.und .und-sub .vchip:not(:has(.upd)){padding-right:8px}
.und .und-sub .upd{all:unset;display:inline-flex;align-items:center;gap:3px;cursor:pointer;background:var(--accent);color:var(--accent-ink);border-radius:999px;padding:0 7px;font-size:11px;font-weight:600;line-height:16px}
.und .und-sub .upd svg{width:11px;height:11px}.und .und-sub .upd:hover{filter:brightness(1.1)}.und .und-sub .upd:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.und .top .search{flex:1 1 220px;max-width:440px;margin-left:auto;position:relative}
.und .top .search input{width:100%;padding-left:32px!important}
.und .sbox{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:9000;background:var(--panel);border:1px solid var(--line-2);border-radius:var(--radius);box-shadow:0 12px 32px rgba(0,0,0,.35);max-height:min(70vh,560px);overflow:auto;padding:6px;min-width:min(420px,calc(100vw - 24px))}
.und[data-theme=fluent] .sbox{background:rgba(17,19,24,.97)}.und[data-theme=fluent][data-mode=light] .sbox{background:rgba(255,255,255,.98)}
.und .sbox .sb-h{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);padding:4px 6px 8px}.und .sbox .sb-h>svg{width:14px;height:14px;flex:none}
.und .sbox .sb-r{display:flex;align-items:center;gap:12px;padding:8px;border-radius:calc(var(--radius) - 2px)}
.und .sbox .sb-r:hover{background:var(--bar)}
.und .sbox .sb-r .rqp{width:34px;height:51px}
.und .sbox .sb-r>.btn,.und .sbox .sb-r>.badge{flex:none}
.und .sbox .sb-o{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.und .sbox>.empty{padding:10px 8px}
.und .top .search>svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:var(--faint);pointer-events:none}
.und .top .acts{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.und .live{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:2px 3px 2px 10px;white-space:nowrap}
.und .live .dot{width:7px;height:7px;border-radius:50%;background:var(--ok);flex:none}
.und .live.retry .dot{background:var(--warn)}.und .live.down .dot{background:var(--bad)}.und .live.paused .dot{background:var(--off)}
.und .live .btn{border-radius:999px!important;min-height:26px!important;width:26px;min-width:26px!important}

/* ---------- buttons, inputs ---------- */
.und button.btn,.und .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;background:var(--bar)!important;color:var(--text)!important;border:1px solid var(--line-2)!important;border-radius:6px!important;
  padding:6px 11px!important;margin:0!important;font:inherit!important;font-size:13px!important;font-weight:500!important;line-height:1.25!important;cursor:pointer;text-transform:none!important;letter-spacing:0!important;
  min-height:32px!important;min-width:0!important;box-shadow:none!important;text-decoration:none!important;white-space:nowrap;-webkit-tap-highlight-color:transparent}
.und .btn:hover:not(:disabled){border-color:var(--accent)!important}
.und .btn:disabled{opacity:.5;cursor:not-allowed}
.und .btn.pri{background:var(--accent-btn)!important;border-color:var(--accent-btn)!important;color:var(--accent-ink)!important}
.und .btn.pri:hover:not(:disabled){filter:brightness(1.08)}
.und .btn.ghost{background:transparent!important;border-color:transparent!important}.und .btn.ghost:hover:not(:disabled){background:var(--bar)!important;border-color:var(--line-2)!important}
.und .btn.danger{color:var(--bad)!important}.und .btn.danger.solid{background:var(--bad)!important;border-color:var(--bad)!important;color:#fff!important}
.und .btn.okc{color:var(--ok)!important}
.und .btn.sm{min-height:28px!important;padding:3px 9px!important;font-size:12.5px!important}
.und .btn.ic{padding:0!important;width:32px;min-width:32px!important}.und .btn.ic.sm{width:28px;min-width:28px!important}
.und .btn svg{width:15px;height:15px;flex:none}
.und .btn.on{border-color:var(--accent)!important;background:var(--accent-soft)!important}
.und input[type=text],.und input[type=number],.und input[type=url],.und input[type=password],.und input[type=search],.und select,.und textarea{
  background:var(--field)!important;color:var(--text)!important;border:1px solid var(--line-2)!important;border-radius:6px!important;padding:6px 9px!important;margin:0!important;
  font:inherit!important;font-size:13px!important;height:auto!important;min-height:32px;max-width:100%;box-shadow:none!important;width:auto}
.und input::placeholder,.und textarea::placeholder{color:var(--faint)}
.und input:focus,.und select:focus,.und textarea:focus{border-color:var(--accent)!important;outline:0}
.und input[type=checkbox],.und input[type=radio]{accent-color:var(--accent);width:16px;height:16px;margin:0;vertical-align:middle;flex:none}
.und input[type=color]{width:42px;height:32px;padding:2px!important;border:1px solid var(--line-2)!important;border-radius:6px!important;background:var(--field)!important;cursor:pointer}
.und textarea{width:100%;resize:vertical;font-family:var(--mono)!important;font-size:12.5px!important;line-height:1.5!important;tab-size:2}
.und .seg{display:inline-flex;border:1px solid var(--line-2);border-radius:6px;overflow:hidden;flex:none}
.und .seg button{background:transparent!important;border:0!important;border-right:1px solid var(--line-2)!important;border-radius:0!important;color:var(--muted)!important;padding:4px 10px!important;margin:0!important;font:inherit!important;font-size:12.5px!important;min-height:28px!important;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
.und .seg button:last-child{border-right:0!important}.und .seg button.on{background:var(--accent-soft)!important;color:var(--text)!important}
.und .seg button svg{width:14px;height:14px}

/* ---------- badges ---------- */
.und .badge{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:1px 8px;font-size:11.5px;font-weight:500;line-height:18px;border:1px solid var(--line-2);color:var(--muted);white-space:nowrap;background:transparent!important;width:auto!important}
.und .badge::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor;flex:none}
.und .badge.plain::before{display:none}
.und .badge.ok{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 35%,transparent)}
.und .badge.warn{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,transparent)}
.und .badge.bad{color:var(--bad);border-color:color-mix(in srgb,var(--bad) 40%,transparent)}
.und .badge.off{color:var(--off)}
.und .badge.upd{color:var(--accent-text);border-color:color-mix(in srgb,var(--accent) 45%,transparent)}.und .badge.upd::before{display:none}
.und .badge.info{color:var(--info)}
.und .chips{display:flex;gap:6px;flex-wrap:wrap}

/* ---------- sections ---------- */
.und .sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px var(--gap);align-items:start}
.und .sec{grid-column:1/-1;min-width:0}.und .sec.half{grid-column:auto}
.und .hcols{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 var(--gap);align-items:start;min-width:0}
.und .hcol{display:flex;flex-direction:column;gap:16px;min-width:0}
.und .hcols.one{grid-template-columns:minmax(0,1fr)}
.und .sec.fill{display:flex;flex-direction:column}.und .sec.fill>.sec-b{flex:1;display:flex;flex-direction:column}.und .sec.fill>.sec-b>:last-child{flex:1}.und .hcols.one>.hcol:empty{display:none}
.und .sec-h{display:flex;align-items:center;gap:8px;margin:0 0 8px;min-height:30px;flex-wrap:wrap}
.und .sec-h h2{display:flex;align-items:center;gap:8px;font:600 15px/1.3 var(--font);color:var(--title);margin:0;padding:0;border:0;background:none;text-transform:none;letter-spacing:0}
.und .sec-h h2 button{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:8px;border-radius:4px}
.und .sec-h h2 button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.und .sec-h h2 button svg{width:15px;height:15px;color:var(--faint);transition:transform .15s}
.und .sec.closed .sec-h h2 button svg{transform:rotate(-90deg)}.und .sec.closed .sec-b{display:none}
.und .sec-h .count{color:var(--muted);font-weight:400;font-size:13px}
.und .sec-h .tools{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-left:auto;max-width:100%}
.und .sec-h .tools .seg{max-width:100%;overflow-x:auto;scrollbar-width:none}.und .sec-h .tools .seg::-webkit-scrollbar{display:none}.und .seg button{flex:none}
.und .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:var(--pad);min-width:0;box-shadow:var(--shadow);position:relative}
.und.has-bg .card,.und.has-bg .panel,.und.has-bg .metric,.und.has-bg .tile{background:color-mix(in srgb,var(--panel) 88%,transparent);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
/* frosted glass: the wallpaper stays sharp, every card blurs what is behind it */
.und.glass .card,.und.glass .panel,.und.glass .metric,.und.glass .tile,.und.glass button.stat,.und.glass .ci,.und.glass .alert,.und.glass .olist,.und.glass .fav,.und.glass .pl,.und.glass .rq,.und.glass .detail,.und.glass .htab{
  background:color-mix(in srgb,var(--panel) 62%,transparent);-webkit-backdrop-filter:blur(var(--glass-blur)) saturate(1.15);backdrop-filter:blur(var(--glass-blur)) saturate(1.15)}
/* text that sits straight on a wallpaper (title bar, section headings, their tools) gets a frosted chip behind it */
.und.has-bg .top .brand,.und.has-bg .sec-h h2,.und.has-bg .sec-h .tools>.muted,.und.has-bg .sec-h .tools>span:not(:empty){background:color-mix(in srgb,var(--panel) 72%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-radius:8px;padding:3px 10px}
.und.has-bg .top .brand{padding:6px 12px 6px 6px;border-radius:var(--radius)}
.und.has-bg .sec-h .tools .btn.ghost{background:color-mix(in srgb,var(--panel) 72%,transparent)!important;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.und .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);min-width:0;overflow:hidden}
.und .empty{color:var(--muted);font-size:13px;padding:16px;text-align:center}

/* overview */
.und .ov{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:var(--gap)}
.und .kv{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:5px 16px;font-size:13px;align-content:start}
.und .kv>span:nth-child(odd){color:var(--muted)}.und .kv>span{min-width:0;overflow-wrap:anywhere}
.und .qa{display:flex;flex-direction:column;gap:10px}
.und .qa .row{display:flex;gap:6px;flex-wrap:wrap}
.und .qa h4{margin:0;font-size:12px;color:var(--faint);text-transform:uppercase;letter-spacing:.05em;font-weight:600}

/* alerts */
.und .alerts{display:flex;flex-direction:column;gap:6px}
.und .alert{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-left:3px solid var(--warn);background:var(--panel);border-radius:var(--radius);padding:8px 12px;font-size:13px;flex-wrap:wrap}
.und .alert.bad{border-left-color:var(--bad)}
.und .alert.crit{background:var(--bad-soft);border-color:color-mix(in srgb,var(--bad) 55%,var(--line));border-left:4px solid var(--bad);padding:11px 14px;box-shadow:0 0 0 1px color-mix(in srgb,var(--bad) 18%,transparent),0 6px 18px -8px color-mix(in srgb,var(--bad) 55%,transparent)}
.und .alert.crit>svg{color:var(--bad);width:18px;height:18px;flex:none}.und .alert.crit b{color:var(--title)}.und .alert.info{border-left-color:var(--accent)}.und .alert.ok{border-left-color:var(--ok)}
.und .alert .grow{min-width:0}.und .alert>svg{color:var(--ok)}

/* metrics */
.und .metrics{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:var(--gap)}
.und .metric{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;min-width:0;position:relative;overflow:hidden;box-shadow:var(--shadow);min-height:96px;display:flex;flex-direction:column}
.und .metric.wide{grid-column:span 2}
.und .metric .mh{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;position:relative;z-index:1}
.und .metric .mh svg{width:15px;height:15px;flex:none}
.und .metric .mv{font-size:22px;font-weight:600;line-height:1.25;margin-top:6px;color:var(--title);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;position:relative;z-index:1}
.und .metric .mv small{font-size:13px;font-weight:500;color:var(--muted);margin-left:4px}
.und .metric .ms{font-size:12px;color:var(--muted);margin-top:auto;padding-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;position:relative;z-index:1}
.und .metric .meter{margin-top:8px;position:relative;z-index:1}
.und .meter{height:5px;background:var(--line);border-radius:3px;overflow:hidden}.und .meter i{display:block;height:100%;width:0;background:var(--ok);border-radius:3px;transition:width .35s}
.und .meter i.warn{background:var(--warn)}.und .meter i.bad{background:var(--bad)}.und .meter i.acc{background:var(--accent)}
.und .spark{position:absolute;left:0;right:0;bottom:0;height:48%;width:100%;pointer-events:none;z-index:0}
.und .spark path.a{fill:var(--accent);fill-opacity:.12}.und .spark path.l{fill:none;stroke:var(--accent);stroke-width:1.4;stroke-opacity:.7}
.und .cores{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(3px,1fr);gap:2px;margin-top:8px;height:34px;align-items:end}
.und .cores i{display:block;background:var(--accent);opacity:.75;border-radius:2px 2px 0 0;min-height:2px;transition:height .35s}

/* containers and VMs */
.und .ftr{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.und .rowh,.und .rowi{display:grid;grid-template-columns:minmax(200px,2.4fr) minmax(110px,1fr) minmax(130px,1.1fr) minmax(70px,.7fr) minmax(110px,.9fr) 150px;gap:10px;align-items:center;padding:8px 12px}
.und .rowh{color:var(--faint);font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--line);background:var(--panel-2);padding-top:7px;padding-bottom:7px}
.und .rowh>:last-child{text-align:right}
.und .rowi{border-bottom:1px solid var(--line);min-height:52px}.und .rowi:last-child{border-bottom:0}
.und .rowi:hover{background:var(--panel-2)}
.und .rowi.busy,.und .tile.busy{opacity:.7}
.und .c-st{display:flex;gap:6px;flex-wrap:wrap;align-items:center;min-width:0}
.und .c-st .mob{display:none!important}
.und .who{display:flex;align-items:center;gap:10px;min-width:0}
.und .who img,.und .who .ph{width:30px;height:30px;border-radius:6px;object-fit:contain;flex:none;background:var(--panel-2)}
.und .who .ph{display:flex;align-items:center;justify-content:center;color:var(--faint)}.und .who .ph svg{width:16px;height:16px}
.und .who .nm{font-weight:600;color:var(--title);display:flex;align-items:center;gap:6px;min-width:0}
.und .who .nm svg{color:var(--warn);width:13px;height:13px;flex:none}
.und .who .im{color:var(--muted);font-size:12px}
.und .res{display:flex;flex-direction:column;gap:3px;font-size:12.5px;font-variant-numeric:tabular-nums;min-width:0}
.und .res .meter{height:4px;max-width:120px}
.und .acts{display:flex;gap:4px;justify-content:flex-end;align-items:center;flex-wrap:nowrap}
.und .tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:var(--gap)}
.und .tile{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:12px;display:flex;flex-direction:column;gap:10px;min-width:0;box-shadow:var(--shadow)}
.und .tile .stats{display:flex;justify-content:space-between;gap:8px;font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums;flex-wrap:wrap}
.und .tile .acts{justify-content:flex-start;flex-wrap:wrap}
.und .more{display:flex;justify-content:center;padding:8px}
.und .favs{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px}
.und .fav{display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:9px 10px;min-width:0;box-shadow:var(--shadow)}
.und .fav img,.und .fav .ph{width:26px;height:26px;border-radius:5px;object-fit:contain;flex:none;background:var(--panel-2)}
.und .fav .t{flex:1;min-width:0}
.und .fav .t b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--title)}

/* menus */
.und .menu{position:fixed;z-index:10002;min-width:200px;max-width:calc(100vw - 16px);max-height:calc(100vh - 16px);overflow:auto;background:var(--panel);border:1px solid var(--line-2);border-radius:8px;box-shadow:0 8px 28px rgba(0,0,0,.35);padding:4px;display:flex;flex-direction:column}
.und .menu button{display:flex!important;align-items:center;gap:9px;width:100%;text-align:left;background:transparent!important;border:0!important;border-radius:5px!important;color:var(--text)!important;padding:8px 10px!important;margin:0!important;font:inherit!important;font-size:13px!important;min-height:34px!important;cursor:pointer;justify-content:flex-start}
.und .menu button:hover,.und .menu button:focus-visible{background:var(--bar)!important;outline:0}
.und .menu button svg{width:15px;height:15px;color:var(--muted);flex:none}
.und .menu button.danger{color:var(--bad)!important}.und .menu button.danger svg{color:var(--bad)}
.und .menu button:disabled{opacity:.45;cursor:not-allowed}
.und .menu hr{border:0;border-top:1px solid var(--line);margin:4px 2px}

/* service widgets */
.und .grp{margin-bottom:16px}.und .grp:last-child{margin-bottom:0}
.und .grp>h3{margin:0 0 8px;padding:0;border:0;background:none;font:600 12px/1.3 var(--font);color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.und .grp>h3 button{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.und .grp>h3 button svg{width:13px;height:13px;transition:transform .15s}.und .grp.closed>h3 button svg{transform:rotate(-90deg)}.und .grp.closed>.grid{display:none}
.und .grid{display:grid;grid-template-columns:repeat(var(--cols,4),minmax(0,1fr));gap:var(--gap)}
.und .w{display:flex;flex-direction:column;min-height:96px}
.und .w.span2{grid-column:span 2}
.und .w .ch{display:flex;align-items:center;gap:10px;min-height:28px;margin-bottom:10px}
.und .w .ch .ico{width:28px;height:28px;flex:none;border-radius:6px;object-fit:contain;padding:3px;background:var(--panel-2)}
.und .w .ch .nm{font-size:14.5px;color:var(--title);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .w .ch a.nm:hover{color:var(--accent-text);text-decoration:none}
.und .w .ch .sub{margin-left:auto;font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:50%}
.und .w .desc{font-size:12px;color:var(--muted);margin:-6px 0 8px}
.und .w.link{flex-direction:row;align-items:center;min-height:0;cursor:pointer;padding:10px 12px}.und .w.link .ch{margin:0;flex:1}
.und .w.link:hover{border-color:var(--accent)}
.und .w.wait .cb{opacity:.45}
.und .w .cb{display:flex;flex-direction:column;flex:1;min-height:0}
.und .blocks{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}
.und .blk{flex:1 1 0;min-width:64px;background:var(--panel-2);border-radius:5px;padding:6px 4px;text-align:center;line-height:1.25}
.und .blk .v{font-size:14px;color:var(--text);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .blk .l{font-size:10.5px;font-weight:700;text-transform:uppercase;color:var(--muted);letter-spacing:.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .lst{display:flex;flex-direction:column;gap:6px;font-size:12.5px}
.und .lst .r{display:flex;justify-content:flex-end;gap:8px;align-items:baseline;min-width:0}
.und .lst .r .t{color:var(--text);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.und .lst .r .when{color:var(--accent-text);white-space:nowrap;font-size:12px}
.und .lst .r .lab{color:var(--muted);margin-right:auto}
.und .cal{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:5px 14px;font-size:12.5px;align-items:center}
.und .cal .d{color:var(--muted);white-space:nowrap}.und .cal .ti{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .cal .ok{color:var(--ok);width:14px;height:14px}.und .cal .ok svg{width:14px;height:14px}
.und .streams{display:flex;flex-direction:column;gap:5px;font-size:12.5px;margin-top:6px}
.und .stream{position:relative;display:flex;gap:8px;align-items:center;background:var(--panel-2);border-radius:5px;padding:4px 8px;overflow:hidden}
.und .stream .pg{position:absolute;left:0;top:0;bottom:0;background:var(--accent-soft);z-index:0}
.und .stream>*:not(.pg){position:relative;z-index:1}
.und .stream svg{width:11px;height:11px;flex:none}
.und .stream .tt{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.und .stream .tm{color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums}
.und button.err{display:block;background:var(--bad-soft)!important;color:var(--bad)!important;border:0!important;border-radius:5px!important;padding:7px 10px!important;font:inherit!important;font-size:12.5px!important;margin:auto 0 0!important;cursor:pointer;text-align:center;width:100%;min-height:0!important}
.und .err .x{display:none;margin-top:6px;text-align:left;word-break:break-word;color:var(--text)}.und .err.open .x{display:block}
.und button.err.cfg{background:var(--panel-2)!important;color:var(--muted)!important}
.und .bars{display:flex;flex-direction:column;gap:8px;font-size:12.5px;margin-top:auto}
.und .bars .bt{display:flex;justify-content:space-between;gap:8px}.und .bars .bt span:last-child{color:var(--muted)}

/* tables */
.und table.t{width:100%;border-collapse:collapse;margin:0;background:transparent}
.und table.t th{background:var(--panel-2)!important;color:var(--faint)!important;font-weight:600;font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:7px 12px!important;border-bottom:1px solid var(--line)!important;white-space:nowrap}
.und table.t td{padding:8px 12px!important;border-bottom:1px solid var(--line)!important;vertical-align:middle;background:transparent!important;color:var(--text);font-size:13px}
.und table.t tr:last-child td{border-bottom:0!important}
.und .tw{overflow-x:auto}

/* dialogs, drawer, toasts */
.und .modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:10000;display:flex;align-items:center;justify-content:center;padding:16px}
.und .modal{background:var(--panel);color:var(--text);border:1px solid var(--line-2);border-radius:10px;max-width:560px;width:100%;max-height:90vh;overflow:auto;padding:18px 20px;box-shadow:0 12px 40px rgba(0,0,0,.4)}
.und .modal.wide{max-width:1100px}
.und .modal h3{margin:0 0 12px;font:600 16px/1.3 var(--font);color:var(--title);display:flex;align-items:center;gap:10px;border:0;padding:0;background:none;text-transform:none;letter-spacing:0}
.und .modal p{margin:0 0 10px}.und .modal ul{margin:0 0 10px;padding-left:20px}
.und .modal .foot{display:flex;gap:8px;justify-content:flex-end;margin-top:16px;flex-wrap:wrap}
.und .drawer-bg{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9500}
.und .drawer{position:fixed;top:0;right:0;bottom:0;width:min(880px,100vw);z-index:9501;background:var(--bg);color:var(--text);border-left:1px solid var(--line-2);display:flex;flex-direction:column;box-shadow:-12px 0 40px rgba(0,0,0,.3)}
.und .drawer .dh{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line)}
.und .drawer .dh h2{margin:0;font:600 17px/1.3 var(--font);color:var(--title);border:0;padding:0;background:none;text-transform:none;letter-spacing:0}
.und .drawer .dmain{flex:1;display:flex;min-height:0}
.und .drawer .dt{display:flex;flex-direction:column;gap:1px;padding:10px 8px;border-right:1px solid var(--line);overflow-y:auto;scrollbar-width:none;flex:0 0 200px;background:var(--panel-2)}
.und .drawer .dt .dg{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--faint);padding:12px 10px 4px}.und .drawer .dt .dg:first-child{padding-top:4px}
.und .drawer .dt button svg{width:15px;height:15px;flex:none;opacity:.85}
.und .drawer .dtitle{font:600 18px/1.3 var(--font);color:var(--title);margin:0 0 14px;padding:0;border:0;background:none;text-transform:none;letter-spacing:0}
.und .drawer .dt button{display:flex!important;align-items:center;gap:9px;text-align:left;border-radius:7px!important;background:none!important;border:0!important;border-bottom:2px solid transparent!important;color:var(--muted)!important;padding:8px 10px!important;margin:0!important;font:inherit!important;font-size:13.5px!important;cursor:pointer;white-space:nowrap;border-radius:0!important;min-height:0!important}
.und .drawer .dt button:hover{background:var(--bar)!important;color:var(--text)!important}
.und .drawer .dt button.on{color:var(--title)!important;background:var(--accent-soft)!important;border-bottom-color:transparent!important;box-shadow:inset 3px 0 0 var(--accent)}
.und input[type=checkbox],.und input[type=radio],.und input[type=range]{accent-color:var(--accent)}
.und select option{background:var(--panel);color:var(--text)}
.und .drawer .db{flex:1;overflow:auto;padding:16px 18px 24px;-webkit-overflow-scrolling:touch}
.und .drawer .df{display:flex;gap:8px;align-items:center;padding:12px 18px;border-top:1px solid var(--line);background:var(--panel);flex-wrap:wrap}
.und .set{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;margin-bottom:14px}
.und .set>h3{margin:0 0 4px;font:600 14px/1.3 var(--font);color:var(--title);border:0;padding:0;background:none;text-transform:none;letter-spacing:0}
.und .set>.hint{color:var(--muted);font-size:12.5px;margin:0 0 12px}
.und .fld{display:flex;flex-direction:column;gap:4px;margin-bottom:12px;min-width:0}.und .fld>label{color:var(--muted);font-size:12.5px;font-weight:500}.und .fld .hint{color:var(--faint);font-size:12px}
.und .fld input[type=text],.und .fld input[type=url],.und .fld input[type=password],.und .fld input[type=number],.und .fld select{width:100%}
.und .grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:0 18px}
.und .switch{display:flex;align-items:center;gap:8px;cursor:pointer;margin:6px 0;font-size:13.5px}
.und .inl{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.und .olist{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.und .olist .oi{display:flex;align-items:center;gap:8px;padding:6px 8px 6px 10px;border-bottom:1px solid var(--line);background:var(--panel);min-height:42px;flex-wrap:wrap}
.und .olist .oi:last-child{border-bottom:0}.und .olist .oi .t{flex:1;min-width:120px}
.und .olist .oi img{width:22px;height:22px;object-fit:contain;flex:none}
.und .olist .oi input[type=text]{flex:1 1 140px;min-width:0}
.und .themes{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.und button.theme{border:2px solid var(--line)!important;border-radius:8px!important;padding:8px!important;cursor:pointer;background:transparent!important;color:var(--text)!important;font:inherit!important;text-align:left;margin:0!important;display:flex;flex-direction:column;gap:6px}
.und button.theme.on{border-color:var(--accent)!important}
.und .theme .pv{height:54px;border-radius:5px;display:flex;gap:4px;padding:6px;border:1px solid rgba(127,127,127,.3)}
.und .theme .pv i{flex:1;border-radius:3px}
.und .theme .tn{display:flex;align-items:baseline;justify-content:space-between;gap:6px;min-width:0}.und .theme .tn b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .sec-in{display:flex;gap:6px}.und .sec-in input{flex:1;min-width:0}
.und .lg{border:1px solid var(--line);border-radius:6px;margin-bottom:10px;background:var(--panel)}
.und .lg .lh{display:flex;gap:6px;align-items:center;padding:8px 10px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.und .lg .lh input[type=text]{flex:1 1 160px}.und .lg .lh input[type=number]{width:64px}
.und .lg .ls{display:flex;gap:6px;align-items:center;padding:6px 10px;border-bottom:1px solid var(--line)}.und .lg .ls:last-child{border-bottom:0}
.und .lg .ls img{width:22px;height:22px;object-fit:contain}.und .lg .ls .t{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .banner{border:1px solid var(--line-2);border-left:3px solid var(--warn);background:var(--warn-soft);border-radius:6px;padding:8px 12px;margin-bottom:10px;font-size:13px}
.und .banner.bad{border-left-color:var(--bad);background:var(--bad-soft)}.und .banner.ok{border-left-color:var(--ok);background:var(--ok-soft)}.und .banner.info{border-left-color:var(--accent);background:var(--accent-soft)}
.und pre.log{background:var(--field);border:1px solid var(--line);border-radius:6px;padding:10px;max-height:60vh;min-height:180px;overflow:auto;font:12px/1.45 var(--mono);white-space:pre;color:var(--text);margin:0}
.und pre.log.wrap{white-space:pre-wrap;word-break:break-word}.und pre.log mark{background:var(--accent-soft);color:inherit;outline:1px solid var(--accent)}
.und .kv2{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:4px 16px;font-size:13px}.und .kv2>span:nth-child(odd){color:var(--muted)}.und .kv2>span{overflow-wrap:anywhere}
.und .progress{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin:6px 0}.und .progress i{display:block;height:100%;background:var(--accent);animation:und-slide 1.2s infinite linear;width:30%}
@keyframes und-slide{0%{margin-left:-30%}100%{margin-left:100%}}
.und .toasts{position:fixed;right:16px;bottom:16px;z-index:10003;display:flex;flex-direction:column;gap:8px;align-items:flex-end;pointer-events:none}
.und .toast{background:var(--panel);color:var(--text);border:1px solid var(--line-2);border-left:3px solid var(--ok);padding:9px 14px;border-radius:6px;max-width:420px;box-shadow:0 6px 20px rgba(0,0,0,.25);font-size:13px;pointer-events:auto}
.und .toast.bad{border-left-color:var(--bad)}
.und .toast.act{display:flex;align-items:center;gap:12px}.und .toast.act>span{flex:1;min-width:0}
.und .ign-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}.und .ign-bar input{flex:1 1 220px;min-width:0}
.und .olist.ign-list{border:0;border-radius:0}.und .ign-list .oi.ign{border:1px solid var(--line);border-radius:var(--radius);margin-bottom:6px}
.und .ign-h{margin:14px 0 6px;font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.und .oi.ign{align-items:center;gap:10px}.und .oi.ign .t{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}.und .oi.ign.expired{opacity:.6}
.und .ahist{display:flex;flex-direction:column;gap:6px;max-height:65vh;overflow:auto}
.und .ah{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);border-radius:var(--radius);background:var(--panel-2)}
.und .ah .grow{display:flex;flex-direction:column;gap:2px;min-width:0}.und .ah .am{font-size:13px;color:var(--text)}
.und .ah .badge{flex:none}
.und .ign-dur{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:4px}
.und .overlay{position:fixed;inset:0;z-index:10004;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;padding:20px;color:#fff;text-align:center}
.und .overlay .box{max-width:440px}.und .overlay h2{font:600 22px/1.3 var(--font);margin:0 0 8px;color:#fff;border:0;background:none;padding:0}
.und .hist{display:flex;flex-direction:column;font-size:13px}.und .hist .hi{display:flex;gap:10px;padding:7px 0;border-bottom:1px solid var(--line);align-items:baseline;flex-wrap:wrap}.und .hist .hi:last-child{border-bottom:0}

/* ---------- responsive ---------- */
@media (max-width:1280px){.und .grid{grid-template-columns:repeat(min(var(--cols,4),3),minmax(0,1fr))}}
@media (max-width:1100px){
  .und .sec.half{grid-column:1/-1}
  .und .rowh,.und .rowi{grid-template-columns:minmax(170px,2fr) minmax(100px,1fr) minmax(110px,1fr) minmax(100px,.8fr) 150px}
  .und .rowh>.c-up,.und .rowi>.c-up{display:none}
}
@media (max-width:900px){
  .und .grid{grid-template-columns:repeat(min(var(--cols,4),2),minmax(0,1fr))}
  .und .ov{grid-template-columns:1fr}
  .und .rowh{display:none}
  .und .rowi{grid-template-columns:minmax(0,1fr) auto;gap:8px 10px;padding:10px 12px}
  .und .rowi>.c-who{grid-column:1/-1;grid-row:1}.und .rowi>.c-acts{grid-column:2;grid-row:2}
  .und .rowi>.c-st{grid-column:1;grid-row:2}
  .und .rowi>.c-res,.und .rowi>.c-upd{display:none}
  .und .c-st .mob{display:inline-flex!important}
}
@media (max-width:640px){
  .und{font-size:14.5px}
  .und .top .search{order:5;flex-basis:100%;max-width:none;margin-left:0}
  .und .top .acts{margin-left:auto}
  .und .grid{grid-template-columns:1fr}.und .w.span2{grid-column:auto}
  .und .metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.und .metric.wide{grid-column:1/-1}
  .und .metric .mv{font-size:19px}
  .und button.btn,.und .btn{min-height:38px!important}.und .btn.ic{width:38px;min-width:38px!important}.und .btn.sm{min-height:36px!important}.und .btn.ic.sm{width:36px;min-width:36px!important}
  .und .seg button{min-height:36px!important}
  .und input[type=text],.und input[type=number],.und input[type=url],.und input[type=password],.und input[type=search],.und select,.und textarea{font-size:16px!important;min-height:40px}
  .und .themes{grid-template-columns:repeat(2,minmax(0,1fr))}
  .und .modal-bg{align-items:flex-end;padding:0}.und .modal{border-radius:14px 14px 0 0;max-height:92vh;padding:16px}
  .und .modal .foot .btn{flex:1}
  .und .drawer{width:100vw;border-left:0}
  .und .drawer .dmain{flex-direction:column}
  .und .drawer .dt{flex-direction:row;flex:none;border-right:0;border-bottom:1px solid var(--line);overflow-x:auto;padding:4px 8px;background:none}
  .und .drawer .dt .dg{display:none}
  .und .drawer .dt button{white-space:nowrap;flex:none}.und .drawer .dt button.on{box-shadow:inset 0 -2px 0 var(--accent)}
  .und .toasts{left:12px;right:12px;bottom:12px;align-items:stretch}.und .toast{max-width:none}
  .und .tiles,.und .favs{grid-template-columns:1fr}
  .und .sec-h .tools{margin-left:0;width:100%}
  .und .top .acts .btn.focus{display:none!important}
}
@media (prefers-reduced-motion:reduce){.und *{transition:none!important;animation:none!important}}

/* ================= 2026.10.30 redesign ================= */
.und [hidden]{display:none!important}
.und .t-ok{color:var(--ok)}.und .t-warn{color:var(--warn)}.und .t-bad{color:var(--bad)}
.und .sections{gap:16px var(--gap)}
.und .sec-h{margin-bottom:6px;min-height:28px}
.und .sec-h h2{font-size:14px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.und .sec-h h2 button{color:var(--text)}

/* stats bar */
.und .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}
.und .stats.is-stale{opacity:.6}
.und button.stat{all:unset;box-sizing:border-box;display:flex;flex-direction:column;gap:2px;padding:11px 13px 13px;background:var(--panel);cursor:pointer;position:relative;min-width:0;min-height:92px;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;isolation:isolate}
.und button.stat>.k,.und button.stat>.v,.und button.stat>.s{position:relative;z-index:1}
.und .stat .sp{position:absolute;left:0;right:0;bottom:0;height:30px;z-index:0;pointer-events:none}
.und button.stat.has-sp{padding-bottom:34px}
.und .stat .sp svg{width:100%;height:100%;display:block}
.und .stat .sp path.a{fill:var(--accent);fill-opacity:.13}.und .stat .sp path.l{fill:none;stroke:var(--accent);stroke-width:1.5;stroke-opacity:.85}
.und .stat.warn .sp path.a{fill:var(--warn)}.und .stat.warn .sp path.l{stroke:var(--warn)}.und .stat.bad .sp path.a{fill:var(--bad)}.und .stat.bad .sp path.l{stroke:var(--bad)}
.und .stat.has-sp .bar{display:none}
.und button.stat:hover{background:var(--panel-2)}
.und button.stat:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.und button.stat.on{background:var(--panel-2);border-color:var(--accent)}
.und .stat .k{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.und .stat .k svg{width:13px;height:13px}
.und .stat .v{font-size:22px;font-weight:650;letter-spacing:-.01em;color:var(--title);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3}
.und .stat .s{font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .stat .bar{position:absolute;left:0;right:0;bottom:0;height:3px;background:transparent}
.und .stat .bar i{display:block;height:100%;width:0;background:var(--ok);transition:width .35s}
.und .stat.warn .bar i{background:var(--warn)}.und .stat.bad .bar i{background:var(--bad)}.und .stat.na .bar i{background:var(--off)}
.und .stat.warn .v{color:var(--warn)}.und .stat.bad .v{color:var(--bad)}.und .stat.na .v{color:var(--muted);font-weight:500}
.und .stat .k::after{content:'';width:6px;height:6px;border-radius:50%;margin-left:auto;background:transparent}
.und .stat.ok .k::after{background:var(--ok)}.und .stat.warn .k::after{background:var(--warn)}.und .stat.bad .k::after{background:var(--bad)}
.und .detail{margin-top:8px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px}
.und .detail .tw{margin:-12px -14px}
.und .dgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;align-items:start}
.und .dk{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px}
.und svg.spark2{width:100%;height:60px;display:block}
.und .spark2 path.a{fill:var(--accent);fill-opacity:.14}.und .spark2 path.l{fill:none;stroke:var(--accent);stroke-width:1.5}
.und .detail .cores{height:60px;margin:0;grid-auto-columns:minmax(4px,1fr)}
.und .stale{font-size:12px;color:var(--warn);margin:0 0 6px}

/* keyboard shortcuts */
.und .keys{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:4px 24px}
.und .kh{display:flex;align-items:center;gap:12px;padding:4px 0;font-size:13px}.und .kh>span:first-child{display:flex;gap:4px;min-width:58px}
.und kbd{font:600 11.5px/1 var(--mono);padding:4px 7px;border-radius:5px;border:1px solid var(--line-2);border-bottom-width:2px;background:var(--panel-2);color:var(--title)}

/* status text */
.und .sec.nomatch,.und .mw.nomatch-col{display:none}
.und .nomatch-note{margin:0 0 14px;padding:10px 14px;border:1px dashed var(--line-2);border-radius:var(--radius);color:var(--muted);font-size:13px;background:color-mix(in srgb,var(--panel) 70%,transparent)}
.und .err-t,.und .bad-t{color:var(--bad)}.und .ok-t{color:var(--ok)}.und .warn-t{color:var(--warn)}
.und .badge.info{color:var(--info);border-color:color-mix(in srgb,var(--info) 40%,transparent)}

/* now playing */
.und .plist,.und .rqlist{display:flex;flex-direction:column;gap:8px}
.und .pl{display:flex;gap:12px;align-items:flex-start;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;min-width:0}
.und .pl.paused{opacity:.75}
.und .pl>.aico,.und .pl>.ph{width:28px;height:28px;flex:none;border-radius:6px;object-fit:contain;margin-top:2px}
.und .pl .pt{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}
.und .pl .pl1{display:flex;flex-direction:column;min-width:0}.und .pl .pl1 b{color:var(--title);font-size:13.5px}
.und .pl .pl2{display:flex;align-items:center;gap:6px;min-width:0}.und .pl .pl2 svg{width:12px;height:12px;flex:none}
.und .pl .pl3{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px}
.und .pl .meter{height:4px}

/* requests */
.und .rq{display:flex;gap:12px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:10px 12px;min-width:0}
.und .rq.pend{border-color:color-mix(in srgb,var(--warn) 45%,var(--line))}
.und .rqp{flex:none;width:38px;height:57px;border-radius:5px;background:var(--panel-2);overflow:hidden;border:1px solid var(--line);display:block}
.und .rqp img{width:100%;height:100%;object-fit:cover;display:block}
.und .rqt{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}.und .rqt b{color:var(--title);font-size:13.5px}
.und .rqa{display:flex;gap:6px;flex:none}
.und .rq>.badge{flex:none}

/* endpoint health */
.und .htab .hrow{display:grid;grid-template-columns:minmax(180px,2.2fr) minmax(130px,1.2fr) minmax(130px,1fr) 80px;gap:12px;align-items:center;padding:9px 14px;border-bottom:1px solid var(--line);min-width:0}
.und .htab .hrow:last-child{border-bottom:0}
.und .htab .hh{font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);background:var(--panel-2);padding-top:7px;padding-bottom:7px}
.und .htab .hn{display:flex;align-items:center;gap:8px;min-width:0}.und .htab .hn .aico,.und .htab .hn .ph{width:20px;height:20px;flex:none;border-radius:4px;object-fit:contain}
.und .htab .hn b{color:var(--title);font-weight:600;font-size:13.5px}
.und .htab .r{text-align:right}
.und .htab .hrow>span{min-width:0}
.und .htab>[role=rowgroup]>.empty{padding:14px}
@media (max-width:640px){
  .und .htab .hrow{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px}
  .und .htab .hh{display:none}
  .und .htab .hrow>:nth-child(1){flex:1 1 0;order:1}.und .htab .hrow>:nth-child(4){flex:none;order:2}
  .und .htab .hrow>:nth-child(2){flex:1 1 0;order:3;font-size:12px}.und .htab .hrow>:nth-child(3){flex:none;order:4}
  .und .htab .hrow::after{content:'';order:2;flex-basis:100%;height:0}
  .und .rq{flex-wrap:wrap}.und .rqa{width:100%;justify-content:flex-end}
}

/* media: four equal columns, by the section's own width (a half-width section gets 2 or 1) */
.und .mbody{container-type:inline-size}
.und .media{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--gap)}
@container (min-width:560px){.und .media{grid-template-columns:repeat(2,minmax(0,1fr))}}
@container (min-width:880px){.und .media{grid-template-columns:repeat(4,minmax(0,1fr))}}
.und .mw{padding:10px 0 6px;min-width:0;display:flex;flex-direction:column}
.und .mw .mh{display:flex;align-items:center;gap:8px;padding:0 12px 8px;min-width:0}
.und .mw .mh h3{margin:0;font:600 13px/1.3 var(--font);color:var(--title);border:0;padding:0;background:none;text-transform:none;letter-spacing:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .mw .mh .count{font-size:12px;color:var(--muted)}
.und .mw .mh .btn{flex:none}
.und .mw{container-type:inline-size}
@container (max-width:280px){.und .mw .mh .btn .lbl{display:none}.und .mw .mh{padding-right:8px}}
.und .mlist{display:flex;flex-direction:column;overflow-y:auto;max-height:var(--media-h,372px);min-height:120px;padding:0 6px;scrollbar-width:thin;scrollbar-color:var(--line-2) transparent}
.und .mlist:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.und .mlist>.empty{margin:auto 0;padding:16px 8px;text-align:center}
.und .mi{display:flex;gap:10px;align-items:center;padding:6px;border-radius:6px;color:var(--text);text-decoration:none!important;min-width:0}
.und a.mi:hover{background:var(--panel-2)}.und a.mi:hover .pt{color:var(--accent-text)}
.und .mimg{flex:none;width:40px;height:60px;border-radius:4px;background:var(--panel-2);overflow:hidden;border:1px solid var(--line)}
.und .mimg img{width:100%;height:100%;object-fit:cover;display:block}
.und .mi .mt{display:flex;flex-direction:column;gap:1px;min-width:0;flex:1}
.und .mi .pt{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .mi .ps{font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.und .mi .pm{display:flex;flex-wrap:wrap;align-items:center;gap:4px 6px;margin-top:2px}
.und .mi .pd{font-size:11.5px;color:var(--accent-text);white-space:nowrap}
.und .mi .badge{font-size:10.5px;line-height:15px;padding:0 6px}
.und[data-density=compact] .mimg{width:32px;height:48px}.und[data-density=compact] .mi{padding:4px 6px}
.und[data-density=expanded] .mimg{width:52px;height:78px}.und[data-density=expanded] .mlist{--media-h:460px}

/* Arr Stack */
.und .arr{display:flex;flex-direction:column}
.und .aitem{border-bottom:1px solid var(--line)}.und .aitem:last-child{border-bottom:0}
.und .aline{display:flex;align-items:center;gap:6px;padding:0 8px 0 0}
.und button.arow{all:unset;box-sizing:border-box;flex:1;min-width:0;display:flex;align-items:center;gap:8px;padding:7px 10px;cursor:pointer;min-height:38px}
.und button.arow:hover{background:var(--panel-2)}.und button.arow:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.und .aico{width:20px;height:20px;object-fit:contain;flex:none;border-radius:4px}
.und span.aico{display:flex;align-items:center;justify-content:center;color:var(--faint)}.und span.aico svg{width:14px;height:14px}
.und .an{font-weight:600;color:var(--title);white-space:nowrap;min-width:90px}
.und .sdot{width:8px;height:8px;border-radius:50%;flex:none;background:var(--off)}
.und .sdot.ok{background:var(--ok)}.und .sdot.warn{background:var(--warn)}.und .sdot.bad{background:var(--bad)}
.und .ai{flex:1;min-width:0;display:flex;gap:10px;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden}
.und .ai .st b{color:var(--text);font-weight:600}
.und .ax{flex:none}
.und .adet{padding:4px 12px 12px 38px;display:flex;flex-direction:column;gap:6px}
.und .adet .blocks{margin:0}

/* download clients */
.und .dls{display:flex;flex-direction:column;gap:var(--gap)}
.und .card.dl{padding:10px 12px}
.und .dlh{display:flex;align-items:center;gap:8px;min-height:28px}
.und .dlb{display:flex;flex-direction:column;gap:6px;margin-top:6px}
.und .dlspeed{display:flex;gap:14px;font-size:13px;font-variant-numeric:tabular-nums;flex-wrap:wrap}
.und .dlspeed b{font-weight:600;color:var(--title)}
.und .dli{display:flex;flex-direction:column;gap:3px}
.und .dln{display:flex;justify-content:space-between;gap:10px;font-size:12px;min-width:0}
.und .dli .meter{height:4px}.und .meter i.off{background:var(--off)}

/* compact container rows */
.und .rowh.c,.und .rowi.c{grid-template-columns:minmax(160px,2.4fr) minmax(90px,.9fr) 70px 80px minmax(90px,.8fr) 48px;padding:8px 14px;min-height:0}
.und .rowi.c{min-height:52px}
.und .rowi.c .who{gap:10px}
.und .rowi.c .who img,.und .rowi.c .who .ph{width:28px;height:28px;border-radius:6px}
.und .rowi.c .nm{font-weight:600;font-size:13.5px}
.und .rowi.c .c-cpu,.und .rowi.c .c-mem{font-size:12.5px}
.und .rowi.c .acts .btn.sm{min-height:30px!important}.und .rowi.c .acts .btn.ic.sm{width:30px;min-width:30px!important}
.und .panel.compact .rowh{padding-top:5px;padding-bottom:5px}

/* apps */
.und .grid.links{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
.und .w.link{padding:8px 10px}.und .w.link .ch .ico{width:22px;height:22px}

/* settings: drag to reorder */
.und .olist .oi .grip{cursor:grab;color:var(--faint);font-size:12px;letter-spacing:-2px;user-select:none;padding:0 2px}
.und .olist .oi.drag{opacity:.5}.und .olist .oi.over{box-shadow:inset 0 2px 0 var(--accent)}

/* sign-in page (Docker version) */
.und .login{max-width:380px;margin:12vh auto 0;padding:24px}
.und .login .brand{margin-bottom:10px}.und .login .btn{width:100%;margin-top:6px!important}
.und .login input{width:100%}
.und .login.skip{margin-top:12px;padding:16px 24px}.und .login.skip p{margin:0 0 6px;font-size:12.5px}

@media (max-width:1100px){
  .und .rowh.c,.und .rowi.c{grid-template-columns:minmax(150px,2fr) minmax(90px,1fr) 64px 76px 48px}
  .und .rowh.c>:nth-child(5),.und .rowi.c>.c-upd{display:none}
}
@media (max-width:900px){
  .und .rowi.c{grid-template-columns:minmax(0,1fr) auto;padding:6px 10px}
  .und .rowi.c>.c-who{grid-column:1;grid-row:1}.und .rowi.c>.c-acts{grid-column:2;grid-row:1/3}
  .und .rowi.c>.c-st{grid-column:1;grid-row:2;display:flex}
  .und .rowi.c>.c-cpu,.und .rowi.c>.c-mem{display:none}
}
@media (max-width:640px){
  .und .stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
  .und button.stat{min-height:76px;padding:9px 10px 10px}.und .stat .v{font-size:18px}
  .und .ai{display:none}.und .an{min-width:0;flex:1}
  .und .adet{padding-left:12px}
}

/* ================= 2026.10.31: compact containers and apps ================= */
/* containers: a multi-column grid of one-line cells */
.und .cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:10px}
.und .cgrid.fixed{grid-template-columns:repeat(var(--cc),minmax(0,1fr))}
.und .ci{display:flex;align-items:center;gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:10px 8px 10px 12px;min-width:0;min-height:60px}
.und .ci:hover{border-color:var(--line-2)}
.und .ci.busy{opacity:.7}
.und .ci .cico,.und .ci span.cico{width:32px;height:32px;border-radius:7px;object-fit:contain;flex:none;background:var(--panel-2)}
.und .ci span.cico{display:flex;align-items:center;justify-content:center;color:var(--faint)}.und .ci span.cico svg{width:14px;height:14px}
.und .ci .cn{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px;line-height:1.25}
.und .ci .cname{display:flex;align-items:center;gap:7px;font-weight:600;font-size:13.5px;color:var(--title)}
.und .ci .cname svg{width:12px;height:12px;color:var(--warn);flex:none}
.und .ci .cs{display:flex;gap:10px;font-size:12px;color:var(--muted);min-width:0;overflow:hidden;white-space:nowrap}
.und .ci .badge{flex:none}
.und .ci .acts{gap:2px;flex:none}
.und .ci .acts .btn.ic.sm{width:30px;min-width:30px!important;min-height:30px!important}
.und .ci .acts .btn{background:transparent!important;border-color:transparent!important}
.und .ci .acts .btn:hover:not(:disabled){background:var(--bar)!important;border-color:var(--line-2)!important}
.und a.wl,.und span.wl{color:inherit;text-decoration:none!important;display:inline-flex;align-items:center;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.und a.wl:hover{color:var(--accent-text)}.und a.wl:hover img{filter:brightness(1.15)}.und a.wl:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
.und .btn.gear{background:transparent!important;border-color:transparent!important;color:var(--muted)!important}.und .btn.gear:hover{background:var(--bar)!important;border-color:var(--line-2)!important;color:var(--title)!important}
.und .ci.st-exited .cname,.und .ci.st-created .cname,.und .ci.st-dead .cname{color:var(--muted);font-weight:500}

/* apps: compact cards in one grid */
.und .agrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;align-items:stretch}
.und .agrid.fixed{grid-template-columns:repeat(var(--ac),minmax(0,1fr))}
.und .card.ac{padding:10px 12px;min-height:0}
.und .ac .cb{flex:0 0 auto}.und .ac .blocks{margin-top:0}
.und .ac .ch{margin-bottom:8px;min-height:24px;gap:8px}
.und .ac .ch .aico{width:22px;height:22px;padding:0;background:transparent}
.und .ac .ch .nm{font-size:13.5px;font-weight:600}
.und .ac .ch .sub{margin-left:auto}
.und .ac .ch .btn{margin-left:2px!important}
.und .ac .blocks{display:grid;grid-template-columns:repeat(auto-fit,minmax(54px,1fr));gap:0;background:var(--panel-2);border-radius:6px;padding:6px 0}
.und .ac .blk{background:transparent;padding:0 6px;border-left:1px solid var(--line);border-radius:0;min-width:0}
.und .ac .blk:first-child{border-left:0}
.und .ac .blk .v{font-size:14px;font-weight:600;color:var(--title)}
.und .ac .blk .l{font-size:9.5px;font-weight:600;color:var(--muted);letter-spacing:.02em;white-space:normal;line-height:1.2;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.und .ac .blk .v{font-size:14px}
.und .ac .streams{margin-top:0}
.und .ac .stream{font-size:12px}
.und .ac button.err{padding:5px 8px!important;text-align:left}
.und .alinks{display:flex;flex-wrap:wrap;gap:6px;margin-top:var(--gap)}
.und a.alink,.und span.alink{display:inline-flex;align-items:center;gap:7px;padding:5px 10px 5px 6px;border:1px solid var(--line);border-radius:999px;background:var(--panel);color:var(--text);font-size:12.5px;text-decoration:none!important}
.und a.alink:hover{border-color:var(--accent)}
.und .alink .aico{width:18px;height:18px}
@media (max-width:640px){
  .und .cgrid,.und .agrid{grid-template-columns:1fr}
  .und .ci .acts .btn.ic.sm{width:34px;min-width:34px!important;min-height:34px!important}
}
.und .picks{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:2px 12px;max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:var(--radius);padding:6px 10px;background:var(--panel-2)}
.und .switch.pk{margin:3px 0;font-size:13px;min-width:0}

/* ---------- Fluent Dark: frosted glass with blue accents (from Homepage custom.css) ---------- */
.und[data-theme=fluent]{background:radial-gradient(1100px 600px at 0% -10%,rgba(59,130,246,.14),transparent 60%),radial-gradient(900px 520px at 100% 0%,rgba(99,102,241,.10),transparent 60%),var(--bg)}
.und[data-theme=fluent].has-bg{background:transparent}
.und[data-theme=fluent] .card,.und[data-theme=fluent] button.stat,.und[data-theme=fluent] .ci,.und[data-theme=fluent] .alert,.und[data-theme=fluent] .panel,.und[data-theme=fluent] .olist{
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-radius:10px;box-shadow:0 4px 6px -1px rgba(0,0,0,.2);transition:background-color .3s,border-color .3s,box-shadow .3s}
.und[data-theme=fluent] .card:hover,.und[data-theme=fluent] button.stat:hover,.und[data-theme=fluent] .ci:hover,.und[data-theme=fluent] a.mi:hover{background-color:rgba(39,43,48,.5);border-color:rgba(59,130,246,.8);box-shadow:0 0 15px rgba(59,130,246,.3)}
.und[data-theme=fluent] .sec-h h2,.und[data-theme=fluent] .nm,.und[data-theme=fluent] .cname{font-weight:500}
.und[data-theme=fluent] .aico,.und[data-theme=fluent] .ci img,.und[data-theme=fluent] .w .ch .ico{background:rgba(255,255,255,.05);border-radius:6px;opacity:.9;transition:transform .3s cubic-bezier(.4,0,.2,1),filter .3s,background-color .3s}
.und[data-theme=fluent] .card:hover .aico,.und[data-theme=fluent] .ci:hover img,.und[data-theme=fluent] a:hover .aico{opacity:1;background:rgba(59,130,246,.15);transform:scale(1.08);filter:drop-shadow(0 0 6px rgba(59,130,246,.8))}
.und[data-theme=fluent] .meter,.und[data-theme=fluent] .progress{background:rgba(0,0,0,.3);border-radius:10px;box-shadow:inset 0 1px 3px rgba(0,0,0,.4)}
.und[data-theme=fluent] .meter i,.und[data-theme=fluent] .progress i,.und[data-theme=fluent] .stat .bar i{background:linear-gradient(90deg,#1e3a8a,#3b82f6,#60a5fa);border-radius:10px;box-shadow:0 0 8px rgba(59,130,246,.4)}
.und[data-theme=fluent] .meter i.warn,.und[data-theme=fluent] .stat.warn .bar i{background:linear-gradient(90deg,#92400e,var(--warn))}
.und[data-theme=fluent] .meter i.bad,.und[data-theme=fluent] .stat.bad .bar i{background:linear-gradient(90deg,#7f1d1d,var(--bad))}
/* overlays stay solid so text over moving content is readable */
.und[data-theme=fluent] .modal,.und[data-theme=fluent] .menu,.und[data-theme=fluent] .toast{background:rgba(17,19,24,.96);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-color:rgba(255,255,255,.12)}
.und[data-theme=fluent] *{scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.12) transparent}

/* Fluent Light: the same glass look on a light background */
.und[data-theme=fluent][data-mode=light]{background:radial-gradient(1100px 600px at 0% -10%,rgba(37,99,235,.12),transparent 60%),radial-gradient(900px 520px at 100% 0%,rgba(99,102,241,.10),transparent 60%),var(--bg)}
.und[data-theme=fluent][data-mode=light] .card,.und[data-theme=fluent][data-mode=light] button.stat,.und[data-theme=fluent][data-mode=light] .ci,.und[data-theme=fluent][data-mode=light] .alert,.und[data-theme=fluent][data-mode=light] .panel,.und[data-theme=fluent][data-mode=light] .olist{box-shadow:0 4px 12px -4px rgba(15,23,42,.12)}
.und[data-theme=fluent][data-mode=light] .card:hover,.und[data-theme=fluent][data-mode=light] button.stat:hover,.und[data-theme=fluent][data-mode=light] .ci:hover,.und[data-theme=fluent][data-mode=light] a.mi:hover{background-color:rgba(255,255,255,.85);border-color:rgba(37,99,235,.6);box-shadow:0 0 15px rgba(37,99,235,.18)}
.und[data-theme=fluent][data-mode=light] .aico,.und[data-theme=fluent][data-mode=light] .ci img,.und[data-theme=fluent][data-mode=light] .w .ch .ico{background:rgba(15,23,42,.04)}
.und[data-theme=fluent][data-mode=light] .meter,.und[data-theme=fluent][data-mode=light] .progress{background:rgba(15,23,42,.08);box-shadow:inset 0 1px 2px rgba(15,23,42,.12)}
.und[data-theme=fluent][data-mode=light] .meter i,.und[data-theme=fluent][data-mode=light] .progress i,.und[data-theme=fluent][data-mode=light] .stat .bar i{background:linear-gradient(90deg,#1d4ed8,#3b82f6,#60a5fa);box-shadow:0 0 6px rgba(37,99,235,.3)}
.und[data-theme=fluent][data-mode=light] .modal,.und[data-theme=fluent][data-mode=light] .menu,.und[data-theme=fluent][data-mode=light] .toast{background:rgba(255,255,255,.97);border-color:rgba(15,23,42,.12)}
.und[data-theme=fluent][data-mode=light] *{scrollbar-color:rgba(15,23,42,.2) transparent}
]]></INLINE>
<SHA256>58fe1df5fdc2372f877cb6f51ea45244ded4454949d514a6d7305a42f8a91822</SHA256>
</FILE>

<FILE Name="&emhttp;/assets/app.js" Mode="0644">
<INLINE><![CDATA[/* UnDash UI: one page (overview, alerts, favourites, metrics, containers, VMs, storage, services) plus a settings drawer.
