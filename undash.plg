        names.slice(i).forEach(function (n) { delete S.busy['d:' + n]; });
        prog.style.display = 'none'; stopB.disabled = true;
        status.textContent = 'Finished: ' + ok + ' updated' + (bad ? ', ' + bad + ' failed' : '') + (stop && i < names.length ? ', ' + (names.length - i) + ' not started' : '') + '.';
