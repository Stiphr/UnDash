FgCFcOVe5DgwRYQB7FzY5RIGjBMH6J55AK31xR9AgubfJqjAvQMwaD86bAFQCDNoHAAE7BQwAAAH
AKB7AFrAH0CCCjwFDXKPTf1x496Mcbg/P+OUuMeTyIvT2YPyKw1eCGLlyBnCVH5qt97tGqQHRJ55
RSOfKMO7VImG6ER4ueib7o9ZHGjvqzD9T9csjVo2Lkq3nMBzHnA7Zq3g6XGTV9Rt2UT9cteBDg1E
xj0MUseiifsaVhyzapLUtR+MBh6WGMsmmkKQPOabYbXOv7G6fPSyW9PFtmKlTFhTPkX/qXBm7aJu
7LrW6Bn7XuRk8sT2p8B7smynMe6xr/vZRM4Rn8+lZ/EqqvCkob7UmTeIl+TYTmK7Co5HYTfuDeFZ
6+DP9utwr7Pqm1jGfsKzl6vam0jBjqqhxjrz5lD+Z7+wyeNjCwAA' | base64 -d > /tmp/undash-font 2>/dev/null
if [ "$(sha256sum /tmp/undash-font | cut -d' ' -f1)" = "c940764593d0fe5d596be327ca7558855e018039fb78509aa21921fd3644c3e4" ]; then mv -f /tmp/undash-font &emhttp;/assets/inter.woff2; chmod 644 &emhttp;/assets/inter.woff2; else echo "font check failed, skipped"; fi
rm -f /tmp/undash-font
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p &flash;
chmod 755 &emhttp;/scripts/oscheck.php &emhttp;/scripts/rc.undash
chmod 600 &flash;/secrets.json 2>/dev/null
# first install: the documented defaults (configuration in appdata, standalone port 9099); an existing file is never changed
[ -f &flash;/undash.cfg ] || printf 'CONFIG_DIR="/mnt/user/appdata/undash"
PORT="9099"
BIND="0.0.0.0"
STANDALONE="yes"
' > &flash;/undash.cfg
# keep sessions and history across a plugin update, drop caches
rm -f /tmp/undash/inspect.json /tmp/undash/vminfo.json /tmp/undash/rates.json /tmp/undash/cg.json
&emhttp;/scripts/rc.undash restart
echo ""
echo "----------------------------------------------------"
echo " UnDash &version; installed"
echo " Open it from the UnDash tab in Unraid's top menu,"
echo " or on its own port (default 9099) when signed in to Unraid"
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
if [ -x &emhttp;/scripts/rc.undash ]; then &emhttp;/scripts/rc.undash stop; fi
rm -rf &emhttp; /tmp/undash
echo "UnDash removed. Your settings were kept in &flash; and in the configuration directory (default /mnt/user/appdata/undash)."

</INLINE>
</FILE>

</PLUGIN>
