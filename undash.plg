    r.tools.appendChild(btn('History', alertHistory, 'ghost sm', 'clock', 'When each problem started and ended'));
  };
  /* Alert ids are "<category>:<resource>" (see include/ignores.php); an alert without a category cannot be ignored. */
  var ALERT_CAT = {
