      h('div', { class: 'ell' }, h('div', { class: 'nm' }, h('span', { class: 'ell', title: c.name }, p.label || c.name), p.favorite ? ic('star', true) : null),
        h('div', { class: 'im ell', title: c.image }, p.description || c.image)));
  }
