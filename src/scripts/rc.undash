#!/bin/bash
# UnDash - start / stop the standalone dashboard port (default 9099).
# Settings come from /boot/config/plugins/undash/undash.cfg (PORT, BIND, STANDALONE); they are read, never sourced.
EM=/usr/local/emhttp/plugins/undash
CFG=/boot/config/plugins/undash/undash.cfg
PIDF=/var/run/undash.pid
CPIDF=/var/run/undash-check.pid

val() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$CFG" 2>/dev/null | tail -1; }
PORT=$(val PORT); BIND=$(val BIND); ON=$(val STANDALONE)
[[ "$PORT" =~ ^[0-9]{4,5}$ ]] && (( PORT >= 1024 && PORT <= 65535 )) || PORT=9099
[[ "$BIND" =~ ^[0-9a-fA-F.:]+$ ]] || BIND=0.0.0.0
[[ "$ON" == "no" ]] || ON=yes

running() { [[ -f $PIDF ]] && kill -0 "$(cat $PIDF)" 2>/dev/null && grep -q "undash/standalone" "/proc/$(cat $PIDF)/cmdline" 2>/dev/null; }

start() {
  [[ $ON == yes ]] || { echo "UnDash standalone port is turned off"; return 0; }
  running && { echo "UnDash already listening (pid $(cat $PIDF))"; return 0; }
  if ss -ltn "sport = :$PORT" 2>/dev/null | grep -q LISTEN; then
    echo "Port $PORT is already in use; UnDash's standalone port was not started" | tee -a /var/log/undash.log
    logger -t undash "port $PORT is already in use; standalone dashboard not started"
    return 1
  fi
  mkdir -p /tmp/undash
  # 4 workers so slow app APIs or a log download never block the dashboard; access logs are not kept, errors go to syslog.
  # Unraid's php.ini prepends webGui/include/local_prepend.php (its own CSRF check for nginx requests); this port does its own
  # sign-in and CSRF checks in router.php, so the prepend is switched off here.
  PHP_CLI_SERVER_WORKERS=4 setsid nohup /usr/bin/php -d auto_prepend_file= -d error_log=syslog -d display_errors=0 -d expose_php=0 \
    -S "$BIND:$PORT" -t "$EM/standalone" "$EM/standalone/router.php" > /dev/null 2>&1 &
  echo $! > $PIDF
  sleep 0.5
  running && echo "UnDash listening on $BIND:$PORT" || { echo "UnDash standalone port failed to start"; return 1; }
}

stop() {
  if running; then
    pkill -P "$(cat $PIDF)" 2>/dev/null; kill "$(cat $PIDF)" 2>/dev/null; sleep 0.3
    echo "UnDash standalone port stopped"
  fi
  rm -f $PIDF
}

# the alert history: one check a minute in the background, whether or not the standalone port is on
checking() { [[ -f $CPIDF ]] && kill -0 "$(cat $CPIDF)" 2>/dev/null && grep -q "undash-alertcheck" "/proc/$(cat $CPIDF)/cmdline" 2>/dev/null; }
start_check() {
  checking && return 0
  mkdir -p /tmp/undash
  setsid nohup bash -c 'exec -a undash-alertcheck bash -c "while true; do nice -n 10 /usr/bin/php -d auto_prepend_file= -d error_log=syslog -d display_errors=0 '"$EM"'/scripts/alertcheck.php; sleep 60; done"' > /dev/null 2>&1 &
  echo $! > $CPIDF
}
stop_check() {
  if checking; then pkill -P "$(cat $CPIDF)" 2>/dev/null; kill "$(cat $CPIDF)" 2>/dev/null; fi
  rm -f $CPIDF
}

case "$1" in
  start) start_check; start ;;
  stop) stop; stop_check ;;
  restart) stop; stop_check; start_check; start ;;
  status) running && echo "running on $BIND:$PORT (pid $(cat $PIDF))" || echo "stopped"; checking && echo "alert checker running (pid $(cat $CPIDF))" || echo "alert checker stopped" ;;
  *) echo "usage: $0 start|stop|restart|status"; exit 1 ;;
esac
